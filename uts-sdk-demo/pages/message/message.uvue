<template>
	<scroll-view class="container" scroll-y="true">
		<view class="content">
			<!-- 第一段：目标ID输入 -->
			<view class="section">
				<text class="section-title">接收方信息</text>
				<view class="input-row">
					<text class="label">目标ID</text>
					<input 
						class="input" 
						type="text" 
						v-model="targetId" 
						placeholder="请输入接收方ID"
					/>
				</view>
				
				<!-- 聊天类型选择 -->
				<view class="chat-type-row">
					<text class="label">会话类型</text>
					<view class="radio-group">
						<view class="radio-item" @click="chatType = 'single'">
							<view :class="['radio-circle', chatType === 'single' ? 'checked' : '']">
								<view v-if="chatType === 'single'" class="radio-inner"></view>
							</view>
							<text class="radio-label">单聊</text>
						</view>
						<view class="radio-item" @click="chatType = 'group'">
							<view :class="['radio-circle', chatType === 'group' ? 'checked' : '']">
								<view v-if="chatType === 'group'" class="radio-inner"></view>
							</view>
							<text class="radio-label">群组</text>
						</view>
					</view>
				</view>
			</view>
			
			<!-- 第二段：消息内容输入 -->
			<view class="section">
				<text class="section-title">消息内容</text>
				<textarea 
					class="textarea" 
					v-model="messageContent" 
					placeholder="请输入要发送的文本消息"
					:maxlength="500"
				/>
				<text class="char-count">{{ messageContent.length }}/500</text>
			</view>
			
			<!-- 消息扩展字段 -->
			<view class="section">
				<text class="section-title">消息扩展字段（可选）</text>
				<text class="ext-hint">用于携带自定义业务字段，JSON格式</text>
				<textarea 
					class="textarea ext-textarea" 
					v-model="extFieldInput" 
					placeholder='{"key1": "value1", "key2": 123}'
					:maxlength="500"
				/>
				<view class="checkbox-row" @click="useExtField = !useExtField">
					<view :class="['checkbox', useExtField ? 'checked' : '']">
						<text v-if="useExtField" class="checkbox-mark">✓</text>
					</view>
					<text class="checkbox-label">启用扩展字段</text>
				</view>
			</view>
			
			<!-- 第三段：操作按钮 -->
			<view class="section">
				<text class="section-title">发送文本消息</text>
				<view 
					class="btn btn-primary" 
					:class="{ 'btn-disabled': !canSend }"
					hover-class="btn-primary-hover"
					@click="handleSend"
				>
					<text class="btn-text">发送文本消息</text>
				</view>
			</view>
			
			<!-- 第四段：图片测试 -->
			<view class="section">
				<text class="section-title">发送图片</text>
				
				<!-- 原图选项 -->
				<view class="checkbox-row" @click="sendOriginalImage = !sendOriginalImage">
					<view :class="['checkbox', sendOriginalImage ? 'checked' : '']">
						<text v-if="sendOriginalImage" class="checkbox-mark">✓</text>
					</view>
					<text class="checkbox-label">发送原图</text>
				</view>
				
				<!-- 图片按钮 -->
				<view class="image-btn-group">
					<view 
						class="btn btn-image" 
						hover-class="btn-image-hover"
						@click="handleChooseImage('album')"
					>
						<text class="btn-text">从相册选择</text>
					</view>
					<view 
						class="btn btn-image" 
						hover-class="btn-image-hover"
						@click="handleChooseImage('camera')"
					>
						<text class="btn-text">拍照</text>
					</view>
				</view>
			</view>
			
			<!-- 第四段半：视频测试 -->
			<view class="section">
				<text class="section-title">发送视频</text>
				<text class="video-hint">支持从相册选择或拍摄视频，自动获取视频时长</text>
				
				<!-- 视频按钮 -->
				<view class="video-btn-group">
					<view 
						class="btn btn-video" 
						hover-class="btn-video-hover"
						@click="handleChooseVideo('album')"
					>
						<text class="btn-text">从相册选择</text>
					</view>
					<view 
						class="btn btn-video" 
						hover-class="btn-video-hover"
						@click="handleChooseVideo('camera')"
					>
						<text class="btn-text">拍摄视频</text>
					</view>
				</view>
			</view>
			
			<!-- 第五段：文件消息测试 -->
			<view class="section">
				<text class="section-title">发送文件</text>
				<text class="file-hint">支持选择任意类型文件发送，如PDF、Word、Excel等</text>
				
				<!-- 文件选择按钮 -->
				<view 
					class="btn btn-file" 
					:class="{ 'btn-disabled': targetId.length === 0 }"
					hover-class="btn-file-hover"
					@click="handleChooseFile"
				>
					<text class="btn-text">选择文件并发送</text>
				</view>
			</view>
			
			<!-- 第六段：CMD消息测试 -->
			<view class="section">
				<text class="section-title">发送CMD消息</text>
				<text class="cmd-hint">透传消息用于发送命令，action: test_command</text>
				<view 
					class="btn btn-cmd" 
					:class="{ 'btn-disabled': targetId.length === 0 }"
					hover-class="btn-cmd-hover"
					@click="handleSendCmd"
				>
					<text class="btn-text">发送CMD消息</text>
				</view>
			</view>
			
			<!-- 第七段：自定义消息测试 - 淘宝订单消息 -->
			<view class="section">
				<text class="section-title">发送自定义消息（淘宝订单）</text>
				<text class="custom-hint">模拟发送图文混合的淘宝订单消息，event: taobao_order</text>
				
				<!-- 订单预览卡片 -->
				<view class="order-card">
					<view class="order-header">
						<text class="order-shop">淘宝店铺：官方旗舰店</text>
						<text class="order-status">已发货</text>
					</view>
					<view class="order-content">
						<image 
							class="order-image" 
							src="/static/logo.png" 
							mode="aspectFill"
						/>
						<view class="order-info">
							<text class="order-title">高端智能手表 运动版</text>
							<text class="order-spec">颜色：星空黑 / 规格：标准版</text>
							<text class="order-price">¥299.00</text>
						</view>
						<text class="order-count">x1</text>
					</view>
					<view class="order-footer">
						<text class="order-total">共1件商品 合计: </text>
						<text class="order-total-price">¥299.00</text>
					</view>
				</view>
				
				<view 
					class="btn btn-custom" 
					:class="{ 'btn-disabled': targetId.length === 0 }"
					hover-class="btn-custom-hover"
					@click="handleSendTaobaoOrder"
				>
					<text class="btn-text">发送淘宝订单消息</text>
				</view>
			</view>
			
			<!-- 日志区域 -->
			<view class="section log-section">
				<text class="section-title">发送日志</text>
				<scroll-view class="log-scroll" scroll-y="true">
					<text class="log-content">{{ logContent }}</text>
				</scroll-view>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	// 统一 API（跨平台，无需条件编译）
	import { sendTextMessage, sendImageMessage, sendVideoMessage, sendCmdMessage, sendCustomMessage } from "@/uni_modules/easemob-uts-sdk"
	// 文件消息和文件选择器（Android 和 iOS 都支持）
	import { sendFileMessage, openFilePicker, FilePickResultData } from "@/uni_modules/easemob-uts-sdk"
	
	// 响应式数据
	const targetId = ref('pfh2')
	const chatType = ref('single') // 'single' 或 'group'
	const messageContent = ref('')
	const logContent = ref('')
	const sendOriginalImage = ref(false) // 是否发送原图
	const extFieldInput = ref('{"customKey": "customValue"}') // 扩展字段输入
	const useExtField = ref(false) // 是否启用扩展字段
	const videoThumbPath = ref('') // 视频缩略图路径（可选）
	
	// 计算属性：是否可以发送
	const canSend = computed((): boolean => {
		return targetId.value.length > 0 && messageContent.value.length > 0
	})
	
	// 添加日志
	function addLog(message: string): void {
		const time = new Date().toLocaleTimeString()
		logContent.value = `[${time}] ${message}\n` + logContent.value
	}
	
	// 解析扩展字段
	function parseExtField(): UTSJSONObject | null {
		if (!useExtField.value || extFieldInput.value.trim().length === 0) {
			return null
		}
		try {
			const ext = JSON.parse(extFieldInput.value.trim()) as UTSJSONObject
			return ext
		} catch (e) {
			addLog('扩展字段JSON解析失败，请检查格式')
			return null
		}
	}
	
	// 发送文本消息已统一封装，无需平台分发

	// 发送消息
	function handleSend(): void {
		if (!canSend.value) {
			addLog('错误：目标ID和消息内容不能为空')
			return
		}
			
		const to = targetId.value.trim()
		const content = messageContent.value.trim()
		const ext = parseExtField()
			
		addLog(`发送消息到 ${chatType.value === 'single' ? '用户' : '群组'}: ${to}`)
		addLog(`消息内容: ${content}`)
		if (ext != null) {
			addLog(`扩展字段: ${JSON.stringify(ext)}`)
		}

		sendTextMessage(
			content,
			to,
			chatType.value,
			(messageInfo: UTSJSONObject) => {
				console.log('[MessagePage] 消息发送成功回调触发')
				const msgId = (messageInfo['msgId'] as string | null) ?? 'unknown'
				const msgType = (messageInfo['type'] as string | null) ?? 'unknown'
				const chatTypeStr = (messageInfo['chatType'] as string | null) ?? 'unknown'
				const msgExt = messageInfo['ext'] as UTSJSONObject | null
				console.log('[MessagePage] 消息 ID:', msgId)
				console.log('[MessagePage] 消息类型:', msgType)
				console.log('[MessagePage] 聊天类型:', chatTypeStr)
				addLog('消息发送成功, ID: ' + msgId)
				addLog('消息类型: ' + msgType + ', 聊天类型: ' + chatTypeStr)
				if (msgExt != null) {
					addLog('扩展字段: ' + JSON.stringify(msgExt))
				}
				messageContent.value = ''
			},
			(code: number, message: string) => {
				console.log(`[MessagePage] 消息发送失败: code=${code}, message=${message}`)
				addLog(`消息发送失败: code=${code}, message=${message}`)
			},
			(progress: number, status: string) => {
				console.log(`[MessagePage] 发送进度: progress=${progress}, status=${status}`)
			},
			ext
		)
	}
	
	// 选择并发送图片
	function handleChooseImage(sourceType: string): void {
		if (targetId.value.length == 0) {
			addLog('错误：请先输入目标ID')
			return
		}
		
		addLog(`正在打开${sourceType === 'camera' ? '相机' : '相册'}...`)
		
		uni.chooseImage({
			count: 1,
			sizeType: ['original', 'compressed'],
			sourceType: [sourceType] as string[],
			success: (res) => {
				const paths = res.tempFilePaths
				if (paths != null && paths.length > 0) {
					const imagePath = paths[0]!
					addLog(`已选择图片: ${imagePath}`)
					
					// 发送图片消息
					sendImageMessage(
						imagePath,
						sendOriginalImage.value,
						targetId.value.trim(),
						chatType.value,
						(messageInfo: UTSJSONObject) => {
							console.log('[MessagePage] 图片发送成功回调触发')
							const msgId = (messageInfo['msgId'] as string | null) ?? 'unknown'
							const msgType = (messageInfo['type'] as string | null) ?? 'unknown'
							const chatTypeStr = (messageInfo['chatType'] as string | null) ?? 'unknown'
							console.log('[MessagePage] 图片消息ID:', msgId)
							console.log('[MessagePage] 消息类型:', msgType)
							console.log('[MessagePage] 聊天类型:', chatTypeStr)
							addLog('图片发送成功, ID: ' + msgId)
							addLog('消息类型: ' + msgType + ', 聊天类型: ' + chatTypeStr)
						},
						(code: number, message: string) => {
							console.log(`[MessagePage] 图片发送失败回调触发: code=${code}, message=${message}`)
							addLog(`图片发送失败: code=${code}, message=${message}`)
						},
						(progress: number, status: string) => {
							console.log(`[MessagePage] 图片发送进度回调触发: progress=${progress}`)
							addLog(`图片上传进度: ${progress}%`)
						}
					)
				}
			},
			fail: (err) => {
				addLog(`选择图片失败`)
			}
		})
	}
	
	// 选择并发送视频
	function handleChooseVideo(sourceType: string): void {
		if (targetId.value.length == 0) {
			addLog('错误：请先输入目标ID')
			return
		}
		
		addLog(`正在打开${sourceType === 'camera' ? '摄像机' : '相册'}...`)
		
		uni.chooseVideo({
			sourceType: [sourceType] as string[],
			maxDuration: 60,
			camera: 'back',
			success: (res) => {
				const videoPath = res.tempFilePath
				const durationFloat = res.duration
				// 将 Float 转换为 Int（视频时长秒数取整）
				const duration = Math.floor(durationFloat as number) as Int
				
				if (videoPath != null) {
					addLog(`已选择视频: ${videoPath}`)
					addLog(`视频时长: ${duration}秒`)
					
					// 发送视频消息
					// sendVideoMessage 参数: videoFilePath, imageThumbPath, timeLength, to, chatType, onSuccess, onError, onProgress
					// imageThumbPath 可以为空字符串，SDK 会自动生成缩略图
					sendVideoMessage(
						videoPath,
						videoThumbPath.value,
						duration,
						targetId.value.trim(),
						chatType.value,
						(messageInfo: UTSJSONObject) => {
							console.log('[MessagePage] 视频发送成功回调触发')
							const msgId = (messageInfo['msgId'] as string | null) ?? 'unknown'
							const msgType = (messageInfo['type'] as string | null) ?? 'unknown'
							const chatTypeStr = (messageInfo['chatType'] as string | null) ?? 'unknown'
							console.log('[MessagePage] 视频消息ID:', msgId)
							console.log('[MessagePage] 消息类型:', msgType)
							console.log('[MessagePage] 聊天类型:', chatTypeStr)
							addLog('视频发送成功, ID: ' + msgId)
							addLog('消息类型: ' + msgType + ', 聊天类型: ' + chatTypeStr)
						},
						(code: number, message: string) => {
							console.log(`[MessagePage] 视频发送失败回调触发: code=${code}, message=${message}`)
							addLog(`视频发送失败: code=${code}, message=${message}`)
						},
						(progress: number, status: string) => {
							console.log(`[MessagePage] 视频发送进度回调触发: progress=${progress}`)
							addLog(`视频上传进度: ${progress}%`)
						}
					)
				}
			},
			fail: (err) => {
				addLog(`选择视频失败`)
			}
		})
	}
	
	// 选择并发送文件
	function handleChooseFile(): void {
		if (targetId.value.length == 0) {
			addLog('错误：请先输入目标ID')
			return
		}
		
		addLog('正在打开文件选择器...')
		
		openFilePicker(
			(result: FilePickResultData) => {
				console.log('[MessagePage] 文件选择成功回调触发')
				addLog(`已选择文件: ${result.fileName}`)
				addLog(`文件大小: ${result.fileSize} 字节`)
				addLog(`文件类型: ${result.mimeType}`)
				
				// 发送文件消息
				sendFileMessage(
					result.filePath,
					targetId.value.trim(),
					chatType.value,
					(messageInfo: UTSJSONObject) => {
						console.log('[MessagePage] 文件发送成功回调触发')
						const msgId = (messageInfo['msgId'] as string | null) ?? 'unknown'
						const msgType = (messageInfo['type'] as string | null) ?? 'unknown'
						const chatTypeStr = (messageInfo['chatType'] as string | null) ?? 'unknown'
						console.log('[MessagePage] 文件消息ID:', msgId)
						console.log('[MessagePage] 消息类型:', msgType)
						console.log('[MessagePage] 聊天类型:', chatTypeStr)
						addLog('文件发送成功, ID: ' + msgId)
						addLog('消息类型: ' + msgType + ', 聊天类型: ' + chatTypeStr)
					},
					(code: number, message: string) => {
						console.log(`[MessagePage] 文件发送失败回调触发: code=${code}, message=${message}`)
						addLog(`文件发送失败: code=${code}, message=${message}`)
					},
					(progress: number, status: string) => {
						console.log(`[MessagePage] 文件发送进度回调触发: progress=${progress}`)
						addLog(`文件上传进度: ${progress}%`)
					}
				)
			},
			(code: number, message: string) => {
				console.log(`[MessagePage] 文件选择失败: code=${code}, message=${message}`)
				addLog(`文件选择失败: code=${code}, message=${message}`)
			},
			() => {
				addLog('用户取消文件选择')
			}
		)
	}
	
	// 发送CMD消息
	function handleSendCmd(): void {
		if (targetId.value.length === 0) {
			addLog('错误：请先输入目标ID')
			return
		}
		
		const to = targetId.value.trim()
		const action = 'test_command'
		
		addLog(`发送CMD消息到 ${chatType.value === 'single' ? '用户' : '群组'}: ${to}`)
		addLog(`Action: ${action}`)
		
		sendCmdMessage(
			action,
			to,
			(messageInfo: UTSJSONObject) => {
			console.log('[MessagePage] CMD消息发送成功回调触发')
			if (messageInfo != null) {
				const msgId = (messageInfo['msgId'] as string | null) ?? 'unknown'
				const msgType = (messageInfo['type'] as string | null) ?? 'unknown'
				console.log('[MessagePage] CMD消息ID:', msgId)
				console.log('[MessagePage] 消息类型:', msgType)
				addLog('CMD消息发送成功, ID: ' + msgId)
				addLog('消息类型: ' + msgType)
			} else {
				console.log('[MessagePage] messageInfo为null或undefined')
				addLog('CMD消息发送成功(无详情)')
			}
			},
			(code: number, message: string) => {
				console.log(`[MessagePage] CMD消息发送失败回调触发: code=${code}, message=${message}`)
				addLog(`CMD消息发送失败: code=${code}, message=${message}`)
			},
			(progress: number, status: string) => {
				console.log(`[MessagePage] CMD消息发送进度回调触发: progress=${progress}, status=${status}`)
				addLog(`发送进度: ${progress}%, status=${status}`)
			}
		)
	}
	
	// 发送淘宝订单自定义消息
	function handleSendTaobaoOrder(): void {
		if (targetId.value.length === 0) {
			addLog('错误：请先输入目标ID')
			return
		}
		
		const to = targetId.value.trim()
		const event = 'taobao_order'
		
		// 构造淘宝订单消息参数
		const orderParams: UTSJSONObject = {
			orderId: 'TB' + Date.now().toString(),
			shopName: '官方旗舰店',
			productName: '高端智能手表 运动版',
			productImage: 'https://example.com/watch.jpg',
			spec: '颜色：星空黑 / 规格：标准版',
			price: '299.00',
			count: '1',
			status: '已发货',
			totalPrice: '299.00'
		}
		
		addLog(`发送自定义消息到 ${chatType.value === 'single' ? '用户' : '群组'}: ${to}`)
		addLog(`Event: ${event}`)
		addLog(`订单ID: ${orderParams['orderId']}`)
		
		sendCustomMessage(
			event,
			orderParams,
			to,
			chatType.value,
			(messageInfo: UTSJSONObject) => {
			console.log('[MessagePage] 自定义消息发送成功回调触发')
			if (messageInfo != null) {
				const msgId = (messageInfo['msgId'] as string | null) ?? 'unknown'
				const msgType = (messageInfo['type'] as string | null) ?? 'unknown'
				console.log('[MessagePage] 自定义消息ID:', msgId)
				console.log('[MessagePage] 消息类型:', msgType)
				addLog('自定义消息发送成功, ID: ' + msgId)
				addLog('消息类型: ' + msgType + ', event: ' + event)
			} else {
				console.log('[MessagePage] messageInfo为null或undefined')
				addLog('自定义消息发送成功(无详情)')
			}
			},
			(code: number, message: string) => {
				console.log(`[MessagePage] 自定义消息发送失败回调触发: code=${code}, message=${message}`)
				addLog(`自定义消息发送失败: code=${code}, message=${message}`)
			},
			(progress: number, status: string) => {
				console.log(`[MessagePage] 自定义消息发送进度回调触发: progress=${progress}, status=${status}`)
				addLog(`发送进度: ${progress}%, status=${status}`)
			}
		)
	}
	
	// 页面加载
	onLoad(() => {
		addLog('消息发送页面加载')
	})
</script>

<style>
	.container {
		flex: 1;
		background-color: #f5f5f5;
	}
	
	.content {
		padding: 15px;
	}
	
	.section {
		background-color: #ffffff;
		border-radius: 10px;
