	.container {
		flex: 1;
		background-color: #f5f5f5;
	}

	.content {
		padding: 15px;
	}

	.title {
		font-size: 24px;
		font-weight: bold;
		text-align: center;
		margin-bottom: 20px;
		color: #333333;
	}

	.section {
		background-color: #ffffff;
		border-radius: 10px;
		padding: 15px;
		margin-bottom: 15px;
	}

	.section-title {
		font-size: 16px;
		font-weight: bold;
		color: #333333;
		margin-bottom: 10px;
	}

	.input {
		height: 40px;
		border-width: 1px;
		border-color: #dddddd;
		border-radius: 5px;
		padding-left: 10px;
		padding-right: 10px;
		background-color: #f9f9f9;
		font-size: 14px;
	}

	.radio-group {
		flex-direction: row;
		align-items: center;
	}

	.radio-label {
		flex-direction: row;
		align-items: center;
		margin-right: 20px;
	}

	.radio-text {
		font-size: 14px;
		color: #333333;
		margin-left: 5px;
	}

	.radio-box {
		width: 18px;
		height: 18px;
		border-radius: 9px;
		border-width: 1px;
		border-color: #999999;
		justify-content: center;
		align-items: center;
	}

	.radio-box-checked {
		border-color: #007aff;
	}

	.radio-inner {
		width: 10px;
		height: 10px;
		border-radius: 5px;
		background-color: #007aff;
	}

	.textarea {
		height: 100px;
		border-width: 1px;
		border-color: #dddddd;
		border-radius: 5px;
		padding: 10px;
		background-color: #f9f9f9;
		font-size: 14px;
		margin-bottom: 10px;
	}

	.btn {
		margin-top: 10px;
	}
</style>
