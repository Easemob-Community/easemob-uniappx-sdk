<script setup lang="uts">
	// #ifdef APP-ANDROID
	import { initSDK, addConnectionListener, addMessageListener, Message } from "./uni_modules/easemob-uts-sdk"
	// #endif
	// #ifdef APP-IOS
	import { initSDK, startConnectionEmit, startMessageEmit } from "./uni_modules/easemob-uts-sdk"
	// #endif
	// #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
	// #endif

	onLaunch(() => {
		console.log('App Launch')
		
		// 初始化 SDK
		initSDK({ appKey: 'easemob-demo#support' })
		
		// #ifdef APP-IOS
		// 方案 B：开启 uni.$emit 广播，.uvue 中直接 uni.$on('em_connected') 监听
		startConnectionEmit()
		uni.$on('em_connected', () => {
			console.log('[EMConnection][iOS] 已连接到服务器')
		})
		uni.$on('em_disconnected', (data : UTSJSONObject) => {
			console.log('[EMConnection][iOS] 连接断开, errorCode:', data['errorCode'])
		})
		uni.$on('em_logout', (data : UTSJSONObject) => {
			console.log('[EMConnection][iOS] 被登出, errorCode:', data['errorCode'])
		})
		uni.$on('em_token_will_expire', () => {
			console.log('[EMConnection][iOS] Token 即将过期')
		})
		uni.$on('em_token_expired', () => {
			console.log('[EMConnection][iOS] Token 已过期')
		})
		// 消息监听
		startMessageEmit()
		uni.$on('em_message_received', (data : UTSJSONObject) => {
			const messagesJson = data['messagesJson'] as string
			const messages = JSON.parse(messagesJson) as UTSJSONObject[]
			console.log('[EMMessage][iOS] 收到消息, 数量:', messages.length)
			messages.forEach((msg : UTSJSONObject) => {
				const body = msg['body'] as UTSJSONObject
				const bodyType = body['type'] as string
				const chatType = msg['chatType'] as number
				const chatTypeName = chatType == 0 ? '单聊' : chatType == 1 ? '群聊' : '聊天室'
				console.log(`[EMMessage][iOS] 来自: ${msg['from']}, 聊天类型: ${chatTypeName}, 消息类型: ${bodyType}`)
				if (bodyType === 'txt') {
					console.log('[EMMessage][iOS] 文本内容:', body['message'] ?? '')
				}
			})
		})
		uni.$on('em_cmd_message_received', (data : UTSJSONObject) => {
			const messagesJson = data['messagesJson'] as string
			const messages = JSON.parse(messagesJson) as UTSJSONObject[]
			console.log('[EMMessage][iOS] 收到透传消息, 数量:', messages.length)
			messages.forEach((msg : UTSJSONObject) => {
				console.log(`[EMMessage][iOS] CMD action: ${(msg['body'] as UTSJSONObject)['action'] ?? ''}`)
			})
		})
		// #endif
		// #ifdef APP-ANDROID
		// 设置完 appKey 后第一时间挂载连接监听
		addConnectionListener(
			(): void => {
				console.log('[EMConnection] 已连接到服务器')
			},
			(errorCode: number): void => {
				console.log('[EMConnection] 连接断开, errorCode:', errorCode)
			},
			(errorCode: number): void => {
				console.log('[EMConnection] 被登出, errorCode:', errorCode)
			},
			(): void => {
				console.log('[EMConnection] Token 即将过期')
			},
			(): void => {
				console.log('[EMConnection] Token 已过期')
			},
			(): void => {
				console.log('[EMConnection] 开始同步离线消息')
			},
			(): void => {
				console.log('[EMConnection] 离线消息同步完成')
			}
		)
		// #endif

		// #ifdef APP-ANDROID
		// 挂载消息监听
		const unsubscribeMessage = addMessageListener(
			(messages : Message[]): void => {
				console.log('[EMMessage] 收到消息, 数量:', messages.length)
				messages.forEach((msg : Message): void => {
					console.log(`[EMMessage] 来自: ${msg.from}, 类型: ${msg.body.type}`)
					if (msg.body.type === 'txt') {
						console.log('[EMMessage] 文本内容:', msg.body.message ?? '')
					}
					const ext = msg.ext
					const extJson = JSON.stringify(ext)
					if (extJson != '{}' && extJson.length > 2) {
						console.log('[EMMessage] 扩展字段:', extJson)
					} else {
						console.log('[EMMessage] 无扩展字段')
					}
				})
			},
			null,
			(messages : Message[]): void => {
				console.log('[EMMessage] 收到命令消息, 数量:', messages.length)
				messages.forEach((msg : Message): void => {
					console.log(`[EMMessage] CMD来自: ${msg.from}, action: ${msg.body.action ?? ''}`)
					const ext = msg.ext
					const extJson = JSON.stringify(ext)
					if (extJson != '{}' && extJson.length > 2) {
						console.log('[EMMessage] CMD扩展字段:', extJson)
					}
				})
			},
			(messages : Message[]): void => {
				console.log('[EMMessage] 消息已读, 数量:', messages.length)
			},
			null,
			null,
			(messages : Message[]): void => {
				console.log('[EMMessage] 消息已送达, 数量:', messages.length)
			},
			(messages : Message[]): void => {
				console.log('[EMMessage] 消息被撤回, 数量:', messages.length)
			},
			null,
			(message : Message, change : any): void => {
				console.log('[EMMessage] 消息变更, msgId:', message.msgId)
			},
			null,
			null,
			null
		)

		// 保存取消订阅函数，在需要时调用（如应用退出）
		// unsubscribe()
		// unsubscribeMessage()
		// #endif
	})

	onAppShow(() => {
		console.log('App Show')
	})

	onAppHide(() => {
		console.log('App Hide')
	})

	// #ifdef APP-ANDROID || APP-HARMONY
	onLastPageBackPress(() => {
		console.log('App LastPageBackPress')
		if (firstBackTime == 0) {
			uni.showToast({
				title: '再按一次退出应用',
				position: 'bottom',
			})
			firstBackTime = Date.now()
			setTimeout(() => {
				firstBackTime = 0
			}, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			firstBackTime = Date.now()
			uni.exit()
		}
	})

	onExit(() => {
		console.log('App Exit')
	})
	// #endif
</script>

<style>
	/*每个页面公共css */
	.uni-row {
		flex-direction: row;
	}

	.uni-column {
		flex-direction: column;
	}
</style>