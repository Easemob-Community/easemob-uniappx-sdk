/**
 * Easemob IM SDK Beta - iOS 平台实现
 * 实现初始化 + 登录 + 登出 + 连接监听 + 状态查询
 */

import { EMClient, EMOptions, EMClientDelegate, EMError, EMErrorCode, EMConnectionState } from 'HyphenateChat';
import {
  IEMClient,
  EMErrorListener,
  EMTokenWillExpireListener,
  EMTokenExpiredListener,
} from '../interface.uts';

// em_bridge.swift 中的独立函数由 UTS 编译器自动识别，无需 declare

// ==================== SDK 实现类 ====================

class EMClientImpl implements IEMClient {
  private static _instance: EMClientImpl | null = null;
  private _client: EMClient | null = null;
  private _isInitialized = false;

  private constructor() {}

  static getInstance(): EMClientImpl {
    if (this._instance == null) {
      this._instance = new EMClientImpl();
    }
    return this._instance!;
  }

  // MARK: - 核心方法

  initSDK(config: UTSJSONObject): Promise<void> {
    return new Promise((resolve, reject) => {
      try {
        if (this._isInitialized) {
          console.log('[iOS] EMClient SDK already initialized');
          resolve();
          return;
        }

        const appKey = config['appKey'] as string;
        const autoLogin = (config['autoLogin'] as boolean) ?? false;
        const options = new EMOptions(appkey = appKey);
        options.isAutoLogin = autoLogin;

        EMClient.shared().initializeSDK(with = options);

        emBridgeSetupDelegate();
        this._client = EMClient.shared();

        this._isInitialized = true;
        console.log('[iOS] EMClient SDK initialized');
        resolve();
      } catch (error) {
        console.error('[iOS] EMClient SDK init failed:', error);
        reject(error);
      }
    });
  }

  login(config: UTSJSONObject): Promise<void> {
    return new Promise((resolve, reject) => {
      try {
        const userId = config['userId'] as string;
        const password = config['password'] as string;
        const useToken = (config['useToken'] as boolean) ?? false;

        const completion = (username: string, error: EMError | null): void => {
          if (error != null) {
            const code = error!.code.rawValue as number;
            const msg = error!.errorDescription ?? 'Login failed';
            console.error('[iOS] Login failed:', code, msg);
            reject(new Error(`Login failed: ${code} - ${msg}`));
          } else {
            console.log('[iOS] Login success:', username);
            resolve();
          }
        };

        if (useToken) {
          EMClient.shared().login(withUsername = userId, token = password, completion = completion);
        } else {
          EMClient.shared().login(withUsername = userId, password = password, completion = completion);
        }
      } catch (error) {
        console.error('[iOS] Login error:', error);
        reject(error);
      }
    });
  }

  logout(): Promise<void> {
    return new Promise((resolve, reject) => {
      try {
        const completion = (error: EMError | null): void => {
          if (error != null) {
            const code = error!.code.rawValue as number;
            const msg = error!.errorDescription ?? 'Logout failed';
            console.error('[iOS] Logout failed:', code, msg);
            reject(new Error(`Logout failed: ${code} - ${msg}`));
          } else {
            console.log('[iOS] Logout success');
            resolve();
          }
        };

        EMClient.shared().logout(true, completion = completion);
      } catch (error) {
        console.error('[iOS] Logout error:', error);
        reject(error);
      }
    });
  }

  destroy(): void {
    emBridgeTeardownDelegate();
    this._client = null;
    this._isInitialized = false;
    console.log('[iOS] EMClient SDK destroyed');
  }

  // MARK: - 事件监听

  @UTSJS.keepAlive
  onConnected(listener: (() => void) | null): void {
    emBridgeSetOnConnected(callback = listener);
  }

  @UTSJS.keepAlive
  onDisconnected(listener: ((errorCode: number) => void) | null): void {
    emBridgeSetOnDisconnected(callback = listener);
  }

  @UTSJS.keepAlive
  onLogout(listener: ((errorCode: number) => void) | null): void {
    emBridgeSetOnLogout(callback = listener);
  }

  @UTSJS.keepAlive
  onTokenWillExpire(listener: EMTokenWillExpireListener | null): void {
    emBridgeSetOnTokenWillExpire(callback = listener);
  }

  @UTSJS.keepAlive
  onTokenExpired(listener: EMTokenExpiredListener | null): void {
    emBridgeSetOnTokenExpired(callback = listener);
  }

  // MARK: - 状态查询

  getVersion(): string {
    return EMClient.shared().version;
  }

  isConnected(): boolean {
    return EMClient.shared().isConnected;
  }

  isLoggedIn(): boolean {
    return EMClient.shared().isLoggedIn;
  }

  getCurrentUser(): string | null {
    return EMClient.shared().currentUsername;
  }

  // MARK: - 桩函数

  onError(_listener: EMErrorListener | null): void {
    // 桩函数：待实现
  }
}

// ==================== 导出 ====================

export function initSDK(config: UTSJSONObject): Promise<void> {
  return EMClientImpl.getInstance().initSDK(config);
}

export function login(config: UTSJSONObject): Promise<void> {
  return EMClientImpl.getInstance().login(config);
}

export function logout(): Promise<void> {
  return EMClientImpl.getInstance().logout();
}

export function destroy(): void {
  EMClientImpl.getInstance().destroy();
}

export function onConnected(listener: (() => void) | null): void {
  EMClientImpl.getInstance().onConnected(listener);
}

export function onDisconnected(listener: ((errorCode: number) => void) | null): void {
  EMClientImpl.getInstance().onDisconnected(listener);
}

export function onLogout(listener: ((errorCode: number) => void) | null): void {
  EMClientImpl.getInstance().onLogout(listener);
}

export function onTokenWillExpire(listener: EMTokenWillExpireListener | null): void {
  EMClientImpl.getInstance().onTokenWillExpire(listener);
}

export function onTokenExpired(listener: EMTokenExpiredListener | null): void {
  EMClientImpl.getInstance().onTokenExpired(listener);
}

export function onError(_listener: EMErrorListener | null): void {}

export function getVersion(): string {
  return EMClientImpl.getInstance().getVersion();
}

export function isConnected(): boolean {
  return EMClientImpl.getInstance().isConnected();
}

export function isLoggedIn(): boolean {
  return EMClientImpl.getInstance().isLoggedIn();
}

export function getCurrentUser(): string | null {
  return EMClientImpl.getInstance().getCurrentUser();
}

// 类型已在 utssdk/index.uts 统一导出，此处不重复 re-export
