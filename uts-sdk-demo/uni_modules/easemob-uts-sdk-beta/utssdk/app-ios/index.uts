/**
 * Easemob IM SDK Beta - iOS 平台实现
 * 实现初始化 + 登录 + 登出 + 连接监听 + 状态查询
 */

import {
  EMClient,
  EMOptions,
  EMError,
  EMErrorCode,
} from 'HyphenateChat';
import {
  EasemobClient,
  EMInitConfig,
  EMErrorListener,
  EMTokenWillExpireListener,
  EMTokenExpiredListener,
  Message,
  SendTextMessageConfig,
  SendCmdMessageConfig,
  SendCustomMessageConfig,
  EMConversation,
  EMCursorResult,
} from '../interface.uts';

// em_bridge.swift 中的独立函数由 UTS 编译器自动识别，无需 declare

// ==================== SDK 实现类 ====================

export class EMClientImpl implements EasemobClient {
  private static _instance: EMClientImpl | null = null;
  private _client: EMClient | null = null;
  private _isInitialized = false;

  private constructor() {}

  static getInstance(): EMClientImpl {
    if (this._instance == null) {
      this._instance = new EMClientImpl();
    }
    return this._instance!;
  }

  static getClient(): EasemobClient | null {
    const instance = EMClientImpl.getInstance();
    return instance._isInitialized ? instance : null;
  }

  static create(config: EMInitConfig): EasemobClient {
    const instance = EMClientImpl.getInstance();
    if (!instance._isInitialized) {
      const appKey = config.appKey!;
      const autoLogin = config.autoLogin ?? false;
      const options = new EMOptions(appkey = appKey);
      options.isAutoLogin = autoLogin;
      EMClient.shared().initializeSDK(with = options);
      emBridgeSetupDelegate();
      emBridgeSetupMessageDelegate();
      console.log('[iOS] EMMessageDelegateNative registered');

      instance._client = EMClient.shared();
      instance._isInitialized = true;
      console.log('[iOS] EMClient SDK initialized');
    } else {
      console.log('[iOS] EMClient SDK already initialized');
    }
    return instance;
  }

  login(config: UTSJSONObject): Promise<void> {
    return new Promise((resolve, reject) => {
      try {
        const userId = config['userId'] as string;
        const password = config['password'] as string;
        const useToken = (config['useToken'] as boolean) ?? false;

        const completion = (username: string, error: EMError | null): void => {
          if (error != null) {
            const code = error!.code.rawValue as number;
            const msg = error!.errorDescription ?? 'Login failed';
            console.error('[iOS] Login failed:', code, msg);
            reject(new Error(`Login failed: ${code} - ${msg}`));
          } else {
            console.log('[iOS] Login success:', username);
            resolve();
          }
        };

        if (useToken) {
          EMClient.shared().login(withUsername = userId, token = password, completion = completion);
        } else {
          EMClient.shared().login(withUsername = userId, password = password, completion = completion);
        }
      } catch (error) {
        console.error('[iOS] Login error:', error);
        reject(error);
      }
    });
  }

  logout(): Promise<void> {
    return new Promise((resolve, reject) => {
      try {
        const completion = (error: EMError | null): void => {
          if (error != null) {
            const code = error!.code.rawValue as number;
            const msg = error!.errorDescription ?? 'Logout failed';
            console.error('[iOS] Logout failed:', code, msg);
            reject(new Error(`Logout failed: ${code} - ${msg}`));
          } else {
            console.log('[iOS] Logout success');
            resolve();
          }
        };

        EMClient.shared().logout(true, completion = completion);
      } catch (error) {
        console.error('[iOS] Logout error:', error);
        reject(error);
      }
    });
  }

  destroy(): void {
    emBridgeTeardownDelegate();
    emBridgeTeardownMessageDelegate();
    this._client = null;
    this._isInitialized = false;
    console.log('[iOS] EMClient SDK destroyed');
  }

  // MARK: - 事件监听

  @UTSJS.keepAlive
  onConnected(listener: (() => void) | null): void {
    emBridgeSetOnConnected(callback = listener);
  }

  @UTSJS.keepAlive
  onDisconnected(listener: ((errorCode: number) => void) | null): void {
    emBridgeSetOnDisconnected(callback = listener);
  }

  @UTSJS.keepAlive
  onLogout(listener: ((errorCode: number) => void) | null): void {
    emBridgeSetOnLogout(callback = listener);
  }

  @UTSJS.keepAlive
  onTokenWillExpire(listener: EMTokenWillExpireListener | null): void {
    emBridgeSetOnTokenWillExpire(callback = listener);
  }

  @UTSJS.keepAlive
  onTokenExpired(listener: EMTokenExpiredListener | null): void {
    emBridgeSetOnTokenExpired(callback = listener);
  }

  @UTSJS.keepAlive
  onMessageReceived(listener: ((messages: Message[]) => void) | null): void {
    emBridgeSetOnMessageReceived(callback = (jsonString: string) => {
      try {
        const messages = JSON.parse(jsonString) as Message[];
        listener?.(messages);
      } catch (e) {
        console.error('[iOS] onMessageReceived JSON parse error:', e);
      }
    });
  }

  onCmdMessageReceived(_listener: ((messages: Message[]) => void) | null): void {
    // 桩函数：待 iOS 桥接实现
  }

  @UTSJS.keepAlive
  onConversationRead(listener: ((from: string, to?: string) => void) | null): void {
    emBridgeSetOnConversationRead(callback = (from: string, to: string) => {
      listener?.(from, to)
    })
  }

  sendConversationReadAck(convId: string): Promise<void> {
    return new Promise((resolve, reject) => {
      try {
        EMClient.shared().chatManager?.ackConversationRead(convId)
        resolve()
      } catch (error) {
        console.error('[iOS] sendConversationReadAck error:', error)
        reject(error)
      }
    })
  }

  markAllMessagesAsRead(convId: string): Promise<void> {
    return new Promise((resolve, reject) => {
      try {
        const conversation = EMClient.shared().chatManager?.getConversation(convId)
        if (conversation != null) {
          conversation.markAllMessagesAsRead()
          resolve()
        } else {
          reject(new Error(`Conversation not found: ${convId}`))
        }
      } catch (error) {
        console.error('[iOS] markAllMessagesAsRead error:', error)
        reject(error)
      }
    })
  }

  getUnreadMessageCount(): number {
    return EMClient.shared().chatManager?.getUnreadMessageCount() ?? 0
  }

  getConversationUnreadMsgCount(convId: string): number {
    const conversation = EMClient.shared().chatManager?.getConversation(convId)
    return conversation?.getUnreadMsgCount() ?? 0
  }

  markAllConversationsAsRead(): Promise<void> {
    return new Promise((resolve, reject) => {
      try {
        EMClient.shared().chatManager?.markAllConversationsAsRead()
        resolve()
      } catch (error) {
        console.error('[iOS] markAllConversationsAsRead error:', error)
        reject(error)
      }
    })
  }

  deleteConversationFromServer(_convId: string, _convType: number, _isDeleteServerMessages: boolean): Promise<void> {
    return new Promise((resolve, reject) => {
      reject(new Error('deleteConversationFromServer is not implemented on iOS yet'))
    })
  }

  deleteConversation(_convId: string, _withMessage: boolean): Promise<void> {
    return new Promise((resolve, reject) => {
      reject(new Error('deleteConversation is not implemented on iOS yet'))
    })
  }

  fetchHistoryMessages(_convId: string, _convType: number, _pageSize: number, _startMsgId: string): Promise<EMCursorResult<Message>> {
    return new Promise((resolve, reject) => {
      reject(new Error('fetchHistoryMessages is not implemented on iOS yet'))
    })
  }

  searchLocalMessagesByKeywords(_convId: string, _keywords: string, _timestamp: number, _maxCount: number, _from: string, _direction: number): Promise<Message[]> {
    return new Promise((resolve, reject) => {
      reject(new Error('searchLocalMessagesByKeywords is not implemented on iOS yet'))
    })
  }

  searchLocalMessagesByTimeRange(_convId: string, _startTimestamp: number, _endTimestamp: number, _maxCount: number, _from: string, _direction: number): Promise<Message[]> {
    return new Promise((resolve, reject) => {
      reject(new Error('searchLocalMessagesByTimeRange is not implemented on iOS yet'))
    })
  }

  loadLocalMessages(_convId: string, _startMsgId: string, _pageSize: number): Promise<Message[]> {
    return new Promise((resolve, reject) => {
      reject(new Error('loadLocalMessages is not implemented on iOS yet'))
    })
  }

  // MARK: - 状态查询

  getVersion(): string {
    return EMClient.shared().version;
  }

  isConnected(): boolean {
    return EMClient.shared().isConnected;
  }

  isLoggedIn(): boolean {
    return EMClient.shared().isLoggedIn;
  }

  getCurrentUser(): string | null {
    return EMClient.shared().currentUsername;
  }

  // MARK: - 桩函数

  onError(listener: EMErrorListener | null): void {
    // 桩函数：待实现
  }

  sendTextMessage(_config: SendTextMessageConfig): Promise<Message> {
    return new Promise((resolve, reject) => {
      reject(new Error('sendTextMessage is not implemented on iOS yet'));
    });
  }

  sendCmdMessage(_config: SendCmdMessageConfig): Promise<Message> {
    return new Promise((resolve, reject) => {
      reject(new Error('sendCmdMessage is not implemented on iOS yet'));
    });
  }

  sendCustomMessage(_config: SendCustomMessageConfig): Promise<Message> {
    return new Promise((resolve, reject) => {
      reject(new Error('sendCustomMessage is not implemented on iOS yet'));
    });
  }

  fetchConversationsFromServer(_limit: number, _cursor: string): Promise<EMCursorResult<EMConversation>> {
    return new Promise((resolve, reject) => {
      reject(new Error('fetchConversationsFromServer is not implemented on iOS yet'));
    });
  }

  getAllConversationsBySort(): Promise<EMConversation[]> {
    return new Promise((resolve, reject) => {
      reject(new Error('getAllConversationsBySort is not implemented on iOS yet'));
    });
  }

  getAllConversations(): Promise<EMConversation[]> {
    return new Promise((resolve, reject) => {
      reject(new Error('getAllConversations is not implemented on iOS yet'));
    });
  }
}

// ==================== 导出 ====================

export function create(config: EMInitConfig): EasemobClient {
  return EMClientImpl.create(config);
}

export function getClient(): EasemobClient | null {
  return EMClientImpl.getClient();
}
