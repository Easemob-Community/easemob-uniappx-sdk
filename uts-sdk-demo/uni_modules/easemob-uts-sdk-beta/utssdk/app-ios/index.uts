	UNIEMConversation,
	type EasemobClient,
	MessageBody
} from '../interface.uts';

export type IMError = {
	errorCode : number,
	errorDesc : string
}
export function getEasemobLogPath(): string {
    // 获取 Library 目录
    let libPaths = NSSearchPathForDirectoriesInDomains(
        FileManager.SearchPathDirectory.libraryDirectory,
        FileManager.SearchPathDomainMask.userDomainMask,
        true
    )
    
    let libraryPath = libPaths.length > 0 ? libPaths[0] : NSHomeDirectory() + "/Library"
    
    // 拼接环信日志路径
    let logPath = libraryPath + "/Application Support/HyphenateSDK/easemobLog/easemob.log"
    
    console.log("环信日志路径: " + logPath)
    return logPath
}
// 初始化
export function initEasemob(config : EMInitConfig) : IMError | null {
	const appKey = config.appKey!;
	const autoLogin = config.autoLogin ?? false;
	const options = new EMOptions(appkey = appKey);
	options.isAutoLogin = autoLogin;

	const err : EMError | null = EMClient.shared().initializeSDK(with = options)
	console.log(`initializeSDK:${err}`)
	if (err == null) {
		return null
	}
	return {
		errorCode: err!.code.rawValue as number,
		errorDesc: err!.errorDescription ?? '初始化失败'
	} as IMError
}

export function login(config : UTSJSONObject) : Promise<void> {
	return new Promise((resolve, reject) => {
		try {
			const userId = config['userId'] as string;
			const password = config['password'] as string;
			const useToken = (config['useToken'] as boolean) ?? false;

			const completion = (username : string, error : EMError | null) : void => {
				if (error != null) {
					const code = error!.code.rawValue as number;
					const msg = error!.errorDescription ?? 'Login failed';
					console.error('[iOS] Login failed:', code, msg);
					reject(new Error(`Login failed: ${code} - ${msg}`));
				} else {
					console.log('[iOS] Login success:', username);
					resolve();
				}
			};

			if (useToken) {
				EMClient.shared().login(withUsername = userId, token = password, completion = completion);
			} else {
				EMClient.shared().login(withUsername = userId, password = password, completion = completion);
			}
		} catch (error) {
			console.error('[iOS] Login error:', error);
			reject(error);
		}
	});
}

export function logout() : Promise<void> {
	return new Promise((resolve, reject) => {
		try {
			const completion = (error : EMError | null) : void => {
				if (error != null) {
					const code = error!.code.rawValue as number;
					const msg = error!.errorDescription ?? 'Logout failed';
					console.error('[iOS] Logout failed:', code, msg);
					reject(new Error(`Logout failed: ${code} - ${msg}`));
				} else {
					console.log('[iOS] Logout success');
					resolve();
				}
			};

			EMClient.shared().logout(true, completion = completion);
		} catch (error) {
			console.error('[iOS] Logout error:', error);
			reject(error);
		}
	});
}

export function sendConversationReadAck(convId : string) : Promise<void> {
	
	console.log(convId)
	return new Promise((resolve, reject) => {
		try {
			const completion = (error : EMError | null) : void => {
				if (error != null) {
					const code = error!.code.rawValue as number;
					const msg = error!.errorDescription ?? 'sendConversationReadAck failed';
					console.error('[iOS] sendConversationReadAck failed:', code, msg);
					reject(new Error(`sendConversationReadAck failed: ${code} - ${msg}`));
				} else {
					resolve();
				}
			};

			EMClient.shared().chatManager?.ackConversationRead(convId, completion = completion);
		} catch (error) {
			console.error('[iOS] sendConversationReadAck error:', error);
			reject(error);
		}
	});
}

export function markAllMessagesAsRead(convId : string) : Promise<void> {
	return new Promise((resolve, reject) => {
		try {
			const conversation = EMClient.shared().chatManager?.getConversationWithConvId(convId)
			if (conversation != null) {
				conversation!.markAllMessages(asRead = null)
				resolve()
			} else {
				reject(new Error(`Conversation not found: ${convId}`))
			}
		} catch (error) {
			console.error('[iOS] markAllMessagesAsRead error:', error)
			reject(error)
		}
	})
}

export function getUnreadMessageCount() : number {
	const conversations = EMClient.shared().chatManager?.getAllConversations() ?? []
	let count = 0
	for (const conv of conversations) {
		count = count + (conv.unreadMessagesCount as number)
	}
	return count
}

export function getConversationUnreadMsgCount(convId : string) : number {
	const conversation = EMClient.shared().chatManager?.getConversationWithConvId(convId)
	if (conversation ==null){
		return 0
	}
	return (conversation!.unreadMessagesCount as number)
}

export function markAllConversationsAsRead() : Promise<void> {
	return new Promise((resolve, reject) => {
		try {
			EMClient.shared().chatManager?.markAllConversationsAsRead()
			resolve()
		} catch (error) {
			console.error('[iOS] markAllConversationsAsRead error:', error)
			reject(error)
		}
	})
}

export function deleteConversationFromServer(convId : string, convType : number, isDeleteServerMessages : boolean) : Promise<void> {
	return new Promise((resolve, reject) => {
		try {
			let type : EMConversationType = EMConversationType.chat
			if (convType == 1) {
				type = EMConversationType.groupChat
			} else if (convType == 2) {
				type = EMConversationType.chatRoom
			}

			const completion = (_aConversationId : string | null, error : EMError | null) : void => {
				if (error != null) {
					const code = error!.code.rawValue as number
					const msg = error!.errorDescription ?? 'deleteConversationFromServer failed'
					console.error('[iOS] deleteConversationFromServer failed:', code, msg)
					reject(new Error(`deleteConversationFromServer failed: ${code} - ${msg}`))
				} else {
					resolve()
				}
			}

			EMClient.shared().chatManager?.deleteServerConversation(convId, conversationType = type, isDeleteServerMessages = isDeleteServerMessages, completion = completion)
		} catch (error) {
			console.error('[iOS] deleteConversationFromServer error:', error)
			reject(error)
		}
	})
}

export function deleteConversation(convId : string, withMessage : boolean) : Promise<void> {
	return new Promise((resolve, reject) => {
		try {
			EMClient.shared().chatManager?.deleteConversation(convId, isDeleteMessages = withMessage)
			resolve()
		} catch (error) {
			console.error('[iOS] deleteConversation error:', error)
			reject(error)
		}
	})
}

export function fetchHistoryMessages(convId : string, convType : number, pageSize : number, startMsgId : string) : Promise<UNIEMCursorResult<string>> {
	return new Promise((resolve, reject) => {
		try {
			const completion = (result : EMCursorResult<EMChatMessage> | null, error : EMError | null) : void => {
				if (error != null) {
					const code = error!.code.rawValue as number
					const msg = error!.errorDescription ?? 'fetchHistoryMessages failed'
					console.error('[iOS] fetchHistoryMessages failed:', code, msg)
					reject(new Error(`fetchHistoryMessages failed: ${code} - ${msg}`))
					return
				}
				const msgList = result?.list ?? []
				const nextCursor = result?.cursor ?? ''
				const json = UNIEMClient.shared.messagesToJsonString(msgList)
				console.log(json)
				resolve({
					data: [json],
					cursor: nextCursor
				} as UNIEMCursorResult<string>)
			}

			UNIEMClient.shared.fetchMessagesFromServerBy(convId, conversationType = convType, cursor = startMsgId, pageSize = pageSize, completion = completion)
		} catch (error) {
			console.error('[iOS] fetchHistoryMessages error:', error)
			reject(error)
		}
	})
}

export function searchLocalMessagesByKeywords(_convId : string, _keywords : string, _timestamp : number, _maxCount : number, _from : string[], _direction : number, _scope : number = 0) : Promise<string> {
	
	return new Promise((resolve, reject) => {
		try {
			const completion = (jsonStr : string | null, error : EMError | null) : void => {
				if (error != null) {
					const code = error!.code.rawValue as number
					const msg = error!.errorDescription ?? 'searchLocalMessagesByKeywords failed'
					console.error('[iOS] searchLocalMessagesByKeywords failed:', code, msg)
					reject(new Error(`searchLocalMessagesByKeywords failed: ${code} - ${msg}`))
					return
				}
				console.log(jsonStr)
				resolve(jsonStr ?? '[]')
			}
			
			console.log(`searchLocalMessagesByKeywords convId=${_convId} keywords=${_keywords} timestamp=${_timestamp} maxCount=${_maxCount} from=${JSON.stringify(_from)} direction=${_direction} scope=${_scope}`)
			UNIEMClient.shared.searchLocalMessagesByKeywords(
				convId = _convId,
				keywords = _keywords.length > 0 ? _keywords : null,
				timestamp = _timestamp,
				maxCount = _maxCount,
				from = _from,
				direction = _direction,
				scope = _scope,
				completion = completion
			)
		} catch (error) {
			console.error('[iOS] searchLocalMessagesByKeywords error:', error)
			reject(error)
		}
	})
}


export function loadLocalMessages(_convId : string, _startMsgId : string, _pageSize : number) : Promise<string> {
	return new Promise((resolve, reject) => {
		try {
			const completion = (jsonStr : string | null, error : EMError | null) : void => {
				if (error != null) {
					const code = error!.code.rawValue as number
					const msg = error!.errorDescription ?? 'loadLocalMessages failed'
					console.error('[iOS] loadLocalMessages failed:', code, msg)
					reject(new Error(`loadLocalMessages failed: ${code} - ${msg}`))
					return
				}
				if (jsonStr == null) {
					resolve("[]")
					return
				}
				resolve(jsonStr)
			}

			UNIEMClient.shared.loadLocalMessages(
				convId = _convId,
				startMsgId = _startMsgId.length > 0 ? _startMsgId : null,
				pageSize = _pageSize,
				completion = completion
			)
		} catch (error) {
			console.error('[iOS] loadLocalMessages error:', error)
			reject(error)
		}
	})
}

// MARK: - 状态查询

export function getVersion() : string {
	return EMClient.shared().version;
}

export function isConnected() : boolean {
	return EMClient.shared().isConnected;
}

export function isLoggedIn() : boolean {
	return EMClient.shared().isLoggedIn;
}

export function getCurrentUser() : string | null {
	return EMClient.shared().currentUsername;
}

function _doSendTextMessage(config : SendTextMessageConfig, resolve : (value : Message) => void, reject : (reason : any) => void) : void {
	const body = new EMTextMessageBody(text = config.content)
	const msg = new EMChatMessage(conversationID = config.to, body = body, ext = null)
	msg.chatType = config.chatType == 'groupChat' ? EMChatType.groupChat : EMChatType.chat

	const completion = (message : EMChatMessage | null, error : EMError | null) : void => {
		if (error != null) {
			reject(new Error('send text message failed: ' + (error!.errorDescription ?? '')));
			return;
		}
		if (message == null) {
			reject(new Error('send text message failed'));
			return;
		}
		resolve({
			msgId: message!.messageId,
			from: message!.from,
			to: message!.to,
			conversationId: message!.conversationId,
			chatType: message!.chatType.rawValue as number,
			body: {
				type: 'txt',
				message: (message!.body as EMTextMessageBody).text ?? null
			}
		} as Message)
	}
	EMClient.shared().chatManager?.send(msg, progress = null, completion = completion)
}

export function sendTextMessage(config : SendTextMessageConfig) : Promise<Message> {
	return new Promise((resolve, reject) => {
		_doSendTextMessage(config, resolve, reject)
	});
}

function _doSendCmdMessage(config : SendCmdMessageConfig, resolve : (value : Message) => void, reject : (reason : any) => void) : void {
	const body = new EMCmdMessageBody(action = config.action)
	const msg = new EMChatMessage(conversationID = config.to, body = body, ext = null)
	msg.chatType = config.chatType == 'groupChat' ? EMChatType.groupChat : EMChatType.chat
	if (config.ext != null) {
		UNIEMClient.shared.setMessageExt(msg, extJson = JSON.stringify(config.ext))
	}


	const completion = (message : EMChatMessage | null, error : EMError | null) : void => {
		if (error != null) {
			reject(new Error('send cmd message failed: ' + (error!.errorDescription ?? '')));
			return;
		}
		if (message == null) {
			reject(new Error('send cmd message failed'));
			return;
		}
		resolve({
			msgId: message!.messageId,
			from: message!.from,
			to: message!.to,
			conversationId: message!.conversationId,
			chatType: message!.chatType.rawValue as number,
			body: {
				type: 'cmd',
				message: (message!.body as EMCmdMessageBody).action ?? null
			}
		} as Message)
	}
	EMClient.shared().chatManager?.send(msg, progress = null, completion = completion)
}

export function sendCmdMessage(config : SendCmdMessageConfig) : Promise<Message> {
	return new Promise((resolve, reject) => {
		_doSendCmdMessage(config, resolve, reject)
	});
}

function _doSendCustomMessage(config : SendCustomMessageConfig, resolve : (value : Message) => void, reject : (reason : any) => void) : void {
	const paramsJson = config.params != null ? JSON.stringify(config.params) : null
	const body = UNIEMClient.shared.createCustomMessageBody(event = config.event, paramsJson = paramsJson)!
	const msg = new EMChatMessage(conversationID = config.to, body = body, ext = null)
	msg.chatType = config.chatType == 'groupChat' ? EMChatType.groupChat : EMChatType.chat
	if (config.ext != null) {
		UNIEMClient.shared.setMessageExt(msg, extJson = JSON.stringify(config.ext))
	}

	const completion = (message : EMChatMessage | null, error : EMError | null) : void => {
		if (error != null) {
			reject(new Error('send custom message failed: ' + (error!.errorDescription ?? '')));
			return;
		}
		if (message == null) {
			reject(new Error('send custom message failed'));
			return;
		}
		resolve({
			msgId: message!.messageId,
			from: message!.from,
			to: message!.to,
			conversationId: message!.conversationId,
			chatType: message!.chatType.rawValue as number,
			body: {
				type: 'custom',
				message: (message!.body as EMCustomMessageBody).event ?? null
			}
		} as Message)
	}
	EMClient.shared().chatManager?.send(msg, progress = null, completion = completion)
}

export function sendCustomMessage(config : SendCustomMessageConfig) : Promise<Message> {
	return new Promise((resolve, reject) => {
		_doSendCustomMessage(config, resolve, reject)
	});
}

function _doFetchConversationsFromServer(limit : number, cursor : string, resolve : (value : UNIEMCursorResult<UNIEMConversation>) => void, reject : (reason : any) => void) : void {
	const completion = (result : EMCursorResult<EMConversation> | null, error : EMError | null) : void => {
		if (error != null) {
			const code = error!.code.rawValue as number;
			const msg = error!.errorDescription ?? 'Fetch conversations failed';
			reject(new Error(`Fetch conversations failed: ${code} - ${msg}`));
			return
		}
		const convList = result?.list ?? []
		const nextCursor = result?.cursor ?? ''
		let conversations : UNIEMConversation[] = []
		for (const conv of convList) {
			conversations.push({
				conversationId: conv.conversationId as string,
				type: conv.type.rawValue as number,
				unreadMsgCount: conv.unreadMessagesCount as number,
				lastMessage: null
			} as UNIEMConversation)
		}
		resolve({
			data: conversations,
			cursor: nextCursor
		} as UNIEMCursorResult<UNIEMConversation>)
	}
	UNIEMClient.shared.fetchConversationsFromServer(cursor = cursor, pageSize = limit, completion = completion)
}

export function fetchConversationsFromServer(limit : number, cursor : string) : Promise<UNIEMCursorResult<UNIEMConversation>> {
	return new Promise((resolve, reject) => {
		_doFetchConversationsFromServer(limit, cursor, resolve, reject)
	});
}

export function getAllConversationsBySort() : UNIEMConversation[] {
	const list = EMClient.shared().chatManager?.getAllConversations(true) ?? []
	let conversations : UNIEMConversation[] = []
	for (const conv of list) {
		conversations.push({
			conversationId: conv.conversationId,
			type: conv.type.rawValue as number,
			unreadMsgCount: conv.unreadMessagesCount as number,
			lastMessage: null
		} as UNIEMConversation)
	}
	return conversations
}

export function getAllConversations() : UNIEMConversation[] {
	const list = EMClient.shared().chatManager?.getAllConversations() ?? []
	let conversations : UNIEMConversation[] = []
	for (const conv of list) {
		conversations.push({
			conversationId: conv.conversationId,
			type: conv.type.rawValue as number,
			unreadMsgCount: conv.unreadMessagesCount as number,
			lastMessage: null
		} as UNIEMConversation)
	}
	return conversations
}



// ==================== 连接监听（Block 回调方式）====================

type ConnectionListener = {
	onConnected?: (() => void) | null;
	onDisconnected?: ((errorCode: number) => void) | null;
	onLogout?: ((errorCode: number) => void) | null;
	onAutoLoginDidComplete?: ((errorJson: string | null) => void) | null;
	onUserAccountDidLoginFromOtherDevice?: ((deviceName: string | null) => void) | null;
	onUserAccountDidRemoveFromServer?: (() => void) | null;
	onUserDidForbidByServer?: (() => void) | null;
	onTokenWillExpire?: (() => void) | null;
	onTokenExpired?: (() => void) | null;
}

const connectionCallbackMap : Map<string, ConnectionListener> = new Map();

@UTSJS.keepAlive
export function addConnectionListener(
	listenerId : string,
	listener : ConnectionListener
) : void {
	connectionCallbackMap.set(listenerId, listener);

	if (connectionCallbackMap.size == 1) {
		UNIEMClient.shared.onConnectionStateDidChangeBlock = (state : number) : void => {
			const isConnected = state == 0;
			connectionCallbackMap.forEach((cbs : ConnectionListener, _id : string) : void => {
				if (isConnected) {
					cbs.onConnected?.();
				} else {
					cbs.onDisconnected?.(state);
				}
			});
		};
		UNIEMClient.shared.onUserAccountDidForcedToLogoutBlock = (errorJson : string | null) : void => {
			let errorCode = 0;
			if (errorJson != null) {
				try {
					const obj = JSON.parse(errorJson) as UTSJSONObject;
					errorCode = (obj['code'] as number) ?? 0;
				} catch (e) {}
			}
			connectionCallbackMap.forEach((cbs : ConnectionListener, _id : string) : void => {
				cbs.onLogout?.(errorCode);
			});
		};
		UNIEMClient.shared.onTokenWillExpireBlock = (_code : number) : void => {
			connectionCallbackMap.forEach((cbs : ConnectionListener, _id : string) : void => {
				cbs.onTokenWillExpire?.();
			});
		};
		UNIEMClient.shared.onTokenDidExpireBlock = (_code : number) : void => {
			connectionCallbackMap.forEach((cbs : ConnectionListener, _id : string) : void => {
				cbs.onTokenExpired?.();
			});
		};
		UNIEMClient.shared.onAutoLoginDidCompleteBlock = (errorJson : string | null) : void => {
			connectionCallbackMap.forEach((cbs : ConnectionListener, _id : string) : void => {
				cbs.onAutoLoginDidComplete?.(errorJson);
			});
		};
		UNIEMClient.shared.onUserAccountDidLoginFromOtherDeviceBlock = (deviceName : string | null) : void => {
			connectionCallbackMap.forEach((cbs : ConnectionListener, _id : string) : void => {
				cbs.onUserAccountDidLoginFromOtherDevice?.(deviceName);
			});
		};
		UNIEMClient.shared.onUserAccountDidRemoveFromServerBlock = () : void => {
			connectionCallbackMap.forEach((cbs : ConnectionListener, _id : string) : void => {
				cbs.onUserAccountDidRemoveFromServer?.();
			});
		};
		UNIEMClient.shared.onUserDidForbidByServerBlock = () : void => {
			connectionCallbackMap.forEach((cbs : ConnectionListener, _id : string) : void => {
				cbs.onUserDidForbidByServer?.();
			});
		};
	}

	console.log('[iOS] addConnectionListener:', listenerId);
}

export function removeConnectionListener(listenerId : string) : void {
	connectionCallbackMap.delete(listenerId);
	if (connectionCallbackMap.size == 0) {
		UNIEMClient.shared.onConnectionStateDidChangeBlock = null;
		UNIEMClient.shared.onUserAccountDidForcedToLogoutBlock = null;
		UNIEMClient.shared.onTokenWillExpireBlock = null;
		UNIEMClient.shared.onTokenDidExpireBlock = null;
		UNIEMClient.shared.onAutoLoginDidCompleteBlock = null;
		UNIEMClient.shared.onUserAccountDidLoginFromOtherDeviceBlock = null;
		UNIEMClient.shared.onUserAccountDidRemoveFromServerBlock = null;
		UNIEMClient.shared.onUserDidForbidByServerBlock = null;
	}
	console.log('[iOS] removeConnectionListener:', listenerId);
}

// ==================== 聊天管理监听（Block 回调方式）====================

type ChatManagerListener = {
	onMessageReceived?: ((messages: string) => void) | null;
	onCmdMessageReceived?: ((messages: string) => void) | null;
	onConversationListDidUpdate?: ((conversations: string) => void) | null;
	onMessagesDidRead?: ((messages: string) => void) | null;
	onGroupMessageDidRead?: ((info: string) => void) | null;
	onGroupMessageAckHasChanged?: (() => void) | null;
	onConversationRead?: ((from: string, to: string) => void) | null;
	onMessagesDidDeliver?: ((messages: string) => void) | null;
	onMessagesInfoDidRecall?: ((infos: string) => void) | null;
	onMessageStatusDidChange?: ((message: string, error: string) => void) | null;
	onMessageAttachmentStatusDidChange?: ((message: string, error: string) => void) | null;
	onMessageContentChanged?: ((message: string, operatorId: string, operationTime: number) => void) | null;
	onMessageReactionDidChange?: ((changes: string) => void) | null;
}

const chatManagerCallbackMap : Map<string, ChatManagerListener> = new Map();

@UTSJS.keepAlive
export function addChatManagerListener(
	listenerId : string,
	listener : ChatManagerListener
) : void {
	chatManagerCallbackMap.set(listenerId, listener);

	if (chatManagerCallbackMap.size == 1) {
		UNIEMClient.shared.onMessagesReceivedBlock = (json : string) : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onMessageReceived?.(json);
			});
		};
		UNIEMClient.shared.onCmdMessagesReceivedBlock = (json : string) : void => {			
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onCmdMessageReceived?.(json);
			});
		};
		UNIEMClient.shared.onConversationListDidUpdateBlock = (conversationsJson : string) : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onConversationListDidUpdate?.(conversationsJson);
			});
		};
		UNIEMClient.shared.onMessagesDidReadBlock = (json : string) : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onMessagesDidRead?.(json);
			});
		};
		UNIEMClient.shared.onGroupMessageDidReadBlock = (infoJson : string) : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onGroupMessageDidRead?.(infoJson);
			});
		};
		UNIEMClient.shared.onGroupMessageAckHasChangedBlock = () : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onGroupMessageAckHasChanged?.();
			});
		};
		UNIEMClient.shared.onConversationReadBlock = (from : string, to : string) : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onConversationRead?.(from, to);
			});
		};
		UNIEMClient.shared.onMessagesDidDeliverBlock = (json : string) : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onMessagesDidDeliver?.(json);
			});
		};
		UNIEMClient.shared.onMessagesInfoDidRecallBlock = (infosJson : string) : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onMessagesInfoDidRecall?.(infosJson);
			});
		};
		UNIEMClient.shared.onMessageStatusDidChangeBlock = (msgJson : string, errorJson : string) : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onMessageStatusDidChange?.(msgJson, errorJson);
			});
		};
		UNIEMClient.shared.onMessageAttachmentStatusDidChangeBlock = (msgJson : string, errorJson : string) : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onMessageAttachmentStatusDidChange?.(msgJson, errorJson);
			});
		};
		UNIEMClient.shared.onMessageContentChangedBlock = (msgJson : string, operatorId : string, operationTime : number) : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onMessageContentChanged?.(msgJson, operatorId, operationTime);
			});
		};
		UNIEMClient.shared.onMessageReactionDidChangeBlock = (changesJson : string) : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onMessageReactionDidChange?.(changesJson);
			});
		};
	}

	console.log('[iOS] addChatManagerListener:', listenerId);
}

export function removeChatManagerListener(listenerId : string) : void {
	chatManagerCallbackMap.delete(listenerId);
	if (chatManagerCallbackMap.size == 0) {
		UNIEMClient.shared.onMessagesReceivedBlock = null;
		UNIEMClient.shared.onCmdMessagesReceivedBlock = null;
		UNIEMClient.shared.onConversationListDidUpdateBlock = null;
		UNIEMClient.shared.onMessagesDidReadBlock = null;
		UNIEMClient.shared.onGroupMessageDidReadBlock = null;
		UNIEMClient.shared.onGroupMessageAckHasChangedBlock = null;
		UNIEMClient.shared.onConversationReadBlock = null;
		UNIEMClient.shared.onMessagesDidDeliverBlock = null;
		UNIEMClient.shared.onMessagesInfoDidRecallBlock = null;
		UNIEMClient.shared.onMessageStatusDidChangeBlock = null;
		UNIEMClient.shared.onMessageAttachmentStatusDidChangeBlock = null;
		UNIEMClient.shared.onMessageContentChangedBlock = null;
		UNIEMClient.shared.onMessageReactionDidChangeBlock = null;
	}
	console.log('[iOS] removeChatManagerListener:', listenerId);
}

// ==================== 群组管理监听（Block 回调方式）====================

type GroupManagerListener = {
	/** 收到群组邀请 JSON: {groupId, groupName, inviter, message} */
	onGroupInvitationDidReceive?: ((data: string) => void) | null;
	/** 群组邀请被接受 JSON: {group, invitee} */
	onGroupInvitationDidAccept?: ((data: string) => void) | null;
	/** 群组邀请被拒绝 JSON: {group, invitee, reason} */
	onGroupInvitationDidDecline?: ((data: string) => void) | null;
	/** 自动加入群组 JSON: {group, inviter, message} */
	onDidJoinGroup?: ((data: string) => void) | null;
	/** 离开群组 JSON: {group, reason} */
	onDidLeaveGroup?: ((data: string) => void) | null;
	/** 收到入群申请 JSON: {group, applicant, reason} */
	onJoinGroupRequestDidReceive?: ((data: string) => void) | null;
	/** 入群申请被拒绝 JSON: {groupId, reason, decliner, applicant} */
	onJoinGroupRequestDidDecline?: ((data: string) => void) | null;
	/** 入群申请被同意 JSON: group object */
	onJoinGroupRequestDidApprove?: ((data: string) => void) | null;
	/** 群组列表更新 JSON: group[] */
	onGroupListDidUpdate?: ((data: string) => void) | null;
	/** 群成员加入禁言列表 JSON: {group, mutedMembers, muteExpire} */
	onGroupMuteListAdded?: ((data: string) => void) | null;
	/** 群成员移出禁言列表 JSON: {group, mutedMembers} */
	onGroupMuteListRemoved?: ((data: string) => void) | null;
	/** 群成员加入白名单 JSON: {group, members} */
	onGroupWhiteListAdded?: ((data: string) => void) | null;
	/** 群成员移出白名单 JSON: {group, members} */
	onGroupWhiteListRemoved?: ((data: string) => void) | null;
	/** 全员禁言状态变化 JSON: {group, isAllMuted} */
	onGroupAllMemberMuteChanged?: ((data: string) => void) | null;
	/** 添加管理员 JSON: {group, admin} */
	onGroupAdminAdded?: ((data: string) => void) | null;
	/** 移除管理员 JSON: {group, admin} */
	onGroupAdminRemoved?: ((data: string) => void) | null;
	/** 群主变更 JSON: {group, newOwner, oldOwner} */
	onGroupOwnerDidUpdate?: ((data: string) => void) | null;
	/** 用户加入群组 JSON: {group, userIds} */
	onUserDidJoinGroup?: ((data: string) => void) | null;
	/** 用户离开群组 JSON: {group, userIds} */
	onUserDidLeaveGroup?: ((data: string) => void) | null;
	/** 群公告更新 JSON: {group, announcement} */
	onGroupAnnouncementDidUpdate?: ((data: string) => void) | null;
	/** 群共享文件添加 JSON: {group, sharedFile} */
	onGroupFileListAdded?: ((data: string) => void) | null;
	/** 群共享文件移除 JSON: {group, fileId} */
	onGroupFileListRemoved?: ((data: string) => void) | null;
	/** 群禁用状态变化 JSON: {group, isDisabled} */
	onGroupStateChanged?: ((data: string) => void) | null;
	/** 群详情更新 JSON: group object */
	onGroupSpecificationDidUpdate?: ((data: string) => void) | null;
	/** 群成员自定义属性变更 JSON: {groupId, userId, attributes, operatorId} */
	onGroupMemberAttributesChanged?: ((data: string) => void) | null;
}

const groupManagerCallbackMap : Map<string, GroupManagerListener> = new Map();

@UTSJS.keepAlive
export function addGroupManagerListener(
	listenerId : string,
	listener : GroupManagerListener
) : void {
	groupManagerCallbackMap.set(listenerId, listener);

	if (groupManagerCallbackMap.size == 1) {
		UNIEMClient.shared.onGroupInvitationDidReceiveBlock = (json : string) : void => {
			groupManagerCallbackMap.forEach((cbs : GroupManagerListener, _id : string) : void => {
				cbs.onGroupInvitationDidReceive?.(json);
			});
		};
		UNIEMClient.shared.onGroupInvitationDidAcceptBlock = (json : string) : void => {
			groupManagerCallbackMap.forEach((cbs : GroupManagerListener, _id : string) : void => {
