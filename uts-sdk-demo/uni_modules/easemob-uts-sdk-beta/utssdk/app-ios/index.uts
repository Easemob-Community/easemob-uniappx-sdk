}

function _doSendTextMessage(config : SendTextMessageConfig, resolve : (value : Message) => void, reject : (reason : any) => void) : void {
	const body = new EMTextMessageBody(text = config.content)
	const msg = new EMChatMessage(conversationID = config.to, body = body, ext = null)
	msg.chatType = config.chatType == 'groupChat' ? EMChatType.groupChat : EMChatType.chat

	const completion = (message : EMChatMessage | null, error : EMError | null) : void => {
		if (error != null) {
			reject(new Error('send text message failed: ' + (error!.errorDescription ?? '')));
			return;
		}
		if (message == null) {
			reject(new Error('send text message failed'));
			return;
		}
		resolve({
			msgId: message!.messageId,
			from: message!.from,
			to: message!.to,
			conversationId: message!.conversationId,
			chatType: message!.chatType.rawValue as number,
			body: {
				type: 'txt',
				message: (message!.body as EMTextMessageBody).text ?? null
			}
		} as Message)
	}
	EMClient.shared().chatManager?.send(msg, progress = null, completion = completion)
}

export function sendTextMessage(config : SendTextMessageConfig) : Promise<Message> {
	return new Promise((resolve, reject) => {
		_doSendTextMessage(config, resolve, reject)
	});
}

function _doSendCmdMessage(config : SendCmdMessageConfig, resolve : (value : Message) => void, reject : (reason : any) => void) : void {
	const body = new EMCmdMessageBody(action = config.action)
	const msg = new EMChatMessage(conversationID = config.to, body = body, ext = null)
	msg.chatType = config.chatType == 'groupChat' ? EMChatType.groupChat : EMChatType.chat
	if (config.ext != null) {
		UNIEMClient.shared.setMessageExt(msg, extJson = JSON.stringify(config.ext))
	}


	const completion = (message : EMChatMessage | null, error : EMError | null) : void => {
		if (error != null) {
			reject(new Error('send cmd message failed: ' + (error!.errorDescription ?? '')));
			return;
		}
		if (message == null) {
			reject(new Error('send cmd message failed'));
			return;
		}
		resolve({
			msgId: message!.messageId,
			from: message!.from,
			to: message!.to,
			conversationId: message!.conversationId,
			chatType: message!.chatType.rawValue as number,
			body: {
				type: 'cmd',
				message: (message!.body as EMCmdMessageBody).action ?? null
			}
		} as Message)
	}
	EMClient.shared().chatManager?.send(msg, progress = null, completion = completion)
}

export function sendCmdMessage(config : SendCmdMessageConfig) : Promise<Message> {
	return new Promise((resolve, reject) => {
		_doSendCmdMessage(config, resolve, reject)
	});
}

function _doSendCustomMessage(config : SendCustomMessageConfig, resolve : (value : Message) => void, reject : (reason : any) => void) : void {
	const paramsJson = config.params != null ? JSON.stringify(config.params) : null
	const body = UNIEMClient.shared.createCustomMessageBody(event = config.event, paramsJson = paramsJson)!
	const msg = new EMChatMessage(conversationID = config.to, body = body, ext = null)
	msg.chatType = config.chatType == 'groupChat' ? EMChatType.groupChat : EMChatType.chat
	if (config.ext != null) {
		UNIEMClient.shared.setMessageExt(msg, extJson = JSON.stringify(config.ext))
	}

	const completion = (message : EMChatMessage | null, error : EMError | null) : void => {
		if (error != null) {
			reject(new Error('send custom message failed: ' + (error!.errorDescription ?? '')));
			return;
		}
		if (message == null) {
			reject(new Error('send custom message failed'));
			return;
		}
		resolve({
			msgId: message!.messageId,
			from: message!.from,
			to: message!.to,
			conversationId: message!.conversationId,
			chatType: message!.chatType.rawValue as number,
			body: {
				type: 'custom',
				message: (message!.body as EMCustomMessageBody).event ?? null
			}
		} as Message)
	}
	EMClient.shared().chatManager?.send(msg, progress = null, completion = completion)
}

export function sendCustomMessage(config : SendCustomMessageConfig) : Promise<Message> {
	return new Promise((resolve, reject) => {
		_doSendCustomMessage(config, resolve, reject)
	});
}

function _doFetchConversationsFromServer(limit : number, cursor : string, resolve : (value : UNIEMCursorResult<UNIEMConversation>) => void, reject : (reason : any) => void) : void {
	const completion = (result : EMCursorResult<EMConversation> | null, error : EMError | null) : void => {
		if (error != null) {
			const code = error!.code.rawValue as number;
			const msg = error!.errorDescription ?? 'Fetch conversations failed';
			reject(new Error(`Fetch conversations failed: ${code} - ${msg}`));
			return
		}
		const convList = result?.list ?? []
		const nextCursor = result?.cursor ?? ''
		let conversations : UNIEMConversation[] = []
		for (const conv of convList) {
			conversations.push({
				conversationId: conv.conversationId as string,
				type: conv.type.rawValue as number,
				unreadMsgCount: conv.unreadMessagesCount as number,
				lastMessage: null
			} as UNIEMConversation)
		}
		resolve({
			data: conversations,
			cursor: nextCursor
		} as UNIEMCursorResult<UNIEMConversation>)
	}
	UNIEMClient.shared.fetchConversationsFromServer(cursor = cursor, pageSize = limit, completion = completion)
}

export function fetchConversationsFromServer(limit : number, cursor : string) : Promise<UNIEMCursorResult<UNIEMConversation>> {
	return new Promise((resolve, reject) => {
		_doFetchConversationsFromServer(limit, cursor, resolve, reject)
	});
}

export function getAllConversationsBySort() : UNIEMConversation[] {
	const list = EMClient.shared().chatManager?.getAllConversations(true) ?? []
	let conversations : UNIEMConversation[] = []
	for (const conv of list) {
		conversations.push({
			conversationId: conv.conversationId,
			type: conv.type.rawValue as number,
			unreadMsgCount: conv.unreadMessagesCount as number,
			lastMessage: null
		} as UNIEMConversation)
	}
	return conversations
}

export function getAllConversations() : UNIEMConversation[] {
	const list = EMClient.shared().chatManager?.getAllConversations() ?? []
	let conversations : UNIEMConversation[] = []
	for (const conv of list) {
		conversations.push({
			conversationId: conv.conversationId,
			type: conv.type.rawValue as number,
			unreadMsgCount: conv.unreadMessagesCount as number,
			lastMessage: null
		} as UNIEMConversation)
	}
	return conversations
}



// ==================== 连接监听（Block 回调方式）====================

type ConnectionListener = {
	onConnected?: (() => void) | null;
	onDisconnected?: ((errorCode: number) => void) | null;
	onLogout?: ((errorCode: number) => void) | null;
	onAutoLoginDidComplete?: ((errorJson: string | null) => void) | null;
	onUserAccountDidLoginFromOtherDevice?: ((deviceName: string | null) => void) | null;
	onUserAccountDidRemoveFromServer?: (() => void) | null;
	onUserDidForbidByServer?: (() => void) | null;
	onTokenWillExpire?: (() => void) | null;
	onTokenExpired?: (() => void) | null;
}

const connectionCallbackMap : Map<string, ConnectionListener> = new Map();

@UTSJS.keepAlive
export function addConnectionListener(
	listenerId : string,
	listener : ConnectionListener
) : void {
	connectionCallbackMap.set(listenerId, listener);

	if (connectionCallbackMap.size == 1) {
		UNIEMClient.shared.onConnectionStateDidChangeBlock = (state : number) : void => {
			const isConnected = state == 0;
			connectionCallbackMap.forEach((cbs : ConnectionListener, _id : string) : void => {
				if (isConnected) {
					cbs.onConnected?.();
				} else {
					cbs.onDisconnected?.(state);
				}
			});
		};
		UNIEMClient.shared.onUserAccountDidForcedToLogoutBlock = (errorJson : string | null) : void => {
			let errorCode = 0;
			if (errorJson != null) {
				try {
					const obj = JSON.parse(errorJson) as UTSJSONObject;
					errorCode = (obj['code'] as number) ?? 0;
				} catch (e) {}
			}
			connectionCallbackMap.forEach((cbs : ConnectionListener, _id : string) : void => {
				cbs.onLogout?.(errorCode);
			});
		};
		UNIEMClient.shared.onTokenWillExpireBlock = (_code : number) : void => {
			connectionCallbackMap.forEach((cbs : ConnectionListener, _id : string) : void => {
				cbs.onTokenWillExpire?.();
			});
		};
		UNIEMClient.shared.onTokenDidExpireBlock = (_code : number) : void => {
			connectionCallbackMap.forEach((cbs : ConnectionListener, _id : string) : void => {
				cbs.onTokenExpired?.();
			});
		};
		UNIEMClient.shared.onAutoLoginDidCompleteBlock = (errorJson : string | null) : void => {
			connectionCallbackMap.forEach((cbs : ConnectionListener, _id : string) : void => {
				cbs.onAutoLoginDidComplete?.(errorJson);
			});
		};
		UNIEMClient.shared.onUserAccountDidLoginFromOtherDeviceBlock = (deviceName : string | null) : void => {
			connectionCallbackMap.forEach((cbs : ConnectionListener, _id : string) : void => {
				cbs.onUserAccountDidLoginFromOtherDevice?.(deviceName);
			});
		};
		UNIEMClient.shared.onUserAccountDidRemoveFromServerBlock = () : void => {
			connectionCallbackMap.forEach((cbs : ConnectionListener, _id : string) : void => {
				cbs.onUserAccountDidRemoveFromServer?.();
			});
		};
		UNIEMClient.shared.onUserDidForbidByServerBlock = () : void => {
			connectionCallbackMap.forEach((cbs : ConnectionListener, _id : string) : void => {
				cbs.onUserDidForbidByServer?.();
			});
		};
	}

	console.log('[iOS] addConnectionListener:', listenerId);
}

export function removeConnectionListener(listenerId : string) : void {
	connectionCallbackMap.delete(listenerId);
	if (connectionCallbackMap.size == 0) {
		UNIEMClient.shared.onConnectionStateDidChangeBlock = null;
		UNIEMClient.shared.onUserAccountDidForcedToLogoutBlock = null;
		UNIEMClient.shared.onTokenWillExpireBlock = null;
		UNIEMClient.shared.onTokenDidExpireBlock = null;
		UNIEMClient.shared.onAutoLoginDidCompleteBlock = null;
		UNIEMClient.shared.onUserAccountDidLoginFromOtherDeviceBlock = null;
		UNIEMClient.shared.onUserAccountDidRemoveFromServerBlock = null;
		UNIEMClient.shared.onUserDidForbidByServerBlock = null;
	}
	console.log('[iOS] removeConnectionListener:', listenerId);
}

export function removeAllConnectionListeners() : void {
	connectionCallbackMap.clear();
	UNIEMClient.shared.onConnectionStateDidChangeBlock = null;
	UNIEMClient.shared.onUserAccountDidForcedToLogoutBlock = null;
	UNIEMClient.shared.onTokenWillExpireBlock = null;
	UNIEMClient.shared.onTokenDidExpireBlock = null;
	UNIEMClient.shared.onAutoLoginDidCompleteBlock = null;
	UNIEMClient.shared.onUserAccountDidLoginFromOtherDeviceBlock = null;
	UNIEMClient.shared.onUserAccountDidRemoveFromServerBlock = null;
	UNIEMClient.shared.onUserDidForbidByServerBlock = null;
	console.log('[iOS] removeAllConnectionListeners');
}

// ==================== 聊天管理监听（Block 回调方式）====================

type ChatManagerListener = {
	onMessageReceived?: ((messages: string) => void) | null;
	onCmdMessageReceived?: ((messages: string) => void) | null;
	onConversationListDidUpdate?: ((conversations: string) => void) | null;
	onMessagesDidRead?: ((messages: string) => void) | null;
	onGroupMessageDidRead?: ((info: string) => void) | null;
	onGroupMessageAckHasChanged?: (() => void) | null;
	onConversationRead?: ((from: string, to: string) => void) | null;
	onMessagesDidDeliver?: ((messages: string) => void) | null;
	onMessagesInfoDidRecall?: ((infos: string) => void) | null;
	onMessageStatusDidChange?: ((message: string, error: string) => void) | null;
	onMessageAttachmentStatusDidChange?: ((message: string, error: string) => void) | null;
	onMessageContentChanged?: ((message: string, operatorId: string, operationTime: number) => void) | null;
	onMessageReactionDidChange?: ((changes: string) => void) | null;
}

const chatManagerCallbackMap : Map<string, ChatManagerListener> = new Map();

@UTSJS.keepAlive
export function addChatManagerListener(
	listenerId : string,
	listener : ChatManagerListener
) : void {
	chatManagerCallbackMap.set(listenerId, listener);

	if (chatManagerCallbackMap.size == 1) {
		UNIEMClient.shared.onMessagesReceivedBlock = (json : string) : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onMessageReceived?.(json);
			});
		};
		UNIEMClient.shared.onCmdMessagesReceivedBlock = (json : string) : void => {			
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onCmdMessageReceived?.(json);
			});
		};
		UNIEMClient.shared.onConversationListDidUpdateBlock = (conversationsJson : string) : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onConversationListDidUpdate?.(conversationsJson);
			});
		};
		UNIEMClient.shared.onMessagesDidReadBlock = (json : string) : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onMessagesDidRead?.(json);
			});
		};
		UNIEMClient.shared.onGroupMessageDidReadBlock = (infoJson : string) : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onGroupMessageDidRead?.(infoJson);
			});
		};
		UNIEMClient.shared.onGroupMessageAckHasChangedBlock = () : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onGroupMessageAckHasChanged?.();
			});
		};
		UNIEMClient.shared.onConversationReadBlock = (from : string, to : string) : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onConversationRead?.(from, to);
			});
		};
		UNIEMClient.shared.onMessagesDidDeliverBlock = (json : string) : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onMessagesDidDeliver?.(json);
			});
		};
		UNIEMClient.shared.onMessagesInfoDidRecallBlock = (infosJson : string) : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onMessagesInfoDidRecall?.(infosJson);
			});
		};
		UNIEMClient.shared.onMessageStatusDidChangeBlock = (msgJson : string, errorJson : string) : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onMessageStatusDidChange?.(msgJson, errorJson);
			});
		};
		UNIEMClient.shared.onMessageAttachmentStatusDidChangeBlock = (msgJson : string, errorJson : string) : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onMessageAttachmentStatusDidChange?.(msgJson, errorJson);
			});
		};
		UNIEMClient.shared.onMessageContentChangedBlock = (msgJson : string, operatorId : string, operationTime : number) : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onMessageContentChanged?.(msgJson, operatorId, operationTime);
			});
		};
		UNIEMClient.shared.onMessageReactionDidChangeBlock = (changesJson : string) : void => {
			chatManagerCallbackMap.forEach((cbs : ChatManagerListener, _id : string) : void => {
				cbs.onMessageReactionDidChange?.(changesJson);
			});
		};
	}

	console.log('[iOS] addChatManagerListener:', listenerId);
}

export function removeChatManagerListener(listenerId : string) : void {
	chatManagerCallbackMap.delete(listenerId);
	if (chatManagerCallbackMap.size == 0) {
		UNIEMClient.shared.onMessagesReceivedBlock = null;
		UNIEMClient.shared.onCmdMessagesReceivedBlock = null;
		UNIEMClient.shared.onConversationListDidUpdateBlock = null;
		UNIEMClient.shared.onMessagesDidReadBlock = null;
		UNIEMClient.shared.onGroupMessageDidReadBlock = null;
		UNIEMClient.shared.onGroupMessageAckHasChangedBlock = null;
		UNIEMClient.shared.onConversationReadBlock = null;
		UNIEMClient.shared.onMessagesDidDeliverBlock = null;
		UNIEMClient.shared.onMessagesInfoDidRecallBlock = null;
		UNIEMClient.shared.onMessageStatusDidChangeBlock = null;
		UNIEMClient.shared.onMessageAttachmentStatusDidChangeBlock = null;
		UNIEMClient.shared.onMessageContentChangedBlock = null;
		UNIEMClient.shared.onMessageReactionDidChangeBlock = null;
	}
	console.log('[iOS] removeChatManagerListener:', listenerId);
}

export function removeAllChatManagerListeners() : void {
	chatManagerCallbackMap.clear();
	UNIEMClient.shared.onMessagesReceivedBlock = null;
	UNIEMClient.shared.onCmdMessagesReceivedBlock = null;
	UNIEMClient.shared.onConversationListDidUpdateBlock = null;
	UNIEMClient.shared.onMessagesDidReadBlock = null;
	UNIEMClient.shared.onGroupMessageDidReadBlock = null;
	UNIEMClient.shared.onGroupMessageAckHasChangedBlock = null;
	UNIEMClient.shared.onConversationReadBlock = null;
	UNIEMClient.shared.onMessagesDidDeliverBlock = null;
	UNIEMClient.shared.onMessagesInfoDidRecallBlock = null;
	UNIEMClient.shared.onMessageStatusDidChangeBlock = null;
	UNIEMClient.shared.onMessageAttachmentStatusDidChangeBlock = null;
	UNIEMClient.shared.onMessageContentChangedBlock = null;
	UNIEMClient.shared.onMessageReactionDidChangeBlock = null;
	console.log('[iOS] removeAllChatManagerListeners');
}

// iOS beta: 仅导出独立函数，不提供 EasemobClient 实例封装