	EMFileMessageBody,
	EMLocationMessageBody,
	EMCmdMessageBody,
	EMCustomMessageBody,
	EMChatMessage,
	EMChatType,
} from 'HyphenateChat';
import {
	EMInitConfig,
	EMErrorListener,
	EMTokenWillExpireListener,
	EMTokenExpiredListener,
	Message,
	SendTextMessageConfig,
	SendCmdMessageConfig,
	SendCustomMessageConfig,
	EMConversation,
	EMCursorResult,
	type EasemobClient,
	MessageBody
} from '../interface.uts';

export type IMError = {
	errorCode : number,
	errorDesc : string
}

// 初始化
export function initEasemob(config : EMInitConfig) : IMError | null {
	const appKey = config.appKey!;
	const autoLogin = config.autoLogin ?? false;
	const options = new EMOptions(appkey = appKey);
	options.isAutoLogin = autoLogin;

	const err : EMError | null = EMClient.shared().initializeSDK(with = options)
	console.log(`initializeSDK:${err}`)
	if (err == null) {
		return null
	}
	return {
		errorCode: err!.code.rawValue as number,
		errorDesc: err!.errorDescription ?? '初始化失败'
	} as IMError
}

export function login(config : UTSJSONObject) : Promise<void> {
	return new Promise((resolve, reject) => {
		try {
			const userId = config['userId'] as string;
			const password = config['password'] as string;
			const useToken = (config['useToken'] as boolean) ?? false;

			const completion = (username : string, error : EMError | null) : void => {
				if (error != null) {
					const code = error!.code.rawValue as number;
					const msg = error!.errorDescription ?? 'Login failed';
					console.error('[iOS] Login failed:', code, msg);
					reject(new Error(`Login failed: ${code} - ${msg}`));
				} else {
					console.log('[iOS] Login success:', username);
					resolve();
				}
			};

			if (useToken) {
				EMClient.shared().login(withUsername = userId, token = password, completion = completion);
			} else {
				EMClient.shared().login(withUsername = userId, password = password, completion = completion);
			}
		} catch (error) {
			console.error('[iOS] Login error:', error);
			reject(error);
		}
	});
}

export function logout() : Promise<void> {
	return new Promise((resolve, reject) => {
		try {
			const completion = (error : EMError | null) : void => {
				if (error != null) {
					const code = error!.code.rawValue as number;
					const msg = error!.errorDescription ?? 'Logout failed';
					console.error('[iOS] Logout failed:', code, msg);
					reject(new Error(`Logout failed: ${code} - ${msg}`));
				} else {
					console.log('[iOS] Logout success');
					resolve();
				}
			};

			EMClient.shared().logout(true, completion = completion);
		} catch (error) {
			console.error('[iOS] Logout error:', error);
			reject(error);
		}
	});
}

export function sendConversationReadAck(convId : string) : Promise<void> {
	return new Promise((resolve, reject) => {
		try {
			EMClient.shared().chatManager?.ackConversationRead(convId)
			resolve()
		} catch (error) {
			console.error('[iOS] sendConversationReadAck error:', error)
			reject(error)
		}
	})
}

export function markAllMessagesAsRead(_convId : string) : Promise<void> {
	return new Promise((_resolve, reject) => {
		reject(new Error('markAllMessagesAsRead is not implemented on iOS yet'))
	})
}

export function getUnreadMessageCount() : number {
	const conversations = EMClient.shared().chatManager?.getAllConversations() ?? []
	let count = 0
	for (const conv of conversations) {
		count = count + (conv.unreadMessagesCount as number)
	}
	return count
}

export function getConversationUnreadMsgCount(convId : string) : number {
	const conversation = EMClient.shared().chatManager?.getConversationWithConvId(convId)
	return (conversation?.unreadMessagesCount as number) ?? 0
}

export function markAllConversationsAsRead() : Promise<void> {
	return new Promise((resolve, reject) => {
