export function getAllConversationsBySort() : Promise<EMConversation[]> {
	return new Promise((resolve, reject) => {
		const list = EMClient.shared().chatManager?.getAllConversations(true) ?? []
		console.log(`getAllConversationsBySort:${list}`)
		let conversations : EMConversation[] = []
		for (const conv of list) {
			conversations.push({
				conversationId: conv.conversationId,
				type: conv.type.rawValue as number,
				unreadMsgCount: conv.unreadMessagesCount as number,
				lastMessage: null
			} as EMConversation)
		}
		console.log(`getAllConversationsBySort:${conversations}`)

		resolve(conversations)
	});
}

export function getAllConversations() : EMConversation[] {
	const list = EMClient.shared().chatManager?.getAllConversations() ?? []
	let conversations : EMConversation[] = []
	for (const conv of list) {
		conversations.push({
			conversationId: conv.conversationId,
			type: conv.type.rawValue as number,
			unreadMsgCount: conv.unreadMessagesCount as number,
			lastMessage: null
		} as EMConversation)
	}
	return conversations
}

// ==================== 消息监听（Block 回调方式）====================

/** 将 EMChatMessage 转为 UTS Message */
function convertEMMessage(msg : EMChatMessage) : Message {
	let body : MessageBody = {
		type: 'txt',
		message: null
	};

	const msgBody = msg.body;
	if (msgBody.type == EMMessageBodyType.text) {
		body.type = 'txt';
		body.message = (msgBody as EMTextMessageBody).text ?? null;
	} else if (msgBody.type == EMMessageBodyType.image) {
		const imageBody = msgBody as EMImageMessageBody;
		body.type = 'img';
		body.message = imageBody.remotePath ?? null;
	} else if (msgBody.type == EMMessageBodyType.voice) {
		const voiceBody = msgBody as EMVoiceMessageBody;
		body.type = 'voice';
		body.message = voiceBody.remotePath ?? null;
	} else if (msgBody.type == EMMessageBodyType.video) {
		const videoBody = msgBody as EMVideoMessageBody;
		body.type = 'video';
		body.message = videoBody.remotePath ?? null;
	} else if (msgBody.type == EMMessageBodyType.location) {
		const locBody = msgBody as EMLocationMessageBody;
		body.type = 'location';
		body.message = locBody.address ?? null;
	} else if (msgBody.type == EMMessageBodyType.file) {
		const fileBody = msgBody as EMFileMessageBody;
		body.type = 'file';
		body.message = fileBody.remotePath ?? null;
	} else if (msgBody.type == EMMessageBodyType.cmd) {
		const cmdBody = msgBody as EMCmdMessageBody;
		body.type = 'cmd';
		body.message = cmdBody.action ?? null;
	} else if (msgBody.type == EMMessageBodyType.custom) {
		const customBody = msgBody as EMCustomMessageBody;
		body.type = 'custom';
		body.message = customBody.event ?? null;
	}
	return {
		msgId: msg.messageId ?? '',
		from: msg.from ?? '',
		to: msg.to ?? '',
		conversationId: msg.conversationId ?? '',
		chatType: msg.chatType.rawValue as number,
		body: body
	};
}

type MessageListener = {
	onMessageReceived : ((messages : string) => void) | null;
	onCmdMessageReceived : ((messages : string) => void) | null;
}

const messageCallbackMap : Map<string, MessageListener> = new Map();

export function addMessageListener(
	listenerId : string,
	onMessageReceived : ((messages : string) => void) | null,
	onCmdMessageReceived : ((messages : string) => void) | null
) : void {
	messageCallbackMap.set(listenerId, {
		onMessageReceived,
		onCmdMessageReceived
	});

	if (messageCallbackMap.size == 1) {
		UNIEMClient.shared.onMessagesReceivedBlock = (messages : EMChatMessage[]) : void => {
			const msgList = messages.map((msg : EMChatMessage) : Message => convertEMMessage(msg));
			const json = JSON.stringify(msgList) ?? "[]";
			messageCallbackMap.forEach((cbs : MessageListener, _id : string) : void => {
				cbs.onMessageReceived?.(json);
			});
		};
		UNIEMClient.shared.onCmdMessagesReceivedBlock = (messages : EMChatMessage[]) : void => {
			const msgList = messages.map((msg : EMChatMessage) : Message => convertEMMessage(msg));
			const json = JSON.stringify(msgList) ?? "[]";
			messageCallbackMap.forEach((cbs : MessageListener, _id : string) : void => {
				cbs.onCmdMessageReceived?.(json);
			});
		};
	}

	console.log('[iOS] addMessageListener:', listenerId);
}

export function removeMessageListener(listenerId : string) : void {
	messageCallbackMap.delete(listenerId);
	if (messageCallbackMap.size == 0) {
		UNIEMClient.shared.onMessagesReceivedBlock = null;
		UNIEMClient.shared.onCmdMessagesReceivedBlock = null;
	}
	console.log('[iOS] removeMessageListener:', listenerId);
}

export function removeAllMessageListeners() : void {
	messageCallbackMap.clear();
	UNIEMClient.shared.onMessagesReceivedBlock = null;
	UNIEMClient.shared.onCmdMessagesReceivedBlock = null;
	console.log('[iOS] removeAllMessageListeners');
}

