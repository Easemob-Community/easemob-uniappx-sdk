 * Easemob IM SDK Beta - iOS 平台实现
 * 实现初始化 + 登录 + 登出 + 连接监听 + 状态查询
 */

import {
	EMClient,
	EMOptions,
	EMError,
	EMMessageBodyType,
	EMTextMessageBody,
	EMImageMessageBody,
	EMVoiceMessageBody,
	EMVideoMessageBody,
	EMFileMessageBody,
	EMLocationMessageBody,
	EMCmdMessageBody,
	EMCustomMessageBody,
	EMChatMessage,
	EMConversation,
	EMCursorResult,
	EMChatType,
} from 'HyphenateChat';
import {
	EMInitConfig,
