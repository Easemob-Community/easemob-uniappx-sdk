// ==================== 聊天室管理监听（Block 回调方式）====================

type ChatroomManagerListener = {
	/** 用户加入聊天室 JSON: {chatroom, user, ext} */
	onChatroomUserJoined?: ((data: string) => void) | null;
	/** 用户离开聊天室 JSON: {chatroom, user} */
	onChatroomUserLeft?: ((data: string) => void) | null;
	/** 被踢出聊天室 JSON: {chatroom, reason}; reason: 0=被移除 1=聊天室销毁 2=离线 */
	onChatroomDidDismiss?: ((data: string) => void) | null;
	/** 聊天室详情更新 JSON: chatroom object */
	onChatroomSpecificationDidUpdate?: ((data: string) => void) | null;
	/** 聊天室成员加入禁言列表 JSON: {chatroom, mutedMembers} mutedMembers 为 {userId: expireTimestamp} 字典 */
	onChatroomMuteListAdded?: ((data: string) => void) | null;
	/** 聊天室成员移出禁言列表 JSON: {chatroom, mutedMembers} mutedMembers 为 string[] */
	onChatroomMuteListRemoved?: ((data: string) => void) | null;
	/** 聊天室成员加入白名单 JSON: {chatroom, members} */
	onChatroomWhiteListAdded?: ((data: string) => void) | null;
	/** 聊天室成员移出白名单 JSON: {chatroom, members} */
	onChatroomWhiteListRemoved?: ((data: string) => void) | null;
	/** 聊天室全员禁言状态变化 JSON: {chatroom, isAllMemberMuted} */
	onChatroomAllMemberMuteChanged?: ((data: string) => void) | null;
	/** 聊天室管理员添加 JSON: {chatroom, admin} */
	onChatroomAdminAdded?: ((data: string) => void) | null;
	/** 聊天室管理员移除 JSON: {chatroom, admin} */
	onChatroomAdminRemoved?: ((data: string) => void) | null;
	/** 聊天室所有者更新 JSON: {chatroom, newOwner, oldOwner} */
	onChatroomOwnerDidUpdate?: ((data: string) => void) | null;
	/** 聊天室公告更新 JSON: {chatroom, announcement} */
	onChatroomAnnouncementDidUpdate?: ((data: string) => void) | null;
	/** 聊天室自定义属性更新 JSON: {roomId, attributeMap, fromId} */
	onChatroomAttributesUpdated?: ((data: string) => void) | null;
	/** 聊天室自定义属性移除 JSON: {roomId, attributes, fromId} */
	onChatroomAttributesRemoved?: ((data: string) => void) | null;
}

const chatroomManagerCallbackMap : Map<string, ChatroomManagerListener> = new Map();

@UTSJS.keepAlive
export function addChatroomManagerListener(
	listenerId : string,
	listener : ChatroomManagerListener
) : void {
	chatroomManagerCallbackMap.set(listenerId, listener);

	if (chatroomManagerCallbackMap.size == 1) {
		UNIEMClient.shared.onChatroomUserJoinedBlock = (json : string) : void => {
