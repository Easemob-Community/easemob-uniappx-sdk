		UNIEMClient.shared.onGroupWhiteListAddedBlock = (json : string) : void => {
			groupManagerCallbackMap.forEach((cbs : GroupManagerListener, _id : string) : void => {
				cbs.onGroupWhiteListAdded?.(json);
			});
		};
		UNIEMClient.shared.onGroupWhiteListRemovedBlock = (json : string) : void => {
			groupManagerCallbackMap.forEach((cbs : GroupManagerListener, _id : string) : void => {
				cbs.onGroupWhiteListRemoved?.(json);
