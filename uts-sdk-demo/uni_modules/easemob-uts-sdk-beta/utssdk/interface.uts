/**
 * Easemob IM SDK Beta - 接口定义（精简版）
 * Android: 初始化 + 登录 + 连接监听
 * iOS: 初始化 + 登录 + 登出 + 连接监听 + 状态查询（已验证可用）
 */

// ==================== 初始化配置 ====================

export type EMInitConfig = {
  /** 应用 AppKey */
  appKey: string;
  /** 是否自动登录，默认 false */
  autoLogin?: boolean;
}

// ==================== 登录配置 ====================

export type EMLoginConfig = {
  /** 用户 ID */
  userId: string;
  /** 密码或 Token */
  password: string;
  /** 是否使用 Token 登录 */
  useToken?: boolean;
}

// ==================== 错误信息 ====================

/** SDK 错误信息 */
export type EMError = {
  /** 错误码 */
  code: number;
  /** 错误描述 */
  message: string;
}

// ==================== 事件处理器类型 ====================

/** 错误监听器 */
export type EMErrorListener = (error: EMError) => void;

/** Token 即将过期监听器 */
export type EMTokenWillExpireListener = () => void;

/** Token 已过期监听器 */
export type EMTokenExpiredListener = () => void;

/** 连接监听器回调集合（eventMap 模式） */
export type ConnectionListenerCallbacks = {
  onConnected?: () => void;
  onDisconnected?: (errorCode: number) => void;
  onLogout?: (errorCode: number) => void;
  onTokenWillExpire?: () => void;
  onTokenExpired?: () => void;
  onOfflineMessageSyncStart?: () => void;
  onOfflineMessageSyncFinish?: () => void;
}

// ==================== SDK 主接口 ====================

/**
 * Easemob IM SDK 客户端实例接口
 */
export interface EasemobClient {
  // MARK: - 事件监听（已实现）

  /** 注册已连接监听 */
  onConnected(listener: (() => void) | null): void;

  /** 注册连接断开监听 */
  onDisconnected(listener: ((errorCode: number) => void) | null): void;

  /** 注册被登出监听 */
  onLogout(listener: ((errorCode: number) => void) | null): void;

  // MARK: - 事件监听（桩函数）

  /** 注册错误监听（桩函数） */
  onError(listener: EMErrorListener | null): void;

  /** 注册 Token 即将过期监听 */
  onTokenWillExpire(listener: EMTokenWillExpireListener | null): void;

  /** 注册 Token 已过期监听 */
  onTokenExpired(listener: EMTokenExpiredListener | null): void;

  // MARK: - 核心方法（已实现）

  /** 登录（Android/iOS 均已实现） */
  login(config: UTSJSONObject): Promise<void>;

  /** 登出（Android/iOS 均已实现） */
  logout(): Promise<void>;

  /** 销毁 SDK 实例 */
  destroy(): void;

  // MARK: - 核心方法（桩函数）

  /** 获取 SDK 版本号（iOS 已实现） */
  getVersion(): string;

  /** 判断是否已连接（iOS 已实现） */
  isConnected(): boolean;

  /** 判断是否已登录（iOS 已实现） */
  isLoggedIn(): boolean;

  /** 获取当前登录用户 ID（iOS 已实现） */
  getCurrentUser(): string | null;
}

/**
 * 创建 Easemob IM SDK 客户端实例
 */
export type CreateEasemobClient = (config: EMInitConfig) => EasemobClient;
