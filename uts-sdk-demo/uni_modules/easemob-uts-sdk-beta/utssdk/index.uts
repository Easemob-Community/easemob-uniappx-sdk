/**
 * Easemob IM SDK Beta - 主入口（精简版）
 * 统一导出所有 API
 */

// ==================== 类型导出 ====================

export {
  EMInitConfig,
  EMLoginConfig,
  EMError,
  EMErrorListener,
  EMTokenWillExpireListener,
  EMTokenExpiredListener,
  EasemobClient,
  CreateEasemobClient,
  SendTextMessageConfig,
  SendCmdMessageConfig,
  SendCustomMessageConfig,
  Message,
  EMConversation,
  EMCursorResult,
} from './interface.uts';

// ==================== 平台相关实现 ====================

// #ifdef APP-IOS
export {
  initEasemob,
  login,
  logout,
  sendTextMessage,
  sendCmdMessage,
  sendCustomMessage,
  getAllConversationsBySort,
  getAllConversations,
  sendConversationReadAck,
  markAllMessagesAsRead,
  getUnreadMessageCount,
  getConversationUnreadMsgCount,
  markAllConversationsAsRead,
  deleteConversationFromServer,
  deleteConversation,
  fetchHistoryMessages,
  searchLocalMessagesByKeywords,
  searchLocalMessagesByTimeRange,
  loadLocalMessages,
  getVersion,
  isConnected,
  isLoggedIn,
  getCurrentUser,
  addMessageListener,
  removeMessageListener,
  removeAllMessageListeners,
  addGroupManagerListener,
  removeGroupManagerListener,
  addChatroomManagerListener,
  removeChatroomManagerListener,
} from './app-ios/index.uts';
// #endif

// #ifdef APP-ANDROID
import { create as _createAndroid, getClient as _getClientAndroid } from './app-android/index.uts';
// #endif

import type { EMInitConfig as _EMInitConfig, EasemobClient as _EasemobClient } from './interface.uts';

export function create(_config: _EMInitConfig): _EasemobClient {
  // #ifdef APP-IOS
  return null as _EasemobClient;
  // #endif
  // #ifdef APP-ANDROID
  return _createAndroid(_config);
  // #endif
}

export function getClient(): _EasemobClient | null {
  // #ifdef APP-IOS
  return null;
  // #endif
  // #ifdef APP-ANDROID
  return _getClientAndroid();
  // #endif
}
