/**
 * Easemob IM SDK Beta - Android 平台实现（精简版）
 * 仅实现初始化 + 登录 + 连接监听，其他为桩函数
 */

import EMClient from 'com.hyphenate.chat.EMClient';
import EMOptions from 'com.hyphenate.chat.EMOptions';
import EMCallBack from 'com.hyphenate.EMCallBack';
import EMConnectionListener from 'com.hyphenate.EMConnectionListener';

import {
  EasemobClient,
  EMInitConfig,
  EMLoginConfig,
  EMError,
  EMErrorListener,
  EMTokenWillExpireListener,
  EMTokenExpiredListener,
  ConnectionListenerCallbacks,
  Message,
  MessageBody,
  SendTextMessageConfig,
  SendCmdMessageConfig,
  SendCustomMessageConfig,
  EMConversation,
  EMCursorResult,
} from '../interface.uts';

// ==================== 事件处理器实现 ====================

class EMConnectionListenerImpl extends EMConnectionListener {
  @UTSJS.keepAlive
  eventMap: ConnectionListenerCallbacks = {};

  override onConnected(): void {
    console.log('[Android] native onConnected fired, hasCallback=' + (this.eventMap.onConnected != null));
    this.eventMap.onConnected?.();
  }

  override onDisconnected(errorCode: Int): void {
    console.log('[Android] native onDisconnected fired, errorCode=' + errorCode + ', hasCallback=' + (this.eventMap.onDisconnected != null));
    this.eventMap.onDisconnected?.(errorCode);
  }

  override onLogout(errorCode: Int): void {
    console.log('[Android] native onLogout fired, errorCode=' + errorCode + ', hasCallback=' + (this.eventMap.onLogout != null));
    this.eventMap.onLogout?.(errorCode);
  }

  override onTokenWillExpire(): void {
    this.eventMap.onTokenWillExpire?.();
  }

  override onTokenExpired(): void {
    this.eventMap.onTokenExpired?.();
  }

  override onOfflineMessageSyncStart(): void {
    this.eventMap.onOfflineMessageSyncStart?.();
  }

  override onOfflineMessageSyncFinish(): void {
    this.eventMap.onOfflineMessageSyncFinish?.();
  }
}

import EMMessage from 'com.hyphenate.chat.EMMessage';
import EMMessageBody from 'com.hyphenate.chat.EMMessageBody';
import EMTextMessageBody from 'com.hyphenate.chat.EMTextMessageBody';
import EMImageMessageBody from 'com.hyphenate.chat.EMImageMessageBody';
import EMVoiceMessageBody from 'com.hyphenate.chat.EMVoiceMessageBody';
import EMVideoMessageBody from 'com.hyphenate.chat.EMVideoMessageBody';
import EMLocationMessageBody from 'com.hyphenate.chat.EMLocationMessageBody';
import EMFileMessageBody from 'com.hyphenate.chat.EMFileMessageBody';
import EMCmdMessageBody from 'com.hyphenate.chat.EMCmdMessageBody';
import EMCustomMessageBody from 'com.hyphenate.chat.EMCustomMessageBody';
import EMMessageListener from 'com.hyphenate.EMMessageListener';
import EMConversationListener from 'com.hyphenate.EMConversationListener';
import MutableList from 'kotlin.collections.MutableList';
import EMMessageChatType from 'com.hyphenate.chat.EMMessage.ChatType';
import { MessageHelper, setMessageExtFromJson, createCustomMessageBody, fetchConversationsFromServer, getAllConversationsBySortInternal, getAllConversationsInternal, sendConversationReadAckInternal, deleteConversationFromServerInternal, deleteConversationInternal, fetchHistoryMessagesInternal, searchLocalMessagesByKeywordsInternal, searchLocalMessagesByTimeRangeInternal, loadLocalMessagesInternal } from 'uts.sdk.modules.easemobUtsSdkBeta';


type MessageListenerCallbacks = {
  onMessageReceived?: ((messages: Message[]) => void) | null;
  onCmdMessageReceived?: ((messages: Message[]) => void) | null;
}

type ConversationListenerCallbacks = {
  onConversationRead?: ((from: string, to?: string) => void) | null;
}

function convertEMMessage(msg: EMMessage): Message {
  let body: MessageBody = {
    type: 'txt',
    message: null,
  };

  const msgBody = msg.getBody();
  if (msgBody instanceof EMTextMessageBody) {
    body.type = 'txt';
    body.message = msgBody.getMessage();
  } else if (msgBody instanceof EMImageMessageBody) {
    body.type = 'img';
    body.message = msgBody.getRemoteUrl() ?? msgBody.getLocalUrl();
  } else if (msgBody instanceof EMVoiceMessageBody) {
    body.type = 'voice';
    body.message = msgBody.getRemoteUrl() ?? msgBody.getLocalUrl();
  } else if (msgBody instanceof EMVideoMessageBody) {
    body.type = 'video';
    body.message = msgBody.getRemoteUrl() ?? msgBody.getLocalUrl();
  } else if (msgBody instanceof EMLocationMessageBody) {
    body.type = 'location';
    body.message = msgBody.getAddress();
  } else if (msgBody instanceof EMFileMessageBody) {
    body.type = 'file';
    body.message = msgBody.getRemoteUrl() ?? msgBody.getLocalUrl();
  } else if (msgBody instanceof EMCmdMessageBody) {
    body.type = 'cmd';
    body.message = msgBody.action();
  } else if (msgBody instanceof EMCustomMessageBody) {
    body.type = 'custom';
    body.message = msgBody.event();
  }

  return {
    msgId: msg.getMsgId(),
    from: msg.getFrom(),
    to: msg.getTo(),
    conversationId: msg.conversationId(),
    chatType: msg.getChatType().ordinal,
    body: body,
  };
}

class EMMessageListenerImpl extends EMMessageListener {
  @UTSJS.keepAlive
  eventMap: MessageListenerCallbacks = {};

  override onMessageReceived(messages: MutableList<EMMessage>): void {
    console.log('[Android] native onMessageReceived, count=' + messages.size);
    const msgList: Message[] = [];
    for (let i: Int = 0; i < messages.size; i++) {
      const msg = messages.get(i);
      if (msg.getBody() instanceof EMCmdMessageBody) {
        continue;
      }
      msgList.push(convertEMMessage(msg));
    }
    this.eventMap.onMessageReceived?.(msgList);
  }

  override onCmdMessageReceived(messages: MutableList<EMMessage>): void {
    console.log('[Android] native onCmdMessageReceived, count=' + messages.size);
    const msgList: Message[] = [];
    for (let i: Int = 0; i < messages.size; i++) {
      msgList.push(convertEMMessage(messages.get(i)));
    }
    this.eventMap.onCmdMessageReceived?.(msgList);
  }
}

// ==================== 回调工厂（核心：用普通成员属性持有闭包，彻底避免 Promise resolve/reject 类型转译问题）====================

/**
 * 通用 EMCallBack 实现：通过成员属性持有 onSuccess/onError 闭包
 * 不直接持有 Promise 的 resolve/reject，避免 UTS→Kotlin 的 Function0/Function1 类型不匹配
 */
class EMConversationListenerImpl extends EMConversationListener {
  @UTSJS.keepAlive
  eventMap: ConversationListenerCallbacks = {};

  override onConversationUpdate(): void {
    // 暂不需要处理
  }

  override onConversationRead(from: string, to: string): void {
    console.log('[Android] native onConversationRead fired, from=' + from + ', to=' + to);
    this.eventMap.onConversationRead?.(from, to);
  }
}

class EMCallBackImpl extends EMCallBack {
  @UTSJS.keepAlive
  onSuccessHandler: (() => void) | null = null;
  @UTSJS.keepAlive
  onErrorHandler: ((code: number, message: string) => void) | null = null;

  override onSuccess(): void {
    this.onSuccessHandler?.();
  }

  override onError(code: Int, message: string): void {
    this.onErrorHandler?.(code, message);
  }
}

/** 创建登录/登出回调实例，注册闭包后返回 */
function makeCallBack(
  onSuccess: () => void,
  onError: (code: number, message: string) => void
): EMCallBackImpl {
  const cb = new EMCallBackImpl();
  cb.onSuccessHandler = onSuccess;
  cb.onErrorHandler = onError;
  return cb;
}

// ==================== SDK 实现类 ====================

export class EMClientImpl implements EasemobClient {
  private static _instance: EMClientImpl | null = null;
  private _listener: EMConnectionListenerImpl | null = null;
  private _messageListener: EMMessageListenerImpl | null = null;
  private _conversationListener: EMConversationListenerImpl | null = null;
  private _isInitialized = false;

  @UTSJS.keepAlive
  private _onConnected: (() => void) | null = null;
  @UTSJS.keepAlive
  private _onDisconnected: ((errorCode: number) => void) | null = null;
  @UTSJS.keepAlive
  private _onLogout: ((errorCode: number) => void) | null = null;
  @UTSJS.keepAlive
  private _onTokenWillExpire: (() => void) | null = null;
  @UTSJS.keepAlive
  private _onTokenExpired: (() => void) | null = null;
  @UTSJS.keepAlive
  private _onMessageReceived: ((messages: Message[]) => void) | null = null;
  @UTSJS.keepAlive
  private _onCmdMessageReceived: ((messages: Message[]) => void) | null = null;
  @UTSJS.keepAlive
  private _onConversationRead: ((from: string, to?: string) => void) | null = null;

  private constructor() {}

  static getInstance(): EMClientImpl {
    if (this._instance == null) {
      this._instance = new EMClientImpl();
    }
    return this._instance!;
  }

  static getClient(): EasemobClient | null {
    const instance = EMClientImpl.getInstance();
    return instance._isInitialized ? instance : null;
  }

  static create(config: EMInitConfig): EasemobClient {
    const instance = EMClientImpl.getInstance();
    if (!instance._isInitialized) {
      const appKey = config.appKey!;
      const autoLogin = config.autoLogin ?? false;
      const options = new EMOptions();
      options.setAppKey(appKey);
      options.setAutoLogin(autoLogin);
      EMClient.getInstance().init(UTSAndroid.getAppContext()!, options);
      instance._listener = new EMConnectionListenerImpl();
      EMClient.getInstance().addConnectionListener(instance._listener!);
      instance._messageListener = new EMMessageListenerImpl();
      EMClient.getInstance().chatManager().addMessageListener(instance._messageListener!);
      instance._conversationListener = new EMConversationListenerImpl();
      EMClient.getInstance().chatManager().addConversationListener(instance._conversationListener!);
      instance._isInitialized = true;
      console.log('[Android] EMClient SDK initialized');
    } else {
      console.log('[Android] EMClient SDK already initialized');
    }
    return instance;
  }

  login(config: UTSJSONObject): Promise<void> {
    return new Promise((resolve, reject) => {
      try {
        const userId = config['userId'] as string;
        const password = config['password'] as string;
        const useToken = (config['useToken'] as boolean) ?? false;
        const callback = makeCallBack(
          (): void => {
            console.log('[Android] Login success:', userId);
            resolve();
          },
          (code: number, message: string): void => {
            console.error('[Android] Login failed:', code, message);
            reject(new Error(`Login failed: ${code} - ${message}`));
          }
        );
        if (useToken) {
          EMClient.getInstance().loginWithToken(userId, password, callback);
        } else {
          EMClient.getInstance().login(userId, password, callback);
        }
      } catch (error) {
        console.error('[Android] Login error:', error);
        reject(error);
      }
    });
  }

  logout(): Promise<void> {
    return new Promise((resolve, reject) => {
      try {
        const callback = makeCallBack(
          (): void => {
            console.log('[Android] Logout success');
            resolve();
          },
          (code: number, message: string): void => {
            console.error('[Android] Logout failed:', code, message);
            reject(new Error(`Logout failed: ${code} - ${message}`));
          }
        );
        EMClient.getInstance().logout(true, callback);
      } catch (error) {
        console.error('[Android] Logout error:', error);
        reject(error);
      }
    });
  }

  destroy(): void {
    if (this._messageListener != null) {
      EMClient.getInstance().chatManager().removeMessageListener(this._messageListener);
    }
    if (this._conversationListener != null) {
      EMClient.getInstance().chatManager().removeConversationListener(this._conversationListener);
    }
    this._listener = null;
    this._messageListener = null;
    this._conversationListener = null;
    this._isInitialized = false;
    console.log('[Android] EMClient SDK destroyed');
  }

  onConnected(listener: (() => void) | null): void {
    this._onConnected = listener;
    if (this._listener != null) {
      this._listener.eventMap.onConnected = listener;
    }
  }

  onDisconnected(listener: ((errorCode: number) => void) | null): void {
    this._onDisconnected = listener;
    if (this._listener != null) {
      this._listener.eventMap.onDisconnected = listener;
    }
  }

  onLogout(listener: ((errorCode: number) => void) | null): void {
    this._onLogout = listener;
    if (this._listener != null) {
      this._listener.eventMap.onLogout = listener;
    }
  }

  onTokenWillExpire(listener: EMTokenWillExpireListener | null): void {
    this._onTokenWillExpire = listener;
    if (this._listener != null) {
      this._listener.eventMap.onTokenWillExpire = listener;
    }
  }

  onTokenExpired(listener: EMTokenExpiredListener | null): void {
    this._onTokenExpired = listener;
    if (this._listener != null) {
      this._listener.eventMap.onTokenExpired = listener;
    }
  }

  onMessageReceived(listener: ((messages: Message[]) => void) | null): void {
    this._onMessageReceived = listener;
    if (this._messageListener != null) {
      this._messageListener.eventMap.onMessageReceived = listener;
    }
  }

  onCmdMessageReceived(listener: ((messages: Message[]) => void) | null): void {
    this._onCmdMessageReceived = listener;
    if (this._messageListener != null) {
      this._messageListener.eventMap.onCmdMessageReceived = listener;
    }
  }

  onConversationRead(listener: ((from: string, to?: string) => void) | null): void {
    this._onConversationRead = listener;
    if (this._conversationListener != null) {
      this._conversationListener.eventMap.onConversationRead = listener;
    }
  }

  sendConversationReadAck(convId: string): Promise<void> {
    return new Promise((resolve, reject) => {
      try {
        sendConversationReadAckInternal(
          convId,
          () => {
            resolve();
          },
          (code: number, message: string) => {
            reject(new Error(`sendConversationReadAck failed: ${code} - ${message}`));
          }
        );
      } catch (error) {
        console.error('[Android] sendConversationReadAck error:', error);
        reject(error);
      }
    });
  }

  markAllMessagesAsRead(convId: string): Promise<void> {
    return new Promise((resolve, reject) => {
      try {
        const conversation = EMClient.getInstance().chatManager().getConversation(convId);
        if (conversation != null) {
          conversation.markAllMessagesAsRead();
          resolve();
        } else {
          reject(new Error(`Conversation not found: ${convId}`));
        }
      } catch (error) {
        console.error('[Android] markAllMessagesAsRead error:', error);
        reject(error);
      }
    });
  }

  getUnreadMessageCount(): number {
    return EMClient.getInstance().chatManager().getUnreadMessageCount();
  }

  getConversationUnreadMsgCount(convId: string): number {
    const conversation = EMClient.getInstance().chatManager().getConversation(convId);
    return conversation != null ? conversation.getUnreadMsgCount() : 0;
  }

  markAllConversationsAsRead(): Promise<void> {
    return new Promise((resolve, reject) => {
      try {
        EMClient.getInstance().chatManager().markAllConversationsAsRead();
        resolve();
      } catch (error) {
        console.error('[Android] markAllConversationsAsRead error:', error);
        reject(error);
      }
    });
  }

  deleteConversationFromServer(convId: string, convType: number, isDeleteServerMessages: boolean): Promise<void> {
    return new Promise((resolve, reject) => {
      try {
        deleteConversationFromServerInternal(
          convId,
          convType as Int,
          isDeleteServerMessages,
          () => { resolve(); },
          (code: number, message: string) => {
            reject(new Error(`deleteConversationFromServer failed: ${code} - ${message}`));
          }
        );
      } catch (error) {
        console.error('[Android] deleteConversationFromServer error:', error);
        reject(error);
      }
    });
  }

  deleteConversation(convId: string, withMessage: boolean): Promise<void> {
    return new Promise((resolve, reject) => {
      try {
        const success = deleteConversationInternal(convId, withMessage);
        if (success) {
          resolve();
        } else {
          reject(new Error(`deleteConversation failed for: ${convId}`));
        }
      } catch (error) {
        console.error('[Android] deleteConversation error:', error);
        reject(error);
      }
    });
  }

  fetchHistoryMessages(convId: string, convType: number, pageSize: number, startMsgId: string): Promise<EMCursorResult<Message>> {
    return new Promise((resolve, reject) => {
      try {
        fetchHistoryMessagesInternal(
          convId,
          convType as Int,
          pageSize as Int,
          startMsgId,
          (messages: UTSJSONObject[], cursor: string) => {
            const result: EMCursorResult<Message> = {
              data: this.parseMessageList(messages),
              cursor: cursor,
            };
            resolve(result);
          },
          (code: number, message: string) => {
            reject(new Error(`fetchHistoryMessages failed: ${code} - ${message}`));
          }
        );
      } catch (error) {
        console.error('[Android] fetchHistoryMessages error:', error);
        reject(error);
      }
    });
  }

  searchLocalMessagesByKeywords(convId: string, keywords: string, timestamp: number, maxCount: number, from: string, direction: number): Promise<Message[]> {
    return new Promise((resolve, reject) => {
      try {
        const messages = searchLocalMessagesByKeywordsInternal(convId, keywords, timestamp as Int, maxCount as Int, from, direction as Int);
        resolve(this.parseMessageList(messages));
      } catch (error) {
        console.error('[Android] searchLocalMessagesByKeywords error:', error);
        reject(error);
      }
    });
  }

  searchLocalMessagesByTimeRange(convId: string, startTimestamp: number, endTimestamp: number, maxCount: number, from: string, direction: number): Promise<Message[]> {
    return new Promise((resolve, reject) => {
      try {
        const messages = searchLocalMessagesByTimeRangeInternal(convId, startTimestamp as Int, endTimestamp as Int, maxCount as Int, from, direction as Int);
        resolve(this.parseMessageList(messages));
      } catch (error) {
        console.error('[Android] searchLocalMessagesByTimeRange error:', error);
        reject(error);
      }
    });
  }

  loadLocalMessages(convId: string, startMsgId: string, pageSize: number): Promise<Message[]> {
    return new Promise((resolve, reject) => {
      try {
        const messages = loadLocalMessagesInternal(convId, startMsgId, pageSize as Int);
        resolve(this.parseMessageList(messages));
      } catch (error) {
        console.error('[Android] loadLocalMessages error:', error);
        reject(error);
      }
    });
  }

  // MARK: - 桩函数

  sendTextMessage(config: SendTextMessageConfig): Promise<Message> {
    return new Promise((resolve, reject) => {
      try {
        const content = config.content;
        const to = config.to;
        const chatType = config.chatType;
        const ext = config.ext ?? null;
        if (content.length === 0) {
          reject(new Error('content 不能为空'));
          return;
        }
        if (to.length === 0) {
          reject(new Error('to 不能为空'));
          return;
        }
        const message = EMMessage.createTextSendMessage(content, to);
        if (chatType === 'group') {
          message.setChatType(EMMessageChatType.GroupChat);
        } else if (chatType === 'chatroom') {
          message.setChatType(EMMessageChatType.ChatRoom);
        } else {
          message.setChatType(EMMessageChatType.Chat);
        }
        if (ext != null) {
          const extJson = JSON.stringify(ext);
          setMessageExtFromJson(message, extJson);
        }
        const callback = makeCallBack(
          (): void => {
            resolve(convertEMMessage(message));
          },
          (code: number, messageStr: string): void => {
            reject(new Error(`Send text message failed: ${code} - ${messageStr}`));
          }
        );
        MessageHelper.setMessageStatusCallback(message, callback);
        EMClient.getInstance().chatManager().sendMessage(message);
      } catch (error) {
        console.error('[Android] sendTextMessage error:', error);
        reject(error);
      }
    });
  }

  sendCmdMessage(config: SendCmdMessageConfig): Promise<Message> {
    return new Promise((resolve, reject) => {
      try {
        const action = config.action;
        const to = config.to;
        const chatType = config.chatType;
        const ext = config.ext ?? null;
        if (action.length === 0) {
          reject(new Error('action 不能为空'));
          return;
        }
        if (to.length === 0) {
          reject(new Error('to 不能为空'));
          return;
        }
        const message = EMMessage.createSendMessage(EMMessage.Type.CMD);
        message.setTo(to);
        const body = new EMCmdMessageBody(action);
        message.addBody(body);
        if (chatType === 'group') {
          message.setChatType(EMMessageChatType.GroupChat);
        } else if (chatType === 'chatroom') {
          message.setChatType(EMMessageChatType.ChatRoom);
        } else {
          message.setChatType(EMMessageChatType.Chat);
        }
        if (ext != null) {
          const extJson = JSON.stringify(ext);
          setMessageExtFromJson(message, extJson);
        }
        const callback = makeCallBack(
          (): void => {
            resolve(convertEMMessage(message));
          },
          (code: number, messageStr: string): void => {
            reject(new Error(`Send cmd message failed: ${code} - ${messageStr}`));
          }
        );
        MessageHelper.setMessageStatusCallback(message, callback);
        EMClient.getInstance().chatManager().sendMessage(message);
      } catch (error) {
        console.error('[Android] sendCmdMessage error:', error);
        reject(error);
      }
    });
  }

  sendCustomMessage(config: SendCustomMessageConfig): Promise<Message> {
    return new Promise((resolve, reject) => {
      try {
        const event = config.event;
        const params = config.params ?? new UTSJSONObject();
        const to = config.to;
        const chatType = config.chatType;
        const ext = config.ext ?? null;
        if (event.length === 0) {
          reject(new Error('event 不能为空'));
          return;
        }
        if (to.length === 0) {
          reject(new Error('to 不能为空'));
          return;
        }
        const message = EMMessage.createSendMessage(EMMessage.Type.CUSTOM);
        message.setTo(to);
        const paramsJson = JSON.stringify(params ?? {});
        const customBody = createCustomMessageBody(event, paramsJson);
        message.addBody(customBody);
        if (chatType === 'group') {
          message.setChatType(EMMessageChatType.GroupChat);
        } else if (chatType === 'chatroom') {
          message.setChatType(EMMessageChatType.ChatRoom);
        } else {
          message.setChatType(EMMessageChatType.Chat);
        }
        if (ext != null) {
          const extJson = JSON.stringify(ext);
          setMessageExtFromJson(message, extJson);
        }
        const callback = makeCallBack(
          (): void => {
            resolve(convertEMMessage(message));
          },
          (code: number, messageStr: string): void => {
            reject(new Error(`Send custom message failed: ${code} - ${messageStr}`));
          }
        );
        MessageHelper.setMessageStatusCallback(message, callback);
        EMClient.getInstance().chatManager().sendMessage(message);
      } catch (error) {
        console.error('[Android] sendCustomMessage error:', error);
        reject(error);
      }
    });
  }

  private parseConversationList(list: UTSJSONObject[]): EMConversation[] {
    const conversationList: EMConversation[] = [];
    for (let i = 0; i < list.length; i++) {
      const conv = list[i];
      const conversation: EMConversation = {
        conversationId: conv['conversationId'] as string,
        type: conv['type'] as number,
        unreadMsgCount: conv['unreadMsgCount'] as number,
      };
      const lastMessage = conv['lastMessage'] as UTSJSONObject | null;
      if (lastMessage != null) {
        const body = lastMessage['body'] as UTSJSONObject | null;
        conversation.lastMessage = {
          msgId: lastMessage['msgId'] as string,
          from: lastMessage['from'] as string,
          to: lastMessage['to'] as string,
          conversationId: lastMessage['conversationId'] as string,
          chatType: lastMessage['chatType'] as number,
          body: {
            type: body != null ? body['type'] as string : '',
            message: body != null ? body['message'] as string | null : null,
          },
        };
      }
      conversationList.push(conversation);
    }
    return conversationList;
  }

  private parseMessageList(list: UTSJSONObject[]): Message[] {
    const msgList: Message[] = [];
    for (let i = 0; i < list.length; i++) {
      const msg = list[i];
      const body = msg['body'] as UTSJSONObject | null;
      msgList.push({
        msgId: msg['msgId'] as string,
        from: msg['from'] as string,
        to: msg['to'] as string,
        conversationId: msg['conversationId'] as string,
        chatType: msg['chatType'] as number,
        body: {
          type: body != null ? body['type'] as string : '',
          message: body != null ? body['message'] as string | null : null,
        },
      });
    }
    return msgList;
  }

  fetchConversationsFromServer(limit: number, cursor: string): Promise<EMCursorResult<EMConversation>> {
    return new Promise((resolve, reject) => {
      try {
        fetchConversationsFromServer(
          limit as Int,
          cursor as string,
          (conversations: UTSJSONObject[], nextCursor: string) => {
            const result: EMCursorResult<EMConversation> = {
              data: this.parseConversationList(conversations),
              cursor: nextCursor,
            };
            resolve(result);
          },
          (code: number, message: string) => {
            reject(new Error(`Fetch conversations failed: ${code} - ${message}`));
          }
        );
      } catch (error) {
        console.error('[Android] fetchConversationsFromServer error:', error);
        reject(error);
      }
    });
  }

  getAllConversationsBySort(): Promise<EMConversation[]> {
    return new Promise((resolve, reject) => {
      try {
        const conversations = getAllConversationsBySortInternal();
        resolve(this.parseConversationList(conversations));
      } catch (error) {
        console.error('[Android] getAllConversationsBySort error:', error);
        reject(error);
      }
    });
  }

  getAllConversations(): Promise<EMConversation[]> {
    return new Promise((resolve, reject) => {
      try {
        const conversations = getAllConversationsInternal();
        resolve(this.parseConversationList(conversations));
      } catch (error) {
        console.error('[Android] getAllConversations error:', error);
        reject(error);
      }
    });
  }

  onError(listener: EMErrorListener | null): void {}
  getVersion(): string { return 'unknown'; }
  isConnected(): boolean { return false; }
  isLoggedIn(): boolean { return false; }
  getCurrentUser(): string | null { return null; }
}

// ==================== 导出 ====================

export function create(config: UTSJSONObject): EasemobClient {
  return EMClientImpl.create({
    appKey: config['appKey'] as string,
    autoLogin: (config['autoLogin'] as boolean) ?? false,
  });
}

export function getClient(): EasemobClient | null {
  return EMClientImpl.getClient();
}
