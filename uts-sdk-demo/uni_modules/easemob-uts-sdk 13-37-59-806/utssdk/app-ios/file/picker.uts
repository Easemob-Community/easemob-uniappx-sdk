/**
 * iOS 文件选择器工具（轮询模式，和 EMMessageBridge 一致）
 * 参考 Android 架构设计，提供统一的文件选择接口
 */

/** 轮询间隔（ms） */
const PICKER_POLL_INTERVAL = 100;
/** 最大等待时间（ms）- 文件选择器等待时间较长 */
const PICKER_POLL_TIMEOUT  = 300000;

/** 生成唯一回调 ID */
function genPickerCallbackId(): string {
	return Date.now().toString() + Math.random().toString(36).substring(2, 9);
}

/**
 * 文件选择结果数据类
 */
export class FilePickResultData {
	filePath: string = '';
	fileName: string = '';
	fileSize: number = 0;
	mimeType: string = '';
}

/**
 * 打开文件选择器
 * @param callback 回调对象，包含 onSuccess, onError, onCancel
 * 
 * 成功回调返回 FilePickResultData:
 * - filePath: 文件路径
 * - fileName: 文件名
 * - fileSize: 文件大小(字节)
 * - mimeType: 文件类型
 * 
 * @example
 * openFilePicker({
 *   onSuccess: (result) => {
 *     console.log("文件名:", result.fileName);
 *     console.log("文件大小:", result.fileSize);
 *     sendFileMessage(result.filePath, to, chatType, callback);
 *   },
 *   onError: (code, message) => {
 *     console.log("选择失败:", code, message);
 *   },
 *   onCancel: () => {
 *     console.log("用户取消选择");
 *   }
 * });
 */
export function openFilePickerImpl(callback: UTSJSONObject): void {
	const callbackId = genPickerCallbackId();
	console.log('[iOS][picker] openFilePicker, callbackId=', callbackId);

	// 提取回调（在函数体顶层提取，规避 iOS 闭包内 UTSJSONObject 访问崩溃）
	const onSuccess = callback["onSuccess"] as ((result: FilePickResultData) => void) | null;
	const onError = callback["onError"] as ((code: number, message: string) => void) | null;
	const onCancel = callback["onCancel"] as (() => void) | null;

	// 调用 Swift 层打开文件选择器
	FilePickerBridge.openFilePicker(callbackId = callbackId);

	// 轮询结果
	pollPickerResult(callbackId, onSuccess, onError, onCancel);
}

/**
 * 轮询文件选择器结果
 */
function pollPickerResult(
	callbackId: string,
	onSuccess: ((result: FilePickResultData) => void) | null,
	onError: ((code: number, message: string) => void) | null,
	onCancel: (() => void) | null
): void {
	let elapsed : number = 0;
	let timer   : number = 0;
	timer = setInterval((): void => {
		elapsed += PICKER_POLL_INTERVAL;
		const status : string = FilePickerBridge.getResultStatus(callbackId = callbackId);

		if (status == 'success') {
			clearInterval(timer);
			// 读取文件信息
			const filePath  : string = FilePickerBridge.getResultFilePath(callbackId = callbackId);
			const fileName  : string = FilePickerBridge.getResultFileName(callbackId = callbackId);
			const fileSizeRaw : Int  = FilePickerBridge.getResultFileSize(callbackId = callbackId);
			const mimeType  : string = FilePickerBridge.getResultMimeType(callbackId = callbackId);
			FilePickerBridge.clearResult(callbackId = callbackId);

			const resultData = new FilePickResultData();
			resultData.filePath = filePath;
			resultData.fileName = fileName;
			resultData.fileSize = fileSizeRaw as number;
			resultData.mimeType = mimeType;

			console.log('[iOS][picker] 文件选择成功:', fileName, fileSizeRaw);
			if (onSuccess != null) { onSuccess!(resultData); }

		} else if (status == 'error') {
			clearInterval(timer);
			const codeRaw : Int    = FilePickerBridge.getResultErrorCode(callbackId = callbackId);
			const msg     : string = FilePickerBridge.getResultErrorMessage(callbackId = callbackId);
			FilePickerBridge.clearResult(callbackId = callbackId);
			console.log('[iOS][picker] 文件选择失败:', codeRaw, msg);
			if (onError != null) { onError!(codeRaw as number, msg); }

		} else if (status == 'cancelled') {
			clearInterval(timer);
			FilePickerBridge.clearResult(callbackId = callbackId);
			console.log('[iOS][picker] 用户取消文件选择');
			if (onCancel != null) { onCancel!(); }

		} else if (elapsed >= PICKER_POLL_TIMEOUT) {
			clearInterval(timer);
			FilePickerBridge.clearResult(callbackId = callbackId);
			console.log('[iOS][picker] 文件选择超时');
			if (onError != null) { onError!(408, '文件选择超时'); }
		}
	}, PICKER_POLL_INTERVAL);
}

/**
 * 处理文件选择器结果（iOS 保留接口，实际由 UIDocumentPickerDelegate 自动处理）
 * @returns 始终返回 false
 */
export function handleFilePickerResultImpl(): boolean {
	return false;
}
