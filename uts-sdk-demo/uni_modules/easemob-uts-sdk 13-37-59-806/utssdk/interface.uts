/**
 * 类型定义（按需扩展）
 */

// ==================== 初始化配置 ====================

export interface EMInitConfig {
  appKey: string;
  autoLogin?: boolean;
}

// ==================== 连接状态监听器 ====================

export interface EMConnectionListener {
  onConnected?: () => void;
  onDisconnected?: (errorCode: number) => void;
  onLogout?: (errorCode: number) => void;
  onTokenWillExpire?: () => void;
  onTokenExpired?: () => void;
  onOfflineMessageSyncStart?: () => void;
  onOfflineMessageSyncFinish?: () => void;
}

// ==================== 登录/登出回调 ====================

export interface EMLoginCallback {
  onSuccess?: () => void;
  onError?: (code: number, message: string) => void;
  onProgress?: (code: number, message: string) => void;
}

export interface EMLogoutCallback {
  onSuccess?: () => void;
  onError?: (code: number, message: string) => void;
}

// ==================== 事件总线类型定义（简化版）====================

/** 事件处理器函数 */
export type EMEventHandler<T = any> = (data: T) => void;

/** 分类事件处理器 */
export type EMCategoryEventHandler = (eventName: string, data: any) => void;
