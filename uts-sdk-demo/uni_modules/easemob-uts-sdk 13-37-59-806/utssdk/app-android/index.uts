// ==================== 事件总线集成 ====================

import {
  EMConnectionEvent,
  EMMessageEvent
} from '../common/event-constants.uts';

/** 事件总线是否已启用 */
let eventBusEnabled = false;

/** 连接监听器 ID */
let connectionListenerId: string | null = null;

/** 消息监听器 ID */
let messageListenerId: string | null = null;

/**
 * 启用事件总线
 * 开启后，SDK 所有事件将自动分发到 EMEventBus
 */
export function enableEventBus(): void {
  if (eventBusEnabled) {
    console.log('[Android] EventBus already enabled');
    return;
  }

  // 注册连接监听器（setTimeout 确保 uni.$emit 在主线程执行，避免 ConcurrentModificationException）
  const connectionCallbacks: ConnectionListenerCallbacks = {
    onConnected: () => {
      setTimeout(() => { uni.$emit(EMConnectionEvent.CONNECTED, null); }, 0);
    },
    onDisconnected: (errorCode: number) => {
      setTimeout(() => { uni.$emit(EMConnectionEvent.DISCONNECTED, errorCode); }, 0);
    },
    onLogout: (errorCode: number) => {
      setTimeout(() => { uni.$emit(EMConnectionEvent.LOGOUT, errorCode); }, 0);
    },
    onTokenWillExpire: () => {
      setTimeout(() => { uni.$emit(EMConnectionEvent.TOKEN_WILL_EXPIRE, null); }, 0);
    },
    onTokenExpired: () => {
      setTimeout(() => { uni.$emit(EMConnectionEvent.TOKEN_EXPIRED, null); }, 0);
    },
    onOfflineMessageSyncStart: () => {
      setTimeout(() => { uni.$emit(EMConnectionEvent.OFFLINE_SYNC_START, null); }, 0);
    },
    onOfflineMessageSyncFinish: () => {
      setTimeout(() => { uni.$emit(EMConnectionEvent.OFFLINE_SYNC_FINISH, null); }, 0);
    }
  };

  const connId = Date.now().toString() + Math.random().toString(36).substring(2, 11);
  connectionListenerId = connId;
  addConnListenerImpl(connId, connectionCallbacks);

  // 注册消息监听器（JSON 序列化 + setTimeout 主线程调度）
  const messageCallbacks: MessageListenerCallbacks = {
    onMessageReceived: (messages: Message[]) => {
      const json = JSON.stringify(messages);
      setTimeout(() => { uni.$emit(EMMessageEvent.RECEIVED, json); }, 0);
    },
    onCmdMessageReceived: (messages: Message[]) => {
      const json = JSON.stringify(messages);
      setTimeout(() => { uni.$emit(EMMessageEvent.CMD_RECEIVED, json); }, 0);
    },
    onStreamMessageReceived: (messages: Message[]) => {
      const json = JSON.stringify(messages);
      setTimeout(() => { uni.$emit(EMMessageEvent.STREAM_RECEIVED, json); }, 0);
    },
    onMessageRead: (messages: Message[]) => {
      const json = JSON.stringify(messages);
      setTimeout(() => { uni.$emit(EMMessageEvent.READ, json); }, 0);
    },
    onGroupMessageRead: (groupReadAcks: GroupReadAck[]) => {
      const json = JSON.stringify(groupReadAcks);
      setTimeout(() => { uni.$emit(EMMessageEvent.GROUP_READ, json); }, 0);
    },
    onReadAckForGroupMessageUpdated: () => {
      setTimeout(() => { uni.$emit(EMMessageEvent.GROUP_READ_ACK_UPDATED, null); }, 0);
    },
    onMessageDelivered: (messages: Message[]) => {
      const json = JSON.stringify(messages);
      setTimeout(() => { uni.$emit(EMMessageEvent.DELIVERED, json); }, 0);
    },
    onMessageRecalled: (messages: Message[]) => {
      const json = JSON.stringify(messages);
      setTimeout(() => { uni.$emit(EMMessageEvent.RECALLED, json); }, 0);
    },
    onMessageRecalledWithExt: (recallMessageInfo: RecallMessageInfo[]) => {
      const json = JSON.stringify(recallMessageInfo);
      setTimeout(() => { uni.$emit(EMMessageEvent.RECALLED, json); }, 0);
    },
    onMessageChanged: (message: Message, change: any) => {
      const json = JSON.stringify(message);
      setTimeout(() => { uni.$emit(EMMessageEvent.CONTENT_CHANGED, json); }, 0);
    },
    onReactionChanged: (messageReactionChangeList: MessageReactionChange[]) => {
      const json = JSON.stringify(messageReactionChangeList);
      setTimeout(() => { uni.$emit(EMMessageEvent.REACTION_CHANGED, json); }, 0);
    },
    onMessageContentChanged: (messageModified: Message, operatorId: string, operationTime: Long) => {
      const json = JSON.stringify(messageModified);
      setTimeout(() => { uni.$emit(EMMessageEvent.CONTENT_CHANGED, json); }, 0);
    },
    onMessagePinChanged: (messageId: string, conversationId: string, pinOperation: number, pinInfo: MessagePinInfo) => {
      setTimeout(() => { uni.$emit(EMMessageEvent.PIN_CHANGED, messageId); }, 0);
    }
  };

  const msgId = Date.now().toString() + Math.random().toString(36).substring(2, 11) + '_msg';
  messageListenerId = msgId;
  addMsgListenerImpl(msgId, messageCallbacks);

  eventBusEnabled = true;
  console.log('[Android] EventBus enabled');
}

/**
 * 禁用事件总线
 */
export function disableEventBus(): void {
  if (!eventBusEnabled) {
    return;
  }

  const connIdToRemove = connectionListenerId;
  if (connIdToRemove != null) {
    removeConnListenerImpl(connIdToRemove);
    connectionListenerId = null;
  }

  const msgIdToRemove = messageListenerId;
  if (msgIdToRemove != null) {
    removeMsgListenerImpl(msgIdToRemove);
    messageListenerId = null;
  }

  eventBusEnabled = false;
  console.log('[Android] EventBus disabled');
}
