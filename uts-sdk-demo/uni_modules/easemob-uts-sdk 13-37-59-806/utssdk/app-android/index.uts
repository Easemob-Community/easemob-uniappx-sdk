// ==================== 初始化 ====================

/**
 * 初始化 SDK
 */
export function initSDK(config: UTSJSONObject): Promise<void> {
  initEMClient(config["appKey"] as string);
  return Promise.resolve();
}

// ==================== 连接监听 ====================

/**
 * 添加连接状态监听
 */
export function addConnectionListener(
  onConnected: (() => void) | null,
  onDisconnected: ((errorCode: number) => void) | null,
  onLogout: ((errorCode: number) => void) | null,
  onTokenWillExpire: (() => void) | null,
  onTokenExpired: (() => void) | null,
  onOfflineMessageSyncStart: (() => void) | null,
  onOfflineMessageSyncFinish: (() => void) | null
): () => void {
  const id = Date.now().toString() + Math.random().toString(36).substring(2, 11);
  const cbs: ConnectionListenerCallbacks = {
    onConnected: onConnected,
    onDisconnected: onDisconnected,
    onLogout: onLogout,
    onTokenWillExpire: onTokenWillExpire,
    onTokenExpired: onTokenExpired,
    onOfflineMessageSyncStart: onOfflineMessageSyncStart,
    onOfflineMessageSyncFinish: onOfflineMessageSyncFinish
  };
  addConnListenerImpl(id, cbs);
  return () => removeConnListenerImpl(id);
}

/**
 * 移除连接状态监听
 */
export function removeConnectionListener(listenerId: string): void {
  removeConnListenerImpl(listenerId);
}

// ==================== 消息监听 ====================

/**
 * 订阅消息监听
 */
export function addMessageListener(
  onMessageReceived: ((messages: Message[]) => void) | null,
  onStreamMessageReceived: ((messages: Message[]) => void) | null,
  onCmdMessageReceived: ((messages: Message[]) => void) | null,
  onMessageRead: ((messages: Message[]) => void) | null,
  onGroupMessageRead: ((groupReadAcks: GroupReadAck[]) => void) | null,
  onReadAckForGroupMessageUpdated: (() => void) | null,
  onMessageDelivered: ((messages: Message[]) => void) | null,
  onMessageRecalled: ((messages: Message[]) => void) | null,
  onMessageRecalledWithExt: ((recallMessageInfo: RecallMessageInfo[]) => void) | null,
  onMessageChanged: ((message: Message, change: any) => void) | null,
  onReactionChanged: ((messageReactionChangeList: MessageReactionChange[]) => void) | null,
  onMessageContentChanged: ((messageModified: Message, operatorId: string, operationTime: Long) => void) | null,
  onMessagePinChanged: ((messageId: string, conversationId: string, pinOperation: number, pinInfo: MessagePinInfo) => void) | null
): () => void {
  const id = Date.now().toString() + Math.random().toString(36).substring(2, 11);
  const callbacks: MessageListenerCallbacks = {
    onMessageReceived: onMessageReceived,
    onStreamMessageReceived: onStreamMessageReceived,
    onCmdMessageReceived: onCmdMessageReceived,
    onMessageRead: onMessageRead,
    onGroupMessageRead: onGroupMessageRead,
    onReadAckForGroupMessageUpdated: onReadAckForGroupMessageUpdated,
    onMessageDelivered: onMessageDelivered,
    onMessageRecalled: onMessageRecalled,
    onMessageRecalledWithExt: onMessageRecalledWithExt,
    onMessageChanged: onMessageChanged,
    onReactionChanged: onReactionChanged,
    onMessageContentChanged: onMessageContentChanged,
    onMessagePinChanged: onMessagePinChanged
  };
  addMsgListenerImpl(id, callbacks);
  return () => removeMsgListenerImpl(id);
}

// ==================== 登录/登出 ====================

/**
 * 登录 SDK（使用用户名密码）
 */
export function loginSDK(
  userId: string,
  password: string,
  onSuccess: (() => void) | null,
  onError: ((code: number, message: string) => void) | null
): void {
  const callback = { onSuccess, onError } as UTSJSONObject;
  loginEMClient(userId, password, callback);
}

/**
 * 使用 Token 登录
 */
export function loginSDKWithToken(
  username: string,
  token: string,
  onSuccess: (() => void) | null,
  onError: ((code: number, message: string) => void) | null
): void {
  const callback = { onSuccess, onError } as UTSJSONObject;
  loginWithTokenImpl(username, token, callback);
}

/**
 * 使用 Agora Token 登录
 */
export function loginSDKWithAgoraToken(username: string, agoraToken: string, callback: UTSJSONObject): void {
  loginWithAgoraTokenImpl(username, agoraToken, callback);
}

/**
 * 同步登出 SDK
 */
export function logoutSDKSync(unbindToken: boolean): number {
  return logoutSyncImpl(unbindToken);
}

/**
 * 异步登出 SDK
 */
export function logoutSDK(
  unbindToken: boolean,
  onSuccess: (() => void) | null = null,
  onError: ((code: number, message: string) => void) | null = null
): void {
  const callback = { onSuccess, onError } as UTSJSONObject;
  logoutEMClient(unbindToken, callback);
}

// 状态查询函数（包装导出，uts-proxy 才能识别）
export function getCurrentUser(): string { return queryCurrentUser(); }
export function isLoggedInBefore(): boolean { return queryIsLoggedInBefore(); }
export function isConnected(): boolean { return queryIsConnected(); }
export function isLoggedIn(): boolean { return queryIsLoggedIn(); }

// ==================== 消息发送API ====================

/**
 * 发送文本消息（统一跨平台签名，接收独立回调参数）
 */
export function sendTextMessage(
  content: string,
  to: string,
  chatType: string,
  onSuccess: ((messageInfo: UTSJSONObject) => void) | null,
  onError: ((code: number, message: string) => void) | null,
  onProgress: ((progress: number, status: string) => void) | null = null,
  ext: UTSJSONObject | null = null
): void {
  const callback = new UTSJSONObject();
  callback['onSuccess'] = onSuccess;
  callback['onError'] = onError;
  if (onProgress != null) {
    callback['onProgress'] = onProgress;
  }
  sendTextMessageImpl(content, to, chatType, callback, ext);
}

