/**
 * 发送透传（命令）消息
 */
export function sendCmdMessageImpl(action: string, to: string, callback: UTSJSONObject, ext: UTSJSONObject | null = null): void {
	const callbackId = generateCallbackId();
	messageCallbacks.set(callbackId, callback);

	const message = EMMessage.createSendMessage(EMMessage.Type.CMD);
	message.setTo(to);
	const body = new EMCmdMessageBody(action);
	message.addBody(body);
	setMessageExt(message, ext);
	setMessageCallback(message, callbackId);
	EMClient.getInstance().chatManager().sendMessage(message);
}

/**
 * 发送自定义消息
 */
export function sendCustomMessageImpl(event: string, params: UTSJSONObject, to: string, chatType: string, callback: UTSJSONObject, ext: UTSJSONObject | null = null): void {
	const callbackId = generateCallbackId();
	messageCallbacks.set(callbackId, callback);

	const message = EMMessage.createSendMessage(EMMessage.Type.CUSTOM);
	message.setTo(to);

	const paramsJson = JSON.stringify(params);
	const customBody = createCustomMessageBody(event, paramsJson);

	message.addBody(customBody);
	setEMMessageChatType(message, chatType);
	setMessageExt(message, ext);
	setMessageCallback(message, callbackId);
	EMClient.getInstance().chatManager().sendMessage(message);
}

/**
 * 发送合并转发消息
 */
export function sendCombinedMessageImpl(title: string, summary: string, compatibleText: string, messageIdList: string[], to: string, callback: UTSJSONObject): void {
	const callbackId = generateCallbackId();
	messageCallbacks.set(callbackId, callback);

	const msgIdList = new java.util.ArrayList<string>();
	for (let i = 0; i < messageIdList.length; i++) {
		msgIdList.add(messageIdList[i]);
	}

	const message = EMMessage.createCombinedSendMessage(title, summary, compatibleText, msgIdList, to);
	setMessageCallback(message, callbackId);
	EMClient.getInstance().chatManager().sendMessage(message);
}

/**
 * 下载消息附件
 */
export function downloadAttachmentImpl(message: Message, callback: UTSJSONObject): void {
	const emMessage = EMClient.getInstance().chatManager().getMessage(message.msgId);
	if (emMessage != null) {
		const callbackId = generateCallbackId();
		messageCallbacks.set(callbackId, callback);
		setMessageCallback(emMessage, callbackId);
		EMClient.getInstance().chatManager().downloadAttachment(emMessage);
	}
}

/**
 * 下载消息缩略图
 */
export function downloadThumbnailImpl(message: Message, callback: UTSJSONObject): void {
	const emMessage = EMClient.getInstance().chatManager().getMessage(message.msgId);
	if (emMessage != null) {
		const callbackId = generateCallbackId();
		messageCallbacks.set(callbackId, callback);
		setMessageCallback(emMessage, callbackId);
		EMClient.getInstance().chatManager().downloadThumbnail(emMessage);
	}
}
