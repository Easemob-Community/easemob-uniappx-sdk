/**
 * iOS 平台 - 消息发送
 */

/** 轮询间隔（ms） */
const MSG_POLL_INTERVAL = 50;
/** 最大等待时间（ms） */
const MSG_POLL_TIMEOUT  = 15000;

/** 上次上报的进度跟踪（用于去重，避免重复上报相同值） */
let _lastProgressCid : string = '';
let _lastProgressVal : number = -1;

/** 生成唯一回调 ID */
function genCallbackId(): string {
  return Date.now().toString() + Math.random().toString(36).substring(2, 9);
}

/** 从 Bridge 读取成功结果并构建 UTSJSONObject（拆分子表达式，规避 Swift 类型推断超时） */
function buildSuccessMessageInfo(callbackId: string): UTSJSONObject {
  const msgId     : string = EMMessageBridge.getResultMsgId(callbackId = callbackId);
  const from      : string = EMMessageBridge.getResultFrom(callbackId = callbackId);
  const to        : string = EMMessageBridge.getResultTo(callbackId = callbackId);
  const type      : string = EMMessageBridge.getResultType(callbackId = callbackId);
  const chatType  : string = EMMessageBridge.getResultChatType(callbackId = callbackId);
  // getResultTimestamp 返回 Swift Int，不能直接赋给 number（NSNumber），改用 Int 接收
  const tsRaw   : Int    = EMMessageBridge.getResultTimestamp(callbackId = callbackId);
  const extJson : string = EMMessageBridge.getResultExtJson(callbackId = callbackId);
  EMMessageBridge.clearResult(callbackId = callbackId);
  // 先转字符串，再拼接，规避字符串拼接表达式类型推断超时
  const tsStr   : string = tsRaw.toString();
  const part1   : string = '{"msgId":"' + msgId + '","from":"' + from + '",';
  const part2   : string = '"to":"' + to + '","type":"' + type + '",';
  const part3   : string = '"chatType":"' + chatType + '","timestamp":';
  const infoStr : string = part1 + part2 + part3 + tsStr + ',"ext":' + extJson + '}';
  return JSON.parse(infoStr) as UTSJSONObject;
}

/** 从 Bridge 读取错误结果后触发 onError 回调 */
function handleErrorResult(
  callbackId: string,
  onError: ((code: number, message: string) => void) | null
): void {
  const codeRaw : Int    = EMMessageBridge.getResultCode(callbackId = callbackId);
  const msg     : string = EMMessageBridge.getResultMessage(callbackId = callbackId);
  EMMessageBridge.clearResult(callbackId = callbackId);
  if (onError != null) {
    onError!(codeRaw as number, msg);
  }
}

/**
 * 轮询 EMMessageBridge 结果（不含进度），用于文本/CMD/自定义等无附件消息
 */
function pollMessageResult(
  callbackId: string,
  onSuccess: ((messageInfo: UTSJSONObject) => void) | null,
  onError: ((code: number, message: string) => void) | null
): void {
  let elapsed : number = 0;
  let timer   : number = 0;
  timer = setInterval((): void => {
    elapsed += MSG_POLL_INTERVAL;
    const status : string = EMMessageBridge.getResultStatus(callbackId = callbackId);
    if (status == 'success') {
      clearInterval(timer);
      const info : UTSJSONObject = buildSuccessMessageInfo(callbackId);
      if (onSuccess != null) { onSuccess!(info); }
    } else if (status == 'error') {
      clearInterval(timer);
      handleErrorResult(callbackId, onError);
    } else if (elapsed >= MSG_POLL_TIMEOUT) {
      clearInterval(timer);
      EMMessageBridge.clearResult(callbackId = callbackId);
      if (onError != null) { onError!(408, 'Send message timeout'); }
    }
  }, MSG_POLL_INTERVAL);
}

/**
 * 从 Bridge 读取上传进度并上报（去重：仅在进度变化时回调，减少刷屏）
 * progressFn 为非空函数，调用方需在外部做 null 判断后传入 onProgress!
 */
function reportProgress(
  callbackId: string,
  progressFn: (progress: number, status: string) => void
): void {
  const pRaw : Int = EMMessageBridge.getResultProgress(callbackId = callbackId);
  if (pRaw < 0) { return; }
  const pNum : number = pRaw as number;
  if (callbackId == _lastProgressCid && pNum == _lastProgressVal) { return; }
  _lastProgressCid = callbackId;
  _lastProgressVal = pNum;
  progressFn(pNum, 'uploading');
}

/**
 * 发送完成时上报 100% 进度（拆出闭包，减少 Swift 类型推断压力）
 */
function reportFinalProgress(
  onProgress: ((progress: number, status: string) => void) | null
): void {
  if (onProgress != null) { onProgress!(100, 'complete'); }
  _lastProgressCid = '';
  _lastProgressVal = -1;
}

/**
 * 轮询 EMMessageBridge 结果（含上传进度），用于图片/视频等附件消息
 */
function pollMessageResultWithProgress(
  callbackId: string,
  onSuccess: ((messageInfo: UTSJSONObject) => void) | null,
  onError: ((code: number, message: string) => void) | null,
  onProgress: ((progress: number, status: string) => void) | null
): void {
  let elapsed : number = 0;
  let timer   : number = 0;
  timer = setInterval((): void => {
    elapsed += MSG_POLL_INTERVAL;
    const status : string = EMMessageBridge.getResultStatus(callbackId = callbackId);
    if (status == 'success') {
      clearInterval(timer);
      reportFinalProgress(onProgress);
      const info : UTSJSONObject = buildSuccessMessageInfo(callbackId);
      if (onSuccess != null) { onSuccess!(info); }
    } else if (status == 'error') {
      clearInterval(timer);
      handleErrorResult(callbackId, onError);
    } else if (elapsed >= MSG_POLL_TIMEOUT) {
      clearInterval(timer);
      EMMessageBridge.clearResult(callbackId = callbackId);
      if (onError != null) { onError!(408, 'Send message timeout'); }
    } else if (onProgress != null) {
      reportProgress(callbackId, onProgress!);
    }
  }, MSG_POLL_INTERVAL);
}

// 文件选择结果类型
export type FilePickResultData = {
  filePath: string;
  fileName: string;
  fileSize: number;
  mimeType: string;
}

/** 发送文本消息 */
export function sendTextMessageImpl(
  content: string, to: string, chatType: string,
  callback: UTSJSONObject, ext: UTSJSONObject | null
): void {
  console.log('[iOS][sender] sendTextMessage 进入, to=', to);
  const cid = genCallbackId();
  const extJson: string = ext != null ? (JSON.stringify(ext) ?? '') : '';
  // 在函数体顶层提取回调，规避 iOS 闭包内 UTSJSONObject 访问崩溃
  const onSuccess = callback["onSuccess"] as ((messageInfo: UTSJSONObject) => void) | null;
  const onError = callback["onError"] as ((code: number, message: string) => void) | null;
  // 将参数打包为单一 JSON 字符串，规避 UTS 调用 Swift 多具名参数崩溃
  const paramsObj = new UTSJSONObject();
  paramsObj['content']    = content;
  paramsObj['to']         = to;
  paramsObj['chatType']   = chatType;
  paramsObj['extJson']    = extJson;
  paramsObj['callbackId'] = cid;
  const paramsJson: string = JSON.stringify(paramsObj) ?? '{}';
  console.log('[iOS][sender] 调用 EMMessageBridge.sendTextMessage');
  EMMessageBridge.sendTextMessage(paramsJson = paramsJson);
  console.log('[iOS][sender] 调用完毕，开始轮询');
  pollMessageResult(cid, onSuccess, onError);
}

/** 发送图片消息 */
export function sendImageMessageImpl(
  filePath: string, sendOriginalImage: boolean, to: string,
  chatType: string, callback: UTSJSONObject, ext: UTSJSONObject | null
): void {
  console.log('[iOS][sender] sendImageMessage 进入, to=', to);
  const cid = genCallbackId();
  const extJson: string = ext != null ? (JSON.stringify(ext) ?? '') : '';
  const onSuccess = callback["onSuccess"] as ((messageInfo: UTSJSONObject) => void) | null;
  const onError = callback["onError"] as ((code: number, message: string) => void) | null;
  const onProgress = callback["onProgress"] as ((progress: number, status: string) => void) | null;
  const paramsObj = new UTSJSONObject();
  paramsObj['filePath']          = filePath;
  paramsObj['sendOriginalImage'] = sendOriginalImage;
  paramsObj['to']                = to;
  paramsObj['chatType']          = chatType;
  paramsObj['extJson']           = extJson;
  paramsObj['callbackId']        = cid;
  const paramsJson: string = JSON.stringify(paramsObj) ?? '{}';
  console.log('[iOS][sender] 调用 EMMessageBridge.sendImageMessage');
  EMMessageBridge.sendImageMessage(paramsJson = paramsJson);
  console.log('[iOS][sender] 图片消息发送完毕，开始轮询');
  pollMessageResultWithProgress(cid, onSuccess, onError, onProgress);
}

/** 发送视频消息 */
export function sendVideoMessageImpl(
  videoFilePath: string, imageThumbPath: string, timeLength: number,
  to: string, chatType: string, callback: UTSJSONObject
): void {
  console.log('[iOS][sender] sendVideoMessage 进入, to=', to);
  const cid = genCallbackId();
  const onSuccess = callback["onSuccess"] as ((messageInfo: UTSJSONObject) => void) | null;
  const onError = callback["onError"] as ((code: number, message: string) => void) | null;
  const onProgress = callback["onProgress"] as ((progress: number, status: string) => void) | null;
  const paramsObj = new UTSJSONObject();
  paramsObj['videoFilePath']  = videoFilePath;
  paramsObj['imageThumbPath'] = imageThumbPath;
  paramsObj['timeLength']     = timeLength;
  paramsObj['to']             = to;
  paramsObj['chatType']       = chatType;
  paramsObj['callbackId']     = cid;
  const paramsJson: string = JSON.stringify(paramsObj) ?? '{}';
  console.log('[iOS][sender] 调用 EMMessageBridge.sendVideoMessage');
  EMMessageBridge.sendVideoMessage(paramsJson = paramsJson);
  console.log('[iOS][sender] 视频消息发送完毕，开始轮询');
  pollMessageResultWithProgress(cid, onSuccess, onError, onProgress);
}

