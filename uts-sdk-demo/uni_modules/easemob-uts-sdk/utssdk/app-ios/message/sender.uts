/** 发送透传消息 */
export function sendCmdMessageImpl(
  action: string, to: string, callback: UTSJSONObject, ext: UTSJSONObject | null
): void {
  console.log('[iOS][sender] sendCmdMessage 进入, action=', action, 'to=', to);
  const cid = genCallbackId();
  const extJson: string = ext != null ? (JSON.stringify(ext) ?? '') : '';
  const onSuccess = callback["onSuccess"] as ((messageInfo: UTSJSONObject) => void) | null;
  const onError = callback["onError"] as ((code: number, message: string) => void) | null;
  // CMD 消息默认单聊（chatType=single）
  const paramsObj = new UTSJSONObject();
  paramsObj['action']     = action;
  paramsObj['to']         = to;
  paramsObj['chatType']   = 'single';
  paramsObj['extJson']    = extJson;
  paramsObj['callbackId'] = cid;
  const paramsJson: string = JSON.stringify(paramsObj) ?? '{}';
  console.log('[iOS][sender] 调用 EMMessageBridge.sendCmdMessage');
  EMMessageBridge.sendCmdMessage(paramsJson = paramsJson);
  console.log('[iOS][sender] CMD消息发送完毕，开始轮询');
  pollMessageResult(cid, onSuccess, onError);
}

/** 发送自定义消息 */
export function sendCustomMessageImpl(
  event: string, params: UTSJSONObject, to: string,
  chatType: string, callback: UTSJSONObject, ext: UTSJSONObject | null
): void {
  console.log('[iOS][sender] sendCustomMessage 进入, event=', event, 'to=', to);
  const cid = genCallbackId();
  const extJson: string = ext != null ? (JSON.stringify(ext) ?? '') : '';
  const customParamsJson: string = JSON.stringify(params) ?? '{}';
  const onSuccess = callback["onSuccess"] as ((messageInfo: UTSJSONObject) => void) | null;
  const onError = callback["onError"] as ((code: number, message: string) => void) | null;
  const paramsObj = new UTSJSONObject();
  paramsObj['event']        = event;
  paramsObj['customParams'] = customParamsJson;
  paramsObj['to']           = to;
  paramsObj['chatType']     = chatType;
  paramsObj['extJson']      = extJson;
  paramsObj['callbackId']   = cid;
  const paramsJson: string = JSON.stringify(paramsObj) ?? '{}';
  console.log('[iOS][sender] 调用 EMMessageBridge.sendCustomMessage');
  EMMessageBridge.sendCustomMessage(paramsJson = paramsJson);
  console.log('[iOS][sender] 自定义消息发送完毕，开始轮询');
  pollMessageResult(cid, onSuccess, onError);
}

