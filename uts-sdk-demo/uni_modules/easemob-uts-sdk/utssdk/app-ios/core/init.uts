/**
 * iOS 平台 - SDK初始化
 */

import { EMClient, EMOptions } from 'HyphenateChat';

export function initEMClient(appkey: string): void {
	const options = new EMOptions(appkey = appkey)
	options.isAutoLogin = false
	EMClient.shared().initializeSDK(with = options)
	console.log('[iOS] initSDK appKey:', appkey)
}
