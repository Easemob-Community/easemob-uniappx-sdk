/**
 * iOS 平台 - 连接监听
 *
 * 提供两种使用方式：
 *
 * 「方案 A」 addConnectionListenerImpl / addConnectionListenerIOS
 *   通过独立函数参数注册回调，适合在 UTS 插件层内部使用
 *
 * 「方案 B」 uni.$emit 事件广播（自动开启，无需手动注册）
 *   SDK 连接事件会自动广播到 uni 事件总线，在任意 .uvue 里直接 uni.$on 监听：
 *   - em_connected
 *   - em_disconnected       参数: { errorCode: number }
 *   - em_logout             参数: { errorCode: number }
 *   - em_token_will_expire  参数: { errorCode: number }
 *   - em_token_expired      参数: { errorCode: number }
 *   - em_offline_sync_start
 *   - em_offline_sync_finish
 */

import { EMClient, EMClientDelegate, EMConnectionState, EMError, EMErrorCode } from 'HyphenateChat';

/** 回调类型定义 */
export type ConnectionListenerCallbacks = {
  onConnected: (() => void) | null;
  onDisconnected: ((errorCode: number) => void) | null;
  onLogout: ((errorCode: number) => void) | null;
  onTokenWillExpire: (() => void) | null;
  onTokenExpired: (() => void) | null;
  onOfflineMessageSyncStart: (() => void) | null;
  onOfflineMessageSyncFinish: (() => void) | null;
};

/** 存储所有已注册的回调（方案 A） */
const callbackMap: Map<string, ConnectionListenerCallbacks> = new Map();

/** 是否已开启 uni.$emit 广播（方案 B） */
let autoEmitEnabled = false;

/**
 * 实现 EMClientDelegate，将事件分发给所有已注册的回调，并广播 uni 事件
 */
class EMConnectionDelegate implements EMClientDelegate {
  connectionStateDidChange(aConnectionState: EMConnectionState): void {
    if (aConnectionState == EMConnectionState.connected) {
      // 方案 A回调
      callbackMap.forEach((cbs: ConnectionListenerCallbacks, _id: string): void => {
        cbs.onConnected?.();
      });
      // 方案 B 广播
      if (autoEmitEnabled) {
        uni.$emit('em_connected');
      }
    } else {
      callbackMap.forEach((cbs: ConnectionListenerCallbacks, _id: string): void => {
        cbs.onDisconnected?.(0);
      });
      if (autoEmitEnabled) {
        uni.$emit('em_disconnected', { errorCode: 0 });
      }
    }
  }

  autoLoginDidCompleteWithError(aError: EMError | null): void {
    if (aError != null) {
      const code = aError!.code.rawValue as number;
      callbackMap.forEach((cbs: ConnectionListenerCallbacks, _id: string): void => {
        cbs.onLogout?.(code);
      });
      if (autoEmitEnabled) {
        uni.$emit('em_logout', { errorCode: code });
      }
    }
  }

  tokenWillExpire(aErrorCode: EMErrorCode): void {
    const code = aErrorCode.rawValue as number;
    callbackMap.forEach((cbs: ConnectionListenerCallbacks, _id: string): void => {
      cbs.onTokenWillExpire?.();
    });
    if (autoEmitEnabled) {
      uni.$emit('em_token_will_expire', { errorCode: code });
    }
  }

  tokenDidExpire(aErrorCode: EMErrorCode): void {
    const code = aErrorCode.rawValue as number;
    callbackMap.forEach((cbs: ConnectionListenerCallbacks, _id: string): void => {
      cbs.onTokenExpired?.();
    });
    if (autoEmitEnabled) {
      uni.$emit('em_token_expired', { errorCode: code });
    }
  }

  onOfflineMessageSyncStart(): void {
    callbackMap.forEach((cbs: ConnectionListenerCallbacks, _id: string): void => {
      cbs.onOfflineMessageSyncStart?.();
    });
    if (autoEmitEnabled) {
      uni.$emit('em_offline_sync_start');
    }
  }

  onOfflineMessageSyncFinish(): void {
    callbackMap.forEach((cbs: ConnectionListenerCallbacks, _id: string): void => {
      cbs.onOfflineMessageSyncFinish?.();
    });
    if (autoEmitEnabled) {
      uni.$emit('em_offline_sync_finish');
    }
  }
}

/** 全局唯一 delegate 实例 */
const connectionDelegate: EMConnectionDelegate = new EMConnectionDelegate();

/** delegate 是否已注册 */
let delegateRegistered = false;

/** 确保 delegate 已注册到 EMClient */
function ensureDelegateRegistered(): void {
  if (!delegateRegistered) {
    EMClient.shared().add(connectionDelegate, delegateQueue = null);
    delegateRegistered = true;
  }
}

/** 尝试注销 delegate（当没有任何订阅者时） */
function tryUnregisterDelegate(): void {
  if (delegateRegistered && callbackMap.size == 0 && !autoEmitEnabled) {
    EMClient.shared().removeDelegate(connectionDelegate);
    delegateRegistered = false;
  }
}

// ==================== 方案 A ====================

export function addConnectionListenerImpl(listenerId: string, listener: ConnectionListenerCallbacks): void {
  ensureDelegateRegistered();
  callbackMap.set(listenerId, listener);
  console.log('[iOS] addConnectionListener registered:', listenerId);
}

export function removeConnectionListenerImpl(listenerId: string): void {
  callbackMap.delete(listenerId);
  tryUnregisterDelegate();
  console.log('[iOS] removeConnectionListener:', listenerId);
}

export function removeAllConnectionListeners(): void {
  callbackMap.clear();
  tryUnregisterDelegate();
  console.log('[iOS] removeAllConnectionListeners');
}

// ==================== 方案 B ====================

export function enableConnectionEmit(): void {
  if (!autoEmitEnabled) {
    autoEmitEnabled = true;
    ensureDelegateRegistered();
    console.log('[iOS] connection uni.$emit enabled');
  }
}

export function disableConnectionEmit(): void {
  autoEmitEnabled = false;
  tryUnregisterDelegate();
  console.log('[iOS] connection uni.$emit disabled');
}
