/**
 * 环信 SDK 事件常量定义
 * 
 * 提供原子化事件和分类事件两种注册方式：
 * 
 * 【原子化事件】监听单一具体事件
 *   EMEventBus.on(EMEventName.Connection.CONNECTED, callback)
 * 
 * 【分类事件】监听某一类别的所有事件
 *   EMEventBus.onCategory(EMEventCategory.CONNECTION, callback)
 */

// ==================== 事件类别 ====================

export enum EMEventCategory {
  /** 连接相关事件 */
  CONNECTION = 'connection',
  /** 消息相关事件 */
  MESSAGE = 'message',
  /** 群组相关事件 */
  GROUP = 'group',
  /** 聊天室相关事件 */
  CHATROOM = 'chatroom',
  /** 联系人相关事件 */
  CONTACT = 'contact',
  /** 多端登录相关事件 */
  MULTI_DEVICE = 'multi_device',
  /** 在线状态相关事件 */
  PRESENCE = 'presence',
  /** 线程相关事件 */
  THREAD = 'thread',
  /** 用户属性相关事件 */
  USER_INFO = 'user_info'
}

// ==================== 连接事件 ====================

export class EMConnectionEvent {
  /** 连接成功 */
  static readonly CONNECTED = 'em:connection:connected';
  /** 连接断开 */
  static readonly DISCONNECTED = 'em:connection:disconnected';
  /** 被踢下线/登出 */
  static readonly LOGOUT = 'em:connection:logout';
  /** Token 即将过期 */
  static readonly TOKEN_WILL_EXPIRE = 'em:connection:token_will_expire';
  /** Token 已过期 */
  static readonly TOKEN_EXPIRED = 'em:connection:token_expired';
  /** 离线消息同步开始 */
  static readonly OFFLINE_SYNC_START = 'em:connection:offline_sync_start';
  /** 离线消息同步完成 */
  static readonly OFFLINE_SYNC_FINISH = 'em:connection:offline_sync_finish';

  /** 获取该类别所有事件名 */
  static getAllEvents(): string[] {
    return [
      EMConnectionEvent.CONNECTED,
      EMConnectionEvent.DISCONNECTED,
      EMConnectionEvent.LOGOUT,
      EMConnectionEvent.TOKEN_WILL_EXPIRE,
      EMConnectionEvent.TOKEN_EXPIRED,
      EMConnectionEvent.OFFLINE_SYNC_START,
      EMConnectionEvent.OFFLINE_SYNC_FINISH
    ];
  }
}

// ==================== 消息事件 ====================

export class EMMessageEvent {
  /** 收到普通消息 */
  static readonly RECEIVED = 'em:message:received';
  /** 收到 CMD 消息 */
  static readonly CMD_RECEIVED = 'em:message:cmd_received';
  /** 收到流式消息 */
  static readonly STREAM_RECEIVED = 'em:message:stream_received';
  /** 消息已读 */
  static readonly READ = 'em:message:read';
  /** 消息已送达 */
  static readonly DELIVERED = 'em:message:delivered';
  /** 消息被撤回 */
  static readonly RECALLED = 'em:message:recalled';
  /** 消息内容变更 */
  static readonly CONTENT_CHANGED = 'em:message:content_changed';
  /** 消息置顶变更 */
  static readonly PIN_CHANGED = 'em:message:pin_changed';
  /** 群组消息已读回执 */
  static readonly GROUP_READ = 'em:message:group_read';
  /** 群组消息已读回执更新 */
  static readonly GROUP_READ_ACK_UPDATED = 'em:message:group_read_ack_updated';
  /** Reaction 变更 */
  static readonly REACTION_CHANGED = 'em:message:reaction_changed';

  /** 获取该类别所有事件名 */
  static getAllEvents(): string[] {
    return [
      EMMessageEvent.RECEIVED,
      EMMessageEvent.CMD_RECEIVED,
      EMMessageEvent.STREAM_RECEIVED,
      EMMessageEvent.READ,
      EMMessageEvent.DELIVERED,
      EMMessageEvent.RECALLED,
      EMMessageEvent.CONTENT_CHANGED,
      EMMessageEvent.PIN_CHANGED,
      EMMessageEvent.GROUP_READ,
      EMMessageEvent.GROUP_READ_ACK_UPDATED,
      EMMessageEvent.REACTION_CHANGED
    ];
  }
}

// ==================== 群组事件 ====================

export class EMGroupEvent {
  /** 被邀请加入群组 */
  static readonly INVITATION_RECEIVED = 'em:group:invitation_received';
  /** 群组邀请被接受 */
  static readonly INVITATION_ACCEPTED = 'em:group:invitation_accepted';
  /** 群组邀请被拒绝 */
  static readonly INVITATION_DECLINED = 'em:group:invitation_declined';
  /** 被移出群组 */
  static readonly REMOVED = 'em:group:removed';
  /** 群组被销毁 */
  static readonly DESTROYED = 'em:group:destroyed';
  /** 群成员加入 */
  static readonly MEMBER_JOINED = 'em:group:member_joined';
  /** 群成员离开 */
  static readonly MEMBER_EXITED = 'em:group:member_exited';
  /** 群成员被踢出 */
  static readonly MEMBER_KICKED = 'em:group:member_kicked';
  /** 群组信息变更 */
  static readonly INFO_CHANGED = 'em:group:info_changed';
  /** 群共享文件新增 */
  static readonly SHARED_FILE_ADDED = 'em:group:shared_file_added';
  /** 群共享文件删除 */
  static readonly SHARED_FILE_DELETED = 'em:group:shared_file_deleted';
  /** 群禁言状态变更 */
  static readonly MUTE_STATE_CHANGED = 'em:group:mute_state_changed';
  /** 群管理员新增 */
  static readonly ADMIN_ADDED = 'em:group:admin_added';
  /** 群管理员移除 */
  static readonly ADMIN_REMOVED = 'em:group:admin_removed';
  /** 群所有者变更 */
  static readonly OWNER_CHANGED = 'em:group:owner_changed';
  /** 群公告变更 */
  static readonly ANNOUNCEMENT_CHANGED = 'em:group:announcement_changed';

  /** 获取该类别所有事件名 */
  static getAllEvents(): string[] {
    return [
      EMGroupEvent.INVITATION_RECEIVED,
      EMGroupEvent.INVITATION_ACCEPTED,
      EMGroupEvent.INVITATION_DECLINED,
      EMGroupEvent.REMOVED,
      EMGroupEvent.DESTROYED,
      EMGroupEvent.MEMBER_JOINED,
      EMGroupEvent.MEMBER_EXITED,
      EMGroupEvent.MEMBER_KICKED,
      EMGroupEvent.INFO_CHANGED,
      EMGroupEvent.SHARED_FILE_ADDED,
      EMGroupEvent.SHARED_FILE_DELETED,
      EMGroupEvent.MUTE_STATE_CHANGED,
      EMGroupEvent.ADMIN_ADDED,
      EMGroupEvent.ADMIN_REMOVED,
      EMGroupEvent.OWNER_CHANGED,
      EMGroupEvent.ANNOUNCEMENT_CHANGED
    ];
  }
}

// ==================== 聊天室事件 ====================

export class EMChatroomEvent {
  /** 被踢出聊天室 */
  static readonly KICKED = 'em:chatroom:kicked';
  /** 聊天室被销毁 */
  static readonly DESTROYED = 'em:chatroom:destroyed';
  /** 聊天室成员加入 */
  static readonly MEMBER_JOINED = 'em:chatroom:member_joined';
  /** 聊天室成员离开 */
  static readonly MEMBER_EXITED = 'em:chatroom:member_exited';
  /** 聊天室成员被禁言 */
  static readonly MEMBER_MUTED = 'em:chatroom:member_muted';
  /** 聊天室成员被解除禁言 */
  static readonly MEMBER_UNMUTED = 'em:chatroom:member_unmuted';
  /** 聊天室成员被踢出 */
  static readonly MEMBER_KICKED = 'em:chatroom:member_kicked';
  /** 聊天室公告变更 */
  static readonly ANNOUNCEMENT_CHANGED = 'em:chatroom:announcement_changed';
  /** 聊天室信息变更 */
  static readonly INFO_CHANGED = 'em:chatroom:info_changed';
  /** 聊天室属性变更 */
  static readonly ATTRIBUTES_UPDATED = 'em:chatroom:attributes_updated';
  /** 聊天室属性被移除 */
  static readonly ATTRIBUTES_REMOVED = 'em:chatroom:attributes_removed';

  /** 获取该类别所有事件名 */
  static getAllEvents(): string[] {
    return [
      EMChatroomEvent.KICKED,
      EMChatroomEvent.DESTROYED,
      EMChatroomEvent.MEMBER_JOINED,
      EMChatroomEvent.MEMBER_EXITED,
      EMChatroomEvent.MEMBER_MUTED,
      EMChatroomEvent.MEMBER_UNMUTED,
      EMChatroomEvent.MEMBER_KICKED,
      EMChatroomEvent.ANNOUNCEMENT_CHANGED,
      EMChatroomEvent.INFO_CHANGED,
      EMChatroomEvent.ATTRIBUTES_UPDATED,
      EMChatroomEvent.ATTRIBUTES_REMOVED
    ];
  }
}

// ==================== 联系人事件 ====================

export class EMContactEvent {
  /** 收到好友申请 */
  static readonly INVITATION_RECEIVED = 'em:contact:invitation_received';
  /** 好友申请被接受 */
  static readonly INVITATION_ACCEPTED = 'em:contact:invitation_accepted';
  /** 好友申请被拒绝 */
  static readonly INVITATION_DECLINED = 'em:contact:invitation_declined';
  /** 被删除好友 */
  static readonly DELETED = 'em:contact:deleted';
  /** 好友备注变更 */
  static readonly REMARK_CHANGED = 'em:contact:remark_changed';

  /** 获取该类别所有事件名 */
  static getAllEvents(): string[] {
    return [
      EMContactEvent.INVITATION_RECEIVED,
      EMContactEvent.INVITATION_ACCEPTED,
      EMContactEvent.INVITATION_DECLINED,
      EMContactEvent.DELETED,
      EMContactEvent.REMARK_CHANGED
    ];
  }
}

// ==================== 多端登录事件 ====================

export class EMMultiDeviceEvent {
  /** 其他设备登录 */
  static readonly LOGGED_IN = 'em:multi_device:logged_in';
  /** 其他设备登出 */
  static readonly LOGGED_OUT = 'em:multi_device:logged_out';
  /** 其他设备删除会话 */
  static readonly CONVERSATION_DELETED = 'em:multi_device:conversation_deleted';
  /** 其他设备清空会话消息 */
  static readonly CONVERSATION_CLEANED = 'em:multi_device:conversation_cleaned';

  /** 获取该类别所有事件名 */
  static getAllEvents(): string[] {
    return [
      EMMultiDeviceEvent.LOGGED_IN,
      EMMultiDeviceEvent.LOGGED_OUT,
      EMMultiDeviceEvent.CONVERSATION_DELETED,
      EMMultiDeviceEvent.CONVERSATION_CLEANED
    ];
  }
}

// ==================== 在线状态事件 ====================

export class EMPresenceEvent {
  /** 订阅的在线状态变更 */
  static readonly UPDATED = 'em:presence:updated';

  /** 获取该类别所有事件名 */
  static getAllEvents(): string[] {
    return [
      EMPresenceEvent.UPDATED
    ];
  }
}

// ==================== 线程事件 ====================

export class EMThreadEvent {
  /** 线程创建 */
  static readonly CREATED = 'em:thread:created';
  /** 线程更新 */
  static readonly UPDATED = 'em:thread:updated';
  /** 线程销毁 */
  static readonly DESTROYED = 'em:thread:destroyed';
  /** 用户被踢出线程 */
  static readonly USER_KICKED = 'em:thread:user_kicked';

  /** 获取该类别所有事件名 */
  static getAllEvents(): string[] {
    return [
      EMThreadEvent.CREATED,
      EMThreadEvent.UPDATED,
      EMThreadEvent.DESTROYED,
      EMThreadEvent.USER_KICKED
    ];
  }
}

// ==================== 用户属性事件 ====================

export class EMUserInfoEvent {
  /** 用户属性变更 */
  static readonly UPDATED = 'em:user_info:updated';

  /** 获取该类别所有事件名 */
  static getAllEvents(): string[] {
    return [
      EMUserInfoEvent.UPDATED
    ];
  }
}

