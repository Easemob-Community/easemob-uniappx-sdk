 * @param to 接收方
 * @param callback 发送回调
 */
export function sendCombinedMessage(title: string, summary: string, compatibleText: string, messageIdList: string[], to: string, callback: UTSJSONObject): void {
  sendCombinedMessageImpl(title, summary, compatibleText, messageIdList, to, callback);
}