 * @param callback 发送回调
 */
export function sendLocationMessage(latitude: Double, longitude: Double, locationAddress: string, buildingName: string, to: string, callback: UTSJSONObject): void {
  sendLocationMessageImpl(latitude, longitude, locationAddress, buildingName, to, callback);
}

/**
 * 发送位置消息（不含建筑物名称）
