 * @param ext 扩展属性（可选）
 */
export function sendCmdMessage(action: string, to: string, callback: UTSJSONObject, ext: UTSJSONObject | null = null): void {
  sendCmdMessageImpl(action, to, callback, ext);
}

/**
 * 发送自定义消息
