// ==================== 导出类型 ====================

export {
  ConnectionListenerCallbacks,
  MessageListenerCallbacks,
  Message,
  MessageType,
  MessageTypeValues,
  MessageBody,
  GroupReadAck,
  RecallMessageInfo,
  MessageReactionChange,
  MessagePinInfo
};

// ==================== 初始化 ====================

/**
 * 初始化 SDK
 */
export function initSDK(config: UTSJSONObject): Promise<void> {
  initEMClient(config["appKey"] as string);
  return Promise.resolve();
}

// ==================== 连接监听 ====================

/**
 * 添加连接状态监听
 */
export function addConnectionListener(listener: UTSJSONObject): () => void {
  const id = Date.now().toString() + Math.random().toString(36).substring(2, 11);
  addConnListenerImpl(id, listener);
  return () => removeConnListenerImpl(id);
}

/**
 * 移除连接状态监听
 */
export function removeConnectionListener(listenerId: string): void {
  removeConnListenerImpl(listenerId);
}

// ==================== 消息监听 ====================

/**
 * 订阅消息监听
 */
export function addMessageListener(listener: UTSJSONObject): () => void {
  const id = Date.now().toString() + Math.random().toString(36).substring(2, 11);
  const callbacks: MessageListenerCallbacks = {
    onMessageReceived: listener["onMessageReceived"] as ((messages: Message[]) => void) | null,
    onStreamMessageReceived: listener["onStreamMessageReceived"] as ((messages: Message[]) => void) | null,
    onCmdMessageReceived: listener["onCmdMessageReceived"] as ((messages: Message[]) => void) | null,
    onMessageRead: listener["onMessageRead"] as ((messages: Message[]) => void) | null,
    onGroupMessageRead: listener["onGroupMessageRead"] as ((groupReadAcks: GroupReadAck[]) => void) | null,
    onReadAckForGroupMessageUpdated: listener["onReadAckForGroupMessageUpdated"] as (() => void) | null,
    onMessageDelivered: listener["onMessageDelivered"] as ((messages: Message[]) => void) | null,
    onMessageRecalled: listener["onMessageRecalled"] as ((messages: Message[]) => void) | null,
    onMessageRecalledWithExt: listener["onMessageRecalledWithExt"] as ((recallMessageInfo: RecallMessageInfo[]) => void) | null,
    onMessageChanged: listener["onMessageChanged"] as ((message: Message, change: any) => void) | null,
    onReactionChanged: listener["onReactionChanged"] as ((messageReactionChangeList: MessageReactionChange[]) => void) | null,
    onMessageContentChanged: listener["onMessageContentChanged"] as ((messageModified: Message, operatorId: string, operationTime: Long) => void) | null,
    onMessagePinChanged: listener["onMessagePinChanged"] as ((messageId: string, conversationId: string, pinOperation: number, pinInfo: MessagePinInfo) => void) | null
  };
  addMsgListenerImpl(id, callbacks);
  return () => removeMsgListenerImpl(id);
}

// ==================== 登录/登出 ====================

/**
 * 登录 SDK（使用用户名密码）
 */
export function loginSDK(userId: string, password: string, callback: UTSJSONObject): void {
  loginEMClient(userId, password, callback);
}

/**
 * 使用 Token 登录
 */
export function loginSDKWithToken(username: string, token: string, callback: UTSJSONObject): void {
  loginWithTokenImpl(username, token, callback);
}

/**
 * 使用 Agora Token 登录
 */
export function loginSDKWithAgoraToken(username: string, agoraToken: string, callback: UTSJSONObject): void {
  loginWithAgoraTokenImpl(username, agoraToken, callback);
}

/**
 * 同步登出 SDK
 */
export function logoutSDKSync(unbindToken: boolean): number {
  return logoutSyncImpl(unbindToken);
}

/**
 * 异步登出 SDK
 */
export function logoutSDK(unbindToken: boolean, callback: UTSJSONObject = {} as UTSJSONObject): void {
  logoutEMClient(unbindToken, callback);
}

// 导出状态查询函数
export { getCurrentUser, isLoggedInBefore, isConnected, isLoggedIn };

