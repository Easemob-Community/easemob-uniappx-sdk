 * @param timeLength 视频时长（秒）
 * @param to 接收方
 * @param callback 发送回调
 */
export function sendVideoMessage(videoFilePath: string, imageThumbPath: string, timeLength: Int, to: string, callback: UTSJSONObject): void {
  sendVideoMessageImpl(videoFilePath, imageThumbPath, timeLength, to, callback);
}

/**
