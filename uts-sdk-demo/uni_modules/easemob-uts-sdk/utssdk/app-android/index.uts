/**
 * Android 平台实现入口
 */

import { initEMClient } from './apis/modules/init.uts';
import {
  addConnectionListenerImpl as addConnListenerImpl,
  removeConnectionListenerImpl as removeConnListenerImpl
} from './apis/connection.uts';
import {
  addMessageListenerImpl as addMsgListenerImpl,
  removeMessageListenerImpl as removeMsgListenerImpl
} from './apis/message.uts';
import {
  loginEMClient,
  loginWithToken as loginWithTokenImpl,
  loginWithAgoraToken as loginWithAgoraTokenImpl,
  logoutSync as logoutSyncImpl,
  logoutEMClient
} from './apis/modules/login.uts';

// 直接从 login.uts 导出状态查询函数
export { getCurrentUser, isLoggedInBefore, isConnected, isLoggedIn } from './apis/modules/login.uts';

/**
 * 初始化 SDK
 */
export function initSDK(config: UTSJSONObject): Promise<void> {
  initEMClient(config["appKey"] as string);
  return Promise.resolve();
}

/**
 * 添加连接状态监听
 * @param listener 监听器回调
 * @returns 取消订阅函数
 */
export function addConnectionListener(listener: UTSJSONObject): () => void {
  const id = Date.now().toString() + Math.random().toString(36).substring(2, 11);
  addConnListenerImpl(id, listener);
  
  // 返回取消订阅函数
  return () => removeConnListenerImpl(id);
}

/**
 * 移除连接状态监听
 * @param listenerId 监听器 ID
 */
export function removeConnectionListener(listenerId: string): void {
  removeConnListenerImpl(listenerId);
}

/**
 * 订阅消息监听
 * @param listener 监听器回调
 * @returns 取消订阅函数
 */
export function addMessageListener(listener: UTSJSONObject): () => void {
  const id = Date.now().toString() + Math.random().toString(36).substring(2, 11);
  addMsgListenerImpl(id, listener);

  // 返回取消订阅函数
  return () => removeMsgListenerImpl(id);
}

// 导出连接监听相关类型和函数
export { removeAllConnectionListeners, ConnectionListenerCallbacks } from './apis/connection.uts';

// 导出消息监听相关类型和函数
export { removeAllMessageListeners, MessageListenerCallbacks, Message, MessageType, MessageTypeValues } from './apis/message.uts';

/**
 * 登录 SDK（使用用户名密码）
 * @param userId 用户ID
 * @param password 密码
 * @param callback 登录回调
 */
export function loginSDK(userId: string, password: string, callback: UTSJSONObject): void {
  loginEMClient(userId, password, callback);
}

/**
 * 使用 Token 登录
 * @param username 用户ID
 * @param token Token
 * @param callback 登录回调
 */
export function loginSDKWithToken(username: string, token: string, callback: UTSJSONObject): void {
  loginWithTokenImpl(username, token, callback);
}

/**
 * 使用 Agora Token 登录
 * @param username 用户ID
 * @param agoraToken Agora Token
 * @param callback 登录回调
 */
export function loginSDKWithAgoraToken(username: string, agoraToken: string, callback: UTSJSONObject): void {
  loginWithAgoraTokenImpl(username, agoraToken, callback);
}

/**
 * 同步登出 SDK
 * @param unbindToken 是否解绑 Token
 * @return 错误码
 */
export function logoutSDKSync(unbindToken: boolean): number {
  return logoutSyncImpl(unbindToken);
}

/**
 * 异步登出 SDK
 * @param unbindToken 是否解绑 Token
 * @param callback 登出回调（传空对象表示无回调）
 */
export function logoutSDK(unbindToken: boolean, callback: UTSJSONObject = {} as UTSJSONObject): void {
  logoutEMClient(unbindToken, callback);
}