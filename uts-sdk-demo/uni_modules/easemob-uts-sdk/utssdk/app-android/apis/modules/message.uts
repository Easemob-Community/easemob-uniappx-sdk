 */
export function sendImageMessageImpl(filePath: string, sendOriginalImage: boolean, to: string, chatType: string, callback: UTSJSONObject): void {
	const callbackId = generateCallbackId();
	messageCallbacks.set(callbackId, callback);

	const message = EMMessage.createImageSendMessage(filePath, sendOriginalImage, to);
	setEMMessageChatType(message, chatType);
	setMessageCallback(message, callbackId);
	EMClient.getInstance().chatManager().sendMessage(message);
}

