/**
 * 消息发送 - 内部实现
 * 封装不同类型的消息发送API
 * 使用Kotlin混编解决synchronized方法调用问题
 */

import EMClient from 'com.hyphenate.chat.EMClient';
import EMMessage from 'com.hyphenate.chat.EMMessage';
import EMCallBack from 'com.hyphenate.EMCallBack';
import EMCmdMessageBody from 'com.hyphenate.chat.EMCmdMessageBody';
import EMMessageChatType from 'com.hyphenate.chat.EMMessage.ChatType';
import Uri from 'android.net.Uri';
import { Message } from './listeners/message-listener.uts';

// 导入Kotlin辅助类（用于解决synchronized方法调用问题）
import { MessageHelper } from 'uts.sdk.modules.easemobUtsSdk';

// 消息发送回调映射表
const messageCallbacks: Map<string, UTSJSONObject> = new Map();

/**
 * 生成唯一回调ID
 */
function generateCallbackId(): string {
	return Date.now().toString() + Math.random().toString(36).substring(2, 11);
}

/**
 * 消息信息接口 - 前端友好的消息结构
 * 对应 Kotlin 层的 MessageInfo 数据类
 */
export interface MessageInfo {
	msgId: string;
	from: string;
	to: string;
	type: string;
	chatType: string;
	timestamp: number;
}

/**
 * 消息发送回调实现类
 * 支持在成功回调中返回前端友好的 MessageInfo 对象
 */
class MessageSendCallBack extends EMCallBack {
	private callbackId: string;
	private message: EMMessage | null = null;

	constructor(callbackId: string, message: EMMessage | null = null) {
		super();
		this.callbackId = callbackId;
		this.message = message;
	}

	override onError(code: Int, message: string): void {
		const callback = messageCallbacks.get(this.callbackId);
		if (callback != null) {
			const onError = callback["onError"];
			if (onError != null) {
				(onError as (code: number, message: string) => void)(code, message);
			}
			messageCallbacks.delete(this.callbackId);
		}
		console.log('[EMMessage] 消息发送失败, code:', code, 'message:', message);
	}

	override onProgress(progress: Int, status: string): void {
		const callback = messageCallbacks.get(this.callbackId);
		if (callback != null) {
			const onProgress = callback["onProgress"];
			if (onProgress != null) {
				(onProgress as (progress: number, status: string) => void)(progress, status);
			}
		}
	}

	override onSuccess(): void {
		const callback = messageCallbacks.get(this.callbackId);
		if (callback != null) {
			const onSuccess = callback["onSuccess"];
			const msg = this.message;
			if (onSuccess != null && msg != null) {
				// 构造 UTSJSONObject 对象
				const messageInfo = new UTSJSONObject();
				messageInfo['msgId'] = msg.getMsgId();
				messageInfo['from'] = msg.getFrom();
				messageInfo['to'] = msg.getTo();
				messageInfo['type'] = msg.getType().name;
				const chatType = msg.getChatType();
				if (chatType == EMMessageChatType.GroupChat) {
					messageInfo['chatType'] = 'group';
				} else if (chatType == EMMessageChatType.ChatRoom) {
					messageInfo['chatType'] = 'chatroom';
				} else {
					messageInfo['chatType'] = 'single';
				}
				messageInfo['timestamp'] = msg.getMsgTime();
				(onSuccess as (messageInfo: UTSJSONObject) => void)(messageInfo);
			}
			messageCallbacks.delete(this.callbackId);
		}
		const msg = this.message;
		console.log('[EMMessage] 消息发送成功, ID:', msg != null ? msg.getMsgId() : 'unknown');
	}
}

/**
 * 设置消息回调（通过Kotlin辅助类）
 * 使用 MessageHelper.setMessageStatusCallback 设置回调
 * 在回调中构造前端友好的 MessageInfo 对象
 */
function setMessageCallback(message: EMMessage, callbackId: string): void {
	const callback = new MessageSendCallBack(callbackId, message);
	MessageHelper.setMessageStatusCallback(message, callback);
}

/**
 * 设置消息的聊天类型
 */
function setEMMessageChatType(message: EMMessage, chatType: string): void {
	if (chatType === 'group') {
		message.setChatType(EMMessageChatType.GroupChat);
	} else if (chatType === 'chatroom') {
		message.setChatType(EMMessageChatType.ChatRoom);
	} else {
		message.setChatType(EMMessageChatType.Chat);
	}
}

/**
 * 发送文本消息
 * @param content 文本内容
 * @param to 接收方（用户ID、群组ID或聊天室ID）
 * @param chatType 聊天类型：'single'-单聊, 'group'-群聊, 'chatroom'-聊天室
 * @param callback 发送回调
 */
export function sendTextMessageImpl(content: string, to: string, chatType: string, callback: UTSJSONObject): void {
	const callbackId = generateCallbackId();
	messageCallbacks.set(callbackId, callback);

	const message = EMMessage.createTxtSendMessage(content, to);
	setEMMessageChatType(message, chatType);
	setMessageCallback(message, callbackId);
	EMClient.getInstance().chatManager().sendMessage(message);
}

