import {
	addMessageListenerImpl as addMsgListenerInternal,
	removeMessageListenerImpl as removeMsgListenerInternal,
	removeAllMessageListeners,
	MessageListenerCallbacks,
	Message,
	MessageType,
	MessageTypeValues,
	MessageBody,
	GroupReadAck,
	RecallMessageInfo,
	MessageReactionChange,
	MessagePinInfo
} from './modules/listeners/message-listener.uts';

// 消息发送API
import {
	sendTextMessageImpl as sendTextMsgInternal,
	sendImageMessageImpl as sendImageMsgInternal,
	sendImageMessageWithUriImpl as sendImageMsgWithUriInternal,
	sendGifImageMessageImpl as sendGifImageMsgInternal,
	sendVoiceMessageImpl as sendVoiceMsgInternal,
	sendVoiceMessageWithUriImpl as sendVoiceMsgWithUriInternal,
	sendVideoMessageImpl as sendVideoMsgInternal,
	sendVideoMessageWithUriImpl as sendVideoMsgWithUriInternal,
	sendVideoMessageWithUrisImpl as sendVideoMsgWithUrisInternal,
	sendLocationMessageImpl as sendLocationMsgInternal,
	sendLocationMessageSimpleImpl as sendLocationMsgSimpleInternal,
	sendFileMessageImpl as sendFileMsgInternal,
	sendFileMessageWithUriImpl as sendFileMsgWithUriInternal,
	sendCmdMessageImpl as sendCmdMsgInternal,
	sendCustomMessageImpl as sendCustomMsgInternal,
	sendCombinedMessageImpl as sendCombinedMsgInternal,
	downloadAttachmentImpl,
	downloadThumbnailImpl
} from './modules/message.uts';

// 重新导出类型
export {
	removeAllMessageListeners,
	MessageListenerCallbacks,
	Message,
	MessageType,
	MessageTypeValues,
	MessageBody,
	GroupReadAck,
	RecallMessageInfo,
	MessageReactionChange,
	MessagePinInfo
};

/**
 * 添加消息监听
 * @param listenerId 监听器唯一标识（用于移除）
 * @param listener 监听器回调对象（UTSJSONObject）
 */
export function addMessageListenerImpl(listenerId : string, listener : UTSJSONObject) : void {
	const callbacks : MessageListenerCallbacks = {
		onMessageReceived: listener["onMessageReceived"] as ((messages : Message[]) => void) | null,
		onStreamMessageReceived: listener["onStreamMessageReceived"] as ((messages : Message[]) => void) | null,
		onCmdMessageReceived: listener["onCmdMessageReceived"] as ((messages : Message[]) => void) | null,
		onMessageRead: listener["onMessageRead"] as ((messages : Message[]) => void) | null,
		onGroupMessageRead: listener["onGroupMessageRead"] as ((groupReadAcks : GroupReadAck[]) => void) | null,
		onReadAckForGroupMessageUpdated: listener["onReadAckForGroupMessageUpdated"] as (() => void) | null,
		onMessageDelivered: listener["onMessageDelivered"] as ((messages : Message[]) => void) | null,
		onMessageRecalled: listener["onMessageRecalled"] as ((messages : Message[]) => void) | null,
		onMessageRecalledWithExt: listener["onMessageRecalledWithExt"] as ((recallMessageInfo : RecallMessageInfo[]) => void) | null,
		onMessageChanged: listener["onMessageChanged"] as ((message : Message, change : any) => void) | null,
		onReactionChanged: listener["onReactionChanged"] as ((messageReactionChangeList : MessageReactionChange[]) => void) | null,
		onMessageContentChanged: listener["onMessageContentChanged"] as ((messageModified : Message, operatorId : string, operationTime : Long) => void) | null,
		onMessagePinChanged: listener["onMessagePinChanged"] as ((messageId : string, conversationId : string, pinOperation : number, pinInfo : MessagePinInfo) => void) | null
	};

	addMsgListenerInternal(listenerId, callbacks);
}

/**
 * 移除消息监听
 * @param listenerId 监听器唯一标识
 */
export function removeMessageListenerImpl(listenerId : string) : void {
	removeMsgListenerInternal(listenerId);
}

/**
 * 移除所有消息监听器
 */
export function clearAllMessageListeners() : void {
	removeAllMessageListeners();
}

// ==================== 消息发送API ====================

/**
 * 发送文本消息
 * @param content 文本内容
 * @param to 接收方（用户ID、群组ID或聊天室ID）
 * @param chatType 聊天类型：'single'-单聊, 'group'-群聊, 'chatroom'-聊天室
 * @param callback 发送回调 { onSuccess, onError, onProgress }
 * @param ext 扩展属性（可选）
 */
export function sendTextMessageImpl(content: string, to: string, chatType: string, callback: UTSJSONObject, ext: UTSJSONObject | null = null): void {
	sendTextMsgInternal(content, to, chatType, callback, ext);
}

/**
 * 发送图片消息（使用文件路径）
 * @param filePath 图片文件路径
 * @param sendOriginalImage 是否发送原图
 * @param to 接收方
 * @param chatType 聊天类型
 * @param callback 发送回调
 * @param ext 扩展属性（可选）
 */
export function sendImageMessageImpl(filePath: string, sendOriginalImage: boolean, to: string, chatType: string, callback: UTSJSONObject, ext: UTSJSONObject | null = null): void {
	sendImageMsgInternal(filePath, sendOriginalImage, to, chatType, callback, ext);
}

/**
 * 发送图片消息（使用Uri）
 */
export function sendImageMessageWithUriImpl(imageUri: Uri, sendOriginalImage: boolean, to: string, callback: UTSJSONObject): void {
	sendImageMsgWithUriInternal(imageUri, sendOriginalImage, to, callback);
}

