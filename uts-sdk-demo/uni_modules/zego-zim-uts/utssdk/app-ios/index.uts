/**
 * 1、@argumentLabel('') 不能去掉，否则会导致 event 失效
 * 2、有多个空标签参数时，参数名不能更改，否则会导致 event 失效
 */
@UTSiOS.keyword("fileprivate")
class ZIMEventHandlerImpl implements NZIMEventHandler {

    @UTSJS.keepAlive
    eventMap = {} as ZIMEventHandler;
    
    // MARK: - Main

    zim(zim : NZIM, @argumentLabel('') errorInfo : NZIMError) : void {
        this.eventMap.onError?.({ code: errorInfo.code.rawValue, message: errorInfo.message });
    }

    zim(zim : NZIM, @argumentLabel('connectionStateChanged') state : NZIMConnectionState,
        @argumentLabel('') event : NZIMConnectionEvent,
        @argumentLabel('') extendedData : UTSJSONObject
    ) : void {
        this.eventMap.onConnectionStateChanged?.({ state: state.rawValue, event: event.rawValue, extendedData });
    }

    zim(zim : NZIM, @argumentLabel('tokenWillExpire') second : UInt32) : void {
        this.eventMap.onTokenWillExpire?.({ second: Number.from(second) });
    }

    zim(zim : NZIM, @argumentLabel('userInfoUpdated') info : NZIMUserFullInfo) : void {
        this.eventMap.onUserInfoUpdated?.({ info: mZIMUserFullInfo(info) });
    }

    zim(zim : NZIM, @argumentLabel('userRuleUpdated') info : NZIMUserRule) : void {
        this.eventMap.onUserRuleUpdated?.({ userRule: { offlinePushRule: mZIMUserOfflinePushRule(info.offlinePushRule) } });
    }

    zim(zim : NZIM, @argumentLabel('userStatusUpdated') infos : Array<NZIMUserStatus>) : void {
        this.eventMap.onUserStatusUpdated?.({ userStatusList: mZIMUserStatusList(infos) });
    }

    // MARK: - Conversation

    zim(zim : NZIM, @argumentLabel('conversationChanged') infos : Array<NZIMConversationChangeInfo>) : void {
        this.eventMap.onConversationChanged?.({ infoList: mZIMConversationChangeInfoList(infos) });
    }

    zim(zim : NZIM, @argumentLabel('conversationSyncStateChanged') state : NZIMConversationSyncState) : void {
        this.eventMap.onConversationSyncStateChanged?.({ state: state.rawValue });
    }
    
    zim(zim : NZIM, @argumentLabel('conversationTotalUnreadMessageCountUpdated') count : UInt32) : void {
        this.eventMap.onConversationTotalUnreadMessageCountUpdated?.({ totalUnreadMessageCount: Number.from(count) });
    }

    zim(zim : NZIM, @argumentLabel('conversationsAllDeleted') info : NZIMConversationsAllDeletedInfo) : void {
        this.eventMap.onConversationsAllDeleted?.({ count: Number.from(info.count) });
    }

    zim(zim : NZIM, @argumentLabel('conversationMessageReceiptChanged') infos : Array<NZIMMessageReceiptInfo>) : void {
        this.eventMap.onConversationMessageReceiptChanged?.({ infos: mZIMMessageReceiptInfoList(infos) });
    }

    // MARK: - Message

    zim(zim : NZIM, @argumentLabel('peerMessageReceived') messageList : Array<NZIMMessage>,
        @argumentLabel('') info : NZIMMessageReceivedInfo,
        @argumentLabel('') fromUserID : string
    ) : void {
        this.eventMap.onPeerMessageReceived?.({ fromConversationID: fromUserID, info: { isOfflineMessage: info.isOfflineMessage }, messageList: mZIMMessageList(messageList) });
    }

    zim(zim : NZIM, @argumentLabel('roomMessageReceived') messageList : Array<NZIMMessage>,
        @argumentLabel('') info : NZIMMessageReceivedInfo,
        @argumentLabel('') fromRoomID : string
    ) : void {
        this.eventMap.onRoomMessageReceived?.({ fromConversationID: fromRoomID, info: { isOfflineMessage: info.isOfflineMessage }, messageList: mZIMMessageList(messageList) });
    }

    zim(zim : NZIM, @argumentLabel('groupMessageReceived') messageList : Array<NZIMMessage>,
        @argumentLabel('') info : NZIMMessageReceivedInfo,
        @argumentLabel('') fromGroupID : string
    ) : void {
        this.eventMap.onGroupMessageReceived?.({ fromConversationID: fromGroupID, info: { isOfflineMessage: info.isOfflineMessage }, messageList: mZIMMessageList(messageList) });
    }

    zim(zim : NZIM, @argumentLabel('broadcastMessageReceived') info : NZIMMessage) : void {
        this.eventMap.onBroadcastMessageReceived?.({ message: mZIMMessage(info) });
    }

    zim(zim : NZIM, @argumentLabel('messageSentStatusChanged') infos : Array<NZIMMessageSentStatusChangeInfo>) : void {
        this.eventMap.onMessageSentStatusChanged?.({ infos: mZIMMessageSentStatusChangeInfoList(infos) });
    }

    zim(zim : NZIM, @argumentLabel('messageDeleted') info : NZIMMessageDeletedInfo) : void {
        this.eventMap.onMessageDeleted?.({
            conversationID: info.conversationID,
            conversationType: info.conversationType.rawValue,
            messageDeleteType: info.messageDeleteType.rawValue,
            isDeleteConversationAllMessage: info.isDeleteConversationAllMessage,
            messageList: mZIMMessageList(info.messageList)
        });
    }

    zim(zim : NZIM, @argumentLabel('messageEdited') infos : Array<NZIMMessage>) : void {
        this.eventMap.onMessageEdited?.({ messageList: mZIMMessageList(infos) });
    }

    zim(zim : NZIM, @argumentLabel('messageRevokeReceived') infos : Array<NZIMRevokeMessage>) : void {
        this.eventMap.onMessageRevokeReceived?.({ messageList: mZIMMessageList(infos as Array<NZIMMessage>) });
    }

    zim(zim : NZIM, @argumentLabel('messageReceiptChanged') infos : Array<NZIMMessageReceiptInfo>) : void {
        this.eventMap.onMessageReceiptChanged?.({ infos: mZIMMessageReceiptInfoList(infos) });
    }

    zim(zim : NZIM, @argumentLabel('messageReactionsChanged') infos : Array<NZIMMessageReaction>) : void {
        this.eventMap.onMessageReactionsChanged?.({ reactions: mZIMMessageReactionList(infos) });
    }

    zim(zim : NZIM, @argumentLabel('messageRepliedInfoChanged') infos : Array<NZIMMessage>) : void {
        this.eventMap.onMessageRepliedInfoChanged?.({ messageList: mZIMMessageList(infos) });
    }

    zim(zim : NZIM, @argumentLabel('messageRepliedCountChanged') infos : Array<NZIMMessageRootRepliedCountInfo>) : void {
        this.eventMap.onMessageRepliedCountChanged?.({ infos: mZIMMessageRootRepliedCountInfoList(infos) });
    }

    zim(zim : NZIM, @argumentLabel('messagePinStatusChanged') infos : Array<NZIMMessagePinStatusChangeInfo>) : void {
        this.eventMap.onMessagePinStatusChanged?.({ infos: mZIMMessagePinStatusChangeInfoList(infos) });
    }
    
    // MARK: - Room

    zim(zim : NZIM, @argumentLabel('roomStateChanged') state : NZIMRoomState,
        @argumentLabel('') event : NZIMRoomEvent,
        @argumentLabel('') extendedData : UTSJSONObject,
        @argumentLabel('') roomID : string
    ) : void {
        this.eventMap.onRoomStateChanged?.({ roomID, state: state.rawValue, event: event.rawValue, extendedData });
    }

    zim(zim : NZIM, @argumentLabel('roomMemberJoined') infos : Array<NZIMUserInfo>, @argumentLabel('') roomID : string) : void {
        this.eventMap.onRoomMemberJoined?.({ roomID, memberList: mZIMUserInfoList(infos) });
    }

    zim(zim : NZIM, @argumentLabel('roomMemberLeft') infos : Array<NZIMUserInfo>, @argumentLabel('') roomID : string) : void {
        this.eventMap.onRoomMemberLeft?.({ roomID, memberList: mZIMUserInfoList(infos) });
    }

    zim(zim : NZIM, @argumentLabel('roomAttributesUpdated') info : NZIMRoomAttributesUpdateInfo, @argumentLabel('') roomID : string) : void {
        this.eventMap.onRoomAttributesUpdated?.({ roomID, infos: [{ action: info.action.rawValue, roomAttributes: mMap(info.roomAttributes) }] });
    }

    zim(zim : NZIM, @argumentLabel('roomAttributesBatchUpdated') infos : Array<NZIMRoomAttributesUpdateInfo>, @argumentLabel('') roomID : string) : void {
        this.eventMap.onRoomAttributesBatchUpdated?.({ roomID, infos: mZIMRoomAttributesUpdateInfoList(infos) });
    }

    zim(zim : NZIM, @argumentLabel('roomMemberAttributesUpdated') infos : Array<NZIMRoomMemberAttributesUpdateInfo>,
        @argumentLabel('') operatedInfo : NZIMRoomOperatedInfo,
        @argumentLabel('') roomID : string
    ) : void {
        this.eventMap.onRoomMemberAttributesUpdated?.({ roomID, infos: mZIMRoomMemberAttributesUpdateInfoList(infos), operatedInfo: { userID: operatedInfo.userID } });
    }

    // MARK: - Group

    zim(zim : NZIM, @argumentLabel('groupStateChanged') state : NZIMGroupState,
        @argumentLabel('') event : NZIMGroupEvent,
        @argumentLabel('') operatedInfo : NZIMGroupOperatedInfo,
        @argumentLabel('') groupInfo : NZIMGroupFullInfo
    ) : void {
        this.eventMap.onGroupStateChanged?.({
            state: state.rawValue,
            event: event.rawValue,
            operatedInfo: mZIMGroupOperatedInfo(operatedInfo),
            groupInfo: mZIMGroupFullInfo(groupInfo),
        });
    }

    zim(zim : NZIM, @argumentLabel('groupNameUpdated') groupName : string,
        @argumentLabel('') operatedInfo : NZIMGroupOperatedInfo,
        @argumentLabel('') groupID : string
    ) : void {
        this.eventMap.onGroupNameUpdated?.({ groupID, groupName, operatedInfo: mZIMGroupOperatedInfo(operatedInfo) });
    }

    zim(zim : NZIM, @argumentLabel('groupAvatarUrlUpdated') groupAvatarUrl : string,
        @argumentLabel('') operatedInfo : NZIMGroupOperatedInfo,
        @argumentLabel('') groupID : string
    ) : void {
        this.eventMap.onGroupAvatarUrlUpdated?.({ groupID, groupAvatarUrl, operatedInfo: mZIMGroupOperatedInfo(operatedInfo) });
    }

    zim(zim : NZIM, @argumentLabel('groupNoticeUpdated') groupNotice : string,
        @argumentLabel('') operatedInfo : NZIMGroupOperatedInfo,
        @argumentLabel('') groupID : string
    ) : void {
        this.eventMap.onGroupNoticeUpdated?.({ groupID, groupNotice, operatedInfo: mZIMGroupOperatedInfo(operatedInfo) });
    }

    zim(zim : NZIM, @argumentLabel('groupAliasUpdated') groupAlias : string,
        @argumentLabel('') operatedUserID : string,
        @argumentLabel('') groupID : string
    ) : void {
        this.eventMap.onGroupAliasUpdated?.({ groupID, groupAlias, operatedUserID });
    }

    zim(zim : NZIM, @argumentLabel('groupAttributesUpdated') infos : Array<NZIMGroupAttributesUpdateInfo>,
        @argumentLabel('') operatedInfo : NZIMGroupOperatedInfo,
        @argumentLabel('') groupID : string
    ) : void {
        this.eventMap.onGroupAttributesUpdated?.({ groupID, infoList: mZIMGroupAttributesUpdateInfoList(infos), operatedInfo: mZIMGroupOperatedInfo(operatedInfo) });
    }

    zim(zim : NZIM, @argumentLabel('groupMutedInfoUpdated') info : NZIMGroupMuteInfo,
        @argumentLabel('') operatedInfo : NZIMGroupOperatedInfo,
        @argumentLabel('') groupID : string
    ) : void {
        this.eventMap.onGroupMutedInfoUpdated?.({ groupID, mutedInfo: mZIMGroupMuteInfo(info), operatedInfo: mZIMGroupOperatedInfo(operatedInfo) });
    }

    zim(zim : NZIM, @argumentLabel('groupVerifyInfoUpdated') info : NZIMGroupVerifyInfo,
        @argumentLabel('') operatedInfo : NZIMGroupOperatedInfo,
        @argumentLabel('') groupID : string
    ) : void {
        this.eventMap.onGroupVerifyInfoUpdated?.({ groupID, verifyInfo: mZIMGroupVerifyInfo(info), operatedInfo: mZIMGroupOperatedInfo(operatedInfo) });
    }

    zim(zim : NZIM, @argumentLabel('groupMemberStateChanged') state : NZIMGroupMemberState,
        @argumentLabel('') event : NZIMGroupMemberEvent,
        @argumentLabel('') userList : Array<NZIMGroupMemberInfo>,
        @argumentLabel('') operatedInfo : NZIMGroupOperatedInfo,
        @argumentLabel('') groupID : string
    ) : void {
        this.eventMap.onGroupMemberStateChanged?.({
            groupID,
            state: state.rawValue,
            event: event.rawValue,
            userList: mZIMGroupMemberInfoList(userList),
            operatedInfo: mZIMGroupOperatedInfo(operatedInfo),
        });
    }

    zim(zim : NZIM, @argumentLabel('groupMemberInfoUpdated') infos : Array<NZIMGroupMemberInfo>,
        @argumentLabel('') operatedInfo : NZIMGroupOperatedInfo,
        @argumentLabel('') groupID : string
    ) : void {
        this.eventMap.onGroupMemberInfoUpdated?.({ groupID, userList: mZIMGroupMemberInfoList(infos), operatedInfo: mZIMGroupOperatedInfo(operatedInfo) });
    }

    zim(zim : NZIM, @argumentLabel('groupApplicationUpdated') infos : Array<NZIMGroupApplicationInfo>) : void {
        this.eventMap.onGroupApplicationUpdated?.({ applicationList: mZIMGroupApplicationInfoList(infos) });
    }

    zim(zim : NZIM, @argumentLabel('groupApplicationListChanged') infos : Array<NZIMGroupApplicationInfo>,
        @argumentLabel('') action : NZIMGroupApplicationListChangeAction
    ) : void {
        this.eventMap.onGroupApplicationListChanged?.({ action: action.rawValue, applicationList: mZIMGroupApplicationInfoList(infos) });
    }

    // MARK: - Call

    zim(zim : NZIM, @argumentLabel('callInvitationCreated') info : NZIMCallInvitationCreatedInfo, @argumentLabel('') callID : string) : void {
        this.eventMap.onCallInvitationCreated?.({
            callID,
            mode: info.mode.rawValue,
            caller: info.caller,
            extendedData: info.extendedData,
            timeout: Number.from(info.timeout),
            createTime: Number.from(info.createTime),
            callUserList: mZIMCallUserInfoList(info.callUserList)
        });
    }

    zim(zim : NZIM, @argumentLabel('callInvitationReceived') info : NZIMCallInvitationReceivedInfo, @argumentLabel('') callID : string) : void {
        this.eventMap.onCallInvitationReceived?.({
            callID,
            mode: info.mode.rawValue,
            caller: info.caller,
            inviter: info.inviter,
            extendedData: info.extendedData,
            timeout: Number.from(info.timeout),
            createTime: Number.from(info.createTime),
            callUserList: mZIMCallUserInfoList(info.callUserList)
        });
    }

    zim(zim : NZIM, @argumentLabel('callInvitationCancelled') info : NZIMCallInvitationCancelledInfo, @argumentLabel('') callID : string) : void {
        this.eventMap.onCallInvitationCancelled?.({ callID, mode: info.mode.rawValue, inviter: info.inviter, extendedData: info.extendedData });
    }

    zim(zim : NZIM, @argumentLabel('callInvitationTimeout') info : NZIMCallInvitationTimeoutInfo, @argumentLabel('') callID : string) : void {
        this.eventMap.onCallInvitationTimeout?.({ callID, mode: info.mode.rawValue });
    }

    zim(zim : NZIM, @argumentLabel('callInvitationEnded') info : NZIMCallInvitationEndedInfo, @argumentLabel('') callID : string) : void {
        this.eventMap.onCallInvitationEnded?.({
            callID,
            mode: info.mode.rawValue,
            caller: info.caller,
            operatedUserID: info.operatedUserID,
            extendedData: info.extendedData,
            endTime: Number.from(info.endTime),
        });
    }

    zim(zim : NZIM, @argumentLabel('callUserStateChanged') info : NZIMCallUserStateChangeInfo, @argumentLabel('') callID : string) : void {
        this.eventMap.onCallUserStateChanged?.({ callID, callUserList: mZIMCallUserInfoList(info.callUserList) });
    }

    // MARK: - Friend

    zim(zim : NZIM, @argumentLabel('blacklistChanged') infos : Array<NZIMUserInfo>, @argumentLabel('') action : NZIMBlacklistChangeAction) : void {
        this.eventMap.onBlacklistChanged?.({ action: action.rawValue, userList: mZIMUserInfoList(infos) });
    }

    zim(zim : NZIM, @argumentLabel('friendInfoUpdated') infos : Array<NZIMFriendInfo>) : void {
        this.eventMap.onFriendInfoUpdated?.({ friendList: mZIMFriendInfoList(infos) });
    }

    zim(zim : NZIM, @argumentLabel('friendListChanged') infos : Array<NZIMFriendInfo>, @argumentLabel('') action : NZIMFriendListChangeAction) : void {
        this.eventMap.onFriendListChanged?.({ action: action.rawValue, friendList: mZIMFriendInfoList(infos) });
    }

    zim(zim : NZIM, @argumentLabel('friendApplicationUpdated') infos : Array<NZIMFriendApplicationInfo>) : void {
        this.eventMap.onFriendApplicationUpdated?.({ applicationList: mZIMFriendApplicationInfoList(infos) });
    }

    zim(zim : NZIM, @argumentLabel('friendApplicationListChanged') infos : Array<NZIMFriendApplicationInfo>,
        @argumentLabel('') action : NZIMFriendApplicationListChangeAction
    ) : void {
        this.eventMap.onFriendApplicationListChanged?.({ action: action.rawValue, applicationList: mZIMFriendApplicationInfoList(infos) });
    }
}
