    // queryHistoryMessage(by conversationID: String, conversationType: NZIMConversationType, config: NZIMMessageQueryConfig, callback: @escaping NZIMMessageQueriedCallback)
    queryHistoryMessage(conversationID : string, conversationType : ZIMConversationType, config : ZIMMessageQueryConfig) : Promise<ZIMMessageQueriedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _type = NZIMConversationType(rawValue = conversationType.toInt())!;

            const _config = new NZIMMessageQueryConfig();
            _config.count = config.count.toUInt32();
            _config.reverse = config.reverse ?? true;
            if (config.nextMessage != null) {
                _config.nextMessage = this.nextMessageMap.get(config.nextMessage!);
            }

            this._zim!.queryHistoryMessage(by = conversationID, conversationType = _type, config = _config, callback =
                (conversationID : string, conversationType : NZIMConversationType, infos : Array<NZIMMessage>, errorInfo : NZIMError) => {
                    if (isSucc(errorInfo, reject)) {
                        const len = infos.length;
                        if (len > 0) {
                            this.putNextMessage(infos[0]);
                            this.putNextMessage(infos[len - 1]);
                        }
                        resolve({ conversationID, conversationType: conversationType.rawValue, messageList: mZIMMessageList(infos) });
                    }
                });
        });
    }

    // queryMessages(by messageSeqs: [NSNumber], conversationID: String, conversationType: NZIMConversationType, callback: @escaping NZIMMessageQueriedCallback)
    queryMessages(messageSeqs : number[], conversationID : string, conversationType : ZIMConversationType) : Promise<ZIMMessageQueriedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _type = NZIMConversationType(rawValue = conversationType.toInt())!;

            this._zim!.queryMessages(by = messageSeqs, conversationID = conversationID, conversationType = _type, callback =
                (conversationID : string, conversationType : NZIMConversationType, infos : Array<NZIMMessage>, errorInfo : NZIMError) => {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ conversationID, conversationType: conversationType.rawValue, messageList: mZIMMessageList(infos) });
                    }
                });
        });
    }

