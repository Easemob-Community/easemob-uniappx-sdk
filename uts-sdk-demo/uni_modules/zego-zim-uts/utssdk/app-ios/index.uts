            }

            const _type = NZIMConversationType(rawValue = conversationType.toInt())!;

            const _config = new NZIMMessageDeleteConfig();
            _config.isAlsoDeleteServerMessage = config.isAlsoDeleteServerMessage ?? true;

            this._zim!.deleteMessages(oZIMMessageList(messageList), conversationID = conversationID, conversationType = _type, config = _config, callback =
                (conversationID : string, conversationType : NZIMConversationType, errorInfo : NZIMError) => {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ conversationID, conversationType: conversationType.rawValue });
                    }
                });
        });
    }

