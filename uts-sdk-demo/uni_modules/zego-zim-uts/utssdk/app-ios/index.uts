    // MARK: - Group

    // createGroup(with groupInfo: NZIMGroupInfo, userIDs: [String], config: NZIMGroupAdvancedConfig, callback: @escaping NZIMGroupCreatedCallback)
    createGroup(groupInfo : ZIMGroupInfo, userIDs : string[], config ?: ZIMGroupAdvancedConfig) : Promise<ZIMGroupCreatedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _groupInfo = new NZIMGroupInfo();
            _groupInfo.groupID = groupInfo.groupID ?? '';
            _groupInfo.groupName = groupInfo.groupName ?? '';
            _groupInfo.groupAvatarUrl = groupInfo.groupAvatarUrl ?? '';

            const _config = new NZIMGroupAdvancedConfig();
            if (config != null) {
                _config.groupNotice = config!.groupNotice ?? '';
                _config.groupAttributes = oMap(config!.groupAttributes ?? {});
                _config.maxMemberCount = (config!.maxMemberCount ?? 0).toUInt32();
                _config.joinMode = NZIMGroupJoinMode(rawValue = (config!.joinMode ?? 0).toUInt())!;
                _config.inviteMode = NZIMGroupInviteMode(rawValue = (config!.inviteMode ?? 0).toUInt())!;
                _config.beInviteMode = NZIMGroupBeInviteMode(rawValue = (config!.beInviteMode ?? 0).toUInt())!;
            }

            this._zim!.createGroup(with = _groupInfo, userIDs = userIDs, config = _config, callback =
                (info : NZIMGroupFullInfo, infos : Array<NZIMGroupMemberInfo>, errorUserList : Array<NZIMErrorUserInfo>, errorInfo : NZIMError) => {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ groupInfo: mZIMGroupFullInfo(info), userList: mZIMGroupMemberInfoList(infos), errorUserList: mZIMErrorUserInfoList(errorUserList) });
                    }
                });
        });
    }

