                    Number.from(totalIndexFileSize),
                );
            };

            this._zim!.editMessage(oZIMMessage(message, false), config = new NZIMMessageEditConfig(), notification = _notification, callback = 
                (info : NZIMMessage, errorInfo : NZIMError) => {
