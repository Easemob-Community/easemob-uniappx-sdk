                return reject(this.NoInitErr);
            }

            const _config = new NZIMMessageReactionUserQueryConfig();
            _config.count = config.count.toUInt32();
            _config.nextFlag = (config.nextFlag ?? 0).toUInt64();
            _config.reactionType = config.reactionType ?? '';

            this._zim!.queryMessageReactionUserList(by = oZIMMessage(message, false), config = _config, callback =
                (info : NZIMMessage, infos : Array<NZIMMessageReactionUserInfo>, reactionType : string, nextFlag : Int64, totalCount : Int32, errorInfo : NZIMError) => {
                    if (isSucc(errorInfo, reject)) {
                        resolve({
                            message: mZIMMessage(info),
                            reactionType,
                            nextFlag: Number.from(nextFlag),
                            totalCount: Number.from(totalCount),
                            userList: mZIMMessageReactionUserInfoList(infos)
                        });
                    }
                });
        });
    }


    // queryMessageRepliedList(by message: NZIMMessage, config: NZIMMessageRepliedListQueryConfig, callback: @escaping NZIMMessageRepliedListQueriedCallback)
    queryMessageRepliedList(message : ZIMMessage, config : ZIMMessageRepliedListQueryConfig) : Promise<ZIMMessageRepliedListQueriedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMMessageRepliedListQueryConfig();
            _config.count = config.count.toUInt32();
            _config.nextFlag = (config.nextFlag ?? 0).toInt64();

            this._zim!.queryMessageRepliedList(by = oZIMMessage(message, false), config = _config, callback =
                (infos : Array<NZIMMessage>, nextFlag : Int64, info : NZIMMessageRootRepliedInfo, errorInfo : NZIMError) => {
                    if (isSucc(errorInfo, reject)) {
                        const _info = {
                            state: info.state.rawValue,
                            senderUserID: info.senderUserID,
                            repliedCount: Number.from(info.repliedCount),
                            sentTime: Number.from(info.sentTime),
                        } as ZIMMessageRootRepliedInfo;
                        if (info.message != null) {
                            _info.message = mZIMMessage(info.message!);
                        }
                        resolve({ nextFlag: Number.from(nextFlag), rootRepliedInfo: _info, messageList: mZIMMessageList(infos) });
                    }
                });
        });
    }

