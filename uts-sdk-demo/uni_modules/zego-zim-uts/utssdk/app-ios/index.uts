const isSucc = (errorInfo: NZIMError, reject: (err: any) => void): boolean => {
    const code = errorInfo.code.rawValue as number;
    if (code != 0) {
        reject(new UniError('zim-apicall-error', code, errorInfo.message));
        return false;
    }
    return true;
}

export class ZIM implements IZIM {
    private static _instance: IZIM | null = null;
    
    private _zim : NZIM | null = null;
    private _event: ZIMEventHandlerImpl | null = null;
    private constructor(nzim : NZIM) {
        super(); // error: 'self' used before 'super.init' call
        this._zim = nzim;
        this._event = new ZIMEventHandlerImpl();
        this._zim!.setEventHandler(this._event!);
    }

    private NoInitErr = new UniError('zim-apicall-error', 1, 'No instance.');
    
    // HBuilderX 编译的 swift 代码，存在强制类型转换问题，导致锚点为对象类型的分页查询时App崩溃。
    private nextMessageMap = new Map<string, NZIMMessage>();
    private nextConversationMap = new Map<string, NZIMConversation>();
    private putNextMessage(msgObj: NZIMMessage): string {
        const key = Number.from(msgObj.localMessageID).toString();
        this.nextMessageMap.set(key , msgObj);
        return key;
    }
    private putNextConversation(convObj: NZIMConversation): string {
        const key = convObj.type.rawValue.toString() + convObj.conversationID;
        this.nextConversationMap.set(key , convObj);
        return key;
    }

    // setLogConfig(_ config: NZIMLogConfig)
    static setLogConfig(config : ZIMLogConfig) : void {
        const _config = new NZIMLogConfig();
        if (config.logPath != null && config.logPath != '') {
            _config.logPath = config.logPath!;
        }
        if (config.logSize != null && config.logSize! > 0) {
            _config.logSize = config.logSize!.toUInt64();
        }

        NZIM.setLogConfig(_config);
    }

    // setCacheConfig(_ config: NZIMCacheConfig)
    static setCacheConfig(config : ZIMCacheConfig) : void {
        const _config = new NZIMCacheConfig();
        if (config.cachePath != '') {
            _config.cachePath = config.cachePath;
        }

        NZIM.setCacheConfig(_config);
    }

    // setAdvancedConfig(key: String, value: String)
    static setAdvancedConfig(key : string, value : string) : void {
        NZIM.setAdvancedConfig(key = key, value = value);
    }

    // setGeofencingConfig(with areaList: [NSNumber], type: NZIMGeofencingType) -> Bool
    static setGeofencingConfig(areaList : number[], type : ZIMGeofencingType) : boolean {
        return NZIM.setGeofencingConfig(with = areaList, type = NZIMGeofencingType(rawValue = type.toInt())!);
    }

    static getVersion() : string {
        return NZIM.getVersion();
    }

    static create(appConfig : ZIMAppConfig) : IZIM {
        if(this._instance == null) {
            const appInfo = uni.getAppBaseInfo();
            const value = (appInfo.isUniAppX ?? false) ? 'uni-app-x' : 'uni-app-u';
            NZIM.setAdvancedConfig(key = 'zim_cross_platform', value = value);
            NZIM.setAdvancedConfig(key = 'zim_cross_platform_uts', value = JSON.stringify(appInfo) ?? value);
            const config = new NZIMAppConfig();
            config.appID = appConfig.appID.toUInt32();
            config.appSign = appConfig.appSign;
            // create(with config: NZIMAppConfig) -> NZIM?
            const nzim = NZIM.create(with = config);
            
            this._instance = new ZIM(nzim!);
        }
        return this._instance!;
    }
    
    static getInstance() : IZIM {
        return this._instance!;
    }

        
    destroy() : void {
        this.nextMessageMap.clear();
        this.nextConversationMap.clear();
        this._event = null;
        if (this._zim != null) {
            this._zim!.destroy();
            this._zim = null;
        }
        UTSiOS.destroyInstance(this);
    }
    
    uploadLog() : Promise<void> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            this._zim!.uploadLog(with = (errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    resolve();
                }
            });
        });
    }

    // queryLocalFileCache(with config: NZIMFileCacheQueryConfig, callback: @escaping NZIMFileCacheQueriedCallback)
    queryLocalFileCache(config : ZIMFileCacheQueryConfig) : Promise<ZIMFileCacheQueriedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMFileCacheQueryConfig();
            _config.endTime = config.endTime.toInt64();

            this._zim!.queryLocalFileCache(with = _config, callback = (info : NZIMFileCacheInfo, errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    resolve({ totalFileSize: Number.from(info.totalFileSize) });
                }
            });
        });
    }

    // clearLocalFileCache(with config: NZIMFileCacheClearConfig, callback: @escaping NZIMFileCacheClearedCallback)
    clearLocalFileCache(config : ZIMFileCacheClearConfig) : Promise<void> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMFileCacheClearConfig();
            _config.endTime = config.endTime.toInt64();

            this._zim!.clearLocalFileCache(with = _config, callback = (errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    resolve();
                }
            });
        });
    }

    // MARK: - User
    
    // login(with userID: String, config: NZIMLoginConfig, callback: @escaping NZIMLoggedInCallback)
    login(userID : string, config : ZIMLoginConfig) : Promise<void> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMLoginConfig();
            _config.userName = config.userName ?? '';
            _config.customStatus = config.customStatus ?? '';
            _config.token = config.token ?? '';
            _config.isOfflineLogin = config.isOfflineLogin ?? false;

            this._zim!.login(with = userID, config = _config, callback = (errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    resolve();
                }
            });
        });
    }

    logout() : void {
        this.nextMessageMap.clear();
        this.nextConversationMap.clear();
        if (this._zim != null) {
            this._zim!.logout();
        }
    }

    // renewToken(_ token: String, callback: @escaping NZIMTokenRenewedCallback)
    renewToken(token : string) : Promise<ZIMTokenRenewedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            this._zim!.renewToken(token, callback = (token : string, errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    resolve({ token });
                }
            });
        });
    }

    // updateUserName(_ userName: String, callback: @escaping NZIMUserNameUpdatedCallback)
    updateUserName(userName : string) : Promise<ZIMUserNameUpdatedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            this._zim!.updateUserName(userName, callback = (userName : string, errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    resolve({ userName });
                }
            });
        });
    }

    // updateUserAvatarUrl(_ userAvatarUrl: String, callback: @escaping NZIMUserAvatarUrlUpdatedCallback)
    updateUserAvatarUrl(userAvatarUrl : string) : Promise<ZIMUserAvatarUrlUpdatedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            this._zim!.updateUserAvatarUrl(userAvatarUrl, callback = (userAvatarUrl : string, errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    resolve({ userAvatarUrl });
                }
            });
        });
    }

    // updateUserExtendedData(_ extendedData: String, callback: @escaping NZIMUserExtendedDataUpdatedCallback)
    updateUserExtendedData(extendedData : string) : Promise<ZIMUserExtendedDataUpdatedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            this._zim!.updateUserExtendedData(extendedData, callback = (extendedData : string, errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    resolve({ extendedData });
                }
            });
        });
    }

    // updateUserCustomStatus(_ customStatus: String, callback: @escaping NZIMUserCustomStatusUpdatedCallback)
    updateUserCustomStatus(customStatus : string) : Promise<ZIMUserCustomStatusUpdatedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            this._zim!.updateUserCustomStatus(customStatus, callback = (customStatus : string, errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    resolve({ customStatus });
                }
            });
        });
    }

    // update(_ offlinePushRule: NZIMUserOfflinePushRule, callback: @escaping NZIMUserOfflinePushRuleUpdatedCallback)
    updateUserOfflinePushRule(config : ZIMUserOfflinePushRule) : Promise<ZIMUserOfflinePushRuleUpdatedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMUserOfflinePushRule();
            _config.onlinePlatforms = config.onlinePlatforms ?? [];
            _config.notToReceiveOfflinePushPlatforms = config.notToReceiveOfflinePushPlatforms ?? [];

            this._zim!.update(_config, callback = (info : NZIMUserOfflinePushRule, errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    resolve({ offlinePushRule: mZIMUserOfflinePushRule(info) });
                }
            });
        });
    }

    // querySelfUserInfo(_ callback: @escaping NZIMSelfUserInfoQueriedCallback)
    querySelfUserInfo() : Promise<ZIMSelfUserInfoQueriedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            this._zim!.querySelfUserInfo((info : NZIMSelfUserInfo, errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    resolve({
                        selfUserInfo: {
                            userRule: { offlinePushRule: mZIMUserOfflinePushRule(info.userRule.offlinePushRule) },
                            userStatus: mZIMUserStatus(info.userStatus),
                            userFullInfo: mZIMUserFullInfo(info.userFullInfo)
                        }
                    });
                }
            });
        });
    }

    // queryUsersInfo(by userIDs: [String], config: NZIMUsersInfoQueryConfig, callback: @escaping NZIMUsersInfoQueriedCallback)
    queryUsersInfo(userIDs : string[], config : ZIMUsersInfoQueryConfig) : Promise<ZIMUsersInfoQueriedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMUsersInfoQueryConfig();
            _config.isQueryFromServer = config.isQueryFromServer ?? false;

            this._zim!.queryUsersInfo(by = userIDs, config = _config, callback = 
                (infos : Array<NZIMUserFullInfo>, errorUserList : Array<NZIMErrorUserInfo>, errorInfo : NZIMError) => {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ userList: mZIMUserFullInfoList(infos), errorUserList: mZIMErrorUserInfoList(errorUserList) });
                    }
                });
        });
    }

    // subscribeUsersStatus(_ userIDs: [String], config: NZIMUserStatusSubscribeConfig, callback: @escaping NZIMUsersStatusSubscribedCallback)
    subscribeUsersStatus(userIDs : string[], config : ZIMUserStatusSubscribeConfig) : Promise<ZIMUsersStatusSubscribedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMUserStatusSubscribeConfig();
            _config.subscriptionDuration = config.subscriptionDuration.toUInt32();

            this._zim!.subscribeUsersStatus(userIDs, config = _config, callback = (infos : Array<NZIMErrorUserInfo>, errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    resolve({ errorUserList: mZIMErrorUserInfoList(infos) });
                }
            });
        });
    }

    // unsubscribeUsersStatus(_ userIDs: [String], callback: @escaping NZIMUsersStatusUnsubscribedCallback)
    unsubscribeUsersStatus(userIDs : string[]) : Promise<ZIMUsersStatusUnsubscribedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            this._zim!.unsubscribeUsersStatus(userIDs, callback = (infos : Array<NZIMErrorUserInfo>, errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    resolve({ errorUserList: mZIMErrorUserInfoList(infos) });
                }
            });
        });
    }

    // queryUsersStatus(by userIDs: [String], callback: @escaping NZIMUsersStatusQueriedCallback)
    queryUsersStatus(userIDs : string[]) : Promise<ZIMUsersStatusQueriedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            this._zim!.queryUsersStatus(by = userIDs, callback = (infos : Array<NZIMUserStatus>, errorUserList : Array<NZIMErrorUserInfo>, errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    resolve({ userStatusList: mZIMUserStatusList(infos), errorUserList: mZIMErrorUserInfoList(errorUserList) });
                }
            });
        });
    }

    // querySubscribedUserStatusList(with config: NZIMSubscribedUserStatusQueryConfig, callback: @escaping NZIMSubscribedUserStatusListQueriedCallback)
    querySubscribedUserStatusList(config : ZIMSubscribedUserStatusQueryConfig) : Promise<ZIMSubscribedUserStatusListQueriedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMSubscribedUserStatusQueryConfig();
            if (config.userIDs != null) {
                _config.userIDs = config.userIDs!;
            }

            this._zim!.querySubscribedUserStatusList(with = _config, callback = (infos : Array<NZIMUserStatusSubscription>, errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    resolve({ userStatusSubscriptionList: mZIMUserStatusSubscriptionList(infos) });
                }
            });
        });
    }

    // MARK: - Conversation

    // queryConversation(by conversationID: String, conversationType: NZIMConversationType, callback: @escaping NZIMConversationQueriedCallback)
    queryConversation(conversationID : string, conversationType : ZIMConversationType) : Promise<ZIMConversationQueriedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _type = NZIMConversationType(rawValue = conversationType.toInt())!;

            this._zim!.queryConversation(by = conversationID, conversationType = _type, callback = (info : NZIMConversation, errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    resolve({ conversation: mZIMConversation(info) });
                }
            });
        });
    }

    // queryConversationList(with config: NZIMConversationQueryConfig, option: NZIMConversationFilterOption, callback: @escaping NZIMConversationListQueriedCallback)
    queryConversationList(config : ZIMConversationQueryConfig, option ?: ZIMConversationFilterOption) : Promise<ZIMConversationListQueriedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMConversationQueryConfig();
            _config.count = config.count.toUInt32();
            if (config.nextConversation != null) {
                _config.nextConversation = this.nextConversationMap.get(config.nextConversation!);
            }

            const _option = new NZIMConversationFilterOption();
            if (option != null) {
                _option.isOnlyUnreadConversation = option!.isOnlyUnreadConversation ?? false;
                _option.marks = option!.marks ?? [];
                _option.conversationTypes = option!.conversationTypes ?? [];
                _option.pinnedFilter = NZIMConversationPinnedFilter(rawValue = (option!.pinnedFilter ?? 0).toUInt())!;
            }

            this._zim!.queryConversationList(with = _config, option = _option, callback = (infos : Array<NZIMConversation>, errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    const len = infos.length;
                    if (len > 0) {
                        this.putNextConversation(infos[len - 1]);
                    }
                    resolve({ conversationList: mZIMConversationList(infos) });
                }
            });
        });
    }

    // queryConversationPinnedList(with config: NZIMConversationQueryConfig, callback: @escaping NZIMConversationPinnedListQueriedCallback)
    queryConversationPinnedList(config : ZIMConversationQueryConfig) : Promise<ZIMConversationPinnedListQueriedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMConversationQueryConfig();
            _config.count = config.count.toUInt32();
            if (config.nextConversation != null) {
                _config.nextConversation = this.nextConversationMap.get(config.nextConversation!);
            }

            this._zim!.queryConversationPinnedList(with = _config, callback = (infos : Array<NZIMConversation>, errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    const len = infos.length;
                    if (len > 0) {
                        this.putNextConversation(infos[len - 1]);
                    }
                    resolve({ conversationList: mZIMConversationList(infos) });
                }
            });
        });
    }

    // queryConversationTotalUnreadMessageCount(with config: NZIMConversationTotalUnreadMessageCountQueryConfig, callback: @escaping NZIMConversationTotalUnreadMessageCountQueriedCallback)
    queryConversationTotalUnreadMessageCount(config : ZIMConversationTotalUnreadMessageCountQueryConfig) : Promise<ZIMConversationTotalUnreadMessageCountQueriedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMConversationTotalUnreadMessageCountQueryConfig();
            _config.marks = config.marks ?? [];
            _config.conversationTypes = config.conversationTypes ?? [];

            this._zim!.queryConversationTotalUnreadMessageCount(with = _config, callback = (count : UInt32, errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    resolve({ unreadMessageCount: Number.from(count) });
                }
            });
        });
    }

    // deleteConversation(by conversationID: String, conversationType: NZIMConversationType, config: NZIMConversationDeleteConfig, callback: @escaping NZIMConversationDeletedCallback)
    deleteConversation(conversationID : string, conversationType : ZIMConversationType, config : ZIMConversationDeleteConfig) : Promise<ZIMConversationDeletedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _type = NZIMConversationType(rawValue = conversationType.toInt())!;
            const _config = new NZIMConversationDeleteConfig();
            _config.isAlsoDeleteServerConversation = config.isAlsoDeleteServerConversation ?? true;

            this._zim!.deleteConversation(by = conversationID, conversationType = _type, config = _config, callback =
                (conversationID : string, conversationType : NZIMConversationType, errorInfo : NZIMError) => {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ conversationID, conversationType: conversationType.rawValue });
                    }
                });
        });
    }

