    // MARK: - DB Search

    // searchLocalConversations(with config: NZIMConversationSearchConfig, callback: @escaping NZIMConversationsSearchedCallback)
    searchLocalConversations(config : ZIMConversationSearchConfig) : Promise<ZIMConversationsSearchedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMConversationSearchConfig();
            _config.keywords = config.keywords ?? [];
            _config.senderUserIDs = config.senderUserIDs ?? [];
            _config.subMessageTypes = config.subMessageTypes ?? [];
            _config.messageTypes = config.messageTypes ?? [];
            _config.startTime = (config.startTime ?? 0).toInt64();
            _config.endTime = (config.endTime ?? 0).toInt64();
            _config.totalConversationCount = (config.totalConversationCount ?? 0).toUInt32();
            _config.conversationMessageCount = (config.conversationMessageCount ?? 0).toUInt32();
            _config.nextFlag = (config.nextFlag ?? 0).toUInt32();

            this._zim!.searchLocalConversations(with = _config, callback = (infos : Array<NZIMConversationSearchInfo>, nextFlag : UInt32, errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    resolve({ nextFlag: Number.from(nextFlag), conversationSearchInfoList: mZIMConversationSearchInfoList(infos) });
                }
            });
        });
    }

    // searchLocalMessages(by conversationID: String, conversationType: NZIMConversationType, config: NZIMMessageSearchConfig, callback: @escaping NZIMMessagesSearchedCallback)
    searchLocalMessages(conversationID : string, conversationType : ZIMConversationType, config : ZIMMessageSearchConfig) : Promise<ZIMMessagesSearchedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _type = NZIMConversationType(rawValue = conversationType.toInt())!;

            this._zim!.searchLocalMessages(by = conversationID, conversationType = _type, config = oZIMMessageSearchConfig(config, this.nextMessageMap), callback =
                (conversationID : string, conversationType : NZIMConversationType, infos : Array<NZIMMessage>, nextMessage : NZIMMessage | null, errorInfo : NZIMError) => {
                    if (isSucc(errorInfo, reject)) {
                        const res : ZIMMessagesSearchedResult = { conversationID, conversationType: conversationType.rawValue, messageList: mZIMMessageList(infos) };
                        if (nextMessage != null) {
                            res.nextMessage = this.putNextMessage(nextMessage!);
                        }
                        resolve(res);
                    }
                });
        });
    }

    // searchGlobalLocalMessages(with config: NZIMMessageSearchConfig, callback: @escaping NZIMMessagesGlobalSearchedCallback)
    searchGlobalLocalMessages(config : ZIMMessageSearchConfig) : Promise<ZIMMessagesGlobalSearchedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            this._zim!.searchGlobalLocalMessages(with = oZIMMessageSearchConfig(config, this.nextMessageMap), callback = (infos : Array<NZIMMessage>, nextMessage : NZIMMessage | null, errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    const res : ZIMMessagesGlobalSearchedResult = { messageList: mZIMMessageList(infos) };
                    if (nextMessage != null) {
                        res.nextMessage = this.putNextMessage(nextMessage!);
                    }
                    resolve(res);
                }
            });
        });
    }

