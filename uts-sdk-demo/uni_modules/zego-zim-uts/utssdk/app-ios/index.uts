    // MARK: - Message

    // sendMessage(_ message: NZIMMessage, toConversationID: String, conversationType: NZIMConversationType, config: NZIMMessageSendConfig, notification: NZIMMessageSendNotification?, callback: @escaping NZIMMessageSentCallback)
    @UTSJS.keepAlive
    sendMessage(message : ZIMMessage, toConversationID : string, conversationType : ZIMConversationType, config : ZIMMessageSendConfig, notification ?: ZIMMessageSendNotification) : Promise<ZIMMessageSentResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _type = NZIMConversationType(rawValue = conversationType.toInt())!;

            const _notification = new NZIMMessageSendNotification();
            _notification.onMessageAttached = (info : NZIMMessage) => {
                notification?.onMessageAttached?.(mZIMMessage(info));
            };
            _notification.onMediaUploadingProgress = (info : NZIMMediaMessage, currentFileSize : UInt64, totalFileSize : UInt64) => {
                notification?.onMediaUploadingProgress?.(mZIMMessage(info), Number.from(currentFileSize), Number.from(totalFileSize));
            };
            _notification.onMultipleMediaUploadingProgress = (
                info : NZIMMultipleMessage, currentFileSize : UInt64, totalFileSize : UInt64, messageInfoIndex : UInt32, currentIndexFileSize : UInt64, totalIndexFileSize : UInt64) => {
                notification?.onMultipleMediaUploadingProgress?.(
                    mZIMMessage(info),
                    Number.from(currentFileSize),
                    Number.from(totalFileSize),
                    Number.from(messageInfoIndex),
                    Number.from(currentIndexFileSize),
                    Number.from(totalIndexFileSize),
                );
            };

            this._zim!.sendMessage(oZIMMessage(message, true), toConversationID = toConversationID, conversationType = _type, config = oZIMMessageSendConfig(config), notification = _notification, callback =
                (info : NZIMMessage, errorInfo : NZIMError) => {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ message: mZIMMessage(info) });
                    }
                });
        });
    }

    // replyMessage(_ message: NZIMMessage, toOriginalMessage: NZIMMessage, config: NZIMMessageSendConfig, notification: NZIMMessageSendNotification?, callback: @escaping NZIMMessageSentCallback)
    @UTSJS.keepAlive
    replyMessage(message : ZIMMessage, toOriginalMessage : ZIMMessage, config : ZIMMessageSendConfig, notification ?: ZIMMessageSendNotification) : Promise<ZIMMessageSentResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _notification = new NZIMMessageSendNotification();
            _notification.onMessageAttached = (info : NZIMMessage) => {
                notification?.onMessageAttached?.(mZIMMessage(info));
            };
            _notification.onMediaUploadingProgress = (info : NZIMMediaMessage, currentFileSize : UInt64, totalFileSize : UInt64) => {
                notification?.onMediaUploadingProgress?.(mZIMMessage(info), Number.from(currentFileSize), Number.from(totalFileSize));
            };
            _notification.onMultipleMediaUploadingProgress = (
                info : NZIMMultipleMessage, currentFileSize : UInt64, totalFileSize : UInt64, messageInfoIndex : UInt32, currentIndexFileSize : UInt64, totalIndexFileSize : UInt64) => {
                notification?.onMultipleMediaUploadingProgress?.(
                    mZIMMessage(info),
                    Number.from(currentFileSize),
                    Number.from(totalFileSize),
                    Number.from(messageInfoIndex),
                    Number.from(currentIndexFileSize),
                    Number.from(totalIndexFileSize),
                );
            };

            this._zim!.replyMessage(oZIMMessage(message, true), toOriginalMessage = oZIMMessage(toOriginalMessage, false), config = oZIMMessageSendConfig(config), notification = _notification, callback =
                (info : NZIMMessage, errorInfo : NZIMError) => {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ message: mZIMMessage(info) });
                    }
                });
        });
    }

