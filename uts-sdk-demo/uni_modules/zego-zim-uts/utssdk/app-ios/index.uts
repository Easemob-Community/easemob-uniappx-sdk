    // downloadMediaFile(with message: NZIMMessage, fileType: NZIMMediaFileType, config: NZIMMediaDownloadConfig, progress: @escaping NZIMMediaDownloadingProgress, callback: @escaping NZIMMediaDownloadedCallback)
    @UTSJS.keepAlive
    downloadMediaFile(message : ZIMMessage, fileType : ZIMMediaFileType, config : ZIMMediaDownloadConfig, progress : ZIMMediaDownloadingProgress) : Promise<ZIMMediaDownloadedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _type = NZIMMediaFileType(rawValue = fileType.toUInt())!;

            const _config = new NZIMMediaDownloadConfig();
            _config.messageInfoIndex = (config.messageInfoIndex ?? 0).toUInt32();

            const _progress = (info : NZIMMessage, currentFileSize : UInt64, totalFileSize : UInt64) => {
                progress(mZIMMessage(info), Number.from(currentFileSize), Number.from(totalFileSize));
            };

            this._zim!.downloadMediaFile(with = oZIMMessage(message, false), fileType = _type, config = _config, progress = _progress, callback = 
                (info : NZIMMessage, errorInfo : NZIMError) => {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ message: mZIMMessage(info) });
                    }
                });
        });
    }

    // importLocalMessages(fromFolderPath folderPath: String, config: NZIMMessageImportConfig, progress: @escaping NZIMMessageImportingProgress, callback: @escaping NZIMMessageImportedCallback)
    @UTSJS.keepAlive
    importLocalMessages(folderPath : string, config : ZIMMessageImportConfig, progress : ZIMMessageImportingProgress) : Promise<void> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = config;

            const _progress = (currentMessageCount : UInt64, totalMessageCount : UInt64) => {
                progress(Number.from(currentMessageCount), Number.from(totalMessageCount));
            };

            this._zim!.importLocalMessages(fromFolderPath = folderPath, config = new NZIMMessageImportConfig(), progress = _progress, callback = (errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    resolve();
                }
            });
        });
    }

