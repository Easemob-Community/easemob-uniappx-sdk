                }
            });
        });
    }

    // revokeMessage(_ message: NZIMMessage, config: NZIMMessageRevokeConfig, callback: @escaping NZIMMessageRevokedCallback)
    revokeMessage(message : ZIMMessage, config : ZIMMessageRevokeConfig) : Promise<ZIMMessageRevokedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMMessageRevokeConfig();
            _config.revokeExtendedData = config.revokeExtendedData ?? '';
            if (config.pushConfig != null) {
                _config.pushConfig = oZIMPushConfig(config.pushConfig!);
            }

            this._zim!.revokeMessage(oZIMMessage(message, false), config = _config, callback = (info : NZIMMessage, errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    resolve({ message: mZIMMessage(info) });
                }
            });
        });
    }

