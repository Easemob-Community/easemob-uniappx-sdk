    // deleteMessages(_ messageList: [ZIMMessage], conversationID: String, conversationType: NZIMConversationType, config: NZIMMessageDeleteConfig, callback: @escaping NZIMMessageDeletedCallback)
    deleteMessages(messageList : ZIMMessage[], conversationID : string, conversationType : ZIMConversationType, config : ZIMMessageDeleteConfig) : Promise<ZIMMessageDeletedResult> {
