    // MARK: - Call

    // callInvite(with invitees: [String], config: NZIMCallInviteConfig, callback: @escaping NZIMCallInvitationSentCallback)
    callInvite(invitees : string[], config : ZIMCallInviteConfig) : Promise<ZIMCallInvitationSentResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMCallInviteConfig();
            _config.mode = NZIMCallInvitationMode(rawValue = (config.mode ?? 0).toInt())!;
            _config.timeout = (config.timeout ?? 0).toUInt32();
            _config.extendedData = config.extendedData ?? '';
            _config.enableNotReceivedCheck = config.enableNotReceivedCheck ?? false;

            if (config.pushConfig != null) {
                _config.pushConfig = oZIMPushConfig(config.pushConfig!);
            }

            this._zim!.callInvite(with = invitees, config = _config, callback = (callID : string, info : NZIMCallInvitationSentInfo, errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    resolve({
                        callID,
                        timeout: Number.from(info.timeout),
                        errorUserList: mZIMErrorUserInfoList(info.errorUserList)
                    });
                }
            });
        });
    }

    // callCancel(with invitees: [String], callID: String, config: NZIMCallCancelConfig, callback: @escaping NZIMCallCancelSentCallback)
    callCancel(invitees : string[], callID : string, config : ZIMCallCancelConfig) : Promise<ZIMCallCancelSentResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMCallCancelConfig();
            _config.extendedData = config.extendedData ?? '';

            if (config.pushConfig != null) {
                _config.pushConfig = oZIMPushConfig(config.pushConfig!);
            }

            this._zim!.callCancel(with = invitees, callID = callID, config = _config, callback = (callID : string, infos : Array<string>, errorInfo : NZIMError) => {
                if (isSucc(errorInfo, reject)) {
                    resolve({ callID, errorInvitees: infos });
                }
            });
        });
    }

