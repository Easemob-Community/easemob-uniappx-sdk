        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            this._zim!.updateMessageLocalExtendedData(localExtendedData, message = oZIMMessage(message, false), callback = (info : NZIMMessage, errorInfo : NZIMError) => {
