            unreadMemberCount: Number.from(v.unreadMemberCount),
            isSelfOperated: v.isSelfOperated,
            readTime: Number.from(v.readTime),
        } as ZIMMessageReceiptInfo;
    });
};

export const oZIMMessageRepliedInfo = (info: ZIMMessageRepliedInfo): NZIMMessageRepliedInfo => {
    const obj = new NZIMMessageRepliedInfo();
    obj.state = NZIMMessageRepliedInfoState(rawValue = info.state.toUInt())!;
    obj.messageSeq = info.messageSeq.toInt64();
    obj.messageID = parseInt(info.messageID, 10).toInt64();
    obj.sentTime = info.sentTime.toUInt64();
    obj.senderUserID = info.senderUserID;
    obj.messageInfo = oZIMMessageLiteInfo(info.messageInfo);
    return obj;
};

export const mZIMMessageRepliedInfo = (info: NZIMMessageRepliedInfo) => {
    return {
        state: info.state.rawValue,
        messageSeq: Number.from(info.messageSeq),
        messageID: Number.from(info.messageID).toString(),
        senderUserID: info.senderUserID,
        sentTime: Number.from(info.sentTime),
        messageInfo: mZIMMessageLiteInfo(info.messageInfo),
    } as ZIMMessageRepliedInfo;
};

