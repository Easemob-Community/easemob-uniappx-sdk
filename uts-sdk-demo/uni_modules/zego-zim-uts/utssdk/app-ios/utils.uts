    return infos.map((v) => {
        const json: ZIMGroupApplicationInfo = {
            type: v.type.rawValue,
            state: v.state.rawValue,
            createTime: Number.from(v.createTime),
            updateTime: Number.from(v.updateTime),
            wording: v.wording,
            applyUser: mZIMUserInfo(v.applyUser),
            groupInfo: mZIMGroupInfo(v.groupInfo),
        };
        if (v.operatedUser != null) {
            json.operatedUser = mZIMGroupMemberSimpleInfo(v.operatedUser!);
        }
        return json;
    });
};

