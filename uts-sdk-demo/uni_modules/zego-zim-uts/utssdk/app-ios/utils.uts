    return infos.map((v) => mZIMUserOrGroupMember(v));
};

export const mZIMGroupMemberSimpleInfo = (info: NZIMGroupMemberSimpleInfo) => {
    return {
        userID: info.userID,
        userName: info.userName,
        userAvatarUrl: info.userAvatarUrl,
        memberRole: Number.from(info.memberRole),
        memberNickname: info.memberNickname,
    } as ZIMGroupMemberSimpleInfo;
};

export const mZIMGroupMemberInfo = (info: NZIMGroupMemberInfo) => {
    const groupEnterInfo: ZIMGroupEnterInfo = {
        enterTime: Number.from(info.groupEnterInfo.enterTime),
        enterType: info.groupEnterInfo.enterType.rawValue,
    };
    if (info.groupEnterInfo.operatedUser != null) {
        groupEnterInfo.operatedUser = mZIMGroupMemberSimpleInfo(info.groupEnterInfo.operatedUser!);
    }

    return {
        userID: info.userID,
        userName: info.userName,
        userAvatarUrl: info.userAvatarUrl,
        memberRole: Number.from(info.memberRole),
        memberNickname: info.memberNickname,
        muteExpiredTime: Number.from(info.muteExpiredTime),
        groupEnterInfo,
    } as ZIMGroupMemberInfo;
};

export const mZIMGroupMemberInfoList = (infos: Array<NZIMGroupMemberInfo>) => {
    return infos.map((v) => mZIMGroupMemberInfo(v));
};

export const mZIMGroupFullInfo = (info: NZIMGroupFullInfo) => {
    return {
        baseInfo: mZIMGroupInfo(info.baseInfo),
        groupAlias: info.groupAlias,
        groupNotice: info.groupNotice,
        groupAttributes: mMap(info.groupAttributes),
        notificationStatus: info.notificationStatus.rawValue,
        createTime: Number.from(info.createTime),
        maxMemberCount: Number.from(info.maxMemberCount),
        mutedInfo: info.mutedInfo != null ? mZIMGroupMuteInfo(info.mutedInfo) : { mode: 0, expiredTime: 0, roles: [] },
        verifyInfo: info.verifyInfo != null ? mZIMGroupVerifyInfo(info.verifyInfo) : { joinMode: 0, inviteMode: 0, beInviteMode: 0 };
    } as ZIMGroupFullInfo;
};

