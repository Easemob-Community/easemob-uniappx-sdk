    obj.userName = info.userName;
    obj.userAvatarUrl = info.userAvatarUrl;
    obj.memberNickname = info.memberNickname;
    obj.memberRole = info.memberRole.toInt32();
    return obj;
};

export const mZIMUserOrGroupMember = (info: NZIMUserInfo) => {
    const map = {
        userID: info.userID,
        userName: info.userName,
        userAvatarUrl: info.userAvatarUrl,
        memberRole: 0,
        memberNickname: '',
    } as ZIMGroupMemberSimpleInfo;
    if (info instanceof NZIMGroupMemberSimpleInfo) {
        map.memberRole = Number.from((info as NZIMGroupMemberSimpleInfo).memberRole);
        map.memberNickname = (info as NZIMGroupMemberSimpleInfo).memberNickname;
    }
    return map;
};

