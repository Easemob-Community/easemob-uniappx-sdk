const unCombineMessageTypes = [2, 20, 31, 32, 100];
const multipleMessageTypes = [1, 200, 11, 12, 13, 14];

// MARK: - Public

export const oMap = (json: UTSJSONObject): HashMap<string, string> => {
    const map: HashMap<string, string> = new HashMap<string, string>();
    for (const key in json) {
        map.put(key, json[key] as string);
    }

    return map;
};

export const mMap = (map: HashMap<string, string>) => {
    const json = {} as UTSJSONObject;
    for (const key in map.keys) {
        json[key] = map.get(key);
    }
    return json;
};

export const oStringArray = (infos: string[]): ArrayList<string> => {
    const _infos: ArrayList<string> = new ArrayList<string>();
    for (let i = 0; i < infos.length; i++) {
        _infos.add(infos[i]);
    }
    
    return _infos;
};

export const mStringArray = (infos: ArrayList<Long>): string[] => {
    const list: string[] = [];
    
    for (let i = 0; i < infos.size; i++) {
        list.push(infos.get(i as Int).toString());
    }
    
    return list;
};

export const oZIMPushConfig = (info: ZIMPushConfig): NZIMPushConfig => {
    const obj: NZIMPushConfig = new NZIMPushConfig();
    obj.title = info.title ?? '';
    obj.content = info.content ?? '';
    obj.payload = info.payload ?? '';
    obj.resourcesID = info.resourcesID ?? '';
    obj.badgeIncrement = (info.badgeIncrement ?? 0) as Int;
    obj.enableBadge = info.enableBadge ?? false;
    if (info.voIPConfig != null) {
        obj.voIPConfig = new NZIMVoIPConfig();
        obj.voIPConfig.iOSVoIPHandleType = NZIMCXHandleType.getZIMCXHandleType(
            info.voIPConfig!.iOSVoIPHandleType.toInt(),
        );
        obj.voIPConfig.iOSVoIPHandleValue = info.voIPConfig!.iOSVoIPHandleValue ?? '';
        obj.voIPConfig.iOSVoIPHasVideo = info.voIPConfig!.iOSVoIPHasVideo ?? false;
    }
    if (info.privateMessageTemplate != null) {
        obj.privateMessageTemplate = new NZIMOfflinePushPrivateMessageTemplate();
        obj.privateMessageTemplate.templateID = info.privateMessageTemplate!.templateID ?? '';
        obj.privateMessageTemplate.titleParameters = info.privateMessageTemplate!.titleParameters ?? '';
        obj.privateMessageTemplate.contentParameters = info.privateMessageTemplate!.contentParameters ?? '';
    }

    return obj;
};

export const mZIMPlatformTypeList = (infos: ArrayList<NZIMPlatformType>) => {
    const list: ZIMPlatformType[] = [];

    for (let i = 0; i < infos.size; i++) {
        list.push(infos.get(i as Int).value());
