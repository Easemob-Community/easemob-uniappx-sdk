};

export const mZIMGroupSearchInfoList = (infos: ArrayList<NZIMGroupSearchInfo>) => {
    const list: ZIMGroupSearchInfo[] = [];

    for (let i = 0; i < infos.size; i++) {
        const info = infos.get(i as Int);
        list.push({
            groupInfo: mZIMGroupInfo(info.groupInfo),
            userList: mZIMGroupMemberInfoList(info.userList),
        });
    }

    return list;
};

