export const oZIMUserOrGroupMember = (info: ZIMGroupMemberSimpleInfo): NZIMUserInfo => {
    const obj = new NZIMGroupMemberSimpleInfo();
    obj.userID = info.userID;
    obj.userName = info.userName;
    obj.userAvatarUrl = info.userAvatarUrl;
    obj.memberRole = (info as ZIMGroupMemberSimpleInfo).memberRole as Int;
    obj.memberNickname = (info as ZIMGroupMemberSimpleInfo).memberNickname;
    return obj;
};

export const mZIMUserOrGroupMember = (info: NZIMUserInfo) => {
    const map = {
        userID: info.userID,
        userName: info.userName,
        userAvatarUrl: info.userAvatarUrl,
        memberRole: 0,
        memberNickname: '',
    } as ZIMGroupMemberSimpleInfo;
    if (info instanceof NZIMGroupMemberSimpleInfo) {
        map.memberRole = info.memberRole;
        map.memberNickname = info.memberNickname;
    }
    return map;
};

export const mZIMUserOrGroupMemberList = (infos: ArrayList<NZIMUserInfo>) => {
    const list: ZIMGroupMemberSimpleInfo[] = [];

    for (let i = 0; i < infos.size; i++) {
        list.push(mZIMUserOrGroupMember(infos.get(i as Int))!);
    }

    return list;
};

export const mZIMGroupMemberSimpleInfo = (info: NZIMGroupMemberSimpleInfo) => {
    return {
        userID: info.userID,
        userName: info.userName,
        userAvatarUrl: info.userAvatarUrl,
        memberRole: info.memberRole,
        memberNickname: info.memberNickname,
    } as ZIMGroupMemberSimpleInfo;
};

export const mZIMGroupMemberInfo = (info: NZIMGroupMemberInfo) => {
    const groupEnterInfo: ZIMGroupEnterInfo = {
        enterTime: info.groupEnterInfo.enterTime,
        enterType: info.groupEnterInfo.enterType.value(),
    };
    if (info.groupEnterInfo.operatedUser != null) {
        groupEnterInfo.operatedUser = mZIMGroupMemberSimpleInfo(info.groupEnterInfo.operatedUser!);
    }

    return {
        userID: info.userID,
        userName: info.userName,
        userAvatarUrl: info.userAvatarUrl,
        memberRole: info.memberRole,
        memberNickname: info.memberNickname,
        muteExpiredTime: info.muteExpiredTime,
        groupEnterInfo,
    } as ZIMGroupMemberInfo;
};

export const mZIMGroupMemberInfoList = (infos: ArrayList<NZIMGroupMemberInfo>) => {
    const list: ZIMGroupMemberInfo[] = [];

    for (let i = 0; i < infos.size; i++) {
        list.push(mZIMGroupMemberInfo(infos.get(i as Int)));
    }

    return list;
};

export const mZIMGroupFullInfo = (info: NZIMGroupFullInfo) => {
    const map = {
        baseInfo: mZIMGroupInfo(info.baseInfo),
        groupAlias: info.groupAlias,
        groupNotice: info.groupNotice,
        groupAttributes: mMap(info.groupAttributes),
        notificationStatus: info.notificationStatus.value(),
        createTime: info.createTime,
        maxMemberCount: info.maxMemberCount,
        mutedInfo: mZIMGroupMuteInfo(info.mutedInfo);
        verifyInfo: mZIMGroupVerifyInfo(info.verifyInfo);
    } as ZIMGroupFullInfo;
    return map;
};

export const mZIMGroupApplicationInfoList = (infos: ArrayList<NZIMGroupApplicationInfo>) => {
    const list: ZIMGroupApplicationInfo[] = [];

    for (let i = 0; i < infos.size; i++) {
        const info = infos.get(i as Int);
        const json: ZIMGroupApplicationInfo = {
            type: info.type.value(),
            state: info.state.value(),
            createTime: info.createTime,
            updateTime: info.updateTime,
            wording: info.wording,
            applyUser: mZIMUserInfo(info.applyUser),
            groupInfo: mZIMGroupInfo(info.groupInfo),
        };
        if (info.operatedUser != null) {
            json.operatedUser = mZIMGroupMemberSimpleInfo(info.operatedUser!);
        }
        list.push(json);
    }

    return list;
};

export const mZIMGroupAttributesUpdateInfoList = (infos: ArrayList<NZIMGroupAttributesUpdateInfo>) => {
    const list: ZIMGroupAttributesUpdateInfo[] = [];

    for (let i = 0; i < infos.size; i++) {
        const info = infos.get(i as Int);
        list.push({ action: info.action.value(), groupAttributes: mMap(info.groupAttributes) });
    }

