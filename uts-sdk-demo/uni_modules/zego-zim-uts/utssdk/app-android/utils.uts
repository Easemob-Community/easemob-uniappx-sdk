    return obj;
};

export const oZIMRoomAdvancedConfig = (config?: ZIMRoomAdvancedConfig): NZIMRoomAdvancedConfig => {
    const _config: NZIMRoomAdvancedConfig = new NZIMRoomAdvancedConfig();
    if (config != null) {
        _config.roomAttributes = oMap(config!.roomAttributes ?? {});
        _config.roomDestroyDelayTime = (config!.roomDestroyDelayTime ?? 0) as Int;
    }
    return _config;
};

