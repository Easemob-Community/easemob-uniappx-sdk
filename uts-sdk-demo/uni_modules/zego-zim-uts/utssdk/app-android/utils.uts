// MARK: - Conversation

export const oZIMConversation = (info: ZIMConversation): NZIMConversation => {
    const obj: NZIMConversation = new NZIMConversation();
    obj.conversationID = info.conversationID;
    obj.type = NZIMConversationType.getZIMConversationType(info.type.toInt());
    obj.orderKey = info.orderKey.toLong();

    return obj;
};

export const mZIMConversation = (info: NZIMConversation) => {
    const mentionedInfoList: ZIMMessageMentionedInfo[] = [];
    if (info.mentionedInfoList != null && info.mentionedInfoList.size > 0) {
        for (let i = 0; i < info.mentionedInfoList.size; i++) {
            const item: NZIMMessageMentionedInfo = info.mentionedInfoList.get(i as Int);
            mentionedInfoList.push({
                type: item.type.value(),
                fromUserID: item.fromUserID,
                messageID: item.messageID.toString(),
                messageSeq: item.messageSeq,
            });
        }
    }

    const map: ZIMConversation = {
        conversationID: info.conversationID,
        conversationName: info.conversationName,
        conversationAlias: info.conversationAlias,
        conversationAvatarUrl: info.conversationAvatarUrl,
        type: info.type.value(),
        notificationStatus: info.notificationStatus.value(),
        unreadMessageCount: info.unreadMessageCount,
        orderKey: info.orderKey,
        isPinned: info.isPinned,
        pinnedTime: info.pinnedTime,
        draft: info.draft,
        marks: Array.fromNative(info.marks) as number[],
        mentionedInfoList,
    };

    if (info.lastMessage != null) {
        map.lastMessage = mZIMMessage(info.lastMessage);
    }
    if (info instanceof NZIMGroupConversation) {
        map.isDisabled = info.isDisabled;
        map.mutedExpiredTime = info.mutedExpiredTime;
    }

    return map;
};

export const mZIMConversationList = (infos: ArrayList<NZIMConversation>) => {
    const list: ZIMConversation[] = [];

    for (let i = 0; i < infos.size; i++) {
        list.push(mZIMConversation(infos.get(i as Int)));
    }

    return list;
};

export const mZIMConversationChangeInfoList = (infos: ArrayList<NZIMConversationChangeInfo>) => {
    const list: ZIMConversationChangeInfo[] = [];

    for (let i = 0; i < infos.size; i++) {
        const info = infos.get(i as Int);
        list.push({ event: info.event.value(), conversation: mZIMConversation(info.conversation) });
    }

    return list;
};

export const oZIMConversationBaseInfoList = (infos: ZIMConversationBaseInfo[]): ArrayList<NZIMConversationBaseInfo> => {
    const _infos: ArrayList<NZIMConversationBaseInfo> = new ArrayList<NZIMConversationBaseInfo>();
    for (let i = 0; i < infos.length; i++) {
        const item = infos[i];
        const info = new NZIMConversationBaseInfo();
        info.conversationID = item.conversationID;
        info.conversationType = NZIMConversationType.getZIMConversationType(item.conversationType.toInt());
        _infos.add(info);        
    }
    return _infos;
};

export const mZIMConversationBaseInfoList = (infos: ArrayList<NZIMConversationBaseInfo>) => {
    const list: ZIMConversationBaseInfo[] = [];

    for (let i = 0; i < infos.size; i++) {
        const info = infos.get(i as Int);
        list.push({
            conversationID: info.conversationID,
            conversationType: info.conversationType.value(),
        });
    }

    return list;
};

// MARK: - Message

export const oZIMMessage = (info: ZIMMessage, isSend: boolean): NZIMMessage => {
    const type = info.type!;
    let obj = oZIMCombineMessage(info, isSend);
    // 合并消息子项
    if (unCombineMessageTypes.indexOf(type) == -1) {
        return obj;
    }
    
    // 根据消息类型赋值
    if (type == 2) {
        const bytes = info.message! as number[];
        const arr = new ByteArray(bytes.length as Int);
        for (let i = 0; i < bytes.length; i++) {
            arr[i as Int] = bytes[i].toByte();
        }
        obj = new NZIMCommandMessage(arr);
    } else if (type == 20) {
        obj = new NZIMBarrageMessage((info.message ?? '') as string);
    } else if (type == 31) {
        obj = new NZIMRevokeMessage();
        try {
            const clz = Class.forName('im.zego.zim.entity.ZIMRevokeMessage');
            
            let field = clz.getDeclaredField('revokeType');
            field.setAccessible(true);
            field.set(obj, NZIMRevokeType.getZIMRevokeType(info.revokeType!.toInt()));
            field.setAccessible(false);
            
            field = clz.getDeclaredField('revokeStatus');
            field.setAccessible(true);
            field.set(obj, NZIMMessageRevokeStatus.getZIMMessageRevokeStatus(info.revokeStatus!.toInt()));
            field.setAccessible(false);

            field = clz.getDeclaredField('originalMessageType');
            field.setAccessible(true);
            field.set(obj, NZIMMessageType.getZIMMessageType(info.originalMessageType!.toInt()));
            field.setAccessible(false);

            field = clz.getDeclaredField('originalTextMessageContent');
            field.setAccessible(true);
            field.set(obj, info.originalTextMessageContent ?? '');
            field.setAccessible(false);

            field = clz.getDeclaredField('revokeTimestamp');
            field.setAccessible(true);
            field.set(obj, info.revokeTimestamp ?? 0);
            field.setAccessible(false);

            field = clz.getDeclaredField('operatedUserID');
            field.setAccessible(true);
            field.set(obj, info.operatedUserID ?? '');
            field.setAccessible(false);

            field = clz.getDeclaredField('revokeExtendedData');
            field.setAccessible(true);
            field.set(obj, info.revokeExtendedData ?? '');
            field.setAccessible(false);
        } catch (error) {}
    } else if (type == 32) {
        const map = new NZIMTipsMessage();
        obj = map;
        map.event = NZIMTipsMessageEvent.getZIMTipsMessageEvent(info.event!.toInt());
        if (info.operatedUser != null) {
            map.operatedUser = oZIMUserOrGroupMember(info.operatedUser!);
        }
        if (info.targetUserList != null) {
            const _infos: ArrayList<NZIMUserInfo> = new ArrayList<NZIMUserInfo>();
            for (let i = 0; i < info.targetUserList!.length; i++) {
                _infos.add(oZIMUserOrGroupMember(info.targetUserList![i]));
            }
            map.targetUserList = _infos;
        }
        if (info.changeInfo != null) {
            map.changeInfo = oZIMTipsMessageChangeInfo(info.changeInfo!);
        }
    } else if (type == 100) {
        const messageList = new ArrayList<NZIMMessage>();
        if (info.messageList != null) {
            for (let i = 0; i < info.messageList!.length; i++) {
                const v = info.messageList![i];
                if (v.type == 100) {
                    const msg = new NZIMCombineMessage(v.title ?? '', v.summary ?? '', new ArrayList<NZIMMessage>());
                    try {
                        const clz = Class.forName('im.zego.zim.entity.ZIMCombineMessage');
                        
                        const field = clz.getDeclaredField('combineID');
                        field.setAccessible(true);
                        field.set(msg, v.combineID ?? '');
                        field.setAccessible(false);
                    } catch (error) {}
                    setZIMMessageValue(msg, v, isSend);
                    messageList.add(msg);
                } else {
                    messageList.add(oZIMCombineMessage(v, isSend));
                }
            }
        }
        obj = new NZIMCombineMessage(info.title ?? '', info.summary ?? '', messageList);
        try {
            const clz = Class.forName('im.zego.zim.entity.ZIMCombineMessage');
            
            const field = clz.getDeclaredField('combineID');
            field.setAccessible(true);
            field.set(obj, info.combineID ?? '');
            field.setAccessible(false);
        } catch (error) {}
    } 

    setZIMMessageValue(obj, info, isSend);
    
    return obj;
};
/**
 * Error: recursive problem
 */
const oZIMCombineMessage = (info: ZIMMessage, isSend: boolean): NZIMMessage => {
    const type = info.type;
    let obj: NZIMMessage = new NZIMMessage(NZIMMessageType.getZIMMessageType(type.toInt()));

    // 根据消息类型赋值
    if (type == 1) {
        obj = new NZIMTextMessage((info.message ?? '') as string);
    } else if (type == 200) {
        obj = new NZIMCustomMessage((info.message ?? '') as string, (info.subType ?? 0).toInt());
        (obj as NZIMCustomMessage).searchedContent = info.searchedContent ?? '';
    } else if (type == 10) {
        obj = new NZIMMultipleMessage();
        (obj as NZIMMultipleMessage).setMessageInfoList(oZIMMessageLiteInfoList(info.messageInfoList!));
    } else if (type == 11) {
        obj = new NZIMImageMessage((info.fileLocalPath ?? '') as string);
        (obj as NZIMImageMessage).setThumbnailDownloadUrl(info.thumbnailDownloadUrl ?? '');
        (obj as NZIMImageMessage).setLargeImageDownloadUrl(info.largeImageDownloadUrl ?? '');

        try {
            const clz = Class.forName('im.zego.zim.entity.ZIMImageMessage');
            
            let field = clz.getDeclaredField('thumbnailLocalPath');
            field.setAccessible(true);
            field.set(obj, info.thumbnailLocalPath ?? '');
            field.setAccessible(false);

            field = clz.getDeclaredField('largeImageLocalPath');
            field.setAccessible(true);
            field.set(obj, info.largeImageLocalPath ?? '');
            field.setAccessible(false);

            field = clz.getDeclaredField('originalImageWidth');
            field.setAccessible(true);
            field.set(obj, info.originalImageWidth ?? 0);
            field.setAccessible(false);

            field = clz.getDeclaredField('originalImageHeight');
            field.setAccessible(true);
            field.set(obj, info.originalImageHeight ?? 0);
            field.setAccessible(false);

            field = clz.getDeclaredField('thumbnailWidth');
            field.setAccessible(true);
            field.set(obj, info.thumbnailWidth ?? 0);
            field.setAccessible(false);

            field = clz.getDeclaredField('thumbnailHeight');
            field.setAccessible(true);
            field.set(obj, info.thumbnailHeight ?? 0);
            field.setAccessible(false);

            field = clz.getDeclaredField('largeImageWidth');
            field.setAccessible(true);
            field.set(obj, info.largeImageWidth ?? 0);
            field.setAccessible(false);

            field = clz.getDeclaredField('largeImageHeight');
            field.setAccessible(true);
            field.set(obj, info.largeImageHeight ?? 0);
            field.setAccessible(false);
        } catch (error) {}
    } else if (type == 12) {
        obj = new NZIMFileMessage((info.fileLocalPath ?? '') as string);
    } else if (type == 13) {
        obj = new NZIMAudioMessage((info.fileLocalPath ?? '') as string, (info.audioDuration ?? 0).toLong());
    } else if (type == 14) {
        obj = new NZIMVideoMessage((info.fileLocalPath ?? '') as string, (info.videoDuration ?? 0).toLong());

        try {
            const clz = Class.forName('im.zego.zim.entity.ZIMVideoMessage');
            
            let field = clz.getDeclaredField('videoFirstFrameDownloadUrl');
            field.setAccessible(true);
            field.set(obj, info.videoFirstFrameDownloadUrl ?? '');
            field.setAccessible(false);

            field = clz.getDeclaredField('videoFirstFrameLocalPath');
            field.setAccessible(true);
            field.set(obj, info.videoFirstFrameLocalPath ?? '');
            field.setAccessible(false);

            field = clz.getDeclaredField('videoFirstFrameWidth');
            field.setAccessible(true);
            field.set(obj, info.videoFirstFrameWidth ?? 0);
            field.setAccessible(false);

            field = clz.getDeclaredField('videoFirstFrameHeight');
            field.setAccessible(true);
            field.set(obj, info.videoFirstFrameHeight ?? 0);
            field.setAccessible(false);
        } catch (error) {}
    }

    if (obj instanceof NZIMMediaMessage) {
        try {
            (obj as NZIMMediaMessage).setFileDownloadUrl(info.fileDownloadUrl ?? '');

            const clz = Class.forName('im.zego.zim.entity.ZIMMediaMessage');
            
            let field = clz.getDeclaredField('fileUID');
            field.setAccessible(true);
            field.set(obj, info.fileUID ?? '');
            field.setAccessible(false);

            field = clz.getDeclaredField('fileName');
            field.setAccessible(true);
            field.set(obj, info.fileName ?? '');
            field.setAccessible(false);

            field = clz.getDeclaredField('fileSize');
            field.setAccessible(true);
            field.set(obj, info.fileSize ?? 0);
            field.setAccessible(false);
        } catch (error) {}
    }

    setZIMMessageValue(obj, info, isSend);
    
    return obj;
};
/**
 * 设置公共属性
 */
const setZIMMessageValue = (obj: NZIMMessage, info: ZIMMessage, isSend: boolean) => {
    if (info.mentionedUserIDs != null) {
        obj.setMentionedUserIDs(oStringArray(info.mentionedUserIDs!));    
    }
    obj.setIsMentionAll(info.isMentionAll ?? false);
    obj.extendedData = info.extendedData ?? '';
    obj.localExtendedData = info.localExtendedData ?? '';
    
    if (!isSend) {
        try {
            const clz = Class.forName('im.zego.zim.entity.ZIMMessage');
            
            let field = clz.getDeclaredField('messageID');
            field.setAccessible(true);
            field.set(obj, info.messageID != null && info.messageID != '' ? parseInt(info.messageID!, 10).toLong() : 0);
            field.setAccessible(false);
            
            field = clz.getDeclaredField('localMessageID');
            field.setAccessible(true);
            field.set(obj, info.localMessageID != null && info.localMessageID != '' ? parseInt(info.localMessageID!, 10).toLong() : 0);
            field.setAccessible(false);

            if (info.repliedInfo != null) {
                field = clz.getDeclaredField('repliedInfo');
                field.setAccessible(true);
                field.set(obj, oZIMMessageRepliedInfo(info.repliedInfo!));
                field.setAccessible(false);
            }

            field = clz.getDeclaredField('conversationType');
            field.setAccessible(true);
            field.set(obj, NZIMConversationType.getZIMConversationType(info.conversationType!.toInt()));
            field.setAccessible(false);
                
            field = clz.getDeclaredField('direction');
            field.setAccessible(true);
            field.set(obj, NZIMMessageDirection.getZIMMessageDirection(info.direction!.toInt()));
            field.setAccessible(false);
                
            field = clz.getDeclaredField('sentStatus');
            field.setAccessible(true);
            field.set(obj, NZIMMessageSentStatus.getZIMMessageSentStatus(info.sentStatus!.toInt()));
            field.setAccessible(false);
                
            field = clz.getDeclaredField('receiptStatus');
            field.setAccessible(true);
            field.set(obj, NZIMMessageReceiptStatus.getZIMMessageReceiptStatus(info.receiptStatus!.toInt()));
            field.setAccessible(false);

            field = clz.getDeclaredField('isUserInserted');
            field.setAccessible(true);
            field.set(obj, info.isUserInserted ?? false);
            field.setAccessible(false);
                
            field = clz.getDeclaredField('isServerMessage');
            field.setAccessible(true);
            field.set(obj, info.isServerMessage ?? false);
            field.setAccessible(false);
            
            field = clz.getDeclaredField('isBroadcastMessage');
            field.setAccessible(true);
            field.set(obj, info.isBroadcastMessage ?? false);
            field.setAccessible(false);
            
            field = clz.getDeclaredField('isGroupTargetedMessage');
            field.setAccessible(true);
            field.set(obj, info.isGroupTargetedMessage ?? false);
            field.setAccessible(false);
                  
            field = clz.getDeclaredField('messageSeq');
            field.setAccessible(true);
            field.set(obj, info.messageSeq ?? 0);
            field.setAccessible(false);
            field = clz.getDeclaredField('conversationSeq');
            field.setAccessible(true);
            field.set(obj, info.messageSeq ?? 0);
            field.setAccessible(false);
                
            field = clz.getDeclaredField('orderKey');
            field.setAccessible(true);
            field.set(obj, info.orderKey ?? 0);
            field.setAccessible(false);

            field = clz.getDeclaredField('timestamp');
            field.setAccessible(true);
            field.set(obj, info.timestamp ?? 0);
            field.setAccessible(false);

            field = clz.getDeclaredField('rootRepliedCount');
            field.setAccessible(true);
            field.set(obj, info.rootRepliedCount ?? 0);
            field.setAccessible(false);

            field = clz.getDeclaredField('editedTime');
            field.setAccessible(true);
            field.set(obj, info.editedTime ?? 0);
            field.setAccessible(false);

            field = clz.getDeclaredField('editorUserID');
            field.setAccessible(true);
            field.set(obj, info.editorUserID ?? '');
            field.setAccessible(false);

            field = clz.getDeclaredField('pinnedTime');
            field.setAccessible(true);
            field.set(obj, info.pinnedTime ?? 0);
            field.setAccessible(false);

            field = clz.getDeclaredField('pinnedUserID');
            field.setAccessible(true);
            field.set(obj, info.pinnedUserID ?? '');
            field.setAccessible(false);
            
            field = clz.getDeclaredField('senderUserID');
            field.setAccessible(true);
            field.set(obj, info.senderUserID ?? '');
            field.setAccessible(false);

            field = clz.getDeclaredField('conversationID');
            field.setAccessible(true);
            field.set(obj, info.conversationID ?? '');
            field.setAccessible(false);
        } catch (error) {}
    }    
}

export const mZIMMessage = (info: NZIMMessage) => {
    const type = info.getType().value() as ZIMMessageType;
    const map = mZIMCombineMessage(info);
    // 合并消息子项
    if (unCombineMessageTypes.indexOf(type) == -1) {
        return map;
    }

    // 根据消息类型赋值
    if (type == 2) {
        const bytes: number[] = [];
        const arr = Array.fromNative((info as NZIMCommandMessage).message) as ArrayList<number>;
        for (let i = 0; i < arr.size; i++) {
            let b = arr.get(i as Int);
            bytes.push(b < 0 ? 256 + b : b);
        }
        map.message = bytes;
    } else if (type == 20) {
        map.message = (info as NZIMBarrageMessage).message;
    } else if (type == 31) {
        const _info = info as NZIMRevokeMessage;
        map.revokeType = _info.getRevokeType().value();
        map.revokeStatus = _info.getRevokeStatus().value();
        map.originalMessageType = _info.getOriginalMessageType().value();
        map.originalTextMessageContent = _info.getOriginalTextMessageContent();
        map.revokeTimestamp = _info.getRevokeTimestamp();
        map.operatedUserID = _info.getOperatedUserID();
        map.revokeExtendedData = _info.getRevokeExtendedData();
    } else if (type == 32) {
        const _info = info as NZIMTipsMessage;
        map.event = _info.event.value();
        map.operatedUser = mZIMUserOrGroupMember(_info.operatedUser);
        map.targetUserList = mZIMUserOrGroupMemberList(_info.targetUserList);
        if (_info.changeInfo != null) { 
            map.changeInfo = mZIMTipsMessageChangeInfo(_info.changeInfo!);
        }
    } else if (type == 100) {
        const _info = info as NZIMCombineMessage;
        map.title = _info.title;
        map.summary = _info.summary;
        map.combineID = _info.getCombineID();
        
        const list: ZIMMessage[] = [];
        for (let i = 0; i < _info.messageList.size; i++) {
            const v = _info.messageList.get(i as Int) as NZIMMessage;
            const msg = mZIMCombineMessage(v);
            if (msg.type == 100) {
                const _v = v as NZIMCombineMessage;
                msg.title = _v.title;
                msg.summary = _v.summary;
                msg.combineID = _v.getCombineID();
                msg.messageList = [];
            }
            list.push(msg);
        }
        map.messageList = list;
    }

    return map;
};
/**
 * Error: recursive problem
 */
const mZIMCombineMessage = (info: NZIMMessage) => {
    const type = info.getType().value() as ZIMMessageType;
    const map = { type } as ZIMMessage;

    // 公共属性
    const messageID = info.getMessageID().toString();
    map.extendedData = info.extendedData;
    map.localExtendedData = info.localExtendedData;
    map.isMentionAll = info.isMentionAll();
    map.mentionedUserIDs = Array.fromNative(info.getMentionedUserIDs()) as string[];
    map.messageID = messageID.length > 1 ? messageID : '';
    map.localMessageID = info.getLocalMessageID().toString();
    map.senderUserID = info.getSenderUserID();
    map.timestamp = info.getTimestamp();
    map.messageSeq = info.getMessageSeq();
    map.orderKey = info.getOrderKey();
    map.conversationID = info.getConversationID();
    map.conversationType = info.getConversationType().value();
    map.direction = info.getDirection().value();
    map.sentStatus = info.getSentStatus().value();
    map.receiptStatus = info.getReceiptStatus().value();
    map.isUserInserted = info.isUserInserted();
    map.isServerMessage = info.isServerMessage();
    map.isBroadcastMessage = info.isBroadcastMessage();
    map.isGroupTargetedMessage = info.isGroupTargetedMessage();
    map.reactions = mZIMMessageReactionList(info.getReactions());
    map.rootRepliedCount = info.getRootRepliedCount();
    map.editorUserID = info.getEditorUserID();
    map.editedTime = info.getEditedTime();
    map.pinnedUserID = info.getPinnedUserID();
    map.pinnedTime = info.getPinnedTime();
    const repliedInfo = info.getRepliedInfo();
    if (repliedInfo != null) {
        map.repliedInfo = mZIMMessageRepliedInfo(repliedInfo!);
    }

    // 根据消息类型赋值
    if (type == 1) {
        map.message = (info as NZIMTextMessage).message;
    } else if (type == 200) {
        const _info = info as NZIMCustomMessage;
        map.message = _info.message;
        map.subType = _info.subType;
        map.searchedContent = _info.searchedContent;
    } else if (type == 10) {
        map.messageInfoList = mZIMMessageLiteInfoList((info as NZIMMultipleMessage).getMessageInfoList());
    } else if (type == 11) {
        const _info = info as NZIMImageMessage;
        map.thumbnailDownloadUrl = _info.getThumbnailDownloadUrl();
        map.thumbnailLocalPath = _info.getThumbnailLocalPath();
        map.largeImageDownloadUrl = _info.getLargeImageDownloadUrl();
        map.largeImageLocalPath = _info.getLargeImageLocalPath();
        map.originalImageWidth = _info.getOriginalImageWidth();
        map.originalImageHeight = _info.getOriginalImageHeight();
        map.thumbnailWidth = _info.getThumbnailWidth();
        map.thumbnailHeight = _info.getThumbnailHeight();
        map.largeImageWidth = _info.getLargeImageWidth();
        map.largeImageHeight = _info.getLargeImageHeight();
    } else if (type == 13) {
        map.audioDuration = (info as NZIMAudioMessage).getAudioDuration();
    } else if (type == 14) {
        const _info = info as NZIMVideoMessage;
        map.videoDuration = _info.getVideoDuration();
        map.videoFirstFrameDownloadUrl = _info.getVideoFirstFrameDownloadUrl();
        map.videoFirstFrameLocalPath = _info.getVideoFirstFrameLocalPath();
        map.videoFirstFrameWidth = _info.getVideoFirstFrameWidth();
        map.videoFirstFrameHeight = _info.getVideoFirstFrameHeight();
    }

    if (info instanceof NZIMMediaMessage) {
        const _info = info as NZIMMediaMessage;
        map.fileDownloadUrl = _info.getFileDownloadUrl();
        map.fileLocalPath = _info.getFileLocalPath();
        map.fileUID = _info.getFileUID();
        map.fileName = _info.getFileName();
        map.fileSize = _info.getFileSize();
    }

    return map;
};

export const oZIMMessageLiteInfo = (info: ZIMMessageLiteInfo): NZIMMessageLiteInfo => {
    const type = info.type!;
    let obj = oZIMMultipleMessageLiteInfo(info);
    // 组合消息子项
    if (multipleMessageTypes.indexOf(type) != -1) {
        return obj;
    }

    // 根据消息类型赋值
    if (type == 31) {
        obj = new NZIMRevokeMessageLiteInfo();
    } else if (type == 100) {
        obj = new NZIMCombineMessageLiteInfo();
        (obj as NZIMCombineMessageLiteInfo).title = info.title ?? '';
        (obj as NZIMCombineMessageLiteInfo).summary = info.summary ?? '';
    } else if (type == 10) {
        obj = new NZIMMultipleMessageLiteInfo();
        if (info.messageInfoList != null) {            
            const _infos: ArrayList<NZIMMessageLiteInfo> = new ArrayList<NZIMMessageLiteInfo>();
            for (let i = 0; i < info.messageInfoList!.length; i++) {
                _infos.add(oZIMMultipleMessageLiteInfo(info.messageInfoList![i]));
            }
            (obj as NZIMMultipleMessageLiteInfo).messageInfoList = _infos;
        }
    }
    
    return obj;
};
/**
 * Error: recursive problem
 */
const oZIMMultipleMessageLiteInfo = (info: ZIMMessageLiteInfo): NZIMMessageLiteInfo => {
    let obj: NZIMMessageLiteInfo = new NZIMMessageLiteInfo();

    // 根据消息类型赋值
    const type = info.type;
    if (type == 1) {
        obj = new NZIMTextMessageLiteInfo();
        (obj as NZIMTextMessageLiteInfo).message = info.message ?? '';
    } else if (type == 200) {
        const map = new NZIMCustomMessageLiteInfo();
        obj = map;
        map.message = info.message ?? '';
        map.subType = (info.subType ?? 0) as Int;
        map.searchedContent = info.searchedContent ?? '';
    } else if (type == 11) {
        const map = new NZIMImageMessageLiteInfo();
        obj = map;
        map.thumbnailDownloadUrl = info.thumbnailDownloadUrl ?? '';
        map.thumbnailLocalPath = info.thumbnailLocalPath ?? '';
        map.largeImageDownloadUrl = info.largeImageDownloadUrl ?? '';
        map.largeImageLocalPath = info.largeImageLocalPath ?? '';
        map.originalImageWidth = (info.originalImageWidth ?? 0) as Int;
        map.originalImageHeight = (info.originalImageHeight ?? 0) as Int;
        map.thumbnailWidth = (info.thumbnailWidth ?? 0) as Int;
        map.thumbnailHeight = (info.thumbnailHeight ?? 0) as Int;
        map.largeImageWidth = (info.largeImageWidth ?? 0) as Int;
        map.largeImageHeight = (info.largeImageHeight ?? 0) as Int;
    } else if (type == 12) {
        obj = new NZIMFileMessageLiteInfo();
    } else if (type == 13) {
        obj = new NZIMAudioMessageLiteInfo();
        (obj as NZIMAudioMessageLiteInfo).audioDuration = (info.audioDuration ?? 0).toLong();
    } else if (type == 14) {
        const map = new NZIMVideoMessageLiteInfo();
        obj = map;
        map.videoDuration = (info.videoDuration ?? 0).toLong();
        map.videoFirstFrameDownloadUrl = info.videoFirstFrameDownloadUrl ?? '';
        map.videoFirstFrameLocalPath = info.videoFirstFrameLocalPath ?? '';
        map.videoFirstFrameWidth = (info.videoFirstFrameWidth ?? 0) as Int;
        map.videoFirstFrameHeight = (info.videoFirstFrameHeight ?? 0) as Int;
    }

    if (obj instanceof NZIMMediaMessageLiteInfo) {
        const map = obj as NZIMMediaMessageLiteInfo;
        map.fileDownloadUrl = info.fileDownloadUrl ?? '';
        map.fileLocalPath = (info.fileLocalPath ?? '') as string;
        map.fileName = info.fileName ?? '';
        map.fileSize = (info.fileSize ?? 0).toLong();
    }

    return obj;
};

export const mZIMMessageLiteInfo = (info: NZIMMessageLiteInfo) => {
    const type = info.type.value() as ZIMMessageType;
    const map = mZIMMultipleMessageLiteInfo(info);
    // 组合消息子项
    if (multipleMessageTypes.indexOf(type) != -1) {
        return map;
    }

    // 根据消息类型赋值
    if (type == 100) {
        map.title = (info as NZIMCombineMessageLiteInfo).title;
        map.summary = (info as NZIMCombineMessageLiteInfo).summary;
    } else if (type == 10) {
        const infos = (info as NZIMMultipleMessageLiteInfo).messageInfoList as ArrayList<NZIMMessageLiteInfo>;
        const list: ZIMMessageLiteInfo[] = [];
        for (let i = 0; i < infos.size; i++) {
            list.push(mZIMMultipleMessageLiteInfo(infos.get(i as Int)));
        }
        map.messageInfoList = list;
    }

    return map;
};
/**
 * Error: recursive problem
 */
const mZIMMultipleMessageLiteInfo = (info: NZIMMessageLiteInfo) => {
    const type = info.type.value() as ZIMMessageType;
    const map = { type } as ZIMMessageLiteInfo;

    // 根据消息类型赋值
    if (type == 1) {
        map.message = (info as NZIMTextMessageLiteInfo).message;
    } else if (type == 200) {
        const _info = info as NZIMCustomMessageLiteInfo;
        map.message = _info.message;
        map.subType = _info.subType;
        map.searchedContent = _info.searchedContent;
    } else if (type == 11) {
        const _info = info as NZIMImageMessageLiteInfo;
        map.thumbnailDownloadUrl = _info.thumbnailDownloadUrl;
        map.thumbnailLocalPath = _info.thumbnailLocalPath;
        map.largeImageDownloadUrl = _info.largeImageDownloadUrl;
        map.largeImageLocalPath = _info.largeImageLocalPath;
        map.originalImageWidth = _info.originalImageWidth;
        map.originalImageHeight = _info.originalImageHeight;
        map.thumbnailWidth = _info.thumbnailWidth;
        map.thumbnailHeight = _info.thumbnailHeight;
        map.largeImageWidth = _info.largeImageWidth;
        map.largeImageHeight = _info.largeImageHeight;
    } else if (type == 13) {
        map.audioDuration = (info as NZIMAudioMessageLiteInfo).audioDuration;
    } else if (type == 14) {
        const _info = info as NZIMVideoMessageLiteInfo;
        map.videoDuration = _info.videoDuration;
        map.videoFirstFrameDownloadUrl = _info.videoFirstFrameDownloadUrl;
        map.videoFirstFrameLocalPath = _info.videoFirstFrameLocalPath;
        map.videoFirstFrameWidth = _info.videoFirstFrameWidth;
        map.videoFirstFrameHeight = _info.videoFirstFrameHeight;
    }

    if (info instanceof NZIMMediaMessageLiteInfo) {
        const _info = info as NZIMMediaMessageLiteInfo;
        map.fileDownloadUrl = _info.fileDownloadUrl;
        map.fileLocalPath = _info.fileLocalPath;
        map.fileName = _info.fileName;
        map.fileSize = _info.fileSize;
    }

    return map;
};

export const oZIMMessageList = (infos: ZIMMessage[]): ArrayList<NZIMMessage> => {
    const _infos: ArrayList<NZIMMessage> = new ArrayList<NZIMMessage>();
    for (let i = 0; i < infos.length; i++) {
        _infos.add(oZIMMessage(infos[i], false));
    }

    return _infos;
};

export const mZIMMessageList = (infos: ArrayList<NZIMMessage>) => {
    const list: ZIMMessage[] = [];

    for (let i = 0; i < infos.size; i++) {
        list.push(mZIMMessage(infos.get(i as Int)));
    }

    return list;
};

export const oZIMMessageLiteInfoList = (infos: ZIMMessageLiteInfo[]): ArrayList<NZIMMessageLiteInfo> => {
    const _infos: ArrayList<NZIMMessageLiteInfo> = new ArrayList<NZIMMessageLiteInfo>();
    for (let i = 0; i < infos.length; i++) {
        _infos.add(oZIMMessageLiteInfo(infos[i]));
    }

    return _infos;
};

export const mZIMMessageLiteInfoList = (infos: ArrayList<NZIMMessageLiteInfo>) => {
    const list: ZIMMessageLiteInfo[] = [];

    for (let i = 0; i < infos.size; i++) {
        list.push(mZIMMessageLiteInfo(infos.get(i as Int)));
    }

    return list;
};

export const mZIMMessageSentStatusChangeInfoList = (infos: ArrayList<NZIMMessageSentStatusChangeInfo>) => {
    const list: ZIMMessageSentStatusChangeInfo[] = [];

    for (let i = 0; i < infos.size; i++) {
        const info = infos.get(i as Int);
        list.push({ reason: info.reason, status: info.status.value(), message: mZIMMessage(info.message) });
    }

    return list;
};

export const mZIMMessageReactionUserInfoList = (infos: ArrayList<NZIMMessageReactionUserInfo>) => {
    const list: ZIMMessageReactionUserInfo[] = [];

    for (let i = 0; i < infos.size; i++) {
        list.push({ userID: infos.get(i as Int).userID });
    }

    return list;
};

export const mZIMMessageReaction = (info: NZIMMessageReaction) => {
    return {
        conversationID: info.conversationID,
        conversationType: info.conversationType.value(),
        reactionType: info.reactionType,
        isSelfIncluded: info.isSelfIncluded,
        messageID: info.messageID.toString(),
        totalCount: info.totalCount,
        userList: mZIMMessageReactionUserInfoList(info.userList),
    } as ZIMMessageReaction;
};

export const mZIMMessageReactionList = (infos: ArrayList<NZIMMessageReaction>) => {
    const list: ZIMMessageReaction[] = [];

    for (let i = 0; i < infos.size; i++) {
        list.push(mZIMMessageReaction(infos.get(i as Int)));
    }

    return list;
};

export const mZIMMessageReceiptInfoList = (infos: ArrayList<NZIMMessageReceiptInfo>) => {
    const list: ZIMMessageReceiptInfo[] = [];

    for (let i = 0; i < infos.size; i++) {
        const info = infos.get(i as Int);
        list.push({
            conversationID: info.conversationID,
            conversationType: info.conversationType.value(),
            status: info.status.value(),
            messageID: info.messageID.toString(),
            readMemberCount: info.readMemberCount,
            unreadMemberCount: info.unreadMemberCount,
            isSelfOperated: info.isSelfOperated,
            readTime: info.readTime.toLong(),
        });
    }

    return list;
};

export const oZIMMessageRepliedInfo = (info: ZIMMessageRepliedInfo): NZIMMessageRepliedInfo => {
    const obj = new NZIMMessageRepliedInfo();
    obj.state = NZIMMessageRepliedInfoState.getZIMMessageRepliedInfoState(info.state.toInt());
    obj.messageSeq = info.messageSeq.toLong();
    obj.messageID = info.messageID.toLong();
    obj.sentTime = info.sentTime.toLong();
    obj.senderUserID = info.senderUserID;
    obj.messageInfo = oZIMMessageLiteInfo(info.messageInfo);
    return obj;
};

export const mZIMMessageRepliedInfo = (info: NZIMMessageRepliedInfo) => {
    return {
        state: info.state.value(),
        messageSeq: info.messageSeq,
        messageID: info.messageID.toString(),
        senderUserID: info.senderUserID,
        sentTime: info.sentTime,
        messageInfo: mZIMMessageLiteInfo(info.messageInfo),
    } as ZIMMessageRepliedInfo;
};

export const mZIMMessageRootRepliedCountInfoList = (infos: ArrayList<NZIMMessageRootRepliedCountInfo>) => {
    const list: ZIMMessageRootRepliedCountInfo[] = [];

    for (let i = 0; i < infos.size; i++) {
        const info = infos.get(i as Int);
        list.push({
            conversationID: info.conversationID,
            conversationType: info.conversationType.value(),
            count: info.count,
            messageID: info.messageID.toString(),
        });
    }

    return list;
};

export const mZIMMessagePinStatusChangeInfoList = (infos: ArrayList<NZIMMessagePinStatusChangeInfo>) => {
    const list: ZIMMessagePinStatusChangeInfo[] = [];

    for (let i = 0; i < infos.size; i++) {
        const info = infos.get(i as Int);
        list.push({
            pinStatus: info.getPinStatus().value(),
            message: mZIMMessage(info.getMessage()),
        });
    }

    return list;
};

export const oZIMTipsMessageChangeInfo = (info: ZIMTipsMessageChangeInfo): NZIMTipsMessageChangeInfo => {
    const type = info.type;
    if (type < 10) {
        return new NZIMTipsMessageGroupChangeInfo();
    } else if (type >= 10 && type < 20) {
        return new NZIMTipsMessageGroupMemberChangeInfo();
    } else if (type == 21) {
        return new NZIMTipsMessagePinStatusChangeInfo();
    }
    return new NZIMTipsMessageChangeInfo();
};

export const mZIMTipsMessageChangeInfo = (info: NZIMTipsMessageChangeInfo) => {
    const type = info.type.value() as ZIMTipsMessageChangeInfoType;
    const map = { type } as ZIMTipsMessageChangeInfo;
    if (type < 10) {
        const _info = info as NZIMTipsMessageGroupChangeInfo;
        map.groupDataFlag = _info.groupDataFlag;
        map.groupName = _info.groupName;
        map.groupAvatarUrl = _info.groupAvatarUrl;
        map.groupNotice = _info.groupNotice;
        if (_info.groupMutedInfo != null) {
            map.groupMutedInfo = mZIMGroupMuteInfo(_info.groupMutedInfo!);
        }
    } else if (type >= 10 && type < 20) {
        const _info = info as NZIMTipsMessageGroupMemberChangeInfo;
        map.memberRole = _info.memberRole;
        map.muteExpiredTime = _info.muteExpiredTime;
        if (_info.groupNewOwner != null) {
            map.groupNewOwner = mZIMGroupMemberSimpleInfo(_info.groupNewOwner!);
        }
    } else if (type == 21) {
        const _info = info as NZIMTipsMessagePinStatusChangeInfo;
        map.isPinned = _info.isPinned;
    }
    return map;
};

export const mZIMConversationSearchInfoList = (infos: ArrayList<NZIMConversationSearchInfo>) => {
    const list: ZIMConversationSearchInfo[] = [];

    for (let i = 0; i < infos.size; i++) {
        const info = infos.get(i as Int);
        list.push({
            conversationID: info.conversationID,
            conversationType: info.conversationType.value(),
            totalMessageCount: info.totalMessageCount,
            messageList: mZIMMessageList(info.messageList),
        });
    }

    return list;
};

export const oZIMMessageSendConfig = (config: ZIMMessageSendConfig): NZIMMessageSendConfig => {
    const _config: NZIMMessageSendConfig = new NZIMMessageSendConfig();
    _config.priority = NZIMMessagePriority.getZIMMessagePriority(config.priority.toInt());
    _config.hasReceipt = config.hasReceipt ?? false;
    _config.isRetrySend = config.isRetrySend ?? false;
    _config.isNotifyMentionedUsers = config.isNotifyMentionedUsers ?? true;
    _config.disableUnreadMessageCount = config.disableUnreadMessageCount ?? false;
    if (config.pushConfig != null) {
        _config.pushConfig = oZIMPushConfig(config.pushConfig!);
    }
    return _config;
};

export const oZIMMessageSearchConfig = (config: ZIMMessageSearchConfig, nextMessageMap: Map<string, NZIMMessage>): NZIMMessageSearchConfig => {
    const _config: NZIMMessageSearchConfig = new NZIMMessageSearchConfig();
    _config.keywords = config.keywords ?? [];
    _config.senderUserIDs = config.senderUserIDs ?? [];
    _config.subMessageTypes = (config.subMessageTypes ?? []) as ArrayList<Int>;
    _config.messageTypes = oZIMMessageTypeList(config.messageTypes ?? []);
    _config.startTime = (config.startTime ?? 0).toLong();
    _config.endTime = (config.endTime ?? 0).toLong();
    _config.count = (config.count ?? 0) as Int;
    _config.order = NZIMMessageOrder.getZIMMessageOrder((config.order ?? 0).toInt());
    if (config.nextMessage != null) {
        _config.nextMessage = nextMessageMap.get(config.nextMessage!);
    }
    return _config;
};

