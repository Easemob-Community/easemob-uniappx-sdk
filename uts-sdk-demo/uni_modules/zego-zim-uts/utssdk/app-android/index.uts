const isSucc = (errorInfo: NZIMError, reject: (err: any) => void): boolean => {
    const code = errorInfo.code.value() as number;
    if (code != 0) {
        reject(new UniError('zim-apicall-error', code, errorInfo.message));
        return false;
    }
    return true;
}

export class ZIM implements IZIM {
    private static _instance: ZIM | null = null;
    
    private _zim: NZIM | null = null;
    private _event: ZIMEventHandlerImpl | null = null;
    // uni-app 使用 uts 插件时，会编译生成 ZIMByJs（继承ZIM的无参构造函数），这里不能使用有参构造函数
    // private constructor(zim: NZIM) {
    initZIM(zim: NZIM) {
        this._zim = zim;
        this._event = new ZIMEventHandlerImpl();
        this._zim!.setEventHandler(this._event!);
    }

    private NoInitErr = new UniError('zim-apicall-error', 1, 'No instance.');

    // 与 iOS 保持逻辑一致
    private nextMessageMap = new Map<string, NZIMMessage>();
    private nextConversationMap = new Map<string, NZIMConversation>();
    private putNextMessage(msgObj: NZIMMessage): string {
        const key = msgObj.getLocalMessageID().toString();
        this.nextMessageMap.set(key , msgObj);
        return key;
    }
    private putNextConversation(convObj: NZIMConversation): string {
        const key = convObj.type.value().toString() + convObj.conversationID;
        this.nextConversationMap.set(key , convObj);
        return key;
    }
    
    static setLogConfig(config: ZIMLogConfig): void {
        const _config = new NZIMLogConfig();
        if (config.logPath != null && config.logPath != '') {
            _config.logPath = config.logPath;
        }
        if (config.logSize != null && config.logSize! > 0) {
            _config.logSize = config.logSize!.toLong();
        }

        NZIM.setLogConfig(_config);
    }

    static setCacheConfig(config: ZIMCacheConfig): void {
        const _config = new NZIMCacheConfig();
        if (config.cachePath != '') {
            _config.cachePath = config.cachePath;
        }

        NZIM.setCacheConfig(_config);
    }

    static setAdvancedConfig(key: string, value: string): void {
        NZIM.setAdvancedConfig(key, value);
    }

    static setGeofencingConfig(areaList: number[], type: ZIMGeofencingType): boolean {
        return NZIM.setGeofencingConfig(
            areaList as ArrayList<Int>, // toIntArray 编译报错
            NZIMGeofencingType.getZIMGeofencingType(type.toInt()),
        );
    }

    static getVersion(): string {
        return NZIM.getVersion();
    }

    static create(appConfig : ZIMAppConfig): IZIM {
        if(this._instance == null) {
            const appInfo = uni.getAppBaseInfo();
            const value = (appInfo.isUniAppX ?? false) ? 'uni-app-x' : 'uni-app-u';
            NZIM.setAdvancedConfig('zim_cross_platform', value);
            NZIM.setAdvancedConfig('zim_cross_platform_uts', JSON.stringify(appInfo) ?? value);
            const config = new NZIMAppConfig();
            config.appID = appConfig.appID.toLong();
            config.appSign = appConfig.appSign;
            const nzim = NZIM.create(config, UTSAndroid.getAppContext()! as Application);
            this._instance = new ZIM();
            this._instance!.initZIM(nzim!);
        }
        return this._instance!;
    }
    
    static getInstance(): IZIM {
        return this._instance!;
    }
    
    
    destroy(): void {
        this.nextMessageMap.clear();
        this.nextConversationMap.clear();
        this._event = null;
        if (this._zim != null) {
            this._zim!.destroy();
            this._zim = null;
        }
    }

    uploadLog(): Promise<void> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const callback = new (class implements NZIMLogUploadedCallback {
                override onLogUploaded(errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve();
                    }
                }
            });
            this._zim!.uploadLog(callback as NZIMLogUploadedCallback);
        });
    }

    queryLocalFileCache(config: ZIMFileCacheQueryConfig): Promise<ZIMFileCacheQueriedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMFileCacheQueryConfig();
            _config.endTime = config.endTime.toLong();

            const callback = new (class implements NZIMFileCacheQueriedCallback {
                override onFileCacheQueried(info: NZIMFileCacheInfo, errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ totalFileSize: info.totalFileSize });
                    }
                }
            });
            this._zim!.queryLocalFileCache(_config, callback as NZIMFileCacheQueriedCallback);
        });
    }

    clearLocalFileCache(config: ZIMFileCacheClearConfig): Promise<void> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMFileCacheClearConfig();
            _config.endTime = config.endTime.toLong();

            const callback = new (class implements NZIMFileCacheClearedCallback {
                override onFileCacheCleared(errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve();
                    }
                }
            });
            this._zim!.clearLocalFileCache(_config, callback as NZIMFileCacheClearedCallback);
        });
    }

    // MARK: - User

    login(userID: string, config: ZIMLoginConfig): Promise<void> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMLoginConfig();
            _config.userName = config.userName ?? '';
            _config.customStatus = config.customStatus ?? '';
            _config.token = config.token ?? '';
            _config.isOfflineLogin = config.isOfflineLogin ?? false;

            const callback = new (class implements NZIMLoggedInCallback {
                override onLoggedIn(errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve();
                    }
                }
            });
            this._zim!.login(userID, _config, callback as NZIMLoggedInCallback);
        });
    }

    logout(): void {
        this.nextMessageMap.clear();
        this.nextConversationMap.clear();
        if (this._zim != null) {
            this._zim!.logout();
        }
    }

    renewToken(token: string): Promise<ZIMTokenRenewedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }
 
            const callback = new (class implements NZIMTokenRenewedCallback {
                override onTokenRenewed(token: string, errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ token });
                    }
                }
            });
            this._zim!.renewToken(token, callback as NZIMTokenRenewedCallback);
        });
    }

    updateUserName(userName: string): Promise<ZIMUserNameUpdatedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const callback = new (class implements NZIMUserNameUpdatedCallback {
                override onUserNameUpdated(userName: string, errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ userName });
                    }
                }
            });
            this._zim!.updateUserName(userName, callback as NZIMUserNameUpdatedCallback);
        });
    }

    updateUserAvatarUrl(userAvatarUrl: string): Promise<ZIMUserAvatarUrlUpdatedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const callback = new (class implements NZIMUserAvatarUrlUpdatedCallback {
                override onUserAvatarUrlUpdated(userAvatarUrl: string, errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ userAvatarUrl });
                    }
                }
            });
            this._zim!.updateUserAvatarUrl(userAvatarUrl, callback as NZIMUserAvatarUrlUpdatedCallback);
        });
    }

    updateUserExtendedData(extendedData: string): Promise<ZIMUserExtendedDataUpdatedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const callback = new (class implements NZIMUserExtendedDataUpdatedCallback {
                override onUserExtendedDataUpdated(extendedData: string, errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ extendedData });
                    }
                }
            });
            this._zim!.updateUserExtendedData(extendedData, callback as NZIMUserExtendedDataUpdatedCallback);
        });
    }

    updateUserCustomStatus(customStatus: string): Promise<ZIMUserCustomStatusUpdatedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const callback = new (class implements NZIMUserCustomStatusUpdatedCallback {
                override onUserCustomStatusUpdated(customStatus: string, errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ customStatus });
                    }
                }
            });
            this._zim!.updateUserCustomStatus(customStatus, callback as NZIMUserCustomStatusUpdatedCallback);
        });
    }

    updateUserOfflinePushRule(offlinePushRule: ZIMUserOfflinePushRule): Promise<ZIMUserOfflinePushRuleUpdatedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMUserOfflinePushRule();
            _config.onlinePlatforms = offlinePushRule.onlinePlatforms as ArrayList<Int>;
            _config.notToReceiveOfflinePushPlatforms = offlinePushRule.notToReceiveOfflinePushPlatforms as ArrayList<Int>;

            const callback = new (class implements NZIMUserOfflinePushRuleUpdatedCallback {
                override onUserOfflinePushRuleInfoUpdated(info: NZIMUserOfflinePushRule, errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ offlinePushRule: mZIMUserOfflinePushRule(info) });
                    }
                }
            });
            this._zim!.updateUserOfflinePushRule(_config, callback as NZIMUserOfflinePushRuleUpdatedCallback);
        });
    }

    querySelfUserInfo(): Promise<ZIMSelfUserInfoQueriedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const callback = new (class implements NZIMSelfUserInfoQueriedCallback {
                override onSelfUserInfoQueried(info: NZIMSelfUserInfo, errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve({
                            selfUserInfo: {
                                userRule: { offlinePushRule: mZIMUserOfflinePushRule(info.userRule.offlinePushRule) },
                                userStatus: mZIMUserStatus(info.userStatus),
                                userFullInfo: mZIMUserFullInfo(info.userFullInfo),
                            },
                        });
                    }
                }
            });
            this._zim!.querySelfUserInfo(callback as NZIMSelfUserInfoQueriedCallback);
        });
    }

    queryUsersInfo(userIDs: string[], config: ZIMUsersInfoQueryConfig): Promise<ZIMUsersInfoQueriedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMUsersInfoQueryConfig();
            _config.isQueryFromServer = config.isQueryFromServer ?? false;

            const callback = new (class implements NZIMUsersInfoQueriedCallback {
                override onUsersInfoQueried(
                    infos: ArrayList<NZIMUserFullInfo>,
                    errorUserList: ArrayList<NZIMErrorUserInfo>,
                    errorInfo: NZIMError,
                ): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve({
                            userList: mZIMUserFullInfoList(infos),
                            errorUserList: mZIMErrorUserInfoList(errorUserList),
                        });
                    }
                }
            });
            this._zim!.queryUsersInfo(userIDs, _config, callback as NZIMUsersInfoQueriedCallback);
        });
    }

    subscribeUsersStatus(
        userIDs: string[],
        config: ZIMUserStatusSubscribeConfig,
    ): Promise<ZIMUsersStatusSubscribedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMUserStatusSubscribeConfig();
            _config.subscriptionDuration = config.subscriptionDuration as Int;

            const callback = new (class implements NZIMUsersStatusSubscribedCallback {
                override onUsersStatusSubscribed(infos: ArrayList<NZIMErrorUserInfo>, errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ errorUserList: mZIMErrorUserInfoList(infos) });
                    }
                }
            });
            this._zim!.subscribeUsersStatus(userIDs, _config, callback as NZIMUsersStatusSubscribedCallback);
        });
    }

    unsubscribeUsersStatus(userIDs: string[]): Promise<ZIMUsersStatusUnsubscribedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const callback = new (class implements NZIMUsersStatusUnsubscribedCallback {
                override onUsersStatusUnsubscribed(infos: ArrayList<NZIMErrorUserInfo>, errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ errorUserList: mZIMErrorUserInfoList(infos) });
                    }
                }
            });
            this._zim!.unsubscribeUsersStatus(userIDs, callback as NZIMUsersStatusUnsubscribedCallback);
        });
    }

    queryUsersStatus(userIDs: string[]): Promise<ZIMUsersStatusQueriedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const callback = new (class implements NZIMUsersStatusQueriedCallback {
                override onUsersStatusQueried(
                    userList: ArrayList<NZIMUserStatus>,
                    infos: ArrayList<NZIMErrorUserInfo>,
                    errorInfo: NZIMError,
                ): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve({
                            userStatusList: mZIMUserStatusList(userList),
                            errorUserList: mZIMErrorUserInfoList(infos),
                        });
                    }
