    // MARK: - DB Search

    searchLocalConversations(config: ZIMConversationSearchConfig): Promise<ZIMConversationsSearchedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMConversationSearchConfig();
            _config.keywords = config.keywords ?? [];
            _config.senderUserIDs = config.senderUserIDs ?? [];
            _config.subMessageTypes = (config.subMessageTypes ?? []) as ArrayList<Int>;
            _config.messageTypes = oZIMMessageTypeList(config.messageTypes ?? []);
            _config.startTime = (config.startTime ?? 0).toLong();
            _config.endTime = (config.endTime ?? 0).toLong();
            _config.totalConversationCount = (config.totalConversationCount ?? 0) as Int;
            _config.conversationMessageCount = (config.conversationMessageCount ?? 0) as Int;
            _config.nextFlag = (config.nextFlag ?? 0) as Int;

            const callback = new (class implements NZIMConversationsSearchedCallback {
                override onConversationsSearched(
                    infos: ArrayList<NZIMConversationSearchInfo>,
                    nextFlag: Int,
                    errorInfo: NZIMError,
                ): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve({
                            nextFlag: nextFlag as number,
                            conversationSearchInfoList: mZIMConversationSearchInfoList(infos),
                        });
                    }
                }
            });
            this._zim!.searchLocalConversations(_config, callback as NZIMConversationsSearchedCallback);
        });
    }

    searchLocalMessages(
        conversationID: string,
        conversationType: ZIMConversationType,
        config: ZIMMessageSearchConfig,
    ): Promise<ZIMMessagesSearchedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _type = NZIMConversationType.getZIMConversationType(conversationType.toInt());

            const that = this;
            const callback = new (class implements NZIMMessagesSearchedCallback {
                override onMessagesSearched(
                    conversationID: string,
                    conversationType: NZIMConversationType,
                    infos: ArrayList<NZIMMessage>,
                    nextMessage: NZIMMessage,
                    errorInfo: NZIMError,
                ): void {
                    if (isSucc(errorInfo, reject)) {
                        const res : ZIMMessagesSearchedResult = { conversationID, conversationType: conversationType.value(), messageList: mZIMMessageList(infos) };
                        if (nextMessage != null) {
                            res.nextMessage = that.putNextMessage(nextMessage!);
                        }
                        resolve(res);
                    }
                }
            });
            this._zim!.searchLocalMessages(
                conversationID,
                _type,
                oZIMMessageSearchConfig(config, this.nextMessageMap),
                callback as NZIMMessagesSearchedCallback,
            );
        });
    }

    searchGlobalLocalMessages(config: ZIMMessageSearchConfig): Promise<ZIMMessagesGlobalSearchedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const that = this;
            const callback = new (class implements NZIMMessagesGlobalSearchedCallback {
                override onMessagesGlobalSearched(
                    infos: ArrayList<NZIMMessage>,
                    nextMessage: NZIMMessage,
                    errorInfo: NZIMError,
                ): void {
                    if (isSucc(errorInfo, reject)) {
                        const res : ZIMMessagesGlobalSearchedResult = { messageList: mZIMMessageList(infos) };
                        if (nextMessage != null) {
                            res.nextMessage = that.putNextMessage(nextMessage!);
                        }
                        resolve(res);
                    }
                }
            });
            this._zim!.searchGlobalLocalMessages(
                oZIMMessageSearchConfig(config, this.nextMessageMap),
                callback as NZIMMessagesGlobalSearchedCallback,
            );
        });
    }

