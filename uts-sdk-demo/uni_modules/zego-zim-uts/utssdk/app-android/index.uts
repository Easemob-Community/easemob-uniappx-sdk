    callInvite(invitees: string[], config: ZIMCallInviteConfig): Promise<ZIMCallInvitationSentResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMCallInviteConfig();
            _config.mode = NZIMCallInvitationMode.getZIMCallInvitationMode((config.mode ?? 0).toInt());
            _config.timeout = (config.timeout ?? 0) as Int;
            _config.extendedData = config.extendedData ?? '';
            _config.enableNotReceivedCheck = config.enableNotReceivedCheck ?? false;

            if (config.pushConfig != null) {
                _config.pushConfig = oZIMPushConfig(config.pushConfig!);
            }

            const callback = new (class implements NZIMCallInvitationSentCallback {
                override onCallInvitationSent(
                    callID: string,
                    info: NZIMCallInvitationSentInfo,
                    errorInfo: NZIMError,
                ): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve({
                            callID,
                            timeout: info.timeout,
                            errorUserList: mZIMErrorUserInfoList(info.errorUserList),
                        });
                    }
                }
            });
            this._zim!.callInvite(invitees, _config, callback as NZIMCallInvitationSentCallback);
        });
    }

