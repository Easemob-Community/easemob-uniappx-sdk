            const _config = new NZIMMessageImportConfig();

            const callback = new (class implements NZIMMessageImportedCallback {
                override onMessageImported(errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve();
                    }
                }

                override onMessageImportingProgress(currentMessageCount: Long, totalMessageCount: Long): void {
                    progress(currentMessageCount, totalMessageCount);
                }
            });
            this._zim!.importLocalMessages(folderPath, _config, callback as NZIMMessageImportedCallback);
        });
    }

