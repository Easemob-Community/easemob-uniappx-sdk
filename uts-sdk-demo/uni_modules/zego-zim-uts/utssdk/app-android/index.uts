    // MARK: - Message

    @UTSJS.keepAlive
    sendMessage(
        message: ZIMMessage,
        toConversationID: string,
        conversationType: ZIMConversationType,
        config: ZIMMessageSendConfig,
        notification?: ZIMMessageSendNotification,
    ): Promise<ZIMMessageSentResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            this._zim!.sendMessage(
                oZIMMessage(message, true),
                toConversationID,
                NZIMConversationType.getZIMConversationType(conversationType.toInt()),
                oZIMMessageSendConfig(config),
                new ZIMMessageSentFullCallbackImpl((data: ZIMMessage) => resolve({ message: data }), reject, notification),
            );
        });
    }

    @UTSJS.keepAlive
    replyMessage(
        message: ZIMMessage,
        toOriginalMessage: ZIMMessage,
        config: ZIMMessageSendConfig,
        notification?: ZIMMessageSendNotification,
    ): Promise<ZIMMessageSentResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            this._zim!.replyMessage(
                oZIMMessage(message, true),
                oZIMMessage(toOriginalMessage, false),
                oZIMMessageSendConfig(config),
                new ZIMMessageSentFullCallbackImpl((data: ZIMMessage) => resolve({ message: data }), reject, notification),
            );
        });
    }

    @UTSJS.keepAlive
    editMessage(
        message: ZIMMessage,
        config: ZIMMessageEditConfig,
        notification?: ZIMMessageSendNotification,
    ): Promise<ZIMMessageEditedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMMessageEditConfig();

            this._zim!.editMessage(
                oZIMMessage(message, false),
                _config,
                new ZIMMessageSentFullCallbackImpl((data: ZIMMessage) => resolve({ message: data }), reject, notification),
            );
        });
    }
    
    cancelSendingMessage(message: ZIMMessage, config: ZIMSendingMessageCancelConfig): Promise<void> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }
        
            const _config = new NZIMSendingMessageCancelConfig();
        
            const callback = new (class implements NZIMSendingMessageCancelledCallback {
                override onSendingMessageCancelled(errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve();
                    }
                }
            });
        
            this._zim!.cancelSendingMessage(oZIMMessage(message, false), _config, callback as NZIMSendingMessageCancelledCallback);
        });
    }

    @UTSJS.keepAlive
    downloadMediaFile(
        message: ZIMMessage,
        fileType: ZIMMediaFileType,
        config: ZIMMediaDownloadConfig,
        progress: ZIMMediaDownloadingProgress,
    ): Promise<ZIMMediaDownloadedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _type = NZIMMediaFileType.getZIMMediaFileType(fileType.toInt());

            const _config = new NZIMMediaDownloadConfig();
            _config.messageInfoIndex = (config.messageInfoIndex ?? 0) as Int;

            const callback = new (class implements NZIMMediaDownloadedCallback {
                override onMediaDownloaded(info: NZIMMessage, errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ message: mZIMMessage(info) });
                    }
                }

                override onMediaDownloadingProgress(
                    info: NZIMMessage,
                    currentFileSize: Long,
                    totalFileSize: Long,
                ): void {
                    progress(mZIMMessage(info), currentFileSize, totalFileSize);
                }
            });
            this._zim!.downloadMediaFile(oZIMMessage(message, false), _type, _config, callback as NZIMMediaDownloadedCallback);
        });
    }

    @UTSJS.keepAlive
    importLocalMessages(
        folderPath: string,
        config: ZIMMessageImportConfig,
        progress: ZIMMessageImportingProgress,
