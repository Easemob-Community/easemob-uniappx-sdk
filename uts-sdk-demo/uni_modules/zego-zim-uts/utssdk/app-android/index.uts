            const callback = new (class implements NZIMGroupInviteApplicationRejectedCallback {
                override onGroupInviteApplicationRejected(
                    groupID: string,
                    inviterUserID: string,
                    errorInfo: NZIMError,
                ): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ groupID, inviterUserID });
                    }
                }
            });
            this._zim!.rejectGroupInviteApplication(
                inviterUserID,
                groupID,
                _config,
                callback as NZIMGroupInviteApplicationRejectedCallback,
            );
        });
    }

