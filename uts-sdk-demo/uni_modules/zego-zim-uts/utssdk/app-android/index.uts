            _config.nextFlag = (config.nextFlag ?? 0).toLong();
            _config.reactionType = config.reactionType ?? '';

            const callback = new (class implements NZIMMessageReactionUserListQueriedCallback {
                override onMessageReactionUserListQueried(
                    info: NZIMMessage,
                    infos: ArrayList<NZIMMessageReactionUserInfo>,
                    reactionType: string,
                    nextFlag: Long,
                    totalCount: Int,
                    errorInfo: NZIMError,
                ): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve({
                            message: mZIMMessage(info),
                            reactionType,
                            nextFlag: nextFlag as number,
                            totalCount: totalCount as number,
                            userList: mZIMMessageReactionUserInfoList(infos),
                        });
                    }
                }
            });
            this._zim!.queryMessageReactionUserList(
                oZIMMessage(message, false),
