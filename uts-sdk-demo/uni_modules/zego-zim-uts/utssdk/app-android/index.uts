    queryHistoryMessage(
        conversationID: string,
        conversationType: ZIMConversationType,
        config: ZIMMessageQueryConfig,
    ): Promise<ZIMMessageQueriedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _type = NZIMConversationType.getZIMConversationType(conversationType.toInt());

            const _config = new NZIMMessageQueryConfig();
            _config.count = config.count as Int;
            _config.reverse = config.reverse ?? true;
            if (config.nextMessage != null) {
                _config.nextMessage = this.nextMessageMap.get(config.nextMessage!);
            }

            const that = this;
            const callback = new (class implements NZIMMessageQueriedCallback {
                override onMessageQueried(
                    conversationID: string,
                    conversationType: NZIMConversationType,
                    infos: ArrayList<NZIMMessage>,
                    errorInfo: NZIMError,
                ): void {
                    if (isSucc(errorInfo, reject)) {
                        const len = infos.size;
                        if (len > 0) {
                            that.putNextMessage(infos[0]);
                            that.putNextMessage(infos[len - 1]);
                        }
                        resolve({
                            conversationID,
                            conversationType: conversationType.value(),
                            messageList: mZIMMessageList(infos),
                        });
                    }
                }
            });
            this._zim!.queryHistoryMessage(conversationID, _type, _config, callback as NZIMMessageQueriedCallback);
        });
    }

