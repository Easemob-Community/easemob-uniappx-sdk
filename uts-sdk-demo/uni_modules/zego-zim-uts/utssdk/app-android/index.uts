    queryMessageRepliedList(
        message: ZIMMessage,
        config: ZIMMessageRepliedListQueryConfig,
    ): Promise<ZIMMessageRepliedListQueriedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMMessageRepliedListQueryConfig();
            _config.count = config.count as Int;
            _config.nextFlag = (config.nextFlag ?? 0).toLong();

            const callback = new (class implements NZIMMessageRepliedListQueriedCallback {
                override onMessageRepliedListQueried(
                    infos: ArrayList<NZIMMessage>,
                    nextFlag: Long,
                    info: NZIMMessageRootRepliedInfo,
                    errorInfo: NZIMError,
                ): void {
                    if (isSucc(errorInfo, reject)) {
                        const _info = {
                            state: info.state.value(),
                            senderUserID: info.senderUserID,
                            repliedCount: info.repliedCount,
                            sentTime: info.sentTime,
                        } as ZIMMessageRootRepliedInfo;
                        if (info.message != null) {
                            _info.message = mZIMMessage(info.message!);
                        }
                        resolve({
                            nextFlag: nextFlag as number,
                            rootRepliedInfo: _info,
                            messageList: mZIMMessageList(infos),
                        });
                    }
                }
            });
            this._zim!.queryMessageRepliedList(
                oZIMMessage(message, false),
                _config,
                callback as NZIMMessageRepliedListQueriedCallback,
            );
        });
    }

