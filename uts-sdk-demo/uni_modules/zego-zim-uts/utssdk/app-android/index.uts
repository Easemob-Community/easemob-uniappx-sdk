    }

    // MARK: - Blacklist

    addUsersToBlacklist(userIDs: string[]): Promise<ZIMBlacklistUsersAddedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const callback = new (class implements NZIMBlacklistUsersAddedCallback {
                override onBlacklistUsersAdded(infos: ArrayList<NZIMErrorUserInfo>, errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ errorUserList: mZIMErrorUserInfoList(infos) });
                    }
                }
            });
            this._zim!.addUsersToBlacklist(userIDs, callback as NZIMBlacklistUsersAddedCallback);
        });
    }

    removeUsersFromBlacklist(userIDs: string[]): Promise<ZIMBlacklistUsersRemovedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const callback = new (class implements NZIMBlacklistUsersRemovedCallback {
                override onBlacklistUsersRemoved(infos: ArrayList<NZIMErrorUserInfo>, errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ errorUserList: mZIMErrorUserInfoList(infos) });
                    }
                }
            });
            this._zim!.removeUsersFromBlacklist(userIDs, callback as NZIMBlacklistUsersRemovedCallback);
        });
    }

    checkUserIsInBlacklist(userID: string): Promise<ZIMBlacklistCheckedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const callback = new (class implements NZIMBlacklistCheckedCallback {
                override onBlacklistChecked(isUserInBlacklist: boolean, errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ isUserInBlacklist });
                    }
                }
            });
            this._zim!.checkUserIsInBlacklist(userID, callback as NZIMBlacklistCheckedCallback);
        });
    }

    queryBlacklist(config: ZIMBlacklistQueryConfig): Promise<ZIMBlacklistQueriedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMBlacklistQueryConfig();
            _config.count = config.count as Int;
            _config.nextFlag = (config.nextFlag ?? 0) as Int;

            const callback = new (class implements NZIMBlacklistQueriedCallback {
                override onBlacklistQueried(infos: ArrayList<NZIMUserInfo>, nextFlag: Int, errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ nextFlag: nextFlag as number, blacklist: mZIMUserInfoList(infos) });
                    }
                }
            });
            this._zim!.queryBlacklist(_config, callback as NZIMBlacklistQueriedCallback);
        });
    }
    
    
