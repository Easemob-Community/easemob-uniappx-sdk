class ZIMMessageSentFullCallbackImpl implements NZIMMessageSentFullCallback {
    resolve: (res: ZIMMessage) => void;
    reject: (err: any) => void;
    
    @UTSJS.keepAlive
    notification: ZIMMessageSendNotification | null = null;

    constructor(
        resolve: (res: ZIMMessage) => void,
        reject: (err: any) => void,
        notification?: ZIMMessageSendNotification,
    ) {
        this.resolve = resolve;
        this.reject = reject;
        this.notification = notification;
    }

    override onMessageSent(info: NZIMMessage, errorInfo: NZIMError): void {
        if (isSucc(errorInfo, this.reject)) {
            this.resolve(mZIMMessage(info));
        }
    }

    override onMessageAttached(info: NZIMMessage): void {
        this.notification?.onMessageAttached?.(mZIMMessage(info));
    }

    override onMediaUploadingProgress(info: NZIMMediaMessage, currentFileSize: Long, totalFileSize: Long): void {
        this.notification?.onMediaUploadingProgress?.(mZIMMessage(info), currentFileSize, totalFileSize);
    }

    override onMultipleMediaUploadingProgress(
        info: NZIMMultipleMessage,
        currentFileSize: Long,
        totalFileSize: Long,
        messageInfoIndex: Int,
        currentIndexFileSize: Long,
        totalIndexFileSize: Long,
    ): void {
        this.notification?.onMultipleMediaUploadingProgress?.(
            mZIMMessage(info),
            currentFileSize,
            totalFileSize,
            messageInfoIndex,
            currentIndexFileSize,
            totalIndexFileSize,
        );
    }
}

class ZIMEventHandlerImpl extends NZIMEventHandler {
    constructor() {
        super();
    }

    @UTSJS.keepAlive
    eventMap = {} as ZIMEventHandler;

    // MARK: - Main

    override onError(zim: NZIM, errorInfo: NZIMError): void {
        this.eventMap.onError?.({ code: errorInfo.code.value(), message: errorInfo.message });
    }

    override onConnectionStateChanged(
        zim: NZIM,
        state: NZIMConnectionState,
        event: NZIMConnectionEvent,
        extendedData: JSONObject,
    ): void {
        this.eventMap.onConnectionStateChanged?.({ state: state.value(), event: event.value(), extendedData: JSON.parseObject(extendedData.toString())! });
    }

    override onTokenWillExpire(zim: NZIM, second: Int) {
        this.eventMap.onTokenWillExpire?.({ second: second as number });
    }

    override onUserInfoUpdated(zim: NZIM, info: NZIMUserFullInfo) {
        this.eventMap.onUserInfoUpdated?.({ info: mZIMUserFullInfo(info) });
    }

    override onUserRuleUpdated(zim: NZIM, info: NZIMUserRule) {
        this.eventMap.onUserRuleUpdated?.({ userRule: { offlinePushRule: mZIMUserOfflinePushRule(info.offlinePushRule) } });
    }

    override onUserStatusUpdated(zim: NZIM, infos: ArrayList<NZIMUserStatus>) {
        this.eventMap.onUserStatusUpdated?.({ userStatusList: mZIMUserStatusList(infos) });
    }

    // MARK: - Conversation

    override onConversationChanged(zim: NZIM, infos: ArrayList<NZIMConversationChangeInfo>) {
        this.eventMap.onConversationChanged?.({ infoList: mZIMConversationChangeInfoList(infos) });
    }
    
    override onConversationSyncStateChanged(zim: NZIM, state: NZIMConversationSyncState): void {
        this.eventMap.onConversationSyncStateChanged?.({ state: state.value() });
    }

    override onConversationTotalUnreadMessageCountUpdated(zim: NZIM, count: Int) {
        this.eventMap.onConversationTotalUnreadMessageCountUpdated?.({ totalUnreadMessageCount: count as number});
    }

    override onConversationsAllDeleted(zim: NZIM, info: NZIMConversationsAllDeletedInfo) {
        this.eventMap.onConversationsAllDeleted?.({ count: info.count });
    }

    override onConversationMessageReceiptChanged(zim: NZIM, infos: ArrayList<NZIMMessageReceiptInfo>) {
        this.eventMap.onConversationMessageReceiptChanged?.({ infos: mZIMMessageReceiptInfoList(infos) });
    }

    // MARK: - Message

    override onPeerMessageReceived(
        zim: NZIM,
        infos: ArrayList<NZIMMessage>,
        info: NZIMMessageReceivedInfo,
        fromConversationID: string,
    ) {
        this.eventMap.onPeerMessageReceived?.({
            fromConversationID,
            info: { isOfflineMessage: info.isOfflineMessage },
            messageList: mZIMMessageList(infos),
        });
    }

    override onRoomMessageReceived(
        zim: NZIM,
        infos: ArrayList<NZIMMessage>,
        info: NZIMMessageReceivedInfo,
        fromConversationID: string,
    ) {
        this.eventMap.onRoomMessageReceived?.({
            fromConversationID,
            info: { isOfflineMessage: info.isOfflineMessage },
            messageList: mZIMMessageList(infos),
        });
    }

    override onGroupMessageReceived(
        zim: NZIM,
        infos: ArrayList<NZIMMessage>,
        info: NZIMMessageReceivedInfo,
        fromConversationID: string,
    ) {
        this.eventMap.onGroupMessageReceived?.({
            fromConversationID,
            info: { isOfflineMessage: info.isOfflineMessage },
            messageList: mZIMMessageList(infos),
        });
    }

    override onBroadcastMessageReceived(zim: NZIM, info: NZIMMessage) {
        this.eventMap.onBroadcastMessageReceived?.({ message: mZIMMessage(info) });
    }

    override onMessageSentStatusChanged(zim: NZIM, infos: ArrayList<NZIMMessageSentStatusChangeInfo>) {
        this.eventMap.onMessageSentStatusChanged?.({ infos: mZIMMessageSentStatusChangeInfoList(infos) });
    }

    override onMessageDeleted(zim: NZIM, info: NZIMMessageDeletedInfo) {
        this.eventMap.onMessageDeleted?.({
            conversationID: info.conversationID,
            conversationType: info.conversationType.value(),
            messageDeleteType: info.messageDeleteType.value(),
            isDeleteConversationAllMessage: info.isDeleteConversationAllMessage,
            messageList: mZIMMessageList(info.messageList),
        });
    }

    override onMessageEdited(zim: NZIM, infos: ArrayList<NZIMMessage>) {
        this.eventMap.onMessageEdited?.({ messageList: mZIMMessageList(infos) });
    }

    override onMessageRevokeReceived(zim: NZIM, infos: ArrayList<NZIMRevokeMessage>) {
        this.eventMap.onMessageRevokeReceived?.({
            messageList: mZIMMessageList(infos as ArrayList<NZIMMessage>),
        });
    }

    override onMessageReceiptChanged(zim: NZIM, infos: ArrayList<NZIMMessageReceiptInfo>) {
        this.eventMap.onMessageReceiptChanged?.({ infos: mZIMMessageReceiptInfoList(infos) });
    }

    override onMessageReactionsChanged(zim: NZIM, infos: ArrayList<NZIMMessageReaction>) {
        this.eventMap.onMessageReactionsChanged?.({ reactions: mZIMMessageReactionList(infos) });
    }

    override onMessageRepliedInfoChanged(zim: NZIM, infos: ArrayList<NZIMMessage>) {
        this.eventMap.onMessageRepliedInfoChanged?.({ messageList: mZIMMessageList(infos) });
    }

    override onMessageRepliedCountChanged(zim: NZIM, infos: ArrayList<NZIMMessageRootRepliedCountInfo>) {
        this.eventMap.onMessageRepliedCountChanged?.({ infos: mZIMMessageRootRepliedCountInfoList(infos) });
    }

    override onMessagePinStatusChanged(zim: NZIM, infos: ArrayList<NZIMMessagePinStatusChangeInfo>) {
        this.eventMap.onMessagePinStatusChanged?.({ infos: mZIMMessagePinStatusChangeInfoList(infos) });
    }
    
    // MARK: - Room

    override onRoomStateChanged(
        zim: NZIM,
        state: NZIMRoomState,
        event: NZIMRoomEvent,
        extendedData: JSONObject,
        roomID: string,
    ) {
        this.eventMap.onRoomStateChanged?.({ roomID, state: state.value(), event: event.value(), extendedData: JSON.parseObject(extendedData.toString())! });
    }

    override onRoomMemberJoined(zim: NZIM, infos: ArrayList<NZIMUserInfo>, roomID: string) {
        this.eventMap.onRoomMemberJoined?.({ roomID, memberList: mZIMUserInfoList(infos) });
    }

    override onRoomMemberLeft(zim: NZIM, infos: ArrayList<NZIMUserInfo>, roomID: string) {
        this.eventMap.onRoomMemberLeft?.({ roomID, memberList: mZIMUserInfoList(infos) });
    }

    override onRoomAttributesUpdated(zim: NZIM, info: NZIMRoomAttributesUpdateInfo, roomID: string) {
        this.eventMap.onRoomAttributesUpdated?.({
            roomID,
            infos: [{ action: info.action.value(), roomAttributes: mMap(info.roomAttributes) }],
        });
    }

    override onRoomAttributesBatchUpdated(zim: NZIM, infos: ArrayList<NZIMRoomAttributesUpdateInfo>, roomID: string) {
        this.eventMap.onRoomAttributesBatchUpdated?.({
            roomID,
            infos: mZIMRoomAttributesUpdateInfoList(infos),
        });
    }

    override onRoomMemberAttributesUpdated(
        zim: NZIM,
        infos: ArrayList<NZIMRoomMemberAttributesUpdateInfo>,
        operatedInfo: NZIMRoomOperatedInfo,
        roomID: string,
    ) {
        this.eventMap.onRoomMemberAttributesUpdated?.({
            roomID,
            infos: mZIMRoomMemberAttributesUpdateInfoList(infos),
            operatedInfo: { userID: operatedInfo.userID },
        });
    }

    // MARK: - Group

    override onGroupStateChanged(
        zim: NZIM,
        state: NZIMGroupState,
        event: NZIMGroupEvent,
        operatedInfo: NZIMGroupOperatedInfo,
        groupInfo: NZIMGroupFullInfo,
    ) {
        this.eventMap.onGroupStateChanged?.({
            state: state.value(),
            event: event.value(),
            operatedInfo: mZIMGroupOperatedInfo(operatedInfo),
            groupInfo: mZIMGroupFullInfo(groupInfo),
        });
    }

    override onGroupNameUpdated(zim: NZIM, groupName: string, operatedInfo: NZIMGroupOperatedInfo, groupID: string) {
        this.eventMap.onGroupNameUpdated?.({
            groupID,
            groupName,
            operatedInfo: mZIMGroupOperatedInfo(operatedInfo),
        });
    }

    override onGroupAvatarUrlUpdated(
        zim: NZIM,
        groupAvatarUrl: string,
        operatedInfo: NZIMGroupOperatedInfo,
        groupID: string,
    ) {
        this.eventMap.onGroupAvatarUrlUpdated?.({
            groupID,
            groupAvatarUrl,
            operatedInfo: mZIMGroupOperatedInfo(operatedInfo),
        });
    }

    override onGroupNoticeUpdated(zim: NZIM, groupNotice: string, operatedInfo: NZIMGroupOperatedInfo, groupID: string) {
        this.eventMap.onGroupNoticeUpdated?.({
            groupID,
            groupNotice,
            operatedInfo: mZIMGroupOperatedInfo(operatedInfo),
        });
    }

    override onGroupAliasUpdated(zim: NZIM, groupAlias: string, operatedUserID: string, groupID: string) {
        this.eventMap.onGroupAliasUpdated?.({ groupID, groupAlias, operatedUserID });
    }

    override onGroupAttributesUpdated(
        zim: NZIM,
        infos: ArrayList<NZIMGroupAttributesUpdateInfo>,
        operatedInfo: NZIMGroupOperatedInfo,
        groupID: string,
    ) {
        this.eventMap.onGroupAttributesUpdated?.({
            groupID,
            infoList: mZIMGroupAttributesUpdateInfoList(infos),
            operatedInfo: mZIMGroupOperatedInfo(operatedInfo),
        });
    }

    override onGroupMutedInfoUpdated(
        zim: NZIM,
        info: NZIMGroupMuteInfo,
        operatedInfo: NZIMGroupOperatedInfo,
        groupID: string,
    ) {
        this.eventMap.onGroupMutedInfoUpdated?.({
            groupID,
            mutedInfo: mZIMGroupMuteInfo(info),
            operatedInfo: mZIMGroupOperatedInfo(operatedInfo),
        });
    }

    override onGroupVerifyInfoUpdated(
        zim: NZIM,
        info: NZIMGroupVerifyInfo,
        operatedInfo: NZIMGroupOperatedInfo,
        groupID: string,
    ) {
        this.eventMap.onGroupVerifyInfoUpdated?.({
            groupID,
            verifyInfo: mZIMGroupVerifyInfo(info),
            operatedInfo: mZIMGroupOperatedInfo(operatedInfo),
        });
    }

    override onGroupMemberStateChanged(
        zim: NZIM,
        state: NZIMGroupMemberState,
        event: NZIMGroupMemberEvent,
        infos: ArrayList<NZIMGroupMemberInfo>,
        operatedInfo: NZIMGroupOperatedInfo,
        groupID: string,
    ) {
        this.eventMap.onGroupMemberStateChanged?.({
            groupID,
            state: state.value(),
            event: event.value(),
            userList: mZIMGroupMemberInfoList(infos),
            operatedInfo: mZIMGroupOperatedInfo(operatedInfo),
        });
    }

    override onGroupMemberInfoUpdated(
        zim: NZIM,
        infos: ArrayList<NZIMGroupMemberInfo>,
        operatedInfo: NZIMGroupOperatedInfo,
        groupID: string,
    ) {
        this.eventMap.onGroupMemberInfoUpdated?.({
            groupID,
            userList: mZIMGroupMemberInfoList(infos),
            operatedInfo: mZIMGroupOperatedInfo(operatedInfo),
        });
    }

    override onGroupApplicationUpdated(zim: NZIM, infos: ArrayList<NZIMGroupApplicationInfo>) {
        this.eventMap.onGroupApplicationUpdated?.({ applicationList: mZIMGroupApplicationInfoList(infos) });
    }

    override onGroupApplicationListChanged(
        zim: NZIM,
        infos: ArrayList<NZIMGroupApplicationInfo>,
        action: NZIMGroupApplicationListChangeAction,
    ) {
        this.eventMap.onGroupApplicationListChanged?.({
            action: action.value(),
            applicationList: mZIMGroupApplicationInfoList(infos),
        });
    }

    // MARK: - Call

    override onCallInvitationCreated(zim: NZIM, info: NZIMCallInvitationCreatedInfo, callID: string) {
        this.eventMap.onCallInvitationCreated?.({
            callID,
            mode: info.mode.value(),
            caller: info.caller,
            extendedData: info.extendedData,
            timeout: info.timeout,
            createTime: info.createTime,
            callUserList: mZIMCallUserInfoList(info.callUserList),
        });
    }

    override onCallInvitationReceived(zim: NZIM, info: NZIMCallInvitationReceivedInfo, callID: string) {
        this.eventMap.onCallInvitationReceived?.({
            callID,
            mode: info.mode.value(),
            caller: info.caller,
            inviter: info.inviter,
            extendedData: info.extendedData,
            timeout: info.timeout,
            createTime: info.createTime,
            callUserList: mZIMCallUserInfoList(info.callUserList),
        });
    }

    override onCallInvitationCancelled(zim: NZIM, info: NZIMCallInvitationCancelledInfo, callID: string) {
        this.eventMap.onCallInvitationCancelled?.({
            callID,
            mode: info.mode.value(),
            inviter: info.inviter,
            extendedData: info.extendedData,
        });
    }

    override onCallInvitationTimeout(zim: NZIM, info: NZIMCallInvitationTimeoutInfo, callID: string) {
        this.eventMap.onCallInvitationTimeout?.({ callID, mode: info.mode.value() });
    }

    override onCallInvitationEnded(zim: NZIM, info: NZIMCallInvitationEndedInfo, callID: string) {
        this.eventMap.onCallInvitationEnded?.({
            callID,
            mode: info.mode.value(),
            caller: info.caller,
            operatedUserID: info.operatedUserID,
            extendedData: info.extendedData,
            endTime: info.endTime,
        });
    }

    override onCallUserStateChanged(zim: NZIM, info: NZIMCallUserStateChangeInfo, callID: string) {
        this.eventMap.onCallUserStateChanged?.({
            callID,
            callUserList: mZIMCallUserInfoList(info.callUserList),
        });
    }

    // MARK: - Friend

    override onBlacklistChanged(zim: NZIM, infos: ArrayList<NZIMUserInfo>, action: NZIMBlacklistChangeAction) {
        this.eventMap.onBlacklistChanged?.({ action: action.value(), userList: mZIMUserInfoList(infos) });
    }

    override onFriendInfoUpdated(zim: NZIM, infos: ArrayList<NZIMFriendInfo>) {
        this.eventMap.onFriendInfoUpdated?.({ friendList: mZIMFriendInfoList(infos) });
    }

    override onFriendListChanged(zim: NZIM, infos: ArrayList<NZIMFriendInfo>, action: NZIMFriendListChangeAction) {
        this.eventMap.onFriendListChanged?.({
            action: action.value(),
            friendList: mZIMFriendInfoList(infos),
        });
    }

    override onFriendApplicationUpdated(zim: NZIM, infos: ArrayList<NZIMFriendApplicationInfo>) {
        this.eventMap.onFriendApplicationUpdated?.({ applicationList: mZIMFriendApplicationInfoList(infos) });
    }

    override onFriendApplicationListChanged(
        zim: NZIM,
        infos: ArrayList<NZIMFriendApplicationInfo>,
        action: NZIMFriendApplicationListChangeAction,
    ) {
        this.eventMap.onFriendApplicationListChanged?.({
            action: action.value(),
            applicationList: mZIMFriendApplicationInfoList(infos),
        });
    }
}
