    queryConversation(
        conversationID: string,
        conversationType: ZIMConversationType,
    ): Promise<ZIMConversationQueriedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _type = NZIMConversationType.getZIMConversationType(conversationType.toInt());

            const callback = new (class implements NZIMConversationQueriedCallback {
                override onConversationQueried(info: NZIMConversation, errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        resolve({ conversation: mZIMConversation(info) });
                    }
                }
            });
            this._zim!.queryConversation(conversationID, _type, callback as NZIMConversationQueriedCallback);
        });
    }

    queryConversationList(
        config: ZIMConversationQueryConfig,
        option?: ZIMConversationFilterOption,
    ): Promise<ZIMConversationListQueriedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMConversationQueryConfig();
            _config.count = config.count as Int;
            if (config.nextConversation != null) {
                _config.nextConversation = this.nextConversationMap.get(config.nextConversation!);
            }

            const _option = new NZIMConversationFilterOption();
            if (option != null) {
                _option.isOnlyUnreadConversation = option!.isOnlyUnreadConversation ?? false;
                _option.marks = (option!.marks ?? []) as ArrayList<Int>;
                _option.conversationTypes = oZIMConversationTypeList(option!.conversationTypes ?? []);
                _option.pinnedFilter = NZIMConversationPinnedFilter.getZIMConversationPinnedFilter((option!.pinnedFilter ?? 0).toInt());
            }

            const that = this;
            const callback = new (class implements NZIMConversationListQueriedCallback {
                override onConversationListQueried(infos: ArrayList<NZIMConversation>, errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        const len = infos.size;
                        if (len > 0) {
                            that.putNextConversation(infos[len - 1]);
                        }
                        resolve({ conversationList: mZIMConversationList(infos) });
                    }
                }
            });
            this._zim!.queryConversationList(_config, _option, callback as NZIMConversationListQueriedCallback);
        });
    }

    queryConversationPinnedList(config: ZIMConversationQueryConfig): Promise<ZIMConversationPinnedListQueriedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _config = new NZIMConversationQueryConfig();
            _config.count = config.count as Int;
            if (config.nextConversation != null) {
                _config.nextConversation = this.nextConversationMap.get(config.nextConversation!);
            }

            const that = this;
            const callback = new (class implements NZIMConversationPinnedListQueriedCallback {
                override onConversationPinnedListQueried(infos: ArrayList<NZIMConversation>, errorInfo: NZIMError): void {
                    if (isSucc(errorInfo, reject)) {
                        const len = infos.size;
                        if (len > 0) {
                            that.putNextConversation(infos[len - 1]);
                        }
                        resolve({ conversationList: mZIMConversationList(infos) });
                    }
                }
            });
            this._zim!.queryConversationPinnedList(_config, callback as NZIMConversationPinnedListQueriedCallback);
        });
    }

