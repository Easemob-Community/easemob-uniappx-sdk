    // MARK: - Group

    createGroup(
        groupInfo: ZIMGroupInfo,
        userIDs: string[],
        config?: ZIMGroupAdvancedConfig,
    ): Promise<ZIMGroupCreatedResult> {
        return new Promise((resolve, reject) => {
            if (this._zim == null) {
                return reject(this.NoInitErr);
            }

            const _groupInfo = new NZIMGroupInfo();
            _groupInfo.groupID = groupInfo.groupID ?? '';
            _groupInfo.groupName = groupInfo.groupName ?? '';
            _groupInfo.groupAvatarUrl = groupInfo.groupAvatarUrl ?? '';

            const _config = new NZIMGroupAdvancedConfig();
            if (config != null) {
                _config.groupNotice = config!.groupNotice ?? '';
                _config.groupAttributes = oMap(config!.groupAttributes ?? {});
                _config.maxMemberCount = (config!.maxMemberCount ?? 0) as Int;
                _config.joinMode = NZIMGroupJoinMode.getZIMGroupJoinMode((config!.joinMode ?? 0).toInt());
                _config.inviteMode = NZIMGroupInviteMode.getZIMGroupInviteMode((config!.inviteMode ?? 0).toInt());
                _config.beInviteMode = NZIMGroupBeInviteMode.getZIMGroupBeInviteMode((config!.beInviteMode ?? 0).toInt());
            }

            const callback = new (class implements NZIMGroupCreatedCallback {
                override onGroupCreated(
                    info: NZIMGroupFullInfo,
                    infos: ArrayList<NZIMGroupMemberInfo>,
                    errorUserList: ArrayList<NZIMErrorUserInfo>,
