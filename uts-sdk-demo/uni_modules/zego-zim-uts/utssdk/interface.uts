    friendList: ZIMFriendInfo[];
};
export type ZIMEventOfFriendInfoUpdatedResult = {
    friendList: ZIMFriendInfo[];
};
export type ZIMEventOfFriendApplicationListChangedResult = {
    action: ZIMFriendApplicationListChangeAction;
    applicationList: ZIMFriendApplicationInfo[];
};
export type ZIMEventOfFriendApplicationUpdatedResult = {
    applicationList: ZIMFriendApplicationInfo[];
};

export type ZIMEventHandler = {
    onError?: (error: ZIMError) => void;
    onConnectionStateChanged?: (data: ZIMEventOfConnectionStateChangedResult) => void;
    onTokenWillExpire?: (data: ZIMEventOfTokenWillExpireResult) => void;
    onUserInfoUpdated?: (data: ZIMEventOfUserInfoUpdatedResult) => void;
    onUserStatusUpdated?: (data: ZIMEventOfUserStatusUpdatedResult) => void;
    onUserRuleUpdated?: (data: ZIMEventOfUserRuleUpdatedResult) => void;

    onConversationsAllDeleted?: (data: ZIMEventOfConversationsAllDeletedResult) => void;
    onConversationChanged?: (data: ZIMEventOfConversationChangedResult) => void;
    onConversationSyncStateChanged?: (data: ZIMEventOfConversationSyncStateChangedResult) => void;
    onConversationTotalUnreadMessageCountUpdated?: (
        data: ZIMEventOfConversationTotalUnreadMessageCountUpdatedResult,
    ) => void;
    onConversationMessageReceiptChanged?: (data: ZIMEventOfMessageReceiptChangedResult) => void;

    onMessageRevokeReceived?: (data: ZIMEventOfMessageRevokeReceivedResult) => void;
    onMessageReceiptChanged?: (data: ZIMEventOfMessageReceiptChangedResult) => void;
    onMessageReactionsChanged?: (data: ZIMEventOfMessageReactionsChangedResult) => void;
    onMessageRepliedCountChanged?: (data: ZIMEventOfMessageRepliedCountChangedResult) => void;
    onMessageRepliedInfoChanged?: (data: ZIMEventOfMessageRepliedInfoChangedResult) => void;
    onMessagePinStatusChanged?: (data: ZIMEventOfMessagePinStatusChangedResult) => void;
    onMessageDeleted?: (data: ZIMEventOfMessageDeletedResult) => void;
    onMessageEdited?: (data: ZIMEventOfMessageEditedResult) => void;
    onMessageSentStatusChanged?: (data: ZIMEventOfMessageSentStatusChangedResult) => void;
    onBroadcastMessageReceived?: (data: ZIMEventOfBroadcastMessageReceivedResult) => void;
    onPeerMessageReceived?: (data: ZIMEventOfConversationMessageReceivedResult) => void;
    onGroupMessageReceived?: (data: ZIMEventOfConversationMessageReceivedResult) => void;
    onRoomMessageReceived?: (data: ZIMEventOfConversationMessageReceivedResult) => void;

    onRoomStateChanged?: (data: ZIMEventOfRoomStateChangedResult) => void;
    onRoomMemberJoined?: (data: ZIMEventOfRoomMemberChangedResult) => void;
    onRoomMemberLeft?: (data: ZIMEventOfRoomMemberChangedResult) => void;
    onRoomAttributesUpdated?: (data: ZIMEventOfRoomAttributesUpdatedResult) => void;
    onRoomAttributesBatchUpdated?: (data: ZIMEventOfRoomAttributesUpdatedResult) => void;
    onRoomMemberAttributesUpdated?: (data: ZIMEventOfRoomMembersAttributesUpdatedResult) => void;

    onGroupStateChanged?: (data: ZIMEventOfGroupStateChangedResult) => void;
    onGroupNameUpdated?: (data: ZIMEventOfGroupNameUpdatedResult) => void;
    onGroupAvatarUrlUpdated?: (data: ZIMEventOfGroupAvatarUrlUpdatedResult) => void;
    onGroupNoticeUpdated?: (data: ZIMEventOfGroupNoticeUpdatedResult) => void;
    onGroupAliasUpdated?: (data: ZIMEventOfGroupAliasUpdatedResult) => void;
    onGroupAttributesUpdated?: (data: ZIMEventOfGroupAttributesUpdatedResult) => void;
    onGroupMutedInfoUpdated?: (data: ZIMEventOfGroupMutedInfoUpdatedResult) => void;
    onGroupVerifyInfoUpdated?: (data: ZIMEventOfGroupVerifyInfoUpdatedResult) => void;
    onGroupApplicationListChanged?: (data: ZIMEventOfGroupApplicationListChangedResult) => void;
    onGroupApplicationUpdated?: (data: ZIMEventOfGroupApplicationUpdatedResult) => void;
    onGroupMemberStateChanged?: (data: ZIMEventOfGroupMemberStateChangedResult) => void;
    onGroupMemberInfoUpdated?: (data: ZIMEventOfGroupMemberInfoUpdatedResult) => void;

    onCallInvitationCreated?: (data: ZIMEventOfCallInvitationCreatedResult) => void;
    onCallInvitationReceived?: (data: ZIMEventOfCallInvitationReceivedResult) => void;
    onCallInvitationCancelled?: (data: ZIMEventOfCallInvitationCancelledResult) => void;
    onCallInvitationTimeout?: (data: ZIMEventOfCallInvitationTimeoutResult) => void;
    onCallInvitationEnded?: (data: ZIMEventOfCallInvitationEndedResult) => void;
    onCallUserStateChanged?: (data: ZIMEventOfCallUserStateChangedResult) => void;

    onBlacklistChanged?: (data: ZIMEventOfBlacklistChangedResult) => void;
    onFriendListChanged?: (data: ZIMEventOfFriendListChangedResult) => void;
    onFriendInfoUpdated?: (data: ZIMEventOfFriendInfoUpdatedResult) => void;
    onFriendApplicationListChanged?: (data: ZIMEventOfFriendApplicationListChangedResult) => void;
    onFriendApplicationUpdated?: (data: ZIMEventOfFriendApplicationUpdatedResult) => void;
};

export interface IZIM {
    destroy(): void;
    uploadLog(): Promise<void>;
    queryLocalFileCache(config: ZIMFileCacheQueryConfig): Promise<ZIMFileCacheQueriedResult>;
    clearLocalFileCache(config: ZIMFileCacheClearConfig): Promise<void>;

    // MARK: - User

    login(userID: string, config: ZIMLoginConfig): Promise<void>;
    logout(): void;
    renewToken(token: string): Promise<ZIMTokenRenewedResult>;
    updateUserName(userName: string): Promise<ZIMUserNameUpdatedResult>;
    updateUserAvatarUrl(userAvatarUrl: string): Promise<ZIMUserAvatarUrlUpdatedResult>;
    updateUserExtendedData(extendedData: string): Promise<ZIMUserExtendedDataUpdatedResult>;
    updateUserCustomStatus(customStatus: string): Promise<ZIMUserCustomStatusUpdatedResult>;
    updateUserOfflinePushRule(offlinePushRule: ZIMUserOfflinePushRule): Promise<ZIMUserOfflinePushRuleUpdatedResult>;
    querySelfUserInfo(): Promise<ZIMSelfUserInfoQueriedResult>;
    queryUsersInfo(userIDs: string[], config: ZIMUsersInfoQueryConfig): Promise<ZIMUsersInfoQueriedResult>;
    subscribeUsersStatus(
        userIDs: string[],
        config: ZIMUserStatusSubscribeConfig,
    ): Promise<ZIMUsersStatusSubscribedResult>;
    unsubscribeUsersStatus(userIDs: string[]): Promise<ZIMUsersStatusUnsubscribedResult>;
    queryUsersStatus(userIDs: string[]): Promise<ZIMUsersStatusQueriedResult>;
    querySubscribedUserStatusList(
        config: ZIMSubscribedUserStatusQueryConfig,
    ): Promise<ZIMSubscribedUserStatusListQueriedResult>;

    // MARK: - Conversation

    queryConversation(
        conversationID: string,
        conversationType: ZIMConversationType,
    ): Promise<ZIMConversationQueriedResult>;
    queryConversationList(
        config: ZIMConversationQueryConfig,
        option?: ZIMConversationFilterOption,
    ): Promise<ZIMConversationListQueriedResult>;
    queryConversationPinnedList(config: ZIMConversationQueryConfig): Promise<ZIMConversationPinnedListQueriedResult>;
    queryConversationTotalUnreadMessageCount(
        config: ZIMConversationTotalUnreadMessageCountQueryConfig,
    ): Promise<ZIMConversationTotalUnreadMessageCountQueriedResult>;
    deleteConversation(
        conversationID: string,
        conversationType: ZIMConversationType,
        config: ZIMConversationDeleteConfig,
    ): Promise<ZIMConversationDeletedResult>;
    deleteAllConversations(config: ZIMConversationDeleteConfig): Promise<void>;
    deleteAllConversationMessages(config: ZIMMessageDeleteConfig): Promise<void>;
    clearConversationUnreadMessageCount(
        conversationID: string,
        conversationType: ZIMConversationType,
    ): Promise<ZIMConversationUnreadMessageCountClearedResult>;
    clearConversationTotalUnreadMessageCount(): Promise<void>;
    updateConversationPinnedState(
        isPinned: boolean,
        conversationID: string,
        conversationType: ZIMConversationType,
    ): Promise<ZIMConversationPinnedStateUpdatedResult>;
    setConversationDraft(
        draft: string,
        conversationID: string,
        conversationType: ZIMConversationType,
    ): Promise<ZIMConversationDraftSetResult>;
    setConversationMark(
        markType: number,
        enable: boolean,
        conversationInfos: ZIMConversationBaseInfo[],
    ): Promise<ZIMConversationMarkSetResult>;
    setConversationNotificationStatus(
        status: ZIMConversationNotificationStatus,
        conversationID: string,
        conversationType: ZIMConversationType,
    ): Promise<ZIMConversationNotificationStatusSetResult>;

    // MARK: - Message

    sendMessage(
        message: ZIMMessage,
        toConversationID: string,
        conversationType: ZIMConversationType,
        config: ZIMMessageSendConfig,
        notification?: ZIMMessageSendNotification,
    ): Promise<ZIMMessageSentResult>;
    replyMessage(
        message: ZIMMessage,
        toOriginalMessage: ZIMMessage,
        config: ZIMMessageSendConfig,
        notification?: ZIMMessageSendNotification,
    ): Promise<ZIMMessageSentResult>;
    editMessage(
        message: ZIMMessage,
        config: ZIMMessageEditConfig,
        notification?: ZIMMessageSendNotification,
    ): Promise<ZIMMessageEditedResult>;
    cancelSendingMessage(message: ZIMMessage, config: ZIMSendingMessageCancelConfig): Promise<void>;
    downloadMediaFile(
        message: ZIMMessage,
        fileType: ZIMMediaFileType,
        config: ZIMMediaDownloadConfig,
        progress: ZIMMediaDownloadingProgress,
    ): Promise<ZIMMediaDownloadedResult>;
    importLocalMessages(
        folderPath: string,
        config: ZIMMessageImportConfig,
        progress: ZIMMessageImportingProgress,
    ): Promise<void>;
    exportLocalMessages(
        folderPath: string,
        config: ZIMMessageExportConfig,
        progress: ZIMMessageExportingProgress,
    ): Promise<void>;
    deleteMessages(
        messageList: ZIMMessage[],
        conversationID: string,
        conversationType: ZIMConversationType,
        config: ZIMMessageDeleteConfig,
    ): Promise<ZIMMessageDeletedResult>;
    deleteAllMessage(
        conversationID: string,
        conversationType: ZIMConversationType,
        config: ZIMMessageDeleteConfig,
    ): Promise<ZIMMessageDeletedResult>;
    queryHistoryMessage(
        conversationID: string,
        conversationType: ZIMConversationType,
        config: ZIMMessageQueryConfig,
    ): Promise<ZIMMessageQueriedResult>;
    queryMessages(
        messageSeqs: number[],
        conversationID: string,
        conversationType: ZIMConversationType,
    ): Promise<ZIMMessageQueriedResult>;
    insertMessageToLocalDB(
        message: ZIMMessage,
        conversationID: string,
        conversationType: ZIMConversationType,
        senderUserID: string,
    ): Promise<ZIMMessageInsertedResult>;
    updateMessageLocalExtendedData(
        localExtendedData: string,
        message: ZIMMessage,
    ): Promise<ZIMMessageLocalExtendedDataUpdatedResult>;
    revokeMessage(message: ZIMMessage, config: ZIMMessageRevokeConfig): Promise<ZIMMessageRevokedResult>;
    queryCombineMessageDetail(message: ZIMMessage): Promise<ZIMCombineMessageDetailQueriedResult>;
    pinMessage(message: ZIMMessage, isPinned: boolean): Promise<void>;
    queryPinnedMessageList(conversationID: string, conversationType: ZIMConversationType): Promise<ZIMPinnedMessageListQueriedResult>;
    sendConversationMessageReceiptRead(
        conversationID: string,
        conversationType: ZIMConversationType,
    ): Promise<ZIMConversationMessageReceiptReadSentResult>;
    sendMessageReceiptsRead(
        messageList: ZIMMessage[],
        conversationID: string,
        conversationType: ZIMConversationType,
    ): Promise<ZIMMessageReceiptsReadSentResult>;
    queryMessageReceiptsInfo(
        messageList: ZIMMessage[],
        conversationID: string,
        conversationType: ZIMConversationType,
    ): Promise<ZIMMessageReceiptsInfoQueriedResult>;
    queryGroupMessageReceiptReadMemberList(
        message: ZIMMessage,
        groupID: string,
        config: ZIMGroupMessageReceiptMemberQueryConfig,
    ): Promise<ZIMGroupMessageReceiptMemberListQueriedResult>;
    queryGroupMessageReceiptUnreadMemberList(
        message: ZIMMessage,
        groupID: string,
        config: ZIMGroupMessageReceiptMemberQueryConfig,
    ): Promise<ZIMGroupMessageReceiptMemberListQueriedResult>;
    addMessageReaction(reactionType: string, message: ZIMMessage): Promise<ZIMMessageReactionAddedResult>;
    deleteMessageReaction(reactionType: string, message: ZIMMessage): Promise<ZIMMessageReactionDeletedResult>;
    queryMessageReactionUserList(
        message: ZIMMessage,
        config: ZIMMessageReactionUserQueryConfig,
    ): Promise<ZIMMessageReactionUserListQueriedResult>;
    queryMessageRepliedList(
        message: ZIMMessage,
        config: ZIMMessageRepliedListQueryConfig,
    ): Promise<ZIMMessageRepliedListQueriedResult>;

    // MARK: - Room

    createRoom(roomInfo: ZIMRoomInfo, config?: ZIMRoomAdvancedConfig): Promise<ZIMRoomCreatedResult>;
    enterRoom(roomInfo: ZIMRoomInfo, config?: ZIMRoomAdvancedConfig): Promise<ZIMRoomEnteredResult>;
    switchRoom(
        fromRoomID: string,
        toRoomInfo: ZIMRoomInfo,
        isCreateWhenRoomNotExisted: boolean,
        config?: ZIMRoomAdvancedConfig,
    ): Promise<ZIMRoomSwitchedResult>;
    joinRoom(roomID: string): Promise<ZIMRoomJoinedResult>;
    leaveRoom(roomID: string): Promise<ZIMRoomLeftResult>;
    leaveAllRoom(): Promise<ZIMRoomAllLeftResult>;
    queryRoomMembers(userIDs: string[], roomID: string): Promise<ZIMRoomMembersQueriedResult>;
    queryRoomMemberList(roomID: string, config: ZIMRoomMemberQueryConfig): Promise<ZIMRoomMemberQueriedResult>;
    queryRoomOnlineMemberCount(roomID: string): Promise<ZIMRoomOnlineMemberCountQueriedResult>;
    setRoomAttributes(
        roomAttributes: UTSJSONObject,
        roomID: string,
        config: ZIMRoomAttributesSetConfig,
    ): Promise<ZIMRoomAttributesOperatedResult>;
    deleteRoomAttributes(
        keys: string[],
        roomID: string,
        config: ZIMRoomAttributesDeleteConfig,
    ): Promise<ZIMRoomAttributesOperatedResult>;
    beginRoomAttributesBatchOperation(roomID: string, config: ZIMRoomAttributesBatchOperationConfig): void;
    endRoomAttributesBatchOperation(roomID: string): Promise<ZIMRoomAttributesBatchOperatedResult>;
    queryRoomAllAttributes(roomID: string): Promise<ZIMRoomAttributesQueriedResult>;
    setRoomMembersAttributes(
        attributes: UTSJSONObject,
        userIDs: string[],
        roomID: string,
        config: ZIMRoomMemberAttributesSetConfig,
    ): Promise<ZIMRoomMembersAttributesOperatedResult>;
    queryRoomMembersAttributes(userIDs: string[], roomID: string): Promise<ZIMRoomMembersAttributesQueriedResult>;
    queryRoomMemberAttributesList(
        roomID: string,
        config: ZIMRoomMemberAttributesQueryConfig,
    ): Promise<ZIMRoomMemberAttributesListQueriedResult>;

    // MARK: - Group

    createGroup(
        groupInfo: ZIMGroupInfo,
        userIDs: string[],
        config?: ZIMGroupAdvancedConfig,
    ): Promise<ZIMGroupCreatedResult>;
    joinGroup(groupID: string): Promise<ZIMGroupJoinedResult>;
    leaveGroup(groupID: string): Promise<ZIMGroupLeftResult>;
    dismissGroup(groupID: string): Promise<ZIMGroupDismissedResult>;
    queryGroupInfo(groupID: string): Promise<ZIMGroupInfoQueriedResult>;
    queryGroupList(): Promise<ZIMGroupListQueriedResult>;
    updateGroupName(groupName: string, groupID: string): Promise<ZIMGroupNameUpdatedResult>;
    updateGroupAvatarUrl(groupAvatarUrl: string, groupID: string): Promise<ZIMGroupAvatarUrlUpdatedResult>;
    updateGroupNotice(groupNotice: string, groupID: string): Promise<ZIMGroupNoticeUpdatedResult>;
    updateGroupAlias(groupAlias: string, groupID: string): Promise<ZIMGroupAliasUpdatedResult>;
    muteGroup(isMute: boolean, groupID: string, config: ZIMGroupMuteConfig): Promise<ZIMGroupMutedResult>;
    setGroupAttributes(groupAttributes: UTSJSONObject, groupID: string): Promise<ZIMGroupAttributesOperatedResult>;
    deleteGroupAttributes(keys: string[], groupID: string): Promise<ZIMGroupAttributesOperatedResult>;
    queryGroupAttributes(keys: string[], groupID: string): Promise<ZIMGroupAttributesQueriedResult>;
    queryGroupAllAttributes(groupID: string): Promise<ZIMGroupAttributesQueriedResult>;
    setGroupMemberRole(role: number, forUserID: string, groupID: string): Promise<ZIMGroupMemberRoleUpdatedResult>;
    setGroupMemberNickname(
        nickname: string,
        forUserID: string,
        groupID: string,
    ): Promise<ZIMGroupMemberNicknameUpdatedResult>;
    transferGroupOwner(toUserID: string, groupID: string): Promise<ZIMGroupOwnerTransferredResult>;
    inviteUsersIntoGroup(userIDs: string[], groupID: string): Promise<ZIMGroupUsersInvitedResult>;
    kickGroupMembers(userIDs: string[], groupID: string): Promise<ZIMGroupMemberKickedResult>;
    queryGroupMemberCount(groupID: string): Promise<ZIMGroupMemberCountQueriedResult>;
    queryGroupMemberInfo(userID: string, groupID: string): Promise<ZIMGroupMemberInfoQueriedResult>;
    queryGroupMemberList(groupID: string, config: ZIMGroupMemberQueryConfig): Promise<ZIMGroupMemberListQueriedResult>;
    muteGroupMembers(
        isMute: boolean,
        userIDs: string[],
        groupID: string,
        config: ZIMGroupMemberMuteConfig,
    ): Promise<ZIMGroupMembersMutedResult>;
    queryGroupMemberMutedList(
        groupID: string,
        config: ZIMGroupMemberQueryConfig,
    ): Promise<ZIMGroupMemberMutedListQueriedResult>;
    updateGroupJoinMode(mode: ZIMGroupJoinMode, groupID: string): Promise<ZIMGroupJoinModeUpdatedResult>;
    updateGroupInviteMode(mode: ZIMGroupInviteMode, groupID: string): Promise<ZIMGroupInviteModeUpdatedResult>;
    updateGroupBeInviteMode(mode: ZIMGroupBeInviteMode, groupID: string): Promise<ZIMGroupBeInviteModeUpdatedResult>;
    sendGroupJoinApplication(
        groupID: string,
        config: ZIMGroupJoinApplicationSendConfig,
    ): Promise<ZIMGroupJoinApplicationSentResult>;
    acceptGroupJoinApplication(
        userID: string,
        groupID: string,
        config: ZIMGroupJoinApplicationAcceptConfig,
    ): Promise<ZIMGroupJoinApplicationAcceptedResult>;
    rejectGroupJoinApplication(
        userID: string,
        groupID: string,
        config: ZIMGroupJoinApplicationRejectConfig,
    ): Promise<ZIMGroupJoinApplicationRejectedResult>;
    sendGroupInviteApplications(
        userIDs: string[],
        groupID: string,
        config: ZIMGroupInviteApplicationSendConfig,
    ): Promise<ZIMGroupInviteApplicationsSentResult>;
    acceptGroupInviteApplication(
        inviterUserID: string,
        groupID: string,
        config: ZIMGroupInviteApplicationAcceptConfig,
    ): Promise<ZIMGroupInviteApplicationAcceptedResult>;
    rejectGroupInviteApplication(
        inviterUserID: string,
        groupID: string,
        config: ZIMGroupInviteApplicationRejectConfig,
    ): Promise<ZIMGroupInviteApplicationRejectedResult>;
    queryGroupApplicationList(
        config: ZIMGroupApplicationListQueryConfig,
    ): Promise<ZIMGroupApplicationListQueriedResult>;

    // MARK: - Call

    callInvite(invitees: string[], config: ZIMCallInviteConfig): Promise<ZIMCallInvitationSentResult>;
    callCancel(invitees: string[], callID: string, config: ZIMCallCancelConfig): Promise<ZIMCallCancelSentResult>;
    callAccept(callID: string, config: ZIMCallAcceptConfig): Promise<ZIMCallAcceptanceSentResult>;
    callReject(callID: string, config: ZIMCallRejectConfig): Promise<ZIMCallRejectionSentResult>;
    callingInvite(
        invitees: string[],
        callID: string,
        config: ZIMCallingInviteConfig,
    ): Promise<ZIMCallingInvitationSentResult>;
    callJoin(callID: string, config: ZIMCallJoinConfig): Promise<ZIMCallJoinSentResult>;
    callQuit(callID: string, config: ZIMCallQuitConfig): Promise<ZIMCallQuitSentResult>;
    callEnd(callID: string, config: ZIMCallEndConfig): Promise<ZIMCallEndSentResult>;
    queryCallInvitationList(config: ZIMCallInvitationQueryConfig): Promise<ZIMCallInvitationListQueriedResult>;

    // MARK: - DB Search

    searchLocalConversations(config: ZIMConversationSearchConfig): Promise<ZIMConversationsSearchedResult>;
    searchLocalMessages(
        conversationID: string,
        conversationType: ZIMConversationType,
        config: ZIMMessageSearchConfig,
    ): Promise<ZIMMessagesSearchedResult>;
    searchGlobalLocalMessages(config: ZIMMessageSearchConfig): Promise<ZIMMessagesGlobalSearchedResult>;
    searchLocalGroups(config: ZIMGroupSearchConfig): Promise<ZIMGroupsSearchedResult>;
    searchLocalGroupMembers(
        groupID: string,
        config: ZIMGroupMemberSearchConfig,
    ): Promise<ZIMGroupMembersSearchedResult>;
    searchLocalFriends(config: ZIMFriendSearchConfig): Promise<ZIMFriendsSearchedResult>;

    // MARK: - Friend

    addFriend(userID: string, config: ZIMFriendAddConfig): Promise<ZIMFriendAddedResult>;
    deleteFriends(userIDs: string[], config: ZIMFriendDeleteConfig): Promise<ZIMFriendsDeletedResult>;
    checkFriendsRelation(
        userIDs: string[],
        config: ZIMFriendRelationCheckConfig,
    ): Promise<ZIMFriendsRelationCheckedResult>;
    updateFriendAlias(friendAlias: string, userID: string): Promise<ZIMFriendAliasUpdatedResult>;
    updateFriendAttributes(friendAttributes: UTSJSONObject, userID: string): Promise<ZIMFriendAttributesUpdatedResult>;
    queryFriendsInfo(userIDs: string[]): Promise<ZIMFriendsInfoQueriedResult>;
    queryFriendList(config: ZIMFriendListQueryConfig): Promise<ZIMFriendListQueriedResult>;
    sendFriendApplication(
        userID: string,
        config: ZIMFriendApplicationSendConfig,
    ): Promise<ZIMFriendApplicationSentResult>;
    acceptFriendApplication(
        userID: string,
        config: ZIMFriendApplicationAcceptConfig,
    ): Promise<ZIMFriendApplicationAcceptedResult>;
    rejectFriendApplication(
        userID: string,
        config: ZIMFriendApplicationRejectConfig,
    ): Promise<ZIMFriendApplicationRejectedResult>;
    queryFriendApplicationList(
        config: ZIMFriendApplicationListQueryConfig,
    ): Promise<ZIMFriendApplicationListQueriedResult>;

    // MARK: - Blacklist

    addUsersToBlacklist(userIDs: string[]): Promise<ZIMBlacklistUsersAddedResult>;
    removeUsersFromBlacklist(userIDs: string[]): Promise<ZIMBlacklistUsersRemovedResult>;
    checkUserIsInBlacklist(userID: string): Promise<ZIMBlacklistCheckedResult>;
    queryBlacklist(config: ZIMBlacklistQueryConfig): Promise<ZIMBlacklistQueriedResult>;

    // MARK: - Event

    /**
     * callback 传入 null 时，可取消已注册的事件
     */

    onError(callback: null | ((error: ZIMError) => void)): void;
    onConnectionStateChanged(callback: null | ((data: ZIMEventOfConnectionStateChangedResult) => void)): void;
    onTokenWillExpire(callback: null | ((data: ZIMEventOfTokenWillExpireResult) => void)): void;
    onUserInfoUpdated(callback: null | ((data: ZIMEventOfUserInfoUpdatedResult) => void)): void;
    onUserStatusUpdated(callback: null | ((data: ZIMEventOfUserStatusUpdatedResult) => void)): void;
    onUserRuleUpdated(callback: null | ((data: ZIMEventOfUserRuleUpdatedResult) => void)): void;

    onConversationsAllDeleted(callback: null | ((data: ZIMEventOfConversationsAllDeletedResult) => void)): void;
    onConversationChanged(callback: null | ((data: ZIMEventOfConversationChangedResult) => void)): void;
    onConversationSyncStateChanged(
        callback: null | ((data: ZIMEventOfConversationSyncStateChangedResult) => void),
    ): void;
    onConversationTotalUnreadMessageCountUpdated(
        callback: null | ((data: ZIMEventOfConversationTotalUnreadMessageCountUpdatedResult) => void),
    ): void;
    onConversationMessageReceiptChanged(callback: null | ((data: ZIMEventOfMessageReceiptChangedResult) => void)): void;

    onMessageRevokeReceived(callback: null | ((data: ZIMEventOfMessageRevokeReceivedResult) => void)): void;
    onMessageReceiptChanged(callback: null | ((data: ZIMEventOfMessageReceiptChangedResult) => void)): void;
    onMessageReactionsChanged(callback: null | ((data: ZIMEventOfMessageReactionsChangedResult) => void)): void;
    onMessageRepliedCountChanged(callback: null | ((data: ZIMEventOfMessageRepliedCountChangedResult) => void)): void;
    onMessageRepliedInfoChanged(callback: null | ((data: ZIMEventOfMessageRepliedInfoChangedResult) => void)): void;
    onMessagePinStatusChanged(callback: null | ((data: ZIMEventOfMessagePinStatusChangedResult) => void)): void;
    onMessageDeleted(callback: null | ((data: ZIMEventOfMessageDeletedResult) => void)): void;
    onMessageEdited(callback: null | ((data: ZIMEventOfMessageEditedResult) => void)): void;
    onMessageSentStatusChanged(callback: null | ((data: ZIMEventOfMessageSentStatusChangedResult) => void)): void;
    onBroadcastMessageReceived(callback: null | ((data: ZIMEventOfBroadcastMessageReceivedResult) => void)): void;
    onPeerMessageReceived(callback: null | ((data: ZIMEventOfConversationMessageReceivedResult) => void)): void;
    onGroupMessageReceived(callback: null | ((data: ZIMEventOfConversationMessageReceivedResult) => void)): void;
    onRoomMessageReceived(callback: null | ((data: ZIMEventOfConversationMessageReceivedResult) => void)): void;

    onRoomStateChanged(callback: null | ((data: ZIMEventOfRoomStateChangedResult) => void)): void;
    onRoomMemberJoined(callback: null | ((data: ZIMEventOfRoomMemberChangedResult) => void)): void;
    onRoomMemberLeft(callback: null | ((data: ZIMEventOfRoomMemberChangedResult) => void)): void;
    onRoomAttributesUpdated(callback: null | ((data: ZIMEventOfRoomAttributesUpdatedResult) => void)): void;
    onRoomAttributesBatchUpdated(callback: null | ((data: ZIMEventOfRoomAttributesUpdatedResult) => void)): void;
    onRoomMemberAttributesUpdated(
        callback: null | ((data: ZIMEventOfRoomMembersAttributesUpdatedResult) => void),
    ): void;

    onGroupStateChanged(callback: null | ((data: ZIMEventOfGroupStateChangedResult) => void)): void;
    onGroupNameUpdated(callback: null | ((data: ZIMEventOfGroupNameUpdatedResult) => void)): void;
    onGroupAvatarUrlUpdated(callback: null | ((data: ZIMEventOfGroupAvatarUrlUpdatedResult) => void)): void;
    onGroupNoticeUpdated(callback: null | ((data: ZIMEventOfGroupNoticeUpdatedResult) => void)): void;
    onGroupAliasUpdated(callback: null | ((data: ZIMEventOfGroupAliasUpdatedResult) => void)): void;
    onGroupAttributesUpdated(callback: null | ((data: ZIMEventOfGroupAttributesUpdatedResult) => void)): void;
    onGroupMutedInfoUpdated(callback: null | ((data: ZIMEventOfGroupMutedInfoUpdatedResult) => void)): void;
    onGroupVerifyInfoUpdated(callback: null | ((data: ZIMEventOfGroupVerifyInfoUpdatedResult) => void)): void;
    onGroupApplicationListChanged(callback: null | ((data: ZIMEventOfGroupApplicationListChangedResult) => void)): void;
    onGroupApplicationUpdated(callback: null | ((data: ZIMEventOfGroupApplicationUpdatedResult) => void)): void;
    onGroupMemberStateChanged(callback: null | ((data: ZIMEventOfGroupMemberStateChangedResult) => void)): void;
    onGroupMemberInfoUpdated(callback: null | ((data: ZIMEventOfGroupMemberInfoUpdatedResult) => void)): void;

    onCallInvitationCreated(callback: null | ((data: ZIMEventOfCallInvitationCreatedResult) => void)): void;
    onCallInvitationReceived(callback: null | ((data: ZIMEventOfCallInvitationReceivedResult) => void)): void;
    onCallInvitationCancelled(callback: null | ((data: ZIMEventOfCallInvitationCancelledResult) => void)): void;
    onCallInvitationTimeout(callback: null | ((data: ZIMEventOfCallInvitationTimeoutResult) => void)): void;
    onCallInvitationEnded(callback: null | ((data: ZIMEventOfCallInvitationEndedResult) => void)): void;
    onCallUserStateChanged(callback: null | ((data: ZIMEventOfCallUserStateChangedResult) => void)): void;

    onBlacklistChanged(callback: null | ((data: ZIMEventOfBlacklistChangedResult) => void)): void;
    onFriendListChanged(callback: null | ((data: ZIMEventOfFriendListChangedResult) => void)): void;
    onFriendInfoUpdated(callback: null | ((data: ZIMEventOfFriendInfoUpdatedResult) => void)): void;
    onFriendApplicationListChanged(
        callback: null | ((data: ZIMEventOfFriendApplicationListChangedResult) => void),
    ): void;
    onFriendApplicationUpdated(callback: null | ((data: ZIMEventOfFriendApplicationUpdatedResult) => void)): void;
}
