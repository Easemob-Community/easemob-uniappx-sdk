export type ZIMError = {
    code: number;
    message: string;
};
export type ZIMAppConfig = {
    appID: number;
    appSign: string;
};
/**
 * Native 平台时可设置属性：logPath、logSize
 *
 * Web 和小程序平台时可设置属性：logLevel
 */
export type ZIMLogConfig = {
    logPath?: string;
    logSize?: number;
    logLevel?: 'debug' | 'info' | 'warn' | 'error' | 'report' | 'disable';
};
export type ZIMLoginConfig = {
    token: string;
    userName: string;
    customStatus: string;
    isOfflineLogin: boolean;
};
export type ZIMCacheConfig = {
    cachePath: string;
};
