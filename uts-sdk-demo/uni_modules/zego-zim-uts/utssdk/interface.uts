export type ZIMConversationBaseInfo = {
    conversationID: string;
    conversationType: ZIMConversationType;
};
export type ZIMConversation = {
    conversationID: string;
    conversationName: string;
    conversationAlias: string;
    conversationAvatarUrl: string;
    type: ZIMConversationType;
    unreadMessageCount: number;
    orderKey: number;
    notificationStatus: ZIMConversationNotificationStatus;
    isPinned: boolean;
    pinnedTime: number;
    draft: string;
    marks: number[];
    mentionedInfoList: ZIMMessageMentionedInfo[];
    lastMessage?: ZIMMessage;
    /**
     * 群会话属性
     */
    isDisabled?: boolean;
    mutedExpiredTime?: number;
};
export type ZIMMessageRepliedInfo = {
    state: ZIMMessageRepliedInfoState;
    messageSeq: number;
    messageID: string;
    senderUserID: string;
    sentTime: number;
    messageInfo: ZIMMessageLiteInfo;
};
export type ZIMMessageRootRepliedInfo = {
    state: ZIMMessageRepliedInfoState;
    repliedCount: number;
    senderUserID: string;
    sentTime: number;
    message?: ZIMMessage;
};
export type ZIMMessageRootRepliedCountInfo = {
    conversationID: string;
    conversationType: ZIMConversationType;
    count: number;
    messageID: string;
};
export type ZIMMessagePinStatusChangeInfo = {
    pinStatus: ZIMMessagePinStatus;
    message: ZIMMessage;
};
export type ZIMMessageReceivedInfo = {
    isOfflineMessage: boolean;
};
export type ZIMMessageMentionedInfo = {
    type: ZIMMessageMentionedType;
    fromUserID: string;
    messageID: string;
    messageSeq: number;
};
export type ZIMConversationChangeInfo = {
    event: ZIMConversationEvent;
    conversation: ZIMConversation;
};
export type ZIMMessageLiteInfo = {
    type: ZIMMessageType;

    /****** 消息类型对应的属性 ******/

    /**
     * 1：文本，200：自定义
     */
    message?: string;

    /**
     * 100：合并
     */
    title?: string;
    summary?: string;

    /**
     * 200：自定义
     */
    subType?: number;
    searchedContent?: string;

    /**
     * 10：组合
     */
    messageInfoList?: ZIMMessageLiteInfo[];

    /**
     * 11-14：媒体文件
     *
     * fileLocalPath: Web 平台时为 File 对象，其他平台为 String
     */
    fileLocalPath?: any;
    fileDownloadUrl?: string;
    fileName?: string;
    fileSize?: number;

    /**
     * 11：图片
     */
    thumbnailDownloadUrl?: string;
    thumbnailLocalPath?: string;
    largeImageDownloadUrl?: string;
    largeImageLocalPath?: string;
    originalImageWidth?: number;
    originalImageHeight?: number;
    thumbnailWidth?: number;
    thumbnailHeight?: number;
    largeImageWidth?: number;
    largeImageHeight?: number;

    /**
     * 13：音频
     */
    audioDuration?: number;

    /**
     * 14：视频
     */
    videoDuration?: number;
    videoFirstFrameDownloadUrl?: string;
    videoFirstFrameLocalPath?: string;
    videoFirstFrameWidth?: number;
    videoFirstFrameHeight?: number;
};
export type ZIMMessage = {
    /****** 发送消息时可赋值的属性 ******/

    type: ZIMMessageType;
    extendedData?: string;
    localExtendedData?: string;
    mentionedUserIDs?: string[];
    isMentionAll?: boolean;

    /****** 消息类型对应的属性 ******/

    /**
     * 1：文本，2：信令，20：弹幕，200：自定义
     */
    message?: string | number[];

    /**
     * 100：合并
     */
    title?: string;
    summary?: string;
    messageList?: ZIMMessage[];
    combineID?: string;

    /**
     * 200：自定义
     */
    subType?: number;
    searchedContent?: string;

    /**
     * 10：组合
     */
    messageInfoList?: ZIMMessageLiteInfo[];

    /**
     * 11-14：媒体文件
     *
     * fileLocalPath: Web 平台时为 File 对象，其他平台为 String
     */
    fileLocalPath?: any;
    fileDownloadUrl?: string;
    fileName?: string;
    fileSize?: number;
    fileUID?: string;

    /**
     * 11：图片
     */
    thumbnailDownloadUrl?: string;
    thumbnailLocalPath?: string;
    largeImageDownloadUrl?: string;
    largeImageLocalPath?: string;
    originalImageWidth?: number;
    originalImageHeight?: number;
    thumbnailWidth?: number;
    thumbnailHeight?: number;
    largeImageWidth?: number;
    largeImageHeight?: number;

    /**
     * 13：音频
     */
    audioDuration?: number;

    /**
     * 14：视频
     */
    videoDuration?: number;
    videoFirstFrameDownloadUrl?: string;
    videoFirstFrameLocalPath?: string;
    videoFirstFrameWidth?: number;
    videoFirstFrameHeight?: number;

    /**
     * 31：撤回
     */
    revokeType?: ZIMRevokeType;
    revokeStatus?: ZIMMessageRevokeStatus;
    revokeTimestamp?: number;
    operatedUserID?: string;
    revokeExtendedData?: string;
    originalMessageType?: ZIMMessageType;
    originalTextMessageContent?: string;

    /**
     * 32：Tips
     */
    event?: ZIMTipsMessageEvent;
    operatedUser?: ZIMGroupMemberSimpleInfo;
    targetUserList?: ZIMGroupMemberSimpleInfo[];
    changeInfo?: ZIMTipsMessageChangeInfo;

    /****** 公共只读属性 ******/
    localMessageID?: string;
    messageID?: string;
    senderUserID?: string;
    timestamp?: number;
    conversationID?: string;
    conversationType?: ZIMConversationType;
    direction?: ZIMMessageDirection;
    sentStatus?: ZIMMessageSentStatus;
    orderKey?: number;
    messageSeq?: number;
    receiptStatus?: ZIMMessageReceiptStatus;
    reactions?: ZIMMessageReaction[];
    isUserInserted?: boolean;
    isServerMessage?: boolean;
    isBroadcastMessage?: boolean;
    isGroupTargetedMessage?: boolean;
    editorUserID?: string;
    editedTime?: number;
    pinnedUserID?: string;
    pinnedTime?: number;
    rootRepliedCount?: number;
    repliedInfo?: ZIMMessageRepliedInfo;
};
export type ZIMTipsMessageChangeInfo = {
    type: ZIMTipsMessageChangeInfoType;
    /**
     * 群变更属性
