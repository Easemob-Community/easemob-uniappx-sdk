    groupDataFlag?: number;
    groupName?: string;
    groupAvatarUrl?: string;
    groupNotice?: string;
    groupMutedInfo?: ZIMGroupMuteInfo;
    /**
     * 群成员变更属性
     */
    memberRole?: number;
    muteExpiredTime?: number;
    groupNewOwner?: ZIMGroupMemberSimpleInfo;
    /**
     * 消息置顶
     */
    isPinned?: boolean;
};
