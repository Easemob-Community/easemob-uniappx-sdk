    // MARK: - DB Search

    searchLocalConversations(config: ZIMConversationSearchConfig): Promise<ZIMConversationsSearchedResult> {
        return this._zim!.searchLocalConversations(config).then((res) => {
            return {
                nextFlag: res.nextFlag,
                conversationSearchInfoList: mZIMConversationSearchInfoList(res.conversationSearchInfoList),
            } as ZIMConversationsSearchedResult;
        });
    }

    searchLocalMessages(
        conversationID: string,
        conversationType: ZIMConversationType,
        config: ZIMMessageSearchConfig,
    ): Promise<ZIMMessagesSearchedResult> {
        const _config: NZIMMessageSearchConfig = {
            keywords: config.keywords,
            senderUserIDs: config.senderUserIDs,
            messageTypes: config.messageTypes,
            subMessageTypes: config.subMessageTypes,
            startTime: config.startTime,
            endTime: config.endTime,
            order: config.order,
            count: config.count,
        };
        if (typeof config.nextMessage == 'string' && config.nextMessage != '') {
            _config.nextMessage = this.nextMessageMap.get(config.nextMessage!)!;
        }

        return this._zim!.searchLocalMessages(conversationID, conversationType, _config).then((res) => {
            if (res.nextMessage != null && res.nextMessage != undefined) {
                this.putNextMessage(res.nextMessage);
            }
            return {
                conversationID: res.conversationID,
                conversationType: res.conversationType,
                nextMessage: res.nextMessage?.localMessageID,
                messageList: mZIMMessageList(res.messageList),
            } as ZIMMessagesSearchedResult;
        });
    }

    searchGlobalLocalMessages(config: ZIMMessageSearchConfig): Promise<ZIMMessagesGlobalSearchedResult> {
        const _config: NZIMMessageSearchConfig = {
            keywords: config.keywords,
            senderUserIDs: config.senderUserIDs,
            messageTypes: config.messageTypes,
            subMessageTypes: config.subMessageTypes,
            startTime: config.startTime,
            endTime: config.endTime,
            order: config.order,
            count: config.count,
        };
        if (typeof config.nextMessage == 'string' && config.nextMessage != '') {
            _config.nextMessage = this.nextMessageMap.get(config.nextMessage!)!;
        }

        return this._zim!.searchGlobalLocalMessages(_config).then((res) => {
            if (res.nextMessage != null && res.nextMessage != undefined) {
                this.putNextMessage(res.nextMessage);
            }
            return {
                nextMessage: res.nextMessage?.localMessageID,
                messageList: mZIMMessageList(res.messageList),
            } as ZIMMessagesGlobalSearchedResult;
        });
    }

    searchLocalGroups(config: ZIMGroupSearchConfig): Promise<ZIMGroupsSearchedResult> {
        return this._zim!.searchLocalGroups(config).then((res) => {
            return {
                nextFlag: res.nextFlag,
                groupSearchInfoList: mZIMGroupSearchInfoList(res.groupSearchInfoList),
            } as ZIMGroupsSearchedResult;
        });
    }

    searchLocalGroupMembers(
        groupID: string,
        config: ZIMGroupMemberSearchConfig,
    ): Promise<ZIMGroupMembersSearchedResult> {
        return this._zim!.searchLocalGroupMembers(groupID, config).then((res) => {
            return {
                groupID: res.groupID,
                nextFlag: res.nextFlag,
                userList: mZIMGroupMemberInfoList(res.userList),
            } as ZIMGroupMembersSearchedResult;
        });
    }

    searchLocalFriends(config: ZIMFriendSearchConfig): Promise<ZIMFriendsSearchedResult> {
        return this._zim!.searchLocalFriends(config).then((res) => {
            return {
                nextFlag: res.nextFlag,
                friendInfoList: mZIMFriendInfoList(res.friendInfoList),
            } as ZIMFriendsSearchedResult;
        });
    }

