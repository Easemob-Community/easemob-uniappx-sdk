    downloadMediaFile(
        message: ZIMMessage,
        fileType: ZIMMediaFileType,
        config: ZIMMediaDownloadConfig,
        progress: ZIMMediaDownloadingProgress,
    ): Promise<ZIMMediaDownloadedResult> {
        const _progress = (message: NZIMMessage, currentFileSize: number, totalFileSize: number) => {
            progress(mZIMMessage(message), currentFileSize, totalFileSize);
        };
        return this._zim!.downloadMediaFile(oZIMMessage(message), fileType, config, _progress).then((res) => {
            return { message: mZIMMessage(res.message) } as ZIMMediaDownloadedResult;
        });
    }

