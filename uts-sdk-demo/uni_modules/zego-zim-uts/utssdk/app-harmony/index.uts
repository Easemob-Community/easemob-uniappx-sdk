const TAG_UTS_EVENT = 'uts_';

type IZIMEventHandler = {
    // Native 层事件接口
    
    error?: (_: NZIM, error: NZIMError) => void;
    connectionStateChanged?: (_: NZIM, data: NZIMEventOfConnectionStateChangedResult) => void;
    tokenWillExpire?: (_: NZIM, data: NZIMEventOfTokenWillExpireResult) => void;
    userInfoUpdated?: (_: NZIM, data: NZIMEventOfUserInfoUpdatedResult) => void;
    userStatusUpdated?: (_: NZIM, data: NZIMEventOfUserStatusUpdatedResult) => void;
    userRuleUpdated?: (_: NZIM, data: NZIMEventOfUserRuleUpdatedResult) => void;

    conversationsAllDeleted?: (_: NZIM, data: NZIMEventOfConversationsAllDeletedResult) => void;
    conversationChanged?: (_: NZIM, data: NZIMEventOfConversationChangedResult) => void;
    conversationSyncStateChanged?: (_: NZIM, data: NZIMEventOfConversationSyncStateChangedResult) => void;
    conversationTotalUnreadMessageCountUpdated?: (_: NZIM, data: NZIMEventOfConversationTotalUnreadMessageCountUpdatedResult) => void;
    conversationMessageReceiptChanged?: (_: NZIM, data: NZIMEventOfMessageReceiptChangedResult) => void;

    messageRevokeReceived?: (_: NZIM, data: NZIMEventOfMessageRevokeReceivedResult) => void;
    messageReceiptChanged?: (_: NZIM, data: NZIMEventOfMessageReceiptChangedResult) => void;
    messageReactionsChanged?: (_: NZIM, data: NZIMEventOfMessageReactionsChangedResult) => void;
    messageRepliedCountChanged?: (_: NZIM, data: NZIMEventOfMessageRepliedCountChangedResult) => void;
    messageRepliedInfoChanged?: (_: NZIM, data: NZIMEventOfMessageRepliedInfoChangedResult) => void;
    messagePinStatusChanged?: (_: NZIM, data: NZIMEventOfMessagePinStatusChangedResult) => void;
    messageDeleted?: (_: NZIM, data: NZIMEventOfMessageDeletedResult) => void;
    messageEdited?: (_: NZIM, data: NZIMEventOfMessageEditedResult) => void;
    messageSentStatusChanged?: (_: NZIM, data: NZIMEventOfMessageSentStatusChangedResult) => void;
    broadcastMessageReceived?: (_: NZIM, data: NZIMEventOfBroadcastMessageReceivedResult) => void;
    peerMessageReceived?: (_: NZIM, data: NZIMEventOfConversationMessageReceivedResult) => void;
    groupMessageReceived?: (_: NZIM, data: NZIMEventOfConversationMessageReceivedResult) => void;
    roomMessageReceived?: (_: NZIM, data: NZIMEventOfConversationMessageReceivedResult) => void;

    roomStateChanged?: (_: NZIM, data: NZIMEventOfRoomStateChangedResult) => void;
    roomMemberJoined?: (_: NZIM, data: NZIMEventOfRoomMemberChangedResult) => void;
    roomMemberLeft?: (_: NZIM, data: NZIMEventOfRoomMemberChangedResult) => void;
    roomAttributesUpdated?: (_: NZIM, data: NZIMEventOfRoomAttributesUpdatedResult) => void;
    roomAttributesBatchUpdated?: (_: NZIM, data: NZIMEventOfRoomAttributesUpdatedResult) => void;
    roomMemberAttributesUpdated?: (_: NZIM, data: NZIMEventOfRoomMembersAttributesUpdatedResult) => void;

    groupStateChanged?: (_: NZIM, data: NZIMEventOfGroupStateChangedResult) => void;
    groupNameUpdated?: (_: NZIM, data: NZIMEventOfGroupNameUpdatedResult) => void;
    groupAvatarUrlUpdated?: (_: NZIM, data: NZIMEventOfGroupAvatarUrlUpdatedResult) => void;
    groupNoticeUpdated?: (_: NZIM, data: NZIMEventOfGroupNoticeUpdatedResult) => void;
    groupAliasUpdated?: (_: NZIM, data: NZIMEventOfGroupAliasUpdatedResult) => void;
    groupAttributesUpdated?: (_: NZIM, data: NZIMEventOfGroupAttributesUpdatedResult) => void;
    groupMutedInfoUpdated?: (_: NZIM, data: NZIMEventOfGroupMutedInfoUpdatedResult) => void;
    groupVerifyInfoUpdated?: (_: NZIM, data: NZIMEventOfGroupVerifyInfoUpdatedResult) => void;
    groupApplicationListChanged?: (_: NZIM, data: NZIMEventOfGroupApplicationListChangedResult) => void;
    groupApplicationUpdated?: (_: NZIM, data: NZIMEventOfGroupApplicationUpdatedResult) => void;
    groupMemberStateChanged?: (_: NZIM, data: NZIMEventOfGroupMemberStateChangedResult) => void;
    groupMemberInfoUpdated?: (_: NZIM, data: NZIMEventOfGroupMemberInfoUpdatedResult) => void;

    callInvitationCreated?: (_: NZIM, data: NZIMEventOfCallInvitationCreatedResult) => void;
    callInvitationReceived?: (_: NZIM, data: NZIMEventOfCallInvitationReceivedResult) => void;
    callInvitationCancelled?: (_: NZIM, data: NZIMEventOfCallInvitationCancelledResult) => void;
    callInvitationTimeout?: (_: NZIM, data: NZIMEventOfCallInvitationTimeoutResult) => void;
    callInvitationEnded?: (_: NZIM, data: NZIMEventOfCallInvitationEndedResult) => void;
    callUserStateChanged?: (_: NZIM, data: NZIMEventOfCallUserStateChangedResult) => void;

    blacklistChanged?: (_: NZIM, data: NZIMEventOfBlacklistChangedResult) => void;
    friendListChanged?: (_: NZIM, data: NZIMEventOfFriendListChangedResult) => void;
    friendInfoUpdated?: (_: NZIM, data: NZIMEventOfFriendInfoUpdatedResult) => void;
    friendApplicationListChanged?: (_: NZIM, data: NZIMEventOfFriendApplicationListChangedResult) => void;
    friendApplicationUpdated?: (_: NZIM, data: NZIMEventOfFriendApplicationUpdatedResult) => void;
    
    // UTS 层事件接口
    
    uts_error?: (error: ZIMError) => void;
    uts_connectionStateChanged?: (data: ZIMEventOfConnectionStateChangedResult) => void;
    uts_tokenWillExpire?: (data: ZIMEventOfTokenWillExpireResult) => void;
    uts_userInfoUpdated?: (data: ZIMEventOfUserInfoUpdatedResult) => void;
    uts_userStatusUpdated?: (data: ZIMEventOfUserStatusUpdatedResult) => void;
    uts_userRuleUpdated?: (data: ZIMEventOfUserRuleUpdatedResult) => void;
    
    uts_conversationsAllDeleted?: (data: ZIMEventOfConversationsAllDeletedResult) => void;
    uts_conversationChanged?: (data: ZIMEventOfConversationChangedResult) => void;
    uts_conversationSyncStateChanged?: (data: ZIMEventOfConversationSyncStateChangedResult) => void;
    uts_conversationTotalUnreadMessageCountUpdated?: (data: ZIMEventOfConversationTotalUnreadMessageCountUpdatedResult) => void;
    uts_conversationMessageReceiptChanged?: (data: ZIMEventOfMessageReceiptChangedResult) => void;
    
    uts_messageRevokeReceived?: (data: ZIMEventOfMessageRevokeReceivedResult) => void;
    uts_messageReceiptChanged?: (data: ZIMEventOfMessageReceiptChangedResult) => void;
    uts_messageReactionsChanged?: (data: ZIMEventOfMessageReactionsChangedResult) => void;
    uts_messageRepliedCountChanged?: (data: ZIMEventOfMessageRepliedCountChangedResult) => void;
    uts_messageRepliedInfoChanged?: (data: ZIMEventOfMessageRepliedInfoChangedResult) => void;
    uts_messagePinStatusChanged?: (data: ZIMEventOfMessagePinStatusChangedResult) => void;
    uts_messageDeleted?: (data: ZIMEventOfMessageDeletedResult) => void;
    uts_messageEdited?: (data: ZIMEventOfMessageEditedResult) => void;
    uts_messageSentStatusChanged?: (data: ZIMEventOfMessageSentStatusChangedResult) => void;
    uts_broadcastMessageReceived?: (data: ZIMEventOfBroadcastMessageReceivedResult) => void;
    uts_peerMessageReceived?: (data: ZIMEventOfConversationMessageReceivedResult) => void;
    uts_groupMessageReceived?: (data: ZIMEventOfConversationMessageReceivedResult) => void;
    uts_roomMessageReceived?: (data: ZIMEventOfConversationMessageReceivedResult) => void;
    
    uts_roomStateChanged?: (data: ZIMEventOfRoomStateChangedResult) => void;
    uts_roomMemberJoined?: (data: ZIMEventOfRoomMemberChangedResult) => void;
    uts_roomMemberLeft?: (data: ZIMEventOfRoomMemberChangedResult) => void;
    uts_roomAttributesUpdated?: (data: ZIMEventOfRoomAttributesUpdatedResult) => void;
    uts_roomAttributesBatchUpdated?: (data: ZIMEventOfRoomAttributesUpdatedResult) => void;
    uts_roomMemberAttributesUpdated?: (data: ZIMEventOfRoomMembersAttributesUpdatedResult) => void;
    
    uts_groupStateChanged?: (data: ZIMEventOfGroupStateChangedResult) => void;
    uts_groupNameUpdated?: (data: ZIMEventOfGroupNameUpdatedResult) => void;
    uts_groupAvatarUrlUpdated?: (data: ZIMEventOfGroupAvatarUrlUpdatedResult) => void;
    uts_groupNoticeUpdated?: (data: ZIMEventOfGroupNoticeUpdatedResult) => void;
    uts_groupAliasUpdated?: (data: ZIMEventOfGroupAliasUpdatedResult) => void;
    uts_groupAttributesUpdated?: (data: ZIMEventOfGroupAttributesUpdatedResult) => void;
    uts_groupMutedInfoUpdated?: (data: ZIMEventOfGroupMutedInfoUpdatedResult) => void;
    uts_groupVerifyInfoUpdated?: (data: ZIMEventOfGroupVerifyInfoUpdatedResult) => void;
    uts_groupApplicationListChanged?: (data: ZIMEventOfGroupApplicationListChangedResult) => void;
    uts_groupApplicationUpdated?: (data: ZIMEventOfGroupApplicationUpdatedResult) => void;
    uts_groupMemberStateChanged?: (data: ZIMEventOfGroupMemberStateChangedResult) => void;
    uts_groupMemberInfoUpdated?: (data: ZIMEventOfGroupMemberInfoUpdatedResult) => void;
    
    uts_callInvitationCreated?: (data: ZIMEventOfCallInvitationCreatedResult) => void;
    uts_callInvitationReceived?: (data: ZIMEventOfCallInvitationReceivedResult) => void;
    uts_callInvitationCancelled?: (data: ZIMEventOfCallInvitationCancelledResult) => void;
    uts_callInvitationTimeout?: (data: ZIMEventOfCallInvitationTimeoutResult) => void;
    uts_callInvitationEnded?: (data: ZIMEventOfCallInvitationEndedResult) => void;
    uts_callUserStateChanged?: (data: ZIMEventOfCallUserStateChangedResult) => void;
    
    uts_blacklistChanged?: (data: ZIMEventOfBlacklistChangedResult) => void;
    uts_friendListChanged?: (data: ZIMEventOfFriendListChangedResult) => void;
    uts_friendInfoUpdated?: (data: ZIMEventOfFriendInfoUpdatedResult) => void;
    uts_friendApplicationListChanged?: (data: ZIMEventOfFriendApplicationListChangedResult) => void;
    uts_friendApplicationUpdated?: (data: ZIMEventOfFriendApplicationUpdatedResult) => void;
};

export class ZIM implements IZIM {
    private static _instance: ZIM | null = null;

    private _zim: NZIM | null = null;
    private _eventMap = {} as IZIMEventHandler;
    private constructor(nzim: NZIM) {
        this._zim = nzim;
    }
    

    // 与 iOS 保持逻辑一致
    private nextMessageMap = new Map<string, NZIMMessage>();
    private nextConversationMap = new Map<string, NZIMConversation>();
    private putNextMessage(msgObj: NZIMMessage): string {
        const key = msgObj.localMessageID;
        this.nextMessageMap.set(key, msgObj);
        return key;
    }
    private putNextConversation(convObj: NZIMConversation): string {
        const key = convObj.type.toString() + convObj.conversationID;
        this.nextConversationMap.set(key, convObj);
        return key;
    }

    static setLogConfig(config: ZIMLogConfig): void {
        let logPath = '';
        let logSize = 0;

        if (typeof config.logPath == 'string') {
            logPath = config.logPath;
        }
        if (typeof config.logSize == 'number') {
            logSize = config.logSize;
        }

        NZIM.setLogConfig({ logPath, logSize } as NZIMLogConfig);
    }

    static setCacheConfig(config: ZIMCacheConfig): void {
        NZIM.setCacheConfig(config);
    }

    static setAdvancedConfig(key: string, value: string): void {
        NZIM.setAdvancedConfig(key, value);
    }

    static setGeofencingConfig(areaList: number[], type: ZIMGeofencingType): boolean {
        return NZIM.setGeofencingConfig(areaList, type);
    }

    static getVersion(): string {
        return NZIM.getVersion();
    }

    static create(appConfig: ZIMAppConfig): IZIM {
        if (ZIM._instance == null) {
            NZIM.setAdvancedConfig('zim_cross_platform', 'uni-app-x');
            const nzim = NZIM.create(appConfig);
            ZIM._instance = new ZIM(nzim!);
        }
        return ZIM._instance!;
    }

    static getInstance(): IZIM {
        return ZIM._instance!;
    }

    destroy(): void {
        this.nextMessageMap.clear();
        this.nextConversationMap.clear();
        if (this._zim != null) {
            this._zim!.destroy();
            this._zim = null;
        }
    }

    uploadLog(): Promise<void> {
        return this._zim!.uploadLog();
    }

    queryLocalFileCache(config: ZIMFileCacheQueryConfig): Promise<ZIMFileCacheQueriedResult> {
