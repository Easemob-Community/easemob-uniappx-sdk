    // MARK: - Group

    createGroup(
        groupInfo: ZIMGroupInfo,
        userIDs: string[],
        config?: ZIMGroupAdvancedConfig,
    ): Promise<ZIMGroupCreatedResult> {
        const _config: NZIMGroupAdvancedConfig = {
            groupNotice: config?.groupNotice ?? '',
            groupAttributes: oMap(config?.groupAttributes),
            maxMemberCount: config?.maxMemberCount ?? 0,
            joinMode: config?.joinMode ?? 0,
            inviteMode: config?.inviteMode ?? 0,
            beInviteMode: config?.beInviteMode ?? 0,
        };
        return this._zim!.createGroup(groupInfo, userIDs, _config).then((res) => {
            return {
                groupInfo: mZIMGroupFullInfo(res.groupInfo),
                userList: mZIMGroupMemberInfoList(res.userList),
                errorUserList: res.errorUserList as ZIMErrorUserInfo[],
            } as ZIMGroupCreatedResult;
        });
    }

