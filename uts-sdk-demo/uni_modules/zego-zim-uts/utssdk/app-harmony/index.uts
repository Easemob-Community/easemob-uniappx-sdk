    // MARK: - Conversation

    queryConversation(
        conversationID: string,
        conversationType: ZIMConversationType,
    ): Promise<ZIMConversationQueriedResult> {
        return this._zim!.queryConversation(conversationID, conversationType).then((res) => {
            return { conversation: mZIMConversation(res.conversation) } as ZIMConversationQueriedResult;
        });
    }

    queryConversationList(
        config: ZIMConversationQueryConfig,
        option?: ZIMConversationFilterOption,
    ): Promise<ZIMConversationListQueriedResult> {
        const _config: NZIMConversationQueryConfig = { count: config.count };
        if (typeof config.nextConversation == 'string' && config.nextConversation != '') {
            _config.nextConversation = this.nextConversationMap.get(config.nextConversation!)!;
        }

        return this._zim!.queryConversationList(_config, option).then((res) => {
            const len = res.conversationList.length;
            if (len > 0) {
                this.putNextConversation(res.conversationList[len - 1]);
            }
            return { conversationList: mZIMConversationList(res.conversationList) } as ZIMConversationListQueriedResult;
        });
    }

    queryConversationPinnedList(config: ZIMConversationQueryConfig): Promise<ZIMConversationPinnedListQueriedResult> {
        const _config: NZIMConversationQueryConfig = { count: config.count };
        if (typeof config.nextConversation == 'string' && config.nextConversation != '') {
            _config.nextConversation = this.nextConversationMap.get(config.nextConversation!)!;
        }

        return this._zim!.queryConversationPinnedList(_config).then((res) => {
            const len = res.conversationList.length;
            if (len > 0) {
                this.putNextConversation(res.conversationList[len - 1]);
            }
            return {
                conversationList: mZIMConversationList(res.conversationList),
            } as ZIMConversationPinnedListQueriedResult;
        });
    }

