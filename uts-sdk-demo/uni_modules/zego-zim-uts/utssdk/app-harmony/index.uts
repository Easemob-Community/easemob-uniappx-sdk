    // MARK: - Event  
    
    // 1. 使 Native 层仅注册、注销一次
    // 2. 业务层多次注册时覆盖旧回调
    private onEvent<T>(type: string, callback: (data: T) => void): boolean {
        this._eventMap[TAG_UTS_EVENT + type] = callback;
        
        return this._eventMap[type] == null || this._eventMap[type] == undefined;
    }
    
    onError(callback: null | ((error: ZIMError) => void)): void {        
        const type = 'error';
        if (callback == null && this._eventMap[type] != null && this._eventMap[type] != undefined) {
            this._zim!.off(type, this._eventMap[type]);
            this._eventMap[type] = null;
        } else if (callback != null && this.onEvent(type, callback)) {
            this._eventMap[type] = (_: NZIM, data: NZIMError) => {
                this._eventMap[TAG_UTS_EVENT + type](data as ZIMError);
            };
            this._zim!.on(type, this._eventMap[type]);
        }
    }

    onConnectionStateChanged(callback: null | ((data: ZIMEventOfConnectionStateChangedResult) => void)): void {
        const type = 'connectionStateChanged';
        if (callback == null && this._eventMap[type] != null && this._eventMap[type] != undefined) {
            this._zim!.off(type, this._eventMap[type]);
            this._eventMap[type] = null;
        } else if (callback != null && this.onEvent(type, callback)) {
            this._eventMap[type] = (_: NZIM, data: NZIMEventOfConnectionStateChangedResult) => {
                const str = data.extendedData;
                this._eventMap[TAG_UTS_EVENT + type]({
                    state: data.state,
                    event: data.event,
                    extendedData: JSON.parseObject(str == null || str.length == 0 ? '{}' : str) ?? {},
                });
            };
            this._zim!.on(type, this._eventMap[type]);
        }
    }

    onTokenWillExpire(callback: null | ((data: ZIMEventOfTokenWillExpireResult) => void)): void {        
        const type = 'tokenWillExpire';
        if (callback == null && this._eventMap[type] != null && this._eventMap[type] != undefined) {
            this._zim!.off(type, this._eventMap[type]);
            this._eventMap[type] = null;
        } else if (callback != null && this.onEvent(type, callback)) {
            this._eventMap[type] = (_: NZIM, data: NZIMEventOfTokenWillExpireResult) => {
                this._eventMap[TAG_UTS_EVENT + type](data as ZIMEventOfTokenWillExpireResult);
            };
            this._zim!.on(type, this._eventMap[type]);
        }
    }

    onUserInfoUpdated(callback: null | ((data: ZIMEventOfUserInfoUpdatedResult) => void)): void {        
        const type = 'userInfoUpdated';
        if (callback == null && this._eventMap[type] != null && this._eventMap[type] != undefined) {
            this._zim!.off(type, this._eventMap[type]);
            this._eventMap[type] = null;
        } else if (callback != null && this.onEvent(type, callback)) {
            this._eventMap[type] = (_: NZIM, data: NZIMEventOfUserInfoUpdatedResult) => {
                this._eventMap[TAG_UTS_EVENT + type](data as ZIMEventOfUserInfoUpdatedResult);
            };
            this._zim!.on(type, this._eventMap[type]);
        }
    }

