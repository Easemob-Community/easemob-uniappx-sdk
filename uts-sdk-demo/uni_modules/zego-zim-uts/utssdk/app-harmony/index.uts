    queryHistoryMessage(
        conversationID: string,
        conversationType: ZIMConversationType,
        config: ZIMMessageQueryConfig,
    ): Promise<ZIMMessageQueriedResult> {
        const _config: NZIMMessageQueryConfig = { count: config.count, reverse: config.reverse };
        if (typeof config.nextMessage == 'string' && config.nextMessage != '') {
            _config.nextMessage = this.nextMessageMap.get(config.nextMessage!)!;
        }

        return this._zim!.queryHistoryMessage(conversationID, conversationType, _config).then((res) => {
            const len = res.messageList.length;
            if (len > 0) {
                this.putNextMessage(res.messageList[0]);
                this.putNextMessage(res.messageList[len - 1]);
            }
            return {
                conversationID: res.conversationID,
                conversationType: res.conversationType,
                messageList: mZIMMessageList(res.messageList),
            } as ZIMMessageQueriedResult;
        });
    }

    queryMessages(
        messageSeqs: number[],
        conversationID: string,
        conversationType: ZIMConversationType,
    ): Promise<ZIMMessageQueriedResult> {
        return this._zim!.queryMessages(messageSeqs, conversationID, conversationType).then((res) => {
            return {
                conversationID: res.conversationID,
                conversationType: res.conversationType,
                messageList: mZIMMessageList(res.messageList),
            } as ZIMMessageQueriedResult;
        });
    }

