    // MARK: - DB Search
    
    searchLocalConversations(config: ZIMConversationSearchConfig): Promise<ZIMConversationsSearchedResult> {
        return this._zim!.searchLocalConversations(config);
    }
    
    searchLocalMessages(
        conversationID: string,
        conversationType: ZIMConversationType,
        config: ZIMMessageSearchConfig,
    ): Promise<ZIMMessagesSearchedResult> {
        if (config.nextMessage != null) {
            config.nextMessage = this.nextMessageMap.get(config.nextMessage!);
        }
        return this._zim!.searchLocalMessages(conversationID, conversationType, config).then((res) => {
            if (res.nextMessage != null) {
                res.nextMessage = this.putNextMessage(res.nextMessage);
            }
            return res;
        });
    }
    
    searchGlobalLocalMessages(config: ZIMMessageSearchConfig): Promise<ZIMMessagesGlobalSearchedResult> {
        if (config.nextMessage != null) {
            config.nextMessage = this.nextMessageMap.get(config.nextMessage!);
        }
        return this._zim!.searchGlobalLocalMessages(config).then((res) => {
            if (res.nextMessage != null) {
                res.nextMessage = this.putNextMessage(res.nextMessage);
            }
            return res;
        });
    }
    
    searchLocalGroups(config: ZIMGroupSearchConfig): Promise<ZIMGroupsSearchedResult> {
        return this._zim!.searchLocalGroups(config);
    }
    
