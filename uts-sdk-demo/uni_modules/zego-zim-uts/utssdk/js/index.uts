export class ZIM implements IZIM {
    private static _logLevel = '';
    private static _instance: IZIM | null = null;
    
    private _zim : ZIMSDK | null = null;
    private constructor(nzim : ZIMSDK) {
        this._zim = nzim;
    }
    
    // 与 iOS 保持逻辑一致
    private nextMessageMap = new Map<string, any>();
    private nextConversationMap = new Map<string, any>();
    private putNextMessage(msgObj: any): string {
        const key = msgObj.localMessageID;
        this.nextMessageMap.set(key , msgObj);
        return key;
    }
    private putNextConversation(convObj: any): string {
        const key = convObj.type.toString() + convObj.conversationID;
        this.nextConversationMap.set(key , convObj);
        return key;
    }
    
    /**
     * 不支持，保留空实现
     */
    static setAdvancedConfig(key : string, value : string): void {}
    
    /**
     * 不支持，保留空实现
     */
    static setCacheConfig(config : ZIMCacheConfig): void {}
    
    static setLogConfig(config : ZIMLogConfig): void {
        if (config.logLevel != null) {
            this._logLevel = config.logLevel!;
        }
    }
    
    static setGeofencingConfig(areaList : number[], type : ZIMGeofencingType): boolean {
        return NZIM.setGeofencingConfig(areaList, type);
    }

    static getVersion(): string {
        return NZIM.getVersion();
    }

    static create(appConfig : ZIMAppConfig): IZIM {
        if(this._instance == null) {
            const nzim = NZIM.create(appConfig);
            nzim!.setLogConfig({ logLevel: this._logLevel });
            
            this._instance = new ZIM(nzim!);
        }
        return this._instance!;
    }
    
    static getInstance(): IZIM {
        return this._instance!;
    }
    

    destroy() : void {
        this.nextMessageMap.clear();
        this.nextConversationMap.clear();
        if (this._zim != null) {
            this._zim!.destroy();
            this._zim = null;
        }
    }
    
    uploadLog() : Promise<void> {
        return this._zim!.uploadLog();
    }

    /**
     * 不支持，保留空实现
     */
    queryLocalFileCache(config: ZIMFileCacheQueryConfig): Promise<ZIMFileCacheQueriedResult> {
        return Promise.resolve({ totalFileSize: 0 });
    }
    
    /**
     * 不支持，保留空实现
     */
    clearLocalFileCache(config: ZIMFileCacheClearConfig): Promise<void> {
        return Promise.resolve();
    }
    
    // MARK: - User
    
    login(userID: string, config: ZIMLoginConfig): Promise<void> {
        return this._zim!.login(userID, config);
    }
    
    logout(): void {
        this.nextMessageMap.clear();
        this.nextConversationMap.clear();
        this._zim!.logout();
    }
    
    renewToken(token: string): Promise<ZIMTokenRenewedResult> {
        return this._zim!.renewToken(token);
    }
    
    updateUserName(userName: string): Promise<ZIMUserNameUpdatedResult> {
        return this._zim!.updateUserName(userName);
    }
    
    updateUserAvatarUrl(userAvatarUrl: string): Promise<ZIMUserAvatarUrlUpdatedResult> {
        return this._zim!.updateUserAvatarUrl(userAvatarUrl);
    }
    
    updateUserExtendedData(extendedData: string): Promise<ZIMUserExtendedDataUpdatedResult> {
        return this._zim!.updateUserExtendedData(extendedData);
    }
    
    updateUserCustomStatus(customStatus: string): Promise<ZIMUserCustomStatusUpdatedResult> {
        return this._zim!.updateUserCustomStatus(customStatus);
    }
    
    updateUserOfflinePushRule(offlinePushRule: ZIMUserOfflinePushRule): Promise<ZIMUserOfflinePushRuleUpdatedResult> {
        return this._zim!.updateUserOfflinePushRule(offlinePushRule);
    }
    
    querySelfUserInfo(): Promise<ZIMSelfUserInfoQueriedResult> {
        return this._zim!.querySelfUserInfo();
    }
    
    queryUsersInfo(userIDs: string[], config: ZIMUsersInfoQueryConfig): Promise<ZIMUsersInfoQueriedResult> {
        return this._zim!.queryUsersInfo(userIDs, config);
    }
    
    subscribeUsersStatus(
        userIDs: string[],
        config: ZIMUserStatusSubscribeConfig,
    ): Promise<ZIMUsersStatusSubscribedResult> {
        return this._zim!.subscribeUsersStatus(userIDs, config);
    }
    
    unsubscribeUsersStatus(userIDs: string[]): Promise<ZIMUsersStatusUnsubscribedResult> {
        return this._zim!.unsubscribeUsersStatus(userIDs);
    }
    
    queryUsersStatus(userIDs: string[]): Promise<ZIMUsersStatusQueriedResult> {
        return this._zim!.queryUsersStatus(userIDs);
    }
    
    querySubscribedUserStatusList(
        config: ZIMSubscribedUserStatusQueryConfig,
    ): Promise<ZIMSubscribedUserStatusListQueriedResult> {
        return this._zim!.querySubscribedUserStatusList(config);
    }
    
    // MARK: - Conversation
    
    queryConversation(
        conversationID: string,
        conversationType: ZIMConversationType,
    ): Promise<ZIMConversationQueriedResult> {
        return this._zim!.queryConversation(conversationID, conversationType);
    }
    
    queryConversationList(
        config: ZIMConversationQueryConfig,
        option?: ZIMConversationFilterOption,
    ): Promise<ZIMConversationListQueriedResult> {
        if (config.nextConversation != null) {
            config.nextConversation = this.nextConversationMap.get(config.nextConversation!);
        }
        return this._zim!.queryConversationList(config, option).then((res) => {
            const len = res.conversationList.length;
            if (len > 0) {
                this.putNextConversation(res.conversationList[len - 1]);
            }
            return res;
        });
    }
    
    queryConversationPinnedList(config: ZIMConversationQueryConfig): Promise<ZIMConversationPinnedListQueriedResult> {
        if (config.nextConversation != null) {
            config.nextConversation = this.nextConversationMap.get(config.nextConversation!);
        }
        return this._zim!.queryConversationPinnedList(config).then((res) => {
            const len = res.conversationList.length;
            if (len > 0) {
                this.putNextConversation(res.conversationList[len - 1]);
            }
            return res;
        });
    }
    
    queryConversationTotalUnreadMessageCount(
        config: ZIMConversationTotalUnreadMessageCountQueryConfig,
    ): Promise<ZIMConversationTotalUnreadMessageCountQueriedResult> {
        return this._zim!.queryConversationTotalUnreadMessageCount(config);
    }
    
    deleteConversation(
        conversationID: string,
        conversationType: ZIMConversationType,
        config: ZIMConversationDeleteConfig,
    ): Promise<ZIMConversationDeletedResult> {
        return this._zim!.deleteConversation(conversationID, conversationType, config);
    }
    
    deleteAllConversations(config: ZIMConversationDeleteConfig): Promise<void> {
        return this._zim!.deleteAllConversations(config);
    }
    
    deleteAllConversationMessages(config: ZIMMessageDeleteConfig): Promise<void> {
        return this._zim!.deleteAllConversationMessages(config);
    }
    
    clearConversationUnreadMessageCount(
        conversationID: string,
        conversationType: ZIMConversationType,
    ): Promise<ZIMConversationUnreadMessageCountClearedResult> {
        return this._zim!.clearConversationUnreadMessageCount(conversationID, conversationType);
    }
    
    clearConversationTotalUnreadMessageCount(): Promise<void> {
        return this._zim!.clearConversationTotalUnreadMessageCount();
    }
    
    updateConversationPinnedState(
        isPinned: boolean,
        conversationID: string,
        conversationType: ZIMConversationType,
    ): Promise<ZIMConversationPinnedStateUpdatedResult> {
        return this._zim!.updateConversationPinnedState(isPinned, conversationID, conversationType);
    }
    
    setConversationDraft(
        draft: string,
        conversationID: string,
        conversationType: ZIMConversationType,
    ): Promise<ZIMConversationDraftSetResult> {
        return this._zim!.setConversationDraft(draft, conversationID, conversationType);
    }
    
    setConversationMark(
        markType: number,
        enable: boolean,
        conversationInfos: ZIMConversationBaseInfo[],
    ): Promise<ZIMConversationMarkSetResult> {
        return this._zim!.setConversationMark(markType, enable, conversationInfos);
    }
    
    setConversationNotificationStatus(
        status: ZIMConversationNotificationStatus,
        conversationID: string,
        conversationType: ZIMConversationType,
    ): Promise<ZIMConversationNotificationStatusSetResult> {
        return this._zim!.setConversationNotificationStatus(status, conversationID, conversationType);
    }
    
    // MARK: - Message
    
    sendMessage(
        message: ZIMMessage,
        toConversationID: string,
        conversationType: ZIMConversationType,
        config: ZIMMessageSendConfig,
        notification?: ZIMMessageSendNotification,
    ): Promise<ZIMMessageSentResult> {
        return this._zim!.sendMessage(message, toConversationID, conversationType, config, notification);
    }
    
    replyMessage(
        message: ZIMMessage,
        toOriginalMessage: ZIMMessage,
        config: ZIMMessageSendConfig,
        notification?: ZIMMessageSendNotification,
    ): Promise<ZIMMessageSentResult> {
        return this._zim!.replyMessage(message, toOriginalMessage, config, notification);
    }
    
    editMessage(
        message: ZIMMessage,
        config: ZIMMessageEditConfig,
        notification?: ZIMMessageSendNotification,
    ): Promise<ZIMMessageEditedResult> {
        return this._zim!.editMessage(message, config, notification);
    }
    
    cancelSendingMessage(message: ZIMMessage, config: ZIMSendingMessageCancelConfig): Promise<void> {
        return this._zim!.cancelSendingMessage(message, config);
    }
    
    /**
     * 不支持，保留空实现
     */
    downloadMediaFile(
        message: ZIMMessage,
        fileType: ZIMMediaFileType,
        config: ZIMMediaDownloadConfig,
        progress: ZIMMediaDownloadingProgress,
    ): Promise<ZIMMediaDownloadedResult> {
        return Promise.resolve({ message });
    }
    
    /**
     * 不支持，保留空实现
     */
    importLocalMessages(
        folderPath: string,
        config: ZIMMessageImportConfig,
        progress: ZIMMessageImportingProgress,
    ): Promise<void> {
        return Promise.resolve();
    }
    
    /**
     * 不支持，保留空实现
     */
    exportLocalMessages(
        folderPath: string,
        config: ZIMMessageExportConfig,
        progress: ZIMMessageExportingProgress,
    ): Promise<void> {
        return Promise.resolve();
    }
    
    deleteMessages(
        messageList: ZIMMessage[],
        conversationID: string,
        conversationType: ZIMConversationType,
        config: ZIMMessageDeleteConfig,
    ): Promise<ZIMMessageDeletedResult> {
        return this._zim!.deleteMessages(messageList, conversationID, conversationType, config);
    }
    
    deleteAllMessage(
        conversationID: string,
        conversationType: ZIMConversationType,
        config: ZIMMessageDeleteConfig,
    ): Promise<ZIMMessageDeletedResult> {
        return this._zim!.deleteAllMessage(conversationID, conversationType, config);
    }
    
    queryHistoryMessage(
        conversationID: string,
        conversationType: ZIMConversationType,
        config: ZIMMessageQueryConfig,
    ): Promise<ZIMMessageQueriedResult> {
        if (config.nextMessage != null) {
            config.nextMessage = this.nextMessageMap.get(config.nextMessage!);
        }
        return this._zim!.queryHistoryMessage(conversationID, conversationType, config).then((res) => {
            const len = res.messageList.length;
            if (len > 0) {
                this.putNextMessage(res.messageList[0]);
                this.putNextMessage(res.messageList[len - 1]);
            }
            return res;
        });
    }
    
    queryMessages(
        messageSeqs: number[],
        conversationID: string,
        conversationType: ZIMConversationType,
    ): Promise<ZIMMessageQueriedResult> {
        return this._zim!.queryMessages(messageSeqs, conversationID, conversationType);
    }
    
    insertMessageToLocalDB(
        message: ZIMMessage,
        conversationID: string,
        conversationType: ZIMConversationType,
        senderUserID: string,
    ): Promise<ZIMMessageInsertedResult> {
        return this._zim!.insertMessageToLocalDB(message, conversationID, conversationType, senderUserID);
    }
    
    updateMessageLocalExtendedData(
        localExtendedData: string,
        message: ZIMMessage,
    ): Promise<ZIMMessageLocalExtendedDataUpdatedResult> {
        return this._zim!.updateMessageLocalExtendedData(localExtendedData, message);
    }
    
    revokeMessage(message: ZIMMessage, config: ZIMMessageRevokeConfig): Promise<ZIMMessageRevokedResult> {
        return this._zim!.revokeMessage(message, config);
    }
    
    queryCombineMessageDetail(message: ZIMMessage): Promise<ZIMCombineMessageDetailQueriedResult> {
        return this._zim!.queryCombineMessageDetail(message);
    }
    
    pinMessage(message: ZIMMessage, isPinned: boolean): Promise<void> {
        return this._zim!.pinMessage(message, isPinned);
    }
    
    queryPinnedMessageList(conversationID: string, conversationType: ZIMConversationType): Promise<ZIMPinnedMessageListQueriedResult> {
        return this._zim!.queryPinnedMessageList(conversationID, conversationType);
    }
    
    sendConversationMessageReceiptRead(
        conversationID: string,
        conversationType: ZIMConversationType,
    ): Promise<ZIMConversationMessageReceiptReadSentResult> {
        return this._zim!.sendConversationMessageReceiptRead(conversationID, conversationType);
    }
    
    sendMessageReceiptsRead(
        messageList: ZIMMessage[],
        conversationID: string,
        conversationType: ZIMConversationType,
    ): Promise<ZIMMessageReceiptsReadSentResult> {
        return this._zim!.sendMessageReceiptsRead(messageList, conversationID, conversationType);
    }
    
    queryMessageReceiptsInfo(
        messageList: ZIMMessage[],
        conversationID: string,
        conversationType: ZIMConversationType,
    ): Promise<ZIMMessageReceiptsInfoQueriedResult> {
        return this._zim!.queryMessageReceiptsInfo(messageList, conversationID, conversationType);
    }
    
    queryGroupMessageReceiptReadMemberList(
        message: ZIMMessage,
        groupID: string,
        config: ZIMGroupMessageReceiptMemberQueryConfig,
    ): Promise<ZIMGroupMessageReceiptMemberListQueriedResult> {
        return this._zim!.queryGroupMessageReceiptReadMemberList(message, groupID, config);
    }
    
    queryGroupMessageReceiptUnreadMemberList(
        message: ZIMMessage,
        groupID: string,
        config: ZIMGroupMessageReceiptMemberQueryConfig,
    ): Promise<ZIMGroupMessageReceiptMemberListQueriedResult> {
        return this._zim!.queryGroupMessageReceiptUnreadMemberList(message, groupID, config);
    }
    
    addMessageReaction(reactionType: string, message: ZIMMessage): Promise<ZIMMessageReactionAddedResult> {
        return this._zim!.addMessageReaction(reactionType, message);
    }
    
    deleteMessageReaction(reactionType: string, message: ZIMMessage): Promise<ZIMMessageReactionDeletedResult> {
        return this._zim!.deleteMessageReaction(reactionType, message);
    }
    
    queryMessageReactionUserList(
        message: ZIMMessage,
        config: ZIMMessageReactionUserQueryConfig,
    ): Promise<ZIMMessageReactionUserListQueriedResult> {
        return this._zim!.queryMessageReactionUserList(message, config);
    }
    
    queryMessageRepliedList(
        message: ZIMMessage,
        config: ZIMMessageRepliedListQueryConfig,
    ): Promise<ZIMMessageRepliedListQueriedResult> {
        return this._zim!.queryMessageRepliedList(message, config);
    }
    
    // MARK: - Room
    
    createRoom(roomInfo: ZIMRoomInfo, config?: ZIMRoomAdvancedConfig): Promise<ZIMRoomCreatedResult> {
        return this._zim!.createRoom(roomInfo, config);
    }
    
    enterRoom(roomInfo: ZIMRoomInfo, config?: ZIMRoomAdvancedConfig): Promise<ZIMRoomEnteredResult> {
        return this._zim!.enterRoom(roomInfo, config);
    }
    
    switchRoom(
        fromRoomID: string,
        toRoomInfo: ZIMRoomInfo,
        isCreateWhenRoomNotExisted: boolean,
        config?: ZIMRoomAdvancedConfig,
    ): Promise<ZIMRoomSwitchedResult> {
        return this._zim!.switchRoom(fromRoomID, toRoomInfo, isCreateWhenRoomNotExisted, config);
    }
    
    joinRoom(roomID: string): Promise<ZIMRoomJoinedResult> {
        return this._zim!.joinRoom(roomID);
    }
    
    leaveRoom(roomID: string): Promise<ZIMRoomLeftResult> {
        return this._zim!.leaveRoom(roomID);
    }
    
    leaveAllRoom(): Promise<ZIMRoomAllLeftResult> {
