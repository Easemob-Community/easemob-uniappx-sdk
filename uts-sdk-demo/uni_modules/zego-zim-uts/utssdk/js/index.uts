    // MARK: - Event
    
    onError(callback: null | ((error: ZIMError) => void)): void {
        if (callback == null) {
            this._zim!.off('error');
        } else {
            this._zim!.on('error', (_, data) => callback(data));
        }
    }
    
    onConnectionStateChanged(callback: null | ((data: ZIMEventOfConnectionStateChangedResult) => void)): void {
        if (callback == null) {
            this._zim!.off('connectionStateChanged');
        } else {
            this._zim!.on('connectionStateChanged', (_, data) => {
                const str = data.extendedData;
                callback({
                    state: data.state as ZIMConnectionState,
                    event: data.event as ZIMConnectionEvent,
                    extendedData: JSON.parseObject(str == null || str.length == 0 ? '{}' : str) ?? {}
                });
            });
        }
    }
    
    onTokenWillExpire(callback: null | ((data: ZIMEventOfTokenWillExpireResult) => void)): void {
        if (callback == null) {
            this._zim!.off('tokenWillExpire');
        } else {
            this._zim!.on('tokenWillExpire', (_, data) => callback(data));
        }
    }
    
