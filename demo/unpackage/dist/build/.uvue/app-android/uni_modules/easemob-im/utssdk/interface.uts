/**
 * 环信IM SDK - 接口定义文件
 * 定义所有对外暴露的API、类型、错误码
 */
// ==================== 基础类型定义 ====================
/**
 * 消息类型枚举
 */
export type EMMessageType = 'txt' | 'image' | 'voice' | 'video' | 'location' | 'file' | 'cmd';
/**
 * 聊天类型枚举
 */
export type EMChatType = 'chat' | 'groupChat' | 'chatRoom';
/**
 * 连接状态枚举
 */
export type EMConnectionState = 'connected' | 'connecting' | 'disconnected';
/**
 * 消息发送状态
 */
export type EMMessageStatus = 'pending' | 'sending' | 'success' | 'fail';
// ==================== 配置类 ====================
/**
 * SDK初始化配置选项
 */
export interface EMOptions {
    /** 环信AppKey */
    appKey: string;
    /** 是否开启自动登录 */
    autoLogin?: boolean;
    /** 是否开启调试模式 */
    debugMode?: boolean;
    /** 是否使用私有部署 */
    usePrivateServer?: boolean;
    /** REST服务器地址（私有部署时配置） */
    restServer?: string;
    /** IM服务器地址（私有部署时配置） */
    imServer?: string;
    /** IM服务器端口 */
    imPort?: number;
}
// ==================== 用户相关 ====================
/**
 * 当前登录用户信息
 */
export interface EMUserInfo {
    /** 用户ID */
    userId: string;
    /** 昵称 */
    nickname?: string;
    /** 头像URL */
    avatarUrl?: string;
    /** 邮箱 */
    email?: string;
    /** 手机号 */
    phone?: string;
    /** 性别 */
    gender?: number;
    /** 签名 */
    sign?: string;
    /** 扩展信息 */
    ext?: string;
}
/**
 * 登录参数
 */
export interface EMLoginParam {
    /** 用户名 */
    username: string;
    /** 密码 */
    password?: string;
    /** Token（密码和token二选一） */
    token?: string;
}
// ==================== 消息相关 ====================
/**
 * 消息基础结构
 */
export interface EMMessage {
    /** 消息ID */
    msgId: string;
    /** 消息类型 */
    type: EMMessageType;
    /** 聊天类型 */
    chatType: EMChatType;
    /** 发送方ID */
    from: string;
    /** 接收方ID */
    to: string;
    /** 时间戳 */
    timestamp: number;
    /** 本地时间戳 */
    localTime: number;
    /** 消息方向：true=发送，false=接收 */
    isSender: boolean;
    /** 消息状态 */
    status: EMMessageStatus;
    /** 是否已读 */
    isRead: boolean;
    /** 消息体内容 */
    body: EMTextMessageBody | EMImageMessageBody | EMVoiceMessageBody | EMFileMessageBody | EMCustomMessageBody;
    /** 扩展属性 */
    ext?: UTSJSONObject;
}
/**
 * 文本消息体
 */
export interface EMTextMessageBody {
    type: 'txt';
    /** 文本内容 */
    content: string;
}
/**
 * 图片消息体
 */
export interface EMImageMessageBody {
    type: 'image';
    /** 本地路径 */
    localPath?: string;
    /** 远程URL */
    remoteUrl?: string;
    /** 缩略图本地路径 */
    thumbnailLocalPath?: string;
    /** 缩略图远程URL */
    thumbnailRemoteUrl?: string;
    /** 图片宽度 */
    width?: number;
    /** 图片高度 */
    height?: number;
    /** 文件大小 */
    fileSize?: number;
    /** 显示名称 */
    displayName?: string;
}
/**
 * 语音消息体
 */
export interface EMVoiceMessageBody {
    type: 'voice';
    /** 本地路径 */
    localPath?: string;
    /** 远程URL */
    remoteUrl?: string;
    /** 语音时长（秒） */
    duration: number;
    /** 文件大小 */
    fileSize?: number;
    /** 显示名称 */
    displayName?: string;
}
/**
 * 文件消息体
 */
export interface EMFileMessageBody {
    type: 'file';
    /** 本地路径 */
    localPath?: string;
    /** 远程URL */
    remoteUrl?: string;
    /** 文件大小 */
    fileSize?: number;
    /** 显示名称 */
    displayName: string;
}
/**
 * 自定义消息体
 */
export interface EMCustomMessageBody {
    type: 'custom';
    /** 自定义事件名 */
    event: string;
    /** 自定义参数 */
    params?: UTSJSONObject;
}
/**
 * 发送消息参数
 */
export interface EMSendMessageParam {
    /** 接收方ID */
    to: string;
    /** 聊天类型 */
    chatType?: EMChatType;
    /** 消息体 */
    body: EMTextMessageBody | EMImageMessageBody | EMVoiceMessageBody | EMFileMessageBody | EMCustomMessageBody;
    /** 扩展属性 */
    ext?: UTSJSONObject;
}
// ==================== 会话相关 ====================
/**
 * 会话信息
 */
export interface EMConversation {
    /** 会话ID */
    conversationId: string;
    /** 会话类型 */
    type: EMChatType;
    /** 未读消息数 */
    unreadCount: number;
    /** 最后一条消息 */
    lastMessage?: EMMessage;
    /** 扩展信息 */
    ext?: string;
}
// ==================== 回调函数类型 ====================
/**
 * 通用成功回调
 */
export type EMSuccessCallback = () => void;
/**
 * 通用失败回调
 */
export type EMFailCallback = (code: number, message: string) => void;
/**
 * 通用进度回调
 */
export type EMProgressCallback = (progress: number) => void;
/**
 * 消息接收监听器
 */
export type EMMessageListener = (message: EMMessage) => void;
/**
 * 连接状态监听器
 */
export type EMConnectionListener = (state: EMConnectionState, error?: EMError) => void;
/**
 * Token即将过期监听器
 */
export type EMTokenWillExpireListener = () => void;
/**
 * Token已过期监听器
 */
export type EMTokenDidExpireListener = () => void;
// ==================== 错误类型 ====================
/**
 * 错误信息结构
 */
export interface EMError {
    /** 错误码 */
    code: number;
    /** 错误描述 */
    message: string;
}
/**
 * 错误码定义
 */
export enum EMErrorCode {
    // 通用错误
    GENERAL_ERROR = 1,
    NETWORK_ERROR = 2,
    DATABASE_ERROR = 3,
    // 登录相关
    INVALID_CREDENTIALS = 100,
    USER_NOT_FOUND = 101,
    USER_ALREADY_EXISTS = 102,
    USER_AUTHENTICATION_FAILED = 103,
    USER_LOGIN_ANOTHER_DEVICE = 104,
    USER_REMOVED = 105,
    USER_KICKED_BY_CHANGE_PASSWORD = 106,
    USER_KICKED_BY_OTHER_DEVICE = 107,
    // 消息相关
    MESSAGE_SEND_FAILED = 200,
    MESSAGE_DELETE_FAILED = 201,
    MESSAGE_UPDATE_FAILED = 202,
    // 连接相关
    CONNECTION_FAILED = 300,
    SERVER_NOT_REACHABLE = 301,
    SERVER_TIMEOUT = 302,
    SERVER_BUSY = 303,
    // 其他
    TOKEN_EXPIRED = 401,
    TOKEN_WILL_EXPIRE = 402,
    // 参数错误
    INVALID_PARAMS = 501,
    INVALID_USERNAME = 502,
    INVALID_PASSWORD = 503
}
// ==================== API 接口定义 ====================
/**
 * 环信IM SDK 主接口
 */
export interface EaseMobIM {
    // ==================== 初始化 ====================
    /**
     * 初始化SDK
     * @param options 配置选项
     */
    init(options: EMOptions): void;
    /**
     * 检查SDK是否已初始化
     */
    isInitialized(): boolean;
    // ==================== 用户管理 ====================
    /**
     * 用户注册
     * @param username 用户名
     * @param password 密码
     * @param onSuccess 成功回调
     * @param onFail 失败回调
     */
    register(username: string, password: string, onSuccess?: EMSuccessCallback, onFail?: EMFailCallback): void;
    /**
     * 用户登录
     * @param params 登录参数
     * @param onSuccess 成功回调
     * @param onFail 失败回调
     */
    login(params: EMLoginParam, onSuccess?: EMSuccessCallback, onFail?: EMFailCallback): void;
    /**
     * 用户登出
     * @param unbindDeviceToken 是否解绑设备token
     * @param onSuccess 成功回调
     * @param onFail 失败回调
     */
    logout(unbindDeviceToken?: boolean, onSuccess?: EMSuccessCallback, onFail?: EMFailCallback): void;
    /**
     * 获取当前登录用户
     */
    getCurrentUser(): EMUserInfo | null;
    /**
     * 检查是否已登录
     */
    isLoggedIn(): boolean;
    /**
     * 获取当前登录的Token
     */
    getToken(): string | null;
    // ==================== 消息管理 ====================
    /**
     * 发送消息
     * @param param 发送参数
     * @param onSuccess 成功回调，返回消息对象
     * @param onFail 失败回调
     * @param onProgress 进度回调（用于文件消息）
     */
    sendMessage(param: EMSendMessageParam, onSuccess?: (message: EMMessage) => void, onFail?: EMFailCallback, onProgress?: EMProgressCallback): void;
    /**
     * 创建文本消息
     * @param to 接收方ID
     * @param content 文本内容
     * @param chatType 聊天类型，默认为单聊
     */
    createTextMessage(to: string, content: string, chatType?: EMChatType): EMSendMessageParam;
    /**
     * 创建图片消息
     * @param to 接收方ID
     * @param localPath 图片本地路径
     * @param chatType 聊天类型，默认为单聊
     */
    createImageMessage(to: string, localPath: string, chatType?: EMChatType): EMSendMessageParam;
    /**
     * 创建语音消息
     * @param to 接收方ID
     * @param localPath 语音文件本地路径
     * @param duration 语音时长（秒）
     * @param chatType 聊天类型，默认为单聊
     */
    createVoiceMessage(to: string, localPath: string, duration: number, chatType?: EMChatType): EMSendMessageParam;
    /**
     * 创建文件消息
     * @param to 接收方ID
     * @param localPath 文件本地路径
     * @param displayName 显示名称
     * @param chatType 聊天类型，默认为单聊
     */
    createFileMessage(to: string, localPath: string, displayName: string, chatType?: EMChatType): EMSendMessageParam;
    /**
     * 创建自定义消息
     * @param to 接收方ID
     * @param event 自定义事件名
     * @param params 自定义参数
     * @param chatType 聊天类型，默认为单聊
     */
    createCustomMessage(to: string, event: string, params?: UTSJSONObject, chatType?: EMChatType): EMSendMessageParam;
    /**
     * 重发消息
     * @param msgId 消息ID
     * @param onSuccess 成功回调
     * @param onFail 失败回调
     */
    resendMessage(msgId: string, onSuccess?: (message: EMMessage) => void, onFail?: EMFailCallback): void;
    /**
     * 撤回消息
     * @param msgId 消息ID
     * @param onSuccess 成功回调
     * @param onFail 失败回调
     */
    recallMessage(msgId: string, onSuccess?: EMSuccessCallback, onFail?: EMFailCallback): void;
    /**
     * 删除消息
     * @param msgId 消息ID
     * @param onSuccess 成功回调
     * @param onFail 失败回调
     */
    deleteMessage(msgId: string, onSuccess?: EMSuccessCallback, onFail?: EMFailCallback): void;
    /**
     * 根据ID获取消息
     * @param msgId 消息ID
     */
    getMessageById(msgId: string): EMMessage | null;
    /**
     * 加载会话中的消息
     * @param conversationId 会话ID
     * @param chatType 聊天类型
     * @param limit 加载数量，默认20
     * @param fromId 从指定消息ID开始加载（用于分页）
     */
    loadMessages(conversationId: string, chatType: EMChatType, limit?: number, fromId?: string): EMMessage[];
    // ==================== 会话管理 ====================
    /**
     * 获取所有会话
     */
    getAllConversations(): EMConversation[];
    /**
     * 获取指定会话
     * @param conversationId 会话ID
     * @param chatType 聊天类型
     * @param createIfNotExists 不存在时是否创建，默认false
     */
    getConversation(conversationId: string, chatType: EMChatType, createIfNotExists?: boolean): EMConversation | null;
    /**
     * 删除会话
     * @param conversationId 会话ID
     * @param chatType 聊天类型
     * @param deleteMessages 是否同时删除消息，默认true
     * @param onSuccess 成功回调
     * @param onFail 失败回调
     */
    deleteConversation(conversationId: string, chatType: EMChatType, deleteMessages?: boolean, onSuccess?: EMSuccessCallback, onFail?: EMFailCallback): void;
    /**
     * 获取会话未读消息总数
     */
    getUnreadMessageCount(): number;
    /**
     * 将所有消息标记为已读
     * @param conversationId 会话ID，不传则标记所有会话
     */
    markAllMessagesAsRead(conversationId?: string): void;
    /**
     * 标记指定消息为已读
     * @param msgId 消息ID
     */
    markMessageAsRead(msgId: string): void;
    // ==================== 事件监听 ====================
    /**
     * 添加消息接收监听器
     * @param listener 监听器函数
     */
    addMessageListener(listener: EMMessageListener): void;
    /**
     * 移除消息接收监听器
     * @param listener 监听器函数
     */
    removeMessageListener(listener: EMMessageListener): void;
    /**
     * 添加连接状态监听器
     * @param listener 监听器函数
     */
    addConnectionListener(listener: EMConnectionListener): void;
    /**
     * 移除连接状态监听器
     * @param listener 监听器函数
     */
    removeConnectionListener(listener: EMConnectionListener): void;
    /**
     * 添加Token即将过期监听器
     * @param listener 监听器函数
     */
    addTokenWillExpireListener(listener: EMTokenWillExpireListener): void;
    /**
     * 移除Token即将过期监听器
     * @param listener 监听器函数
     */
    removeTokenWillExpireListener(listener: EMTokenWillExpireListener): void;
    /**
     * 添加Token已过期监听器
     * @param listener 监听器函数
     */
    addTokenDidExpireListener(listener: EMTokenDidExpireListener): void;
    /**
     * 移除Token已过期监听器
     * @param listener 监听器函数
     */
    removeTokenDidExpireListener(listener: EMTokenDidExpireListener): void;
    // ==================== 其他 ====================
    /**
     * 刷新Token
     * @param token 新的Token
     */
    renewToken(token: string): void;
    /**
     * 获取SDK版本号
     */
    getVersion(): string;
    /**
     * 设置日志级别
     * @param level 日志级别：0=关闭，1=错误，2=警告，3=信息，4=调试
     */
    setLogLevel(level: number): void;
}
/**
 * 插件默认导出对象
 */
export interface EaseMobIMPlugin {
    /** SDK实例 */
    readonly im: EaseMobIM;
    /** 错误码枚举 */
    readonly ErrorCode: typeof EMErrorCode;
    /** 消息类型枚举 */
    readonly MessageType: {
        TEXT: 'txt';
        IMAGE: 'image';
        VOICE: 'voice';
        VIDEO: 'video';
        LOCATION: 'location';
        FILE: 'file';
        CMD: 'cmd';
    };
    /** 聊天类型枚举 */
    readonly ChatType: {
        CHAT: 'chat';
        GROUP_CHAT: 'groupChat';
        CHAT_ROOM: 'chatRoom';
    };
}
