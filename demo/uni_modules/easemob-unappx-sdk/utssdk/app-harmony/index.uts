import { EasemobErrorImpl } from '../unierror';

/**
 * 初始化环信 SDK (HarmonyOS 待实现)
 */
export function initChat(options: EasemobInitOptions): void {
    console.warn('[Easemob HarmonyOS] 暂不支持 HarmonyOS 平台');
    const err = new EasemobErrorImpl(9010001, '暂不支持 HarmonyOS 平台');
    options.fail?.(err);
    options.complete?.(err);
}

