import { UTSAndroid } from "io.dcloud.uts";
import EMOptions from "com.hyphenate.chat.EMOptions";
import EMClient from "com.hyphenate.chat.EMClient";
import EMMessage from "com.hyphenate.chat.EMMessage";
import EMTextMessageBody from "com.hyphenate.chat.EMTextMessageBody";
import EMCallBack from "com.hyphenate.EMCallBack";
import EMConnectionListener from "com.hyphenate.EMConnectionListener";
import EMMessageListener from "com.hyphenate.EMMessageListener";
import HyphenateException from "com.hyphenate.exceptions.HyphenateException";
import Thread from "java.lang.Thread";

/**
 * 初始化环信 SDK
 */
export function initChat(appkey : string) : void {
	const options = new EMOptions();
	options.setAppKey(appkey);
	options.setAutoLogin(false);
	console.log('[Easemob] init SDK with appkey:', appkey);
	EMClient.getInstance().init(UTSAndroid.getAppContext(), options);
	EMClient.getInstance().addConnectionListener(new EMConnectionListenerImpl());
	EMClient.getInstance().chatManager().addMessageListener(new EMMessageListenerImpl());
	console.log('[Easemob] SDK init success');
}

/**
 * 设置调试模式
 */
export function setDebugMode(enable : boolean) : void {
	EMClient.getInstance().setDebugMode(enable);
}

/**
 * 用户注册
 */
export function createAccount(userId : string, password : string) : void {
	console.log('[Easemob] createAccount:', userId);
	new RegisterThread(userId, password).start();
}

/**
 * 用户登录
 */
export function login(userId : string, password : string) : void {
	console.log('[Easemob] login:', userId);
	EMClient.getInstance().login(userId, password, new LoginEMCallBack());
}

/**
 * 使用 Token 登录
 */
export function loginWithToken(userId : string, token : string) : void {
	console.log('[Easemob] loginWithToken:', userId);
	EMClient.getInstance().loginWithToken(userId, token, new LoginEMCallBack());
}

/**
 * 用户登出
 */
export function logout() : void {
	console.log('[Easemob] logout');
	EMClient.getInstance().logout(true, new LogoutEMCallBack());
}

/**
 * 发送文本消息
 */
export function sendTextMessage(content : string, to : string) : void {
	console.log('[Easemob] sendTextMessage to:', to);
	const message = EMMessage.createTextSendMessage(content, to);
	EMClient.getInstance().chatManager().sendMessage(message);
}

/**
 * 获取当前登录用户
 */
export function getCurrentUser() : string {
	return EMClient.getInstance().getCurrentUser();
}

/**
 * 判断是否已登录
 */
export function isLoggedIn() : boolean {
	return EMClient.getInstance().isLoggedInBefore();
}

/**
 * 判断是否连接到服务器
 */
export function isConnected() : boolean {
	return EMClient.getInstance().isConnected();
}

/**
 * 加载本地会话
 */
export function loadAllConversations() : void {
	EMClient.getInstance().chatManager().loadAllConversations();
}

/**
 * 加载本地群组
 */
export function loadAllGroups() : void {
	EMClient.getInstance().groupManager().loadAllGroups();
}

// ============================================
// 内部实现类
// ============================================

/**
 * 登录回调
 */
class LoginEMCallBack extends EMCallBack {
	constructor() {
		super();
	}

	override onError(params0 : number, params1 : string) : void {
		console.log('[Easemob] login error:', params0, params1);
	}

	override onProgress(params0 : number, params1 : string) : void {
		console.log('[Easemob] login progress:', params0, params1);
	}

	override onSuccess() : void {
		console.log('[Easemob] login success');
	}
}

/**
 * 登出回调
 */
class LogoutEMCallBack extends EMCallBack {
	constructor() {
		super();
	}

	override onError(params0 : number, params1 : string) : void {
		console.log('[Easemob] logout error:', params0, params1);
	}

	override onSuccess() : void {
		console.log('[Easemob] logout success');
	}
}

/**
 * 连接状态监听
 */
class EMConnectionListenerImpl extends EMConnectionListener {
	constructor() {
		super();
	}

	override onConnected() : void {
		console.log('[Easemob] onConnected');
	}

	override onDisconnected(params0 : number) : void {
		console.log('[Easemob] onDisconnected:', params0);
	}
}

/**
 * 消息监听
 */
class EMMessageListenerImpl extends EMMessageListener {
	constructor() {
		super();
	}

	override onMessageReceived(messages : MutableList<EMMessage>) : void {
		console.log('[Easemob] onMessageReceived, count:', messages.size);
		for (let i = 0; i < messages.size; i++) {
			const msg = messages.get(i);
			console.log('[Easemob] msg from:', msg.getFrom(), 'id:', msg.getMsgId());
			const body = msg.getBody();
			if (body instanceof EMTextMessageBody) {
				const textBody = body as EMTextMessageBody;
				console.log('[Easemob] text content:', textBody.getMessage());
			}
		}
	}

	override onCmdMessageReceived(messages : MutableList<EMMessage>) : void {
		console.log('[Easemob] onCmdMessageReceived, count:', messages.size);
	}

	override onMessageRead(messages : MutableList<EMMessage>) : void {
		console.log('[Easemob] onMessageRead, count:', messages.size);
	}

	override onMessageDelivered(messages : MutableList<EMMessage>) : void {
		console.log('[Easemob] onMessageDelivered, count:', messages.size);
	}

	override onMessageRecalled(messages : MutableList<EMMessage>) : void {
		console.log('[Easemob] onMessageRecalled, count:', messages.size);
	}
}

/**
 * 注册线程
 */
class RegisterThread extends Thread {
	userId : string;
	password : string;

	constructor(userId : string, password : string) {
		super();
		this.userId = userId;
		this.password = password;
	}

	override run() : void {
		try {
			EMClient.getInstance().createAccount(this.userId, this.password);
			console.log('[Easemob] createAccount success');
		} catch (e) {
			const err = e as HyphenateException;
			console.log('[Easemob] createAccount failed:', err.getErrorCode(), err.getDescription());
		}
	}
}
