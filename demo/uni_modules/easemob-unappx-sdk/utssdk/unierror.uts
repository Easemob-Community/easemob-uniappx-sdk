/**
 * unierror.uts
 * 环信即时通讯 SDK UTS 插件错误定义文件
 */

import { EasemobErrorCode, EasemobError } from "./interface.uts";

/**
 * 错误主题
 */
export const EasemobErrorSubject = 'easemob-unappx-sdk';

/**
 * 错误信息映射表
 */
export const EasemobErrors: Map<EasemobErrorCode, string> = new Map([
    // 通用错误
    [9010001, '未知错误'],
    [9010002, '参数错误'],
    [9010003, '网络错误'],
    [9010004, 'SDK 未初始化'],
    // 登录相关错误
    [9020001, '登录失败'],
    [9020002, '登出失败'],
    [9020003, 'Token 无效或过期'],
    [9020004, '用户已存在'],
    [9020005, '用户不存在'],
    [9020006, '密码错误'],
    // 注册相关错误
    [9030001, '注册失败'],
    [9030002, '用户名无效'],
    [9030003, '密码无效'],
    // 消息相关错误
    [9040001, '发送消息失败'],
    [9040002, '消息内容为空'],
    [9040003, '接收方 ID 为空'],
]);

/**
 * 环信错误对象实现类
 */
export class EasemobErrorImpl extends UniError implements EasemobError {
    override errCode: EasemobErrorCode;
    override errSubject: string;

    /**
     * 构造函数
     * @param errCode 错误码
     * @param customMsg 自定义错误消息（可选）
     */
    constructor(errCode: EasemobErrorCode, customMsg?: string) {
        super();
        this.errSubject = EasemobErrorSubject;
        this.errCode = errCode;
        this.errMsg = customMsg ?? EasemobErrors.get(errCode) ?? '未知错误';
    }
}

/**
 * 获取错误信息
 * @param code 错误码
 * @returns 错误信息
 */
export function getErrorMessage(code: EasemobErrorCode): string {
    return EasemobErrors.get(code) ?? '未知错误';
}
