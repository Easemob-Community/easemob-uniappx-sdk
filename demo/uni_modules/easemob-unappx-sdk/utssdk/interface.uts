/**
 * interface.uts
 * 环信即时通讯 SDK UTS 插件接口定义文件
 */

// ============================================
// 通用类型定义
// ============================================

/**
 * 通用结果
 */
export type EasemobResult = {
    success: boolean;
    errCode: number;
    errMsg: string;
}

/**
 * 聊天类型
 * 0: 单聊 (Chat)
 * 1: 群聊 (GroupChat)
 * 2: 聊天室 (ChatRoom)
 */
export type ChatType = 0 | 1 | 2;

// ============================================
// 错误码定义
// ============================================

export type EasemobErrorCode = 
    | 9010001
    | 9010002
    | 9010003
    | 9010004
    | 9020001
    | 9020002
    | 9020003
    | 9020004
    | 9020005
    | 9020006
    | 9030001
    | 9030002
    | 9030003
    | 9040001
    | 9040002
    | 9040003;

/**
 * 环信错误对象
 */
export interface EasemobError extends IUniError {
    errCode: EasemobErrorCode;
    errSubject: string;
}

// ============================================
// 函数类型定义（简化版）
// ============================================

/** 初始化 SDK */
export type InitChat = (appkey: string) => void;

/** 设置调试模式 */
export type SetDebugMode = (enable: boolean) => void;

/** 用户注册 */
export type CreateAccount = (userId: string, password: string) => void;

/** 用户登录 */
export type Login = (userId: string, password: string) => void;

/** Token 登录 */
export type LoginWithToken = (userId: string, token: string) => void;

/** 用户登出 */
export type Logout = () => void;

/** 发送文本消息 */
export type SendTextMessage = (content: string, to: string) => void;

/** 获取当前用户 */
export type GetCurrentUser = () => string;

/** 判断是否已登录 */
export type IsLoggedIn = () => boolean;

/** 判断是否已连接 */
export type IsConnected = () => boolean;

/** 加载本地会话 */
export type LoadAllConversations = () => void;

/** 加载本地群组 */
export type LoadAllGroups = () => void;
