/**
 * 环信IM SDK - iOS极简版
 */

// 全局状态
let gInited = false

/**
 * 初始化SDK
 */
export function init(appKey: string): boolean {
  // iOS初始化实现
  console.log('[EM] iOS init:', appKey)
  gInited = true
  return true
}

/**
 * 获取SDK版本
 */
export function getVersion(): string {
  return '4.15.1'
}

/**
 * 是否已初始化
 */
export function isInited(): boolean {
  return gInited
}
