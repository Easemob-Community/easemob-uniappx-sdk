/**
 * 环信IM SDK - 简化版入口
 */

// #ifdef APP-ANDROID
import {
  init as androidInit,
  login as androidLogin,
  logout as androidLogout,
  sendText as androidSendText,
  onMessage as androidOnMessage,
  isLoggedIn as androidIsLoggedIn,
  getVersion as androidGetVersion
} from './app-android/index.uts'
// #endif

// #ifdef APP-IOS
import {
  init as iosInit,
  login as iosLogin,
  logout as iosLogout,
  sendText as iosSendText,
  onMessage as iosOnMessage,
  isLoggedIn as iosIsLoggedIn,
  getVersion as iosGetVersion
} from './app-ios/index.uts'
// #endif

// 导出API
export const im = {
  /**
   * 初始化
   */
  init: (appKey: string): boolean => {
    // #ifdef APP-ANDROID
    return androidInit(appKey)
    // #endif
    // #ifdef APP-IOS
    return iosInit(appKey)
    // #endif
    return false
  },
  
  /**
   * 登录
   */
  login: (username: string, password: string, onSuccess?: any, onFail?: any): void => {
    // #ifdef APP-ANDROID
    androidLogin(username, password, onSuccess, onFail)
    // #endif
    // #ifdef APP-IOS
    iosLogin(username, password, onSuccess, onFail)
    // #endif
  },
  
  /**
   * 登出
   */
  logout: (onSuccess?: any): void => {
    // #ifdef APP-ANDROID
    androidLogout(onSuccess)
    // #endif
    // #ifdef APP-IOS
    iosLogout(onSuccess)
    // #endif
  },
  
  /**
   * 发送文本消息
   */
  sendText: (to: string, content: string, onSuccess?: any, onFail?: any): void => {
    // #ifdef APP-ANDROID
    androidSendText(to, content, onSuccess, onFail)
    // #endif
    // #ifdef APP-IOS
    iosSendText(to, content, onSuccess, onFail)
    // #endif
  },
  
  /**
   * 监听消息
   */
  onMessage: (listener: any): void => {
    // #ifdef APP-ANDROID
    androidOnMessage(listener)
    // #endif
    // #ifdef APP-IOS
    iosOnMessage(listener)
    // #endif
  },
  
  /**
   * 是否已登录
   */
  isLoggedIn: (): boolean => {
    // #ifdef APP-ANDROID
    return androidIsLoggedIn()
    // #endif
    // #ifdef APP-IOS
    return iosIsLoggedIn()
    // #endif
    return false
  },
  
  /**
   * 获取版本
   */
  getVersion: (): string => {
    // #ifdef APP-ANDROID
    return androidGetVersion()
    // #endif
    // #ifdef APP-IOS
    return iosGetVersion()
    // #endif
    return ''
  }
}

export default { im }
